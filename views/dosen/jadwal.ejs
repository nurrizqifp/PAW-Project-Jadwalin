<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Jadwal Mengajar Dosen — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'jadwal', currentRole: 'dosen' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-7xl mx-auto space-y-6">

  <% const dsn = (typeof activeDosen !== 'undefined' && activeDosen) ? activeDosen : { inisial: 'AS', nama: 'Ir. Asroni, S.T., M.Eng', bebanSks: 12 }; %>
  <% const dsnJadwal = (typeof dosenJadwal !== 'undefined' && Array.isArray(dosenJadwal)) ? dosenJadwal : []; %>
  <!-- Kop Resmi Khusus Cetak / Print A4 -->
  <div class="print-header hidden">
    <div class="border-b-2 border-zinc-900 pb-3 mb-4 text-center">
      <h1 class="text-xl font-bold uppercase tracking-wider text-zinc-900">Universitas Muhammadiyah Yogyakarta</h1>
      <p class="text-sm font-semibold text-zinc-800">Fakultas Teknik · Program Studi S1 Teknologi Informasi</p>
      <p class="text-xs text-zinc-600 mt-1">Jadwal Mengajar Dosen Semester Ganjil TA 2026/2027</p>
      <p class="font-mono text-xs text-zinc-700 mt-1">Dosen: <%= dsn.nama %> (Kode: <%= dsn.inisial %>)</p>
    </div>
  </div>

  <!-- Header & Toolbar Action -->
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
    <div>
      <h1 class="font-heading text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Jadwal Mengajar — <%= dsn.nama %>
      </h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5 font-mono">
        Total Beban: <strong><%= dsn.bebanSks %> SKS</strong> · <%= dsnJadwal.length %> Sesi · 0 Bentrok
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <!-- Print Button -->
      <button onclick="window.print()" type="button"
        class="inline-flex min-h-[38px] items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 shadow-xs transition-colors">
        <i class="ph ph-printer text-base text-zinc-500"></i>
        <span>Cetak Jadwal (PDF)</span>
      </button>

      <!-- View Mode Switcher: Grid vs Tabel -->
      <div class="inline-flex rounded-lg border border-zinc-200 bg-zinc-100 p-1 dark:border-zinc-800 dark:bg-zinc-800">
        <button id="dosen-view-grid" type="button"
          class="inline-flex items-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-xs dark:bg-zinc-900 dark:text-zinc-100 transition-all">
          <i class="ph ph-calendar-blank text-sm text-[#0c2b5e] dark:text-amber-400"></i>
          <span>Grid Mingguan</span>
        </button>
        <button id="dosen-view-table" type="button"
          class="inline-flex items-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all">
          <i class="ph ph-table text-sm"></i>
          <span>Tabel Rinci</span>
        </button>
      </div>
    </div>
  </div>

  <!-- VIEW 1: CALENDAR GRID MINGGUAN DOSEN -->
  <div id="dosen-grid-container" class="space-y-4">
    <div class="rounded-xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full border-collapse text-left min-w-[850px]">
          <thead>
            <tr class="border-b border-zinc-200 bg-zinc-50/80 dark:border-zinc-800 dark:bg-zinc-800/60 font-mono text-xs uppercase text-zinc-500">
              <th class="w-24 border-r border-zinc-200 px-3 py-3 text-center dark:border-zinc-800">Waktu</th>
              <% const days = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu']; %>
              <% days.forEach(d => { %>
                <th class="border-r border-zinc-200 px-3 py-3 text-center dark:border-zinc-800">
                  <span class="font-bold text-zinc-800 dark:text-zinc-200"><%= d %></span>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 text-xs">
            <%
              const slots = [
                { labelStart: '07:00', labelEnd: '08:40', minStart: 420, minEnd: 530 },
                { labelStart: '08:50', labelEnd: '11:30', minStart: 530, minEnd: 690 },
                { isBreak: true },
                { labelStart: '12:10', labelEnd: '14:50', minStart: 730, minEnd: 900 },
                { labelStart: '15:20', labelEnd: '18:00', minStart: 900, minEnd: 1080 }
              ];
              const toMin = (str) => { const [h, m] = String(str || '00:00').split(':').map(Number); return h * 60 + m; };
            %>
            <% slots.forEach(function(slot) { %>
              <% if (slot.isBreak) { %>
                <tr class="bg-amber-50/50 dark:bg-amber-950/20 border-y border-amber-200/60 dark:border-amber-900/40">
                  <td class="border-r border-zinc-200 bg-amber-50/80 px-3 py-2 font-mono text-zinc-600 text-center dark:border-zinc-800 dark:bg-amber-950/40 text-[11px]">
                    11:30–12:10
                  </td>
                  <td colspan="6" class="px-4 py-2 text-center font-mono text-xs text-amber-900 dark:text-amber-300">
                    <i class="ph ph-moon-stars mr-1.5 text-amber-500"></i> Jeda Sholat Dhuhur & Istirahat (Hard Constraint HC-03)
                  </td>
                </tr>
              <% } else { %>
                <tr class="h-28">
                  <td class="border-r border-zinc-200 bg-zinc-50/90 px-3 py-2 font-mono text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900/90 align-top text-center">
                    <div class="font-semibold text-zinc-700 dark:text-zinc-300"><%= slot.labelStart %></div>
                    <div class="text-[10px] text-zinc-400"><%= slot.labelEnd %></div>
                  </td>
                  <% days.forEach(function(d, idx) {
                    const matched = dsnJadwal.filter(j => j.hari === d && toMin(j.jamMulai) >= slot.minStart && toMin(j.jamMulai) < slot.minEnd);
                  %>
                    <td class="<%= idx < days.length - 1 ? 'border-r border-zinc-200 dark:border-zinc-800' : '' %> p-1.5 <%= matched.length === 0 ? 'bg-zinc-50/30 dark:bg-zinc-950/20' : 'align-top space-y-1.5' %>">
                      <% matched.forEach(function(sesi) {
                        const isLab = String(sesi.ruang || '').toUpperCase().includes('LAB') || String(sesi.jenis || '').toLowerCase().includes('praktikum');
                      %>
                        <div class="rounded-lg border <%= isLab ? 'border-amber-300 bg-amber-50/90 text-amber-950 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200' : 'border-blue-200 bg-blue-50/80 text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-200' %> p-2 shadow-xs">
                          <div class="flex items-center justify-between gap-1">
                            <span class="font-mono text-[9px] font-bold <%= isLab ? 'text-amber-800 dark:text-amber-300 bg-amber-100 dark:bg-amber-900/60' : 'text-blue-800 dark:text-blue-300 bg-blue-100 dark:bg-blue-900/60' %> px-1 rounded"><%= sesi.kodeMatkul %></span>
                            <span class="text-[9px] font-mono px-1 rounded <%= isLab ? 'bg-amber-200/80 text-amber-900 dark:bg-amber-800 dark:text-amber-100' : 'bg-blue-200/80 text-blue-900 dark:bg-blue-800 dark:text-blue-100' %> font-semibold">Kls <%= sesi.kelas %></span>
                          </div>
                          <h4 class="font-heading font-semibold text-[11px] leading-tight pt-1"><%= sesi.mataKuliah %></h4>
                          <div class="mt-1 flex items-center justify-between text-[10px] font-mono opacity-80">
                            <span><%= sesi.ruang %></span>
                            <span><%= sesi.sks %> SKS · <%= isLab ? 'Lab' : 'Teori' %></span>
                          </div>
                        </div>
                      <% }); %>
                    </td>
                  <% }); %>
                </tr>
              <% } %>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- VIEW 2: TABEL RINCI DOSEN LENGKAP KODE MATKUL -->
  <div id="dosen-table-container" class="hidden space-y-4">
    <div class="rounded-xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
      <%- include('../partials/table-pagination', {
        tableId: 'table-dosen-jadwal',
        part: 'toolbar',
        searchPlaceholder: 'Cari mata kuliah, kode MK, atau ruangan...',
        filterOptions: [
          {
            id: 'filter-hari-dsn',
            label: 'Hari',
            dataAttr: 'hari',
            options: [
              { value: 'Semua', text: 'Semua Hari' },
              { value: 'Senin', text: 'Senin' },
              { value: 'Selasa', text: 'Selasa' },
              { value: 'Rabu', text: 'Rabu' },
              { value: 'Kamis', text: 'Kamis' },
              { value: 'Jumat', text: 'Jumat' },
              { value: 'Sabtu', text: 'Sabtu' }
            ]
          },
          {
            id: 'filter-tipe-dsn',
            label: 'Tipe',
            dataAttr: 'jenis',
            options: [
              { value: 'Semua', text: 'Semua Tipe' },
              { value: 'Teori', text: 'Kuliah Teori' },
              { value: 'Praktikum', text: 'Praktikum Lab' }
            ]
          }
        ]
      }) %>

      <div class="overflow-x-auto">
        <table id="table-dosen-jadwal" class="w-full text-left text-xs paginated-table">
          <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
            <tr>
              <th class="px-4 py-3 font-semibold">Kode MK</th>
              <th class="px-4 py-3 font-semibold">Mata Kuliah</th>
              <th class="px-4 py-3 font-semibold">Hari & Jam</th>
              <th class="px-4 py-3 font-semibold">Kelas & SKS</th>
              <th class="px-4 py-3 font-semibold">Ruangan</th>
              <th class="px-4 py-3 font-semibold">Tipe Perkuliahan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
            <% if (dsnJadwal.length === 0) { %>
              <tr class="table-empty-row">
                <td colspan="6" class="px-4 py-6 text-center text-zinc-500">Belum ada jadwal mengajar tercatat.</td>
              </tr>
            <% } else { %>
              <% dsnJadwal.forEach(function(sesi) {
                const isLab = String(sesi.ruang || '').toUpperCase().includes('LAB') || String(sesi.jenis || '').toLowerCase().includes('praktikum');
              %>
                <tr data-hari="<%= sesi.hari %>" data-jenis="<%= isLab ? 'Praktikum' : 'Teori' %>" class="hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 transition-colors">
                  <td class="px-4 py-3 font-mono font-bold <%= isLab ? 'text-amber-700 dark:text-amber-400' : 'text-blue-700 dark:text-blue-400' %>"><%= sesi.kodeMatkul %></td>
                  <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100"><%= sesi.mataKuliah %></td>
                  <td class="px-4 py-3 font-mono text-zinc-700 dark:text-zinc-300"><%= sesi.hari %>, <%= sesi.jamMulai %> - <%= sesi.jamSelesai %></td>
                  <td class="px-4 py-3 font-mono">Kelas <%= sesi.kelas %> (<%= sesi.sks %> SKS)</td>
                  <td class="px-4 py-3 font-mono"><%= sesi.ruang %></td>
                  <td class="px-4 py-3">
                    <% if (isLab) { %>
                      <span class="inline-flex items-center gap-1 font-mono text-[10px] text-amber-700 bg-amber-50 dark:bg-amber-950/60 dark:text-amber-300 px-2 py-0.5 rounded border border-amber-200 dark:border-amber-800 font-semibold">
                        <i class="ph ph-flask"></i> Praktikum Lab
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1 font-mono text-[10px] text-blue-700 bg-blue-50 dark:bg-blue-950/60 dark:text-blue-300 px-2 py-0.5 rounded border border-blue-200 dark:border-blue-900 font-semibold">
                        <i class="ph ph-chalkboard"></i> Kuliah Teori
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <%- include('../partials/table-pagination', {
        tableId: 'table-dosen-jadwal',
        part: 'pagination',
        defaultPageSize: 10
      }) %>
    </div>
  </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  (function initDosenScheduleSwitcher() {
    const btnGrid = document.getElementById('dosen-view-grid');
    const btnTable = document.getElementById('dosen-view-table');
    const gridView = document.getElementById('dosen-grid-container');
    const tableView = document.getElementById('dosen-table-container');

    if (btnGrid && btnTable && gridView && tableView) {
      btnGrid.addEventListener('click', () => {
        gridView.classList.remove('hidden');
        tableView.classList.add('hidden');
        btnGrid.className = 'inline-flex items-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-xs dark:bg-zinc-900 dark:text-zinc-100 transition-all';
        btnTable.className = 'inline-flex items-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
      });

      btnTable.addEventListener('click', () => {
        gridView.classList.add('hidden');
        tableView.classList.remove('hidden');
        btnTable.className = 'inline-flex items-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-xs dark:bg-zinc-900 dark:text-zinc-100 transition-all';
        btnGrid.className = 'inline-flex items-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
      });

      // Otomatis aktifkan tampilan tabel di layar mobile (< 768px)
      if (window.innerWidth < 768) {
        btnTable.click();
      }
    }
  })();
</script>