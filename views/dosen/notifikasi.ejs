<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Notifikasi Dosen — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'notifikasi', currentRole: 'dosen' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-4xl mx-auto space-y-6">

        <div class="flex items-center justify-between border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2 text-xs text-zinc-500 mb-1">
              <a href="/dosen/dashboard" class="hover:text-zinc-900 dark:hover:text-zinc-200">Portal Dosen</a>
              <span>/</span>
              <span class="text-amber-600 dark:text-amber-400 font-semibold">Pusat Notifikasi</span>
            </div>
            <h1 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Pusat Notifikasi Dosen
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
              Notifikasi penerbitan draf jadwal mengajar, jadwal bentrok, atau perubahan jadwal oleh tim akademik.
            </p>
          </div>
          <button type="button"
            onclick="window.toast ? window.toast.success('Semua notifikasi ditandai telah dibaca.') : null"
            class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 shadow-xs transition-colors">
            <i class="ph ph-check-double text-blue-900 dark:text-blue-400"></i>
            <span>Tandai Semua Dibaca</span>
          </button>
        </div>

        <div class="space-y-3">
          <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
              <i class="ph ph-check-circle text-xl"></i>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex items-center justify-between">
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Preferensi Mengajar Anda Telah Diterapkan</p>
                <span class="font-mono text-[11px] text-zinc-400">2 hari lalu</span>
              </div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">
                Admin akademik telah memvalidasi preferensi hari Senin & Rabu Anda. Algoritma AI penjadwalan telah mengalokasikan slot tersebut dengan 100% kepatuhan soft-constraint.
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/60">
              <i class="ph ph-calendar-check text-xl"></i>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex items-center justify-between">
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Draf Jadwal Perkuliahan Resmi Dirilis</p>
                <span class="font-mono text-[11px] text-zinc-400">Kemarin</span>
              </div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">
                Draf jadwal Semester Ganjil 2026/2027 telah dipublikasikan. Anda dapat meninjau alokasi ruangan dan jam mengajar di menu Jadwal Mengajar.
              </p>
            </div>
          </div>
        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>
