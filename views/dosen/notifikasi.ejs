<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Notifikasi Dosen — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'notifikasi', currentRole: 'dosen' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-4xl mx-auto space-y-6">

        <div class="flex items-center justify-between border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2 text-xs text-zinc-500 mb-1">
              <a href="/dosen/dashboard" class="hover:text-zinc-900 dark:hover:text-zinc-200">Portal Dosen</a>
              <span>/</span>
              <span class="text-amber-600 dark:text-amber-400 font-semibold">Pusat Notifikasi</span>
            </div>
            <h1 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Pusat Notifikasi Dosen
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
              Notifikasi penerbitan draf jadwal mengajar, jadwal bentrok, atau perubahan jadwal oleh tim akademik.
            </p>
          </div>
          <button type="button" id="btn-read-all-dosen"
            onclick="handleTandaiSemuaDibaca(this)"
            class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 shadow-xs transition-colors">
            <i class="ph ph-check-double text-blue-900 dark:text-blue-400"></i>
            <span>Tandai Semua Dibaca</span>
          </button>
        </div>

        <div class="space-y-3">
          <% const dsnNotifs = (typeof notifikasiList !== 'undefined' && Array.isArray(notifikasiList)) ? notifikasiList : []; %>
          <% if (dsnNotifs.length === 0) { %>
            <div class="rounded-xl border border-zinc-200 bg-white p-6 text-center text-xs text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900">
              Belum ada notifikasi terbaru.
            </div>
          <% } else { %>
            <% dsnNotifs.forEach(function(item) { %>
              <div class="notif-item rounded-xl border <%= (item.isRead === false) ? 'border-amber-300 bg-amber-50/40 dark:border-amber-800/60 dark:bg-amber-950/20' : 'border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900' %> p-4 shadow-sm flex items-start gap-4 transition-colors">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg <%= (item.isRead === false) ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800' : 'bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/60' %>">
                  <i class="ph <%= (item.isRead === false) ? 'ph-bell-ringing' : 'ph-calendar-check' %> text-xl"></i>
                </div>
                <div class="flex-1 space-y-1">
                  <div class="flex items-center justify-between gap-2">
                    <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100"><%= item.kodeMatkul %> — <%= item.mataKuliah %></p>
                    <span class="font-mono text-[11px] text-zinc-400 shrink-0"><%= item.waktu || 'Terbaru' %></span>
                  </div>
                  <p class="text-xs text-zinc-600 dark:text-zinc-400"><%= item.perubahan %></p>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  async function handleTandaiSemuaDibaca(btn) {
    if (btn) btn.disabled = true;
    try {
      const res = await fetch('/api/notifikasi/read-all', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.sukses) {
        if (window.JadwalinUI?.toast) {
          window.JadwalinUI.toast.show(data.pesan || 'Semua notifikasi ditandai dibaca.', 'success');
        }
        const badge = document.getElementById('admin-notif-badge');
        if (badge) badge.remove();
        document.querySelectorAll('.notif-item').forEach(el => {
          el.className = 'notif-item rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900 p-4 shadow-sm flex items-start gap-4 transition-colors';
        });
      }
    } catch (e) {
      console.error(e);
    } finally {
      if (btn) btn.disabled = false;
    }
  }
</script>
