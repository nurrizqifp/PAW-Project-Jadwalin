<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Form Preferensi Waktu Dosen — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'preferensi', currentRole: 'dosen' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-4xl mx-auto space-y-6">

        <!-- Header -->
        <div class="space-y-1 border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
          <div class="flex items-center gap-2 text-xs text-zinc-500 mb-1">
            <a href="/dosen/dashboard" class="hover:text-zinc-900 dark:hover:text-zinc-200">Portal Dosen</a>
            <span>/</span>
            <span class="text-amber-600 dark:text-amber-400 font-semibold">Preferensi Waktu</span>
          </div>
          <h1 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
            Formulir Preferensi Waktu & Hari Mengajar
          </h1>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400">
            Tentukan hari atau slot waktu di mana Anda bersedia atau berhalangan mengajar. Preferensi ini akan diprioritaskan oleh AI Solver (Soft Constraint SC-01).
          </p>
        </div>

        <form id="form-preferensi-dosen" class="space-y-6" onsubmit="event.preventDefault(); window.toast ? window.toast.success('Preferensi mengajar Anda berhasil disimpan!') : alert('Tersimpan!');">

          <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
            <h2 class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50 border-b border-zinc-100 pb-3 dark:border-zinc-800">
              Ketersediaan Hari
            </h2>

            <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
              <label class="flex flex-col items-center gap-2 rounded-xl border border-zinc-200 p-4 text-center cursor-pointer hover:border-[#0c2b5e] dark:border-zinc-800 dark:hover:border-blue-400 transition-colors">
                <input type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 text-blue-900 focus:ring-blue-900 dark:border-zinc-700 dark:bg-zinc-800">
                <span class="text-xs font-semibold text-zinc-800 dark:text-zinc-200">Senin</span>
              </label>
              <label class="flex flex-col items-center gap-2 rounded-xl border border-zinc-200 p-4 text-center cursor-pointer hover:border-[#0c2b5e] dark:border-zinc-800 dark:hover:border-blue-400 transition-colors">
                <input type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 text-blue-900 focus:ring-blue-900 dark:border-zinc-700 dark:bg-zinc-800">
                <span class="text-xs font-semibold text-zinc-800 dark:text-zinc-200">Selasa</span>
              </label>
              <label class="flex flex-col items-center gap-2 rounded-xl border border-zinc-200 p-4 text-center cursor-pointer hover:border-[#0c2b5e] dark:border-zinc-800 dark:hover:border-blue-400 transition-colors">
                <input type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 text-blue-900 focus:ring-blue-900 dark:border-zinc-700 dark:bg-zinc-800">
                <span class="text-xs font-semibold text-zinc-800 dark:text-zinc-200">Rabu</span>
              </label>
              <label class="flex flex-col items-center gap-2 rounded-xl border border-zinc-200 p-4 text-center cursor-pointer hover:border-[#0c2b5e] dark:border-zinc-800 dark:hover:border-blue-400 transition-colors">
                <input type="checkbox" checked class="h-4 w-4 rounded border-zinc-300 text-blue-900 focus:ring-blue-900 dark:border-zinc-700 dark:bg-zinc-800">
                <span class="text-xs font-semibold text-zinc-800 dark:text-zinc-200">Kamis</span>
              </label>
              <label class="flex flex-col items-center gap-2 rounded-xl border border-zinc-200 p-4 text-center cursor-pointer hover:border-[#0c2b5e] dark:border-zinc-800 dark:hover:border-blue-400 transition-colors">
                <input type="checkbox" class="h-4 w-4 rounded border-zinc-300 text-blue-900 focus:ring-blue-900 dark:border-zinc-700 dark:bg-zinc-800">
                <span class="text-xs font-semibold text-zinc-800 dark:text-zinc-200">Jumat</span>
              </label>
            </div>
          </div>

          <!-- Preferensi Waktu Slot -->
          <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
            <h2 class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50 border-b border-zinc-100 pb-3 dark:border-zinc-800">
              Waktu Preferensi & Catatan Khusus
            </h2>

            <div class="space-y-4">
              <div>
                <label for="preferensi-slot" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">Prioritas Slot Waktu Harian</label>
                <select id="preferensi-slot" class="w-full min-h-[42px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-1 focus:ring-blue-900">
                  <option value="pagi" selected>Prioritas Pagi (07:00 - 11:30)</option>
                  <option value="siang">Prioritas Siang / Sore (12:15 - 17:00)</option>
                  <option value="fleksibel">Fleksibel (Kapan saja)</option>
                </select>
              </div>

              <div>
                <label for="alasan-berhalangan" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">Catatan Jadwal Berhalangan Tetap</label>
                <textarea id="alasan-berhalangan" rows="3" placeholder="Contoh: Hari Jumat ada agenda rapat pimpinan fakultas mulai pukul 09:00 - 11:30..." class="w-full rounded-lg border border-zinc-200 bg-white p-3 text-xs text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-1 focus:ring-blue-900"></textarea>
              </div>
            </div>
          </div>

          <div class="flex justify-end gap-3">
            <button type="submit" class="inline-flex min-h-[40px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-6 py-2 text-xs font-semibold text-white shadow-sm border border-blue-900/40 transition-colors">
              <i class="ph ph-floppy-disk text-base text-amber-400"></i>
              <span>Simpan Preferensi Mengajar</span>
            </button>
          </div>

        </form>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>
