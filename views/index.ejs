<!-- ==================== CLIENT SCRIPTS ==================== -->
<script>
  // Tab Switcher
  function switchAppTab(tabId) {
    // Hide all tabs
    document.querySelectorAll('.app-tab-pane').forEach(el => el.classList.add('hidden'));
    
    // Show active tab
    const target = document.getElementById('tab-content-' + tabId);
    if (target) target.classList.remove('hidden');

    // Update Desktop Nav styles
    document.querySelectorAll('.app-nav-btn').forEach(btn => {
      btn.className = 'app-nav-btn px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-1.5';
    });
    const activeNav = document.getElementById('nav-tab-' + tabId);
    if (activeNav) {
      activeNav.className = 'app-nav-btn px-4 py-2 rounded-lg bg-white text-slate-900 shadow-sm transition-all flex items-center gap-1.5';
    }

    // Update Mobile Nav styles
    document.querySelectorAll('.mob-nav-btn').forEach(btn => {
      btn.className = 'mob-nav-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 whitespace-nowrap';
    });
    const activeMob = document.getElementById('mob-nav-' + tabId);
    if (activeMob) {
      activeMob.className = 'mob-nav-btn px-3 py-1.5 rounded-lg bg-brand-600 text-white whitespace-nowrap';
    }

    if (tabId === 'api') {
      triggerApiCall('/api/status');
    }
  }

  // Scroll to Full Schedule
  function scrollToFullSchedule() {
    switchAppTab('jadwal');
    const el = document.getElementById('full-schedule-section');
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  }

  // Filter Schedule by Day
  function filterDaySchedule(day) {
    document.querySelectorAll('.day-filter-btn').forEach(b => {
      b.className = 'day-filter-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200';
    });
    const activeBtn = document.querySelector(`.day-filter-btn[data-day="${day}"]`);
    if (activeBtn) {
      activeBtn.className = 'day-filter-btn px-3 py-1.5 rounded-xl bg-slate-900 text-white';
    }

    const cards = document.querySelectorAll('.schedule-card');
    cards.forEach(c => {
      const cardDay = c.getAttribute('data-day');
      if (day === 'Semua' || cardDay === day) {
        c.classList.remove('hidden');
      } else {
        c.classList.add('hidden');
      }
    });
  }

  // Live countdown ticker (42:15 ticking down)
  let countdownSecs = 42 * 60 + 15;
  setInterval(() => {
    if (countdownSecs > 0) {
      countdownSecs--;
      const m = Math.floor(countdownSecs / 60);
      const s = countdownSecs % 60;
      const formatted = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} left`;
      const el = document.getElementById('live-countdown');
      if (el) el.innerText = formatted;
    }
  }, 1000);

  // Onboarding Helpers (Wireframe 2)
  function adjustSemester(delta) {
    const input = document.getElementById('input-semester');
    let val = parseInt(input.value || 1, 10) + delta;
    if (val < 1) val = 1;
    if (val > 12) val = 12;
    input.value = val;
  }

  function updateNimPreview() {
    const angkatan = document.getElementById('input-angkatan').value || '2024';
    document.getElementById('nim-prefix').innerText = angkatan + '0140';
  }

  function handleOnboardingSubmit(e) {
    e.preventDefault();
    const semester = parseInt(document.getElementById('input-semester').value, 10);
    const nama = document.getElementById('input-nama').value.trim();
    const suffix = document.getElementById('input-nim-suffix').value.trim();
    const feedback = document.getElementById('onboarding-feedback');

    if (semester < 1 || semester > 12 || isNaN(semester)) {
      feedback.className = 'p-3.5 rounded-xl text-xs bg-red-100 text-red-700 border border-red-200';
      feedback.innerText = 'Validasi Gagal: Semester harus berupa angka bulat 1 sampai 12.';
      feedback.classList.remove('hidden');
      return;
    }

    if (nama.length < 3) {
      feedback.className = 'p-3.5 rounded-xl text-xs bg-red-100 text-red-700 border border-red-200';
      feedback.innerText = 'Validasi Gagal: Nama harus memiliki minimal 3 huruf kapital.';
      feedback.classList.remove('hidden');
      return;
    }

    if (suffix.length !== 3) {
      feedback.className = 'p-3.5 rounded-xl text-xs bg-red-100 text-red-700 border border-red-200';
      feedback.innerText = 'Validasi Gagal: NIM harus terdiri dari 3 digit angka terakhir.';
      feedback.classList.remove('hidden');
      return;
    }

    const angkatan = document.getElementById('input-angkatan').value;
    const fullNim = `${angkatan}0140${suffix}`;

    // Update main greeting
    document.getElementById('main-greeting').innerText = `Selamat Pagi, ${nama}!`;

    feedback.className = 'p-3.5 rounded-xl text-xs bg-emerald-100 text-emerald-800 border border-emerald-200';
    feedback.innerText = `Sukses! Profil mahasiswa ${nama} (NIM: ${fullNim}) berhasil diperbarui untuk Semester ${semester}. Menampilkan jadwal kuliah...`;
    feedback.classList.remove('hidden');

    setTimeout(() => {
      switchAppTab('jadwal');
    }, 900);
  }

  // API Console Trigger
  async function triggerApiCall(endpoint) {
    document.getElementById('console-endpoint-url').innerText = endpoint;
    const out = document.getElementById('api-output');
    const lat = document.getElementById('console-latency');
    out.innerText = '// Memuat...';

    const t0 = performance.now();
    try {
      const res = await fetch(endpoint);
      const data = await res.json();
      const t1 = performance.now();
      lat.innerText = 'Response: ' + (t1 - t0).toFixed(1) + ' ms';
      out.innerText = JSON.stringify(data, null, 2);
    } catch (err) {
      out.innerText = 'Error: ' + err.message;
    }
  }

  // Product Filter
  function filterProductCards() {
    const q = document.getElementById('prodSearchInput').value.toLowerCase();
    document.querySelectorAll('.product-item').forEach(card => {
      const name = card.getAttribute('data-name');
      if (name.includes(q)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  function toggleModal(id) {
    document.getElementById(id).classList.toggle('hidden');
  }

  function previewProdukDetail(p) {
    document.getElementById('modal-name').innerText = p.nama;
    document.getElementById('modal-cat').innerText = p.kategori;
    document.getElementById('modal-desc').innerText = p.deskripsi;
    document.getElementById('modal-fitur').innerText = p.fiturUtama;
    document.getElementById('modal-stok').innerText = p.stok + ' Kuota';
    document.getElementById('modal-harga').innerText = 'Rp ' + Number(p.harga).toLocaleString('id-ID');
    toggleModal('modal-detail');
  }

  function openDemoModal() {
    document.getElementById('modal-demo').classList.remove('hidden');
  }

  function closeDemoModal() {
    document.getElementById('modal-demo').classList.add('hidden');
  }

  // Cek Status Server saat startup
  async function checkServerHealth() {
    try {
      const res = await fetch('/api/status');
      const data = await res.json();
      const el = document.getElementById('nav-uptime-status');
      if (el) el.innerText = `Online (${data.uptimeDetik}s)`;
    } catch (e) {
      const el = document.getElementById('nav-uptime-status');
      if (el) el.innerText = 'Offline';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    checkServerHealth();
  });
</script>

