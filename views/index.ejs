<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-grow">
  
  <!-- ==================== HERO SECTION ==================== -->
  <section id="beranda" class="relative overflow-hidden bg-gradient-to-b from-brand-50/70 via-white to-surface-50 pt-14 pb-20 sm:pt-20 sm:pb-24 border-b border-slate-200/80">
    <!-- Background glow decorations -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 pointer-events-none overflow-hidden opacity-40">
      <div class="absolute -top-32 left-1/4 w-96 h-96 rounded-full bg-brand-300 blur-3xl"></div>
      <div class="absolute -top-24 right-1/4 w-96 h-96 rounded-full bg-accent-300 blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto">
        
        <!-- Live Pill Tag -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/90 backdrop-blur-md text-brand-700 text-xs font-bold mb-6 shadow-sm border border-brand-100 hover:border-brand-300 transition-all">
          <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-500 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          </span>
          <span>Sistem Penjadwalan Cerdas TI UMY • Express.js MVC</span>
          <span class="text-slate-300">|</span>
          <span class="text-slate-500 font-mono text-[11px]">Week 8</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.12]">
          Susun Jadwal Kuliah Cerdas, <br class="hidden sm:inline">
          <span class="bg-gradient-to-r from-brand-600 via-brand-500 to-accent-500 bg-clip-text text-transparent">
            Nol Bentrok
          </span> Berbasis AI.
        </h1>

        <!-- Subheadline -->
        <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto font-normal">
          Mengotomatisasi penyusunan 45 mata kuliah, 20 dosen, dan 8 ruang laboratorium dari <strong>5–7 hari kerja manual</strong> menjadi <strong>kurang dari 15 menit</strong> dengan garansi 100% praktikum di lab yang tepat.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5 sm:gap-4">
          <a href="#simulator" class="px-6 py-3.5 rounded-2xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm shadow-lg shadow-brand-500/25 hover:shadow-brand-500/40 hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Uji Coba Simulator Wireframe</span>
          </a>
          <a href="#produk" class="px-6 py-3.5 rounded-2xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm border border-slate-200/90 shadow-sm hover:border-slate-300 hover:-translate-y-0.5 transition-all duration-200 flex items-center gap-2">
            <span>Daftar Modul Produk</span>
            <span class="w-5 h-5 rounded-full bg-slate-100 text-slate-600 text-xs flex items-center justify-center font-bold">6</span>
          </a>
        </div>

        <!-- Metric Badges PRD -->
        <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4 text-left">
          <div class="bg-white/80 backdrop-blur-sm p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Metrik M-01</span>
              <span class="w-2 h-2 rounded-full bg-brand-500"></span>
            </div>
            <p class="text-2xl sm:text-3xl font-extrabold text-brand-700 tracking-tight">&lt; 15 Menit</p>
            <p class="text-xs text-slate-500 mt-1">AI Smart Solver</p>
          </div>

          <div class="bg-white/80 backdrop-blur-sm p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Metrik M-02</span>
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            </div>
            <p class="text-2xl sm:text-3xl font-extrabold text-emerald-600 tracking-tight">0 Bentrok</p>
            <p class="text-xs text-slate-500 mt-1">Dosen & Ruang Bebas Konflik</p>
          </div>

          <div class="bg-white/80 backdrop-blur-sm p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Metrik M-03</span>
              <span class="w-2 h-2 rounded-full bg-accent-500"></span>
            </div>
            <p class="text-2xl sm:text-3xl font-extrabold text-accent-600 tracking-tight">100%</p>
            <p class="text-xs text-slate-500 mt-1">Praktikum Masuk Lab Sesuai</p>
          </div>

          <div class="bg-white/80 backdrop-blur-sm p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] uppercase tracking-wider text-slate-400 font-bold">Metrik M-04</span>
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            </div>
            <p class="text-2xl sm:text-3xl font-extrabold text-amber-600 tracking-tight">&ge; 85%</p>
            <p class="text-xs text-slate-500 mt-1">Preferensi Dosen Terakomodir</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== LIVE STATUS & LOGGER HEALTHBAR ==================== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-7 relative z-20">
    <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-md flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-3.5 w-full md:w-auto">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-200/60 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-slate-800">Status Server & Logger HTTP</h2>
            <span class="px-2 py-0.5 text-[10px] font-bold bg-emerald-100 text-emerald-800 rounded-md">Online</span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">
            Setiap request dicatat ke <code class="font-mono bg-slate-100 text-brand-700 px-1 py-0.5 rounded font-semibold">logs/logger.md</code>
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 text-xs w-full md:w-auto justify-end">
        <div class="bg-slate-50 px-3.5 py-2 rounded-xl border border-slate-200 flex items-center gap-3 font-mono">
          <span class="text-slate-500">Uptime: <strong id="uptime-text" class="text-slate-800">0s</strong></span>
          <span class="text-slate-300">|</span>
          <span class="text-slate-500">WIB: <span class="text-slate-700 font-semibold"><%= currentDate %></span></span>
        </div>
        <button onclick="checkServerStatus()" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span>Ping Server</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ==================== SECTION 1: MODUL & PRODUK JADWALIN ==================== -->
  <section id="produk" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2 h-2 rounded-full bg-brand-600"></span>
          <span class="text-xs uppercase tracking-wider font-extrabold text-brand-600">Model Backend Integration</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">Katalog Modul & Produk Jadwalin</h2>
        <p class="text-slate-600 text-sm mt-2 max-w-2xl leading-relaxed">
          Seluruh data produk di bawah ini dikelola secara dinamis melalui <code class="font-mono text-xs bg-slate-100 text-brand-700 px-1.5 py-0.5 rounded font-bold">models/produkModel.js</code>, dikirim melalui controller, dan dirender menggunakan template engine EJS.
        </p>
      </div>

      <!-- Quick Category Filter & Search -->
      <div class="flex items-center gap-2">
        <div class="relative">
          <input type="text" id="productSearch" oninput="filterProducts()" placeholder="Cari modul..." class="text-xs pl-8 pr-3 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 w-44 sm:w-56">
          <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <a href="/api/produk" target="_blank" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-sm">
          <span>JSON API</span>
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Category Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 text-xs font-semibold no-scrollbar">
      <button onclick="setCategoryFilter('all')" class="cat-pill active px-3.5 py-1.5 rounded-full bg-brand-600 text-white shadow-sm transition-all" data-cat="all">
        Semua Modul (<%= produk.length %>)
      </button>
      <button onclick="setCategoryFilter('Core AI Engine')" class="cat-pill px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all" data-cat="Core AI Engine">
        Core AI
      </button>
      <button onclick="setCategoryFilter('Manajemen Data')" class="cat-pill px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all" data-cat="Manajemen Data">
        Data Master
      </button>
      <button onclick="setCategoryFilter('Optimasi Jadwal')" class="cat-pill px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all" data-cat="Optimasi Jadwal">
        Constraint Solver
      </button>
      <button onclick="setCategoryFilter('Distribusi Jadwal')" class="cat-pill px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all" data-cat="Distribusi Jadwal">
        Preview & Publish
      </button>
      <button onclick="setCategoryFilter('Portal Dosen')" class="cat-pill px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all" data-cat="Portal Dosen">
        Portal Dosen
      </button>
      <button onclick="setCategoryFilter('Komunikasi')" class="cat-pill px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all" data-cat="Komunikasi">
        Notifikasi Real-time
      </button>
    </div>

    <!-- Product Cards Grid (EJS Looping) -->
    <div id="productGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (produk && produk.length > 0) { %>
        <% produk.forEach(function(item) { %>
          <div class="product-card bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm hover:shadow-card-hover hover:border-brand-300 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden" 
               data-nama="<%= item.nama.toLowerCase() %>" 
               data-kategori="<%= item.kategori %>">
            
            <!-- Top Card Header -->
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-xl text-[11px] font-bold bg-brand-50 text-brand-700 border border-brand-200/50">
                  <%= item.kategori %>
                </span>
                
                <% if (item.badge) { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wide bg-amber-50 text-amber-700 border border-amber-200">
                    <svg class="w-3 h-3 text-amber-500 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                    <%= item.badge %>
                  </span>
                <% } %>
              </div>

              <!-- Product Title -->
              <h3 class="text-lg sm:text-xl font-black text-slate-900 group-hover:text-brand-600 transition-colors leading-snug">
                <%= item.nama %>
              </h3>

              <!-- Description -->
              <p class="mt-2.5 text-xs text-slate-600 leading-relaxed line-clamp-3">
                <%= item.deskripsi %>
              </p>

              <!-- Feature Bullet -->
              <div class="mt-5 pt-4 border-t border-slate-100 space-y-2 text-xs">
                <div class="flex items-start gap-2 text-slate-600">
                  <svg class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="font-medium text-[11px]"><%= item.fiturUtama %></span>
                </div>
                <div class="flex items-center justify-between text-[11px] text-slate-500 pt-1">
                  <span>Kapasitas Lisensi:</span>
                  <span class="font-bold text-slate-800"><%= item.stok %> Kuota Semester</span>
                </div>
              </div>
            </div>

            <!-- Card Bottom: Pricing & Action -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <div>
                <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Estimasi Investasi</span>
                <span class="text-base sm:text-lg font-black text-slate-900 tracking-tight">
                  <%= formatRupiah(item.harga) %>
                </span>
              </div>
              
              <button onclick="previewProdukDetail(<%= JSON.stringify(item) %>)" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 group-hover:bg-brand-600 group-hover:text-white text-slate-800 text-xs font-bold transition-all duration-200">
                <span>Detail</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </button>
            </div>

          </div>
        <% }); %>
      <% } else { %>
        <div class="col-span-full py-16 text-center bg-white rounded-3xl border border-dashed border-slate-300">
          <p class="text-slate-400 font-medium text-sm">Tidak ada produk ditemukan di Model.</p>
        </div>
      <% } %>
    </div>

  </section>

  <!-- ==================== SECTION 2: SIMULATOR WIREFRAME INTERAKTIF ==================== -->
  <section id="simulator" class="bg-gradient-to-b from-slate-100/90 to-slate-200/70 py-20 border-y border-slate-200/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Title -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="px-3.5 py-1 text-xs font-extrabold uppercase tracking-wider rounded-full bg-brand-100 text-brand-800 border border-brand-200">
          Wireframe & UX Fidelity
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mt-3">
          Simulator Antarmuka Jadwalin
        </h2>
        <p class="text-slate-600 text-sm mt-2.5 max-w-xl mx-auto leading-relaxed">
          Mengimplementasikan langsung 4 sketsa wireframe dokumen (<code class="font-mono text-xs text-brand-700 font-bold">docs/images/</code>): Welcome Gate, Onboarding 4 Langkah, Card Kuliah Aktif, dan Jadwal Lengkap.
        </p>

        <!-- Stepper Selector Bar -->
        <div class="mt-8 inline-flex items-center p-1.5 rounded-2xl bg-white border border-slate-300/80 shadow-sm gap-1 text-xs font-bold">
          <button onclick="openWireframeStep('step-welcome')" id="btn-tab-welcome" class="wf-tab px-4 py-2 rounded-xl bg-brand-600 text-white transition-all">
            1. Welcome Gate
          </button>
          <button onclick="openWireframeStep('step-onboarding')" id="btn-tab-onboarding" class="wf-tab px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">
            2. Onboarding
          </button>
          <button onclick="openWireframeStep('step-active-card')" id="btn-tab-active" class="wf-tab px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">
            3. Jadwal Saat Ini
          </button>
          <button onclick="openWireframeStep('step-full-schedule')" id="btn-tab-full" class="wf-tab px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all">
            4. Jadwal Lengkap
          </button>
        </div>
      </div>

      <!-- Simulator Device Frame (Centered Mobile/Tablet Mockup) -->
      <div class="max-w-md sm:max-w-xl mx-auto">
        <div class="bg-white rounded-[2.5rem] p-4 sm:p-6 shadow-2xl border-4 sm:border-8 border-slate-900 relative">
          
          <!-- Mockup Speaker Notch -->
          <div class="w-24 sm:w-28 h-4 bg-slate-900 rounded-b-xl mx-auto mb-4 -mt-4 sm:-mt-6 flex items-center justify-center">
            <div class="w-8 h-1 bg-slate-700 rounded-full"></div>
          </div>

          <!-- Inside Screen Wrapper -->
          <div class="bg-surface-50 rounded-3xl p-5 sm:p-7 min-h-[520px] flex flex-col justify-between border border-slate-200 overflow-hidden relative">

            <!-- ================= SUB-SCREEN 1: WELCOME GATE (Sketsa 1: WhatsApp Image 13.52.34) ================= -->
            <div id="step-welcome" class="wf-screen flex-1 flex flex-col justify-center items-center text-center py-8">
              <div class="w-16 h-16 rounded-3xl bg-gradient-to-tr from-brand-600 to-accent-500 flex items-center justify-center text-white text-3xl font-black shadow-xl shadow-brand-500/30 mb-6">
                J
              </div>
              <h3 class="text-3xl font-black text-slate-900 tracking-tight mb-2">
                Jadwalin
              </h3>
              <p class="text-xs text-slate-500 max-w-xs mb-8">
                Smart Course Scheduling & Zero-Clash Automation untuk Mahasiswa dan Dosen TI UMY.
              </p>

              <!-- Buttons from wireframe -->
              <div class="w-full max-w-xs space-y-3">
                <button onclick="openWireframeStep('step-active-card')" class="w-full py-3.5 px-4 rounded-2xl bg-white hover:bg-slate-50 text-slate-900 font-extrabold text-sm border-2 border-slate-900 shadow-sm transition-transform active:scale-95">
                  Login
                </button>
                
                <button onclick="openWireframeStep('step-onboarding')" class="w-full py-3.5 px-4 rounded-2xl bg-slate-900 hover:bg-brand-600 text-white font-extrabold text-sm border-2 border-slate-900 shadow-lg shadow-slate-900/20 transition-all active:scale-95 flex items-center justify-center gap-2">
                  <span>Coba demo</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </button>

                <p class="text-xs text-slate-500 pt-3">
                  Belum punya akun? <a href="javascript:void(0)" onclick="openWireframeStep('step-onboarding')" class="text-brand-600 font-bold hover:underline">Register</a>
                </p>
              </div>

              <!-- Note from Wireframe 1 -->
              <div class="mt-8 p-3 rounded-xl bg-amber-50 border border-amber-200/80 text-[11px] text-amber-800 text-left max-w-xs flex gap-2">
                <span class="text-base shrink-0">💡</span>
                <span><strong>Catatan Sketsa:</strong> Demo memiliki tutorial step-by-step onboarding untuk membimbing mahasiswa memilih mata kuliah.</span>
              </div>
            </div>

            <!-- ================= SUB-SCREEN 2: ONBOARDING STEPPER (Sketsa 2: WhatsApp Image 13.52.50) ================= -->
            <div id="step-onboarding" class="wf-screen hidden flex-1 flex flex-col justify-between py-2">
              <div>
                <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
                  <div class="flex items-center gap-2">
                    <button onclick="openWireframeStep('step-welcome')" class="p-1 rounded-lg hover:bg-slate-200 text-slate-600">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
                      </svg>
                    </button>
