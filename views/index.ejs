  </div>
</div>

<!-- ==================== CLIENT SPA CONTROLLER ==================== -->
<script>
  // Switch Persona / View
  function switchView(targetId) {
    document.querySelectorAll('.spa-view').forEach(v => v.classList.add('hidden'));
    const target = document.getElementById(targetId);
    if (target) target.classList.remove('hidden');

    // Update Desktop Nav
    document.querySelectorAll('.nav-segment').forEach(b => {
      b.className = 'nav-segment px-3.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 transition-all flex items-center gap-1.5';
    });
    const key = targetId.replace('view-', '');
    const activeDesktop = document.getElementById('nav-btn-' + key);
    if (activeDesktop) {
      activeDesktop.className = 'nav-segment px-3.5 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm transition-all flex items-center gap-1.5';
    }

    // Update Mobile Nav
    document.querySelectorAll('.mob-segment').forEach(b => {
      b.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg text-zinc-600 text-center whitespace-nowrap';
    });
    const activeMobile = document.getElementById('mob-btn-' + key);
    if (activeMobile) {
      activeMobile.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg bg-white text-zinc-900 shadow-sm text-center whitespace-nowrap';
    }

    // Persona text badge
    const badge = document.getElementById('activePersonaBadge');
    if (badge) {
      if (key === 'mahasiswa') badge.innerText = 'Mahasiswa: Andi Pratama';
      if (key === 'akademik') badge.innerText = 'Staf: Rina Wulandari';
      if (key === 'dosen') badge.innerText = 'Dosen: Dr. Budi Santoso';
      if (key === 'system') badge.innerText = 'Administrator Sistem';
    }

    if (targetId === 'view-system') {
      testApiEndpoint('/api/status');
    }
  }

  function scrollToFullSchedule() {
    switchView('view-mahasiswa');
    const el = document.getElementById('fullScheduleTable');
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  }

  // Master Data Subtabs
  function switchMasterTab(tabName) {
    document.querySelectorAll('.master-tab-btn').forEach(b => {
      b.className = 'master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900';
    });
    const active = document.getElementById('m-tab-' + tabName);
    if (active) active.className = 'master-tab-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm';

    document.querySelectorAll('.master-subtable').forEach(t => t.classList.add('hidden'));
    const target = document.getElementById('subtable-' + tabName);
    if (target) target.classList.remove('hidden');
  }

  // Filter Days
  function filterDay(day) {
    document.querySelectorAll('.filter-day-btn').forEach(b => {
      b.className = 'filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900';
    });
    const active = document.querySelector(`.filter-day-btn[data-day="${day}"]`);
    if (active) active.className = 'filter-day-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm';

    document.querySelectorAll('.schedule-item-row').forEach(row => {
      const rowDay = row.getAttribute('data-day');
      if (day === 'Semua' || rowDay === day) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  // AI Generator Trigger (PRD F-03)
  async function runAIGenerate() {
    const btn = document.getElementById('btnGenerateAI');
    const orig = btn.innerHTML;
    btn.innerHTML = '<span>Menyusun Jadwal (AI)...</span>';
    btn.disabled = true;

    try {
      const res = await fetch('/api/generate', { method: 'POST' });
      const data = await res.json();
      btn.innerHTML = '<span>Jadwal Terbit (0 Bentrok)</span>';
      document.getElementById('genStatusBadge').innerText = 'Terpublikasi';
      document.getElementById('valTotalKonflik').innerText = '0 Bentrok';
      setTimeout(() => {
        btn.innerHTML = orig;
        btn.disabled = false;
        alert(data.result.message);
      }, 1000);
    } catch (err) {
      btn.innerHTML = orig;
      btn.disabled = false;
      alert('Gagal generate: ' + err.message);
    }
  }

  function publishSchedule() {
    document.getElementById('genStatusBadge').innerText = 'Terpublikasi';
    alert('Jadwal perkuliahan berhasil dipublikasikan untuk seluruh mahasiswa dan dosen!');
  }

  // Modals
  function openModal(id) {
    document.getElementById(id).classList.remove('hidden');
  }
  function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
  }

  // Pra-KRS modal form
  function stepSem(d) {
    const el = document.getElementById('modal-sem');
    let v = parseInt(el.value || 1, 10) + d;
    if (v < 1) v = 1;
    if (v > 12) v = 12;
    el.value = v;
  }
  function updateModalNim() {
    const ang = document.getElementById('modal-angkatan').value || '2024';
    document.getElementById('modal-nim-prefix').innerText = ang + '0140';
  }
  function savePrakrs(e) {
    e.preventDefault();
    const nama = document.getElementById('modal-nama').value.trim();
    document.getElementById('mhsGreeting').innerText = `Selamat Pagi, ${nama}`;
    closeModal('modal-prakrs');
    alert(`Data Pra-KRS mahasiswa ${nama} berhasil disimpan.`);
  }

  function saveDosenPref(e) {
    e.preventDefault();
    closeModal('modal-preferensi-dosen');
    alert('Preferensi hari riset dosen berhasil dicatat dan dipatuhi oleh solver AI.');
  }

  // System API Inspector
  async function testApiEndpoint(ep) {
    document.getElementById('sys-endpoint-url').innerText = ep;
    const jsonEl = document.getElementById('sys-json-output');
    const msEl = document.getElementById('sys-response-time');
    jsonEl.innerText = '// Memuat...';

    const t0 = performance.now();
    try {
      const res = await fetch(ep);
      const data = await res.json();
      const t1 = performance.now();
      msEl.innerText = (t1 - t0).toFixed(1) + ' ms';
      jsonEl.innerText = JSON.stringify(data, null, 2);
    } catch (err) {
      jsonEl.innerText = 'Error: ' + err.message;
    }
  }

  function copySysOutput() {
    const text = document.getElementById('sys-json-output').innerText;
    navigator.clipboard.writeText(text);
  }

  // Live countdown ticker
  let tickerSeconds = 42 * 60 + 15;
  setInterval(() => {
    if (tickerSeconds > 0) {
      tickerSeconds--;
      const m = Math.floor(tickerSeconds / 60);
      const s = tickerSeconds % 60;
      const el = document.getElementById('countdownTicker');
      if (el) el.innerText = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} left`;
    }
  }, 1000);
</script>

