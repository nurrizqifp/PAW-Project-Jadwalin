<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

  <!-- ==================== BANNER NOTIFIKASI PERUBAHAN JADWAL ==================== -->
  <div id="notifBanner" class="hidden mb-6 bg-white rounded-2xl p-4 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
    <div class="flex items-start sm:items-center gap-3">
      <span class="px-2 py-1 rounded-lg bg-zinc-900 text-white font-mono font-bold text-[10px] uppercase tracking-wider shrink-0">
        Notifikasi TI UMY
      </span>
      <div>
        <div class="font-bold text-zinc-900" id="notifTitle">
          <%= notifikasiList[0] ? `${notifikasiList[0].kodeMatkul} — ${notifikasiList[0].mataKuliah}` : 'Sistem Jadwal Aktif' %>
        </div>
        <p class="text-zinc-500 mt-0.5" id="notifDesc">
          <%= notifikasiList[0] ? notifikasiList[0].perubahan : 'Belum ada perubahan jadwal baru.' %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-3 self-end sm:self-center shrink-0">
      <button onclick="openModal('modal-riwayat-notif')" class="btn-press px-3 py-1.5 rounded-xl bg-zinc-100 hover-surface text-zinc-800 font-semibold">
        Riwayat (<span id="notifCountBadge" class="tabular-nums"><%= notifikasiList.length %></span>)
      </button>
    </div>
  </div>

  <!-- ==================== PANEL 1: MAHASISWA (LAMPIRAN 1, 2, 3, 4) ==================== -->
  <section id="view-mahasiswa" class="spa-view space-y-6">

    <!-- ==================== SUB-VIEW 1: LAMPIRAN 1 — LANDING JADWALIN ==================== -->
    <div id="mhs-subview-landing" class="max-w-md mx-auto py-6 sm:py-12 space-y-6">
      <div id="modal-landing" class="bg-white rounded-3xl p-8 sm:p-10 shadow-mac-lg border-2 border-zinc-900 text-center space-y-6">
        <div class="space-y-3">
          <div class="w-14 h-14 rounded-2xl bg-zinc-900 text-white font-extrabold text-2xl flex items-center justify-center mx-auto shadow-sm">
            J
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900">
            Jadwalin
          </h1>
          <p class="text-xs text-zinc-500 max-w-xs mx-auto">
            AI Powered Smart Course Scheduling &mdash; Program Studi Teknologi Informasi FT UMY
          </p>
        </div>

        <div class="space-y-3 pt-2">
          <button onclick="handleLandingLogin()" class="btn-press w-full py-3.5 px-6 rounded-2xl border-2 border-zinc-900 bg-zinc-900 text-white font-bold text-sm shadow-sm hover:bg-zinc-800">
            Login
          </button>

          <button onclick="startDemoTutorial()" class="btn-press w-full py-3.5 px-6 rounded-2xl border-2 border-zinc-900 bg-white hover-surface text-zinc-900 font-bold text-sm">
            Coba demo
          </button>
        </div>

        <div class="pt-2 text-xs text-zinc-600">
          Belum punya akun?
          <button onclick="startRegisterOnboarding()" class="font-bold text-zinc-900 underline hover:text-zinc-700 ml-1">
            Register
          </button>
        </div>
      </div>
    </div>

    <!-- ==================== SUB-VIEW 2: LAMPIRAN 2 — ONBOARDING 4-STEP ==================== -->
    <div id="mhs-subview-onboarding" class="hidden max-w-2xl mx-auto space-y-5">
      <div id="modal-prakrs" class="bg-white rounded-3xl p-6 sm:p-8 border border-zinc-200 shadow-mac-lg space-y-5">
        
        <!-- Header Onboarding -->
        <div class="flex items-center justify-between pb-3 border-b border-zinc-100">
          <div class="flex items-center gap-2.5">
            <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-zinc-900">Onboarding</h2>
            <span id="onboardingModeBadge" class="px-2.5 py-0.5 rounded-full bg-zinc-900 text-white font-mono text-[10px] font-bold">
              Mode Interaktif
            </span>
          </div>
          <button type="button" onclick="showLandingView()" class="btn-press text-xs font-semibold text-zinc-500 hover:text-zinc-900">
            &larr; Kembali ke Layar Awal
          </button>
        </div>

        <!-- 4 Step Indicator Pills -->
        <div class="grid grid-cols-4 gap-2 text-[11px] font-semibold">
          <div id="ob-step-pill-1" class="p-2.5 rounded-xl bg-zinc-900 text-white text-center font-bold">1. Semester</div>
          <div id="ob-step-pill-2" class="p-2.5 rounded-xl bg-zinc-100 text-zinc-500 text-center">2. Angkatan</div>
          <div id="ob-step-pill-3" class="p-2.5 rounded-xl bg-zinc-100 text-zinc-500 text-center">3. Nama &amp; NIM</div>
          <div id="ob-step-pill-4" class="p-2.5 rounded-xl bg-zinc-100 text-zinc-500 text-center">4. Pra-KRS &amp; AI Mapping</div>
        </div>

        <!-- Info & Tutorial Banner saat Mode Demo Aktif (Lampiran 1) -->
        <div id="demoReadOnlyNotice" class="hidden p-3.5 rounded-2xl bg-zinc-100 border border-zinc-300 text-zinc-800 text-xs font-medium space-y-1">
          <div class="font-bold text-zinc-900 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
            Mode Coba Demo (Tutorial Step-by-Step Read-Only):
          </div>
          <p id="demoStepGuideText" class="text-zinc-600 text-[11px]">
            Input dikunci sesuai aturan demo. Cukup klik tombol <strong>Next &rarr;</strong> di bawah untuk mempelajari setiap langkah alur Onboarding hingga rekomendasi jadwal AI.
          </p>
        </div>

        <form id="formOnboarding" onsubmit="savePrakrs(event)" class="space-y-5">
          <!-- STEP 1: SEMESTER INTEGER 1-12 (BUKAN DROPDOWN, BISA KLIK ATAS BAWAH & INPUT VALIDASI) -->
          <div id="ob-panel-1" class="ob-step-panel space-y-3 p-5 rounded-2xl bg-zinc-50 border border-zinc-200">
            <label for="modal-sem" class="text-sm font-bold text-zinc-900 block">
              1. Kamu saat ini semester berapa?
            </label>
            <p class="text-zinc-500 text-[11px]">
              Hanya menerima bilangan bulat (integer) <strong>1 &ndash; 12</strong>. Gunakan tombol panah atas/bawah atau ketik angka langsung (bukan dropdown).
            </p>

            <div class="flex items-center gap-3 pt-1">
              <div class="inline-flex items-center rounded-xl border-2 border-zinc-900 bg-white overflow-hidden shadow-sm">
                <input id="modal-sem" type="number" min="1" max="12" step="1" value="5" required
                       oninput="validateSemesterInput(this)"
                       class="w-20 text-center text-xl font-extrabold py-2.5 px-2 tabular-nums focus:outline-none">
                <div class="flex flex-col border-l border-zinc-300">
                  <button type="button" id="btnSemUp" onclick="stepSem(1)" aria-label="Naikkan Semester" class="btn-press px-3 py-1 bg-zinc-100 hover-surface text-zinc-900 font-bold border-b border-zinc-300 leading-none">&#9650;</button>
                  <button type="button" id="btnSemDown" onclick="stepSem(-1)" aria-label="Turunkan Semester" class="btn-press px-3 py-1 bg-zinc-100 hover-surface text-zinc-900 font-bold leading-none">&#9660;</button>
                </div>
              </div>

              <span id="semErrorMsg" class="text-zinc-900 font-semibold text-xs hidden">
                Wajib berupa integer antara 1 sampai 12!
              </span>
            </div>
          </div>

          <!-- STEP 2: ANGKATAN PAKAI YEAR PICKER -->
          <div id="ob-panel-2" class="ob-step-panel hidden space-y-3 p-5 rounded-2xl bg-zinc-50 border border-zinc-200">
            <label class="text-sm font-bold text-zinc-900 block">
              2. Angkatan berapa? (Pilih pakai Year Picker)
            </label>
            <p class="text-zinc-500 text-[11px]">
              Pilih tahun angkatan masuk kuliah pada pemilih tahun di bawah ini. Tahun angkatan otomatis menentukan 4 digit awal NIM kamu.
            </p>

            <input id="modal-angkatan" type="hidden" value="2024">
            <div id="yearPickerGrid" class="grid grid-cols-4 gap-2.5 pt-1">
              <% [2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026].forEach(function(yr) { %>
                <button type="button" onclick="selectYearPicker('<%= yr %>')" data-year="<%= yr %>"
                        class="year-picker-btn btn-press py-3 px-3 rounded-xl border font-mono font-bold text-sm tabular-nums <%= yr === 2024 ? 'bg-zinc-900 text-white border-zinc-900 shadow-sm' : 'bg-white text-zinc-800 border-zinc-300 hover-surface' %>">
                  <%= yr %>
                </button>
              <% }); %>
            </div>
          </div>

          <!-- STEP 3: NAMA (AUTO UPPERCASE, STRING ONLY, MIN 3 HURUF) & NIM (3 DIGIT BELAKANG) -->
          <div id="ob-panel-3" class="ob-step-panel hidden space-y-4 p-5 rounded-2xl bg-zinc-50 border border-zinc-200">
            <div class="text-sm font-bold text-zinc-900">
              3. Nama dan NIM berapa?
            </div>

            <div class="space-y-1.5">
              <label for="modal-nama" class="font-bold text-zinc-800 block text-xs">
                Nama Lengkap (Hanya huruf, otomatis huruf besar, minimal 3 huruf):
              </label>
              <input id="modal-nama" type="text" value="ANDI PRATAMA" minlength="3" required
                     oninput="sanitizeNamaInput(this)"
                     placeholder="CONTOH: ANDI PRATAMA"
                     class="w-full font-bold uppercase py-2.5 px-3 rounded-xl border border-zinc-300 bg-white text-sm tracking-wide">
              <span id="namaErrorMsg" class="hidden text-[11px] font-semibold text-zinc-900">
                Nama hanya boleh huruf dan minimal 3 karakter.
              </span>
            </div>

            <div class="space-y-1.5">
              <label for="modal-nim-suffix" class="font-bold text-zinc-800 block text-xs">
                NIM Mahasiswa (Hanya input 3 digit belakang, format: <code class="font-mono">[angkatan]0140[3NIM]</code>):
              </label>
              <div class="flex items-center gap-2">
                <span id="modal-nim-prefix" class="font-mono tabular-nums font-extrabold bg-zinc-200 px-3.5 py-2.5 rounded-xl text-zinc-900 text-sm">
                  20240140
                </span>
                <input id="modal-nim-suffix" type="text" maxlength="3" minlength="3" value="093" required
                       oninput="sanitizeNimSuffix(this)"
                       class="w-20 font-mono tabular-nums font-extrabold text-center py-2.5 px-2 rounded-xl border-2 border-zinc-900 bg-white text-sm">
                <span class="text-zinc-500 font-mono text-xs">
                  &rarr; NIM Lengkap: <strong id="modal-nim-preview" class="text-zinc-900 tabular-nums">20240140093</strong>
                </span>
              </div>
            </div>
          </div>

          <!-- STEP 4: PRA-KRS GRID PER KATEGORI + PREFERENSI + AI MAPPING & VARIASI LAIN -->
          <div id="ob-panel-4" class="ob-step-panel hidden space-y-4 p-5 rounded-2xl bg-zinc-50 border border-zinc-200">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <div class="text-sm font-bold text-zinc-900">
                  4. Masukkan Pra-KRS Semester Ini (Grid per Kategori)
                </div>
                <p class="text-zinc-500 text-[11px]">
                  Pilih mata kuliah berdasarkan kategori &amp; peminatan, masukkan preferensi, lalu dapatkan saran kelas &amp; variasi jadwal dari AI.
                </p>
              </div>

              <div class="flex items-center gap-2">
                <label for="modal-peminatan" class="font-bold text-zinc-700 text-xs">Peminatan (TIxxx):</label>
                <select id="modal-peminatan" onchange="loadPrakrsGrid()" class="py-1.5 px-2.5 rounded-xl border border-zinc-300 font-bold bg-white text-xs">
                  <option value="PR" selected>PR - Programming</option>
                  <option value="DA">DA - Data &amp; AI</option>
                  <option value="NE">NE - Network</option>
                  <option value="UX">UX - User Experience</option>
                </select>
              </div>
            </div>

            <!-- Grid View Mata Kuliah Dikelompokkan Berdasarkan Kategori -->
            <div id="prakrsCategoryGrid" class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-56 overflow-y-auto pr-1"></div>

            <!-- Preferensi Mahasiswa (Kelas / Hari / Jam) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-2 border-t border-zinc-200 text-xs">
              <div>
                <label for="modal-kelas" class="font-bold text-zinc-700 block mb-1">Preferensi Kelas:</label>
                <select id="modal-kelas" onchange="requestAiPrakrsMapping(0)" class="w-full py-1.5 px-2.5 rounded-xl border border-zinc-300 bg-white font-bold">
                  <option value="A">Kelas A</option>
                  <option value="B" selected>Kelas B</option>
                  <option value="C">Kelas C</option>
                  <option value="D">Kelas D</option>
                  <option value="E">Kelas E</option>
                  <option value="F">Kelas F</option>
                </select>
              </div>

              <div>
                <label for="modal-pref-hari" class="font-bold text-zinc-700 block mb-1">Preferensi Hari:</label>
                <select id="modal-pref-hari" onchange="requestAiPrakrsMapping(0)" class="w-full py-1.5 px-2.5 rounded-xl border border-zinc-300 bg-white font-semibold">
                  <option value="Semua" selected>Semua Hari (Senin-Sabtu)</option>
                  <option value="Senin">Prioritas Senin-Rabu</option>
                  <option value="Kamis">Prioritas Rabu-Jumat</option>
                </select>
              </div>

              <div>
                <label for="modal-pref-waktu" class="font-bold text-zinc-700 block mb-1">Preferensi Jam:</label>
                <select id="modal-pref-waktu" onchange="requestAiPrakrsMapping(0)" class="w-full py-1.5 px-2.5 rounded-xl border border-zinc-300 bg-white font-semibold">
                  <option value="Semua" selected>Semua Jam</option>
                  <option value="Pagi">Pagi (07:00 - 11:30)</option>
                  <option value="Siang">Siang (12:10 - 15:00)</option>
                  <option value="Sore">Sore (15:30 - 18:00)</option>
                </select>
              </div>
            </div>

            <!-- Kotak Feedback AI Mapping & Tombol Variasi Lain -->
            <div class="p-3.5 rounded-2xl bg-zinc-900 text-white space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2 py-0.5 rounded bg-white text-zinc-900 font-mono font-bold text-[10px] uppercase">
                  AI Smart Mapping Feedback
                </span>
                <button type="button" id="btnVariasiLain" onclick="cycleAiVariasi()" class="btn-press px-2.5 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 border border-zinc-600 text-white font-semibold text-[11px]">
                  Minta Variasi Lain &#8635;
                </button>
              </div>
              <p id="aiPrakrsFeedbackText" class="text-zinc-200 text-xs leading-relaxed">
                AI memetakan mata kuliah pilihan kamu ke Kelas B (Variasi #1) dengan 0 bentrok jadwal.
              </p>
            </div>

            <!-- Pratinjau Sesi Terjadwal Hasil Pemetaan AI -->
            <div class="p-3 rounded-2xl bg-white border border-zinc-200 space-y-2 text-xs">
              <div class="flex items-center justify-between font-bold text-zinc-900 text-[11px] uppercase tracking-wider">
                <span>Pratinjau Sesi Terjadwal (AI Mapping)</span>
                <span id="prakrsAiPreviewCount" class="font-mono text-zinc-500 font-semibold">0 Sesi</span>
              </div>
              <div id="prakrsAiPreviewList" class="space-y-1.5 max-h-36 overflow-y-auto pr-1"></div>
            </div>
          </div>

          <!-- STICKY ACTION FOOTER: Never clipped! -->
          <div class="sticky bottom-0 bg-white/95 backdrop-blur-md pt-3 pb-1 border-t border-zinc-200 flex items-center justify-between">
            <button type="button" id="btnObPrev" onclick="stepOnboarding(-1)" class="btn-press px-4 py-2.5 rounded-xl bg-zinc-100 hover-surface text-zinc-800 font-bold text-xs sm:text-sm hidden">
              &larr; Sebelumnya
            </button>
            <div class="flex items-center gap-2 ml-auto">
              <button type="button" id="btnObNext" onclick="stepOnboarding(1)" class="btn-press px-6 py-2.5 rounded-xl bg-zinc-900 text-white font-bold text-xs sm:text-sm shadow-sm hover:bg-zinc-800">
                Next &rarr;
              </button>
              <button type="submit" id="btnObSubmit" class="btn-press px-6 py-2.5 rounded-xl bg-zinc-900 text-white font-bold text-xs sm:text-sm shadow-sm hover:bg-zinc-800 hidden">
                Simpan &amp; Terapkan Jadwal
              </button>
            </div>
          </div>

        </form>
      </div>
    </div>

    <!-- ==================== SUB-VIEW 3: LAMPIRAN 3 — JADWAL SAAT INI ==================== -->
    <div id="mhs-subview-current" class="hidden space-y-6">
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-app-border shadow-mac space-y-6">
        
        <!-- Heading Lampiran 3: Selamat [Waktu], [User]! -->
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
          <div>
            <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-medium mb-2">
              <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
              <span id="mhsSemesterText">Semester 5</span>
              <span>&middot;</span>
              <span id="mhsAngkatanText" class="font-mono tabular-nums">Angkatan 2024</span>
              <span>&middot;</span>
              <span id="mhsKelasBadge" class="px-2 py-0.5 rounded bg-zinc-100 font-bold text-zinc-900">Kelas B</span>
              <span>&middot;</span>
              <span id="mhsPeminatanBadge" class="px-2 py-0.5 rounded bg-zinc-900 text-white font-mono text-[11px]">Peminatan: Programming (PR)</span>
              <span>&middot;</span>
              <span id="mhsNimText" class="font-mono tabular-nums">NIM: 20240140093</span>
            </div>

            <h1 id="mhsGreeting" class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900">
              Selamat Pagi, ANDI PRATAMA!
            </h1>
            <p class="text-sm text-zinc-600 mt-1">
              Jadwal kamu saat ini. <span id="mhsAffirmativeCurrent" class="font-medium text-zinc-900">Jadwal perkuliahan semester ganjil aktif bebas bentrok ruang &amp; dosen.</span>
            </p>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button onclick="showOnboardingView(false)" class="btn-press px-4 py-2 rounded-xl bg-zinc-100 hover-surface text-zinc-900 text-xs font-semibold">
              Atur Pra-KRS
            </button>
          </div>
        </div>

        <!-- Card Utama Sesi Saat Ini (Persis Lampiran 3) -->
        <div id="activeSessionCard" class="rounded-2xl p-6 sm:p-8 border-2 border-zinc-900 bg-zinc-50/60 relative space-y-4">
          <div class="flex items-center justify-between gap-2">
            <span id="activeCardTime" class="text-2xl sm:text-3xl font-extrabold font-mono tabular-nums tracking-tight text-zinc-900">
              08:50 - 11:30
            </span>
            <span id="countdownTicker" class="px-3 py-1 rounded-xl bg-zinc-900 text-white font-mono tabular-nums text-xs sm:text-sm font-bold">
              00:42:15 left
            </span>
          </div>

          <div>
            <h2 id="activeCardTitle" class="text-xl sm:text-2xl font-bold text-zinc-900 tracking-tight">
              Pengembangan Aplikasi Web
            </h2>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-1 text-sm">
            <span id="activeCardKelas" class="w-8 h-8 rounded-xl border-2 border-zinc-900 bg-white font-bold text-zinc-900 flex items-center justify-center font-mono">
              B
            </span>
            <span id="activeCardRuang" class="font-mono font-bold text-zinc-900 text-base">
              F6.003
            </span>
            <span class="text-zinc-300 font-light text-lg">|</span>
            <span id="activeCardDosen" class="font-medium text-zinc-700">
              Ir. Asroni, S.T., M.Eng
            </span>
          </div>
        </div>

        <!-- Bottom Bar Lampiran 3: Ringkasan SKS & Tombol "Jadwal Lengkap" di kanan bawah -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
          <div class="flex items-center gap-3 text-xs text-zinc-500">
            <span>Total Paket Pra-KRS: <strong id="mhsTotalSksBadge" class="text-zinc-900 font-mono tabular-nums">20 SKS</strong></span>
            <span>&middot;</span>
            <span id="mhsVariasiLabel" class="font-mono text-zinc-700">Rekomendasi AI: Kelas B (Variasi #1)</span>
          </div>

          <button onclick="showFullScheduleView()" class="btn-press self-end sm:self-auto px-5 py-2.5 rounded-xl border-2 border-zinc-900 bg-zinc-900 text-white text-xs sm:text-sm font-bold tracking-tight">
            Jadwal Lengkap
          </button>
        </div>

      </div>
    </div>

    <!-- ==================== SUB-VIEW 1B: LAMPIRAN 4 — JADWAL KULIAH KAMU ==================== -->
    <div id="mhs-subview-full" class="hidden space-y-6">
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-app-border shadow-mac space-y-6">
        
        <!-- Header Lampiran 4: Jadwal Kuliah Kamu, [User]! + Motivasi Otomatis -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-zinc-100">
          <div>
            <h2 id="mhsFullTitle" class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900">
              Jadwal Kuliah Kamu, ANDI PRATAMA!
            </h2>
            <p id="mhsAffirmativeFull" class="text-xs sm:text-sm text-zinc-600 mt-1">
              Seluruh sesi telah disusun otomatis bebas bentrok ruang &amp; dosen sesuai preferensi Pra-KRS kamu.
            </p>
          </div>

          <!-- Filter Hari & Mode Tampilan -->
          <div class="flex flex-wrap items-center gap-1.5 bg-zinc-100 p-1 rounded-xl text-xs font-semibold text-zinc-600 overflow-x-auto no-scrollbar">
            <button onclick="filterDay('Semua')" class="filter-day-btn px-2.5 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm whitespace-nowrap" data-day="Semua">Semua</button>
            <button onclick="filterDay('Senin')" class="filter-day-btn px-2.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Senin">Senin</button>
            <button onclick="filterDay('Selasa')" class="filter-day-btn px-2.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Selasa">Selasa</button>
            <button onclick="filterDay('Rabu')" class="filter-day-btn px-2.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Rabu">Rabu</button>
            <button onclick="filterDay('Kamis')" class="filter-day-btn px-2.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Kamis">Kamis</button>
            <button onclick="filterDay('Jumat')" class="filter-day-btn px-2.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Jumat">Jumat</button>
            <button onclick="filterDay('Sabtu')" class="filter-day-btn px-2.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Sabtu">Sabtu</button>
          </div>
        </div>

        <!-- Daftar Kartu Jadwal Vertikal Sesuai Lampiran 4 (Dinamis Sesuai Hasil Pra-KRS) -->
        <div id="mhsScheduleContainer" class="space-y-4"></div>

        <!-- Katalog Utuh 111 Sesi Perkuliahan Prodi TI UMY (Ditampilkan saat toggle mode aktif) -->
        <div id="mhsStaticCatalogContainer" class="hidden space-y-4">
          <% jadwal.forEach(function(item) { %>
            <div class="schedule-item-row-static rounded-2xl p-5 border border-zinc-300 bg-white hover-surface space-y-2.5"
                 data-day="<%= item.hari %>"
                 data-id="<%= item.id %>"
                 data-kode="<%= item.kodeMatkul %>"
                 data-kelas="<%= item.kelas %>"
                 data-peminatan="<%= item.peminatanKode || '' %>">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                  <span class="text-xl sm:text-2xl font-extrabold font-mono tabular-nums text-zinc-900 row-jam">
                    <%= item.jamMulai %> - <%= item.jamSelesai %>
                  </span>
                  <span class="px-2.5 py-0.5 rounded-lg bg-zinc-100 text-zinc-800 font-semibold text-xs row-hari">
                    <%= item.hari %>
                  </span>
                </div>

                <div class="flex items-center gap-2 text-xs">
                  <span class="font-mono text-zinc-400"><%= item.kodeMatkul %> &middot; <%= item.sks %> SKS</span>
                  <% if (item.isPilihan) { %>
                    <span class="px-2 py-0.5 rounded bg-zinc-900 text-white font-mono text-[10px]">
                      Peminatan <%= item.peminatanKode %>
                    </span>
                  <% } %>
                  <% if (item.melewatiIstirahat) { %>
                    <span class="px-2 py-0.5 rounded border border-zinc-300 text-zinc-600 text-[10px]">
                      Jeda <%= item.melewatiIstirahat %>
                    </span>
                  <% } %>
                </div>
              </div>

              <div class="text-base sm:text-lg font-bold text-zinc-900">
                <%= item.mataKuliah %>
              </div>

              <div class="flex flex-wrap items-center gap-3 pt-1 text-xs sm:text-sm">
                <span class="px-2.5 py-1 rounded-lg border border-zinc-900 bg-zinc-50 font-mono font-bold text-zinc-900">
                  <%= item.kelas %>
                </span>
                <span class="font-mono font-bold text-zinc-900 row-ruang">
                  <%= item.ruang %>
                </span>
                <span class="text-zinc-300">|</span>
                <span class="text-zinc-700 font-medium">
                  <%= item.dosen %>
                </span>
              </div>
            </div>
          <% }); %>
        </div>

        <div id="emptyScheduleDay" class="hidden py-10 text-center text-xs text-zinc-500 bg-zinc-50 rounded-2xl border border-dashed border-zinc-200">
          <p class="font-bold text-zinc-800 text-sm">Tidak ada sesi perkuliahan pada filter yang dipilih.</p>
          <p class="mt-1">Gunakan tombol "Atur Pra-KRS" atau pilih hari lain untuk melihat sesi lainnya.</p>
        </div>

        <!-- Tombol Kembali (Pojok Kanan Bawah Persis Lampiran 4) -->
        <div class="flex items-center justify-between pt-4 border-t border-zinc-100">
          <button onclick="toggleShowAllCatalog()" id="btnToggleAllCatalog" class="btn-press text-xs font-semibold text-zinc-500 hover:text-zinc-900">
            Tampilkan Semua 111 Sesi Prodi
          </button>

          <button onclick="showCurrentScheduleView()" class="btn-press px-6 py-2.5 rounded-xl border-2 border-zinc-900 bg-white hover-surface text-zinc-900 text-xs sm:text-sm font-bold">
            Kembali
          </button>
        </div>

      </div>
    </div>

  </section>

  <!-- ==================== PANEL 2: STAF AKADEMIK ==================== -->
  <section id="view-akademik" class="spa-view hidden space-y-6">
    
    <!-- Top Generator Bar -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-medium mb-1">
          <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
          <span>Panel Staf Akademik: Rina Wulandari</span>
          <span>&middot;</span>
          <span id="genStatusBadge" class="font-semibold text-zinc-900"><%= jadwalStatus.status %></span>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900">
          Otomatisasi Penjadwalan TI UMY (111 Sesi Pertemuan)
        </h2>
        <p class="text-xs text-zinc-500 mt-1">
          Sistem solver berbasis constraint menghasilkan 0 bentrok dosen &amp; ruangan pada seluruh Gedung F4 &amp; F6.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button onclick="simulasiKonflik()" class="btn-press px-3 py-2.5 rounded-xl bg-zinc-100 hover-surface text-zinc-700 text-xs font-semibold">
          Uji Konflik (US-03)
        </button>

        <button onclick="runAIGenerate()" id="btnGenerateAI" class="btn-press px-4 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold flex items-center space-x-2">
          <svg class="w-4 h-4 text-zinc-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          </svg>
          <span>Generate Jadwal (AI)</span>
        </button>

        <button onclick="publishSchedule()" class="btn-press px-3.5 py-2.5 rounded-xl bg-zinc-100 hover-surface text-zinc-900 text-xs font-semibold">
          Publikasikan
        </button>
      </div>
    </div>

    <!-- Quality Indicators -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Waktu Generate (M-01)</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums">&lt; 15 Menit</span>
        <span class="text-[11px] text-zinc-500">Real-time solver: 1.2 detik</span>
      </div>

      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Bentrok Dosen/Ruang (M-02)</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums" id="valTotalKonflik">0 Bentrok</span>
        <span class="text-[11px] text-zinc-500" id="subTotalKonflik">Hard constraints terpenuhi</span>
      </div>

      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Total Sesi Terjadwal</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums"><%= jadwal.length %> Sesi</span>
        <span class="text-[11px] text-zinc-500">Gedung F4 &amp; F6</span>
      </div>

      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Preferensi Dosen (M-04)</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums">92.4%</span>
        <span class="text-[11px] text-zinc-500">Target &ge; 85% terlampaui</span>
      </div>
    </div>

    <!-- Laporan Konflik & Saran Perbaikan (PRD US-03, F-04) -->
    <div id="conflictReportBox" class="hidden bg-zinc-900 text-white rounded-2xl p-6 border border-zinc-800 shadow-mac space-y-4 text-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-zinc-800">
        <div>
          <span class="px-2 py-0.5 rounded bg-white text-zinc-900 font-mono font-bold text-[10px] uppercase">Laporan Konflik (F-04)</span>
          <h3 class="text-base font-bold mt-1">Deteksi Pelanggaran Hard Constraint &amp; Saran Perbaikan</h3>
        </div>
        <button onclick="runAIGenerate()" class="btn-press px-3.5 py-2 rounded-xl bg-white text-zinc-900 font-bold self-start sm:self-center">
          Resolusi Otomatis via AI Solver
        </button>
      </div>
      <div id="conflictListContainer" class="space-y-2.5"></div>
    </div>

    <!-- Preview & Filter Jadwal Multi-Dimensi -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4 text-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-zinc-100">
        <div>
          <h3 class="text-lg font-bold tracking-tight text-zinc-900">
            Preview &amp; Filter Jadwal Perkuliahan (US-04)
          </h3>
          <p class="text-xs text-zinc-500">
            Filter multi-dimensi per dosen, ruang F4/F6, atau kelas.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <input id="previewFilterDosen" type="text" placeholder="Cari dosen / inisial..." oninput="applyPreviewFilter()" class="py-1.5 px-3 rounded-xl border border-zinc-300 bg-zinc-50 text-xs w-36">
          <select id="previewFilterRuang" onchange="applyPreviewFilter()" class="py-1.5 px-3 rounded-xl border border-zinc-300 bg-zinc-50 text-xs font-medium">
            <option value="">Semua Ruangan</option>
            <% ruanganList.forEach(function(r) { %>
              <option value="<%= r.kode %>"><%= r.kode %> (<%= r.gedung %>)</option>
            <% }); %>
          </select>
          <select id="previewFilterKelas" onchange="applyPreviewFilter()" class="py-1.5 px-3 rounded-xl border border-zinc-300 bg-zinc-50 text-xs font-medium">
            <option value="">Semua Kelas</option>
            <option value="A">Kelas A</option>
            <option value="B">Kelas B</option>
            <option value="C">Kelas C</option>
            <option value="D">Kelas D</option>
            <option value="E">Kelas E</option>
            <option value="F">Kelas F</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto max-h-96">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 text-zinc-600 font-bold border-b border-zinc-200 sticky top-0">
            <tr>
              <th class="p-3">Hari &amp; Jam</th>
              <th class="p-3">Mata Kuliah</th>
              <th class="p-3">Dosen</th>
              <th class="p-3">Kelas</th>
              <th class="p-3">Ruangan</th>
              <th class="p-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="previewTableBody" class="divide-y divide-zinc-100">
            <% jadwal.forEach(function(item) { %>
              <tr class="preview-row hover:bg-zinc-50/50" data-id="<%= item.id %>" data-dosen="<%= item.dosen.toLowerCase() %> <%= item.dosenInisial.toLowerCase() %>" data-ruang="<%= item.ruang.toLowerCase() %>" data-kelas="<%= item.kelas.toLowerCase() %>">
                <td class="p-3 font-mono tabular-nums whitespace-nowrap">
                  <span class="font-bold text-zinc-900 preview-hari"><%= item.hari %></span>
                  <span class="text-zinc-500 ml-1 preview-jam"><%= item.jamMulai %>&ndash;<%= item.jamSelesai %></span>
                </td>
                <td class="p-3">
                  <span class="font-bold text-zinc-900"><%= item.mataKuliah %></span>
                  <span class="text-zinc-400 font-mono ml-1">(<%= item.kodeMatkul %>)</span>
                </td>
                <td class="p-3 text-zinc-700"><%= item.dosen %></td>
                <td class="p-3 font-bold text-zinc-900"><%= item.kelas %></td>
                <td class="p-3 font-mono font-semibold text-zinc-900 preview-ruang"><%= item.ruang %></td>
                <td class="p-3 text-right">
                  <button onclick="openRevisiModal('<%= item.id %>', '<%= item.mataKuliah %>', '<%= item.hari %>', '<%= item.jamMulai %>', '<%= item.jamSelesai %>', '<%= item.ruang %>')" class="btn-press px-2.5 py-1 rounded-lg bg-zinc-100 hover-surface text-zinc-800 font-semibold">
                    Ubah
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Master Data Management Tables -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-zinc-100 gap-3">
        <div>
          <h3 class="text-lg font-bold tracking-tight text-zinc-900">
            Data Master Kurikulum &amp; Akademik TI UMY (US-01)
          </h3>
          <p class="text-xs text-zinc-500" id="masterSummaryDesc">
            Total <%= masterSummary.totalDosen %> Dosen Resmi, <%= masterSummary.totalMatkul %> Kurikulum Sem 1-8, <%= masterSummary.totalPeminatan %> MK Pilihan Peminatan, dan <%= masterSummary.totalRuangan %> Ruangan.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <input id="masterSearchInput" type="text" placeholder="Cari data master..." oninput="filterMasterRows()" class="py-1.5 px-3 rounded-xl border border-zinc-300 bg-zinc-50 text-xs w-40">

          <div class="flex items-center bg-zinc-100 p-1 rounded-xl text-xs font-semibold text-zinc-600 overflow-x-auto no-scrollbar">
            <button onclick="switchMasterTab('kurikulum')" id="m-tab-kurikulum" class="master-tab-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm whitespace-nowrap">
              Kurikulum Sem 1-8 (<span id="countMatkul" class="tabular-nums"><%= masterSummary.totalMatkul %></span>)
            </button>
            <button onclick="switchMasterTab('peminatan')" id="m-tab-peminatan" class="master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap">
              Peminatan (<%= masterSummary.totalPeminatan %>)
            </button>
            <button onclick="switchMasterTab('dosen')" id="m-tab-dosen" class="master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap">
              Dosen (<span id="countDosen" class="tabular-nums"><%= masterSummary.totalDosen %></span>)
            </button>
            <button onclick="switchMasterTab('ruangan')" id="m-tab-ruangan" class="master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap">
              Ruangan (<span id="countRuangan" class="tabular-nums"><%= masterSummary.totalRuangan %></span>)
            </button>
          </div>

          <button onclick="openModal('modal-tambah-master')" class="btn-press px-3 py-1.5 rounded-xl bg-zinc-900 text-white text-xs font-semibold">
            + Tambah Data
          </button>
        </div>
      </div>

      <!-- Master Subtable: Kurikulum Semester 1-8 -->
      <div id="subtable-kurikulum" class="master-subtable overflow-x-auto max-h-96">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 text-zinc-600 font-bold border-b border-zinc-200 sticky top-0">
            <tr>
              <th class="p-3">Semester</th>
              <th class="p-3">Kode MK</th>
              <th class="p-3">Nama Mata Kuliah</th>
              <th class="p-3 font-mono">SKS</th>
              <th class="p-3">Kategori</th>
            </tr>
          </thead>
          <tbody id="tbodyMasterMatkul" class="divide-y divide-zinc-100">
            <% kurikulumList.forEach(function(m) { %>
              <tr class="master-row hover:bg-zinc-50/50">
                <td class="p-3 font-mono font-bold text-zinc-900">Sem <%= m.semester %></td>
                <td class="p-3 font-mono text-zinc-500"><%= m.kode %></td>
                <td class="p-3 font-semibold text-zinc-900"><%= m.nama %></td>
                <td class="p-3 font-mono text-zinc-700 tabular-nums"><%= m.sks %> SKS</td>
                <td class="p-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono <%= m.kode.startsWith('MKWU') ? 'bg-zinc-900 text-white' : 'bg-zinc-100 text-zinc-700' %>">
                    <%= m.kategori %>
                  </span>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Master Subtable: Peminatan (PR, DA, NE, UX) -->
      <div id="subtable-peminatan" class="master-subtable hidden overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 text-zinc-600 font-bold border-b border-zinc-200">
            <tr>
              <th class="p-3">Jalur Peminatan</th>
              <th class="p-3">Kode MK</th>
              <th class="p-3">Nama Mata Kuliah</th>
              <th class="p-3">SKS</th>
              <th class="p-3">Penawaran</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            <% peminatanList.forEach(function(p) { %>
              <tr class="master-row hover:bg-zinc-50/50">
                <td class="p-3 font-bold text-zinc-900"><%= p.peminatan %> (<%= p.kodePeminatan %>)</td>
                <td class="p-3 font-mono text-zinc-500"><%= p.kode %></td>
                <td class="p-3 font-semibold text-zinc-900"><%= p.nama %></td>
                <td class="p-3 font-mono tabular-nums text-zinc-700"><%= p.sks %> SKS</td>
                <td class="p-3 font-mono text-zinc-500">Semester <%= p.semesterPenawaran %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Master Subtable: Dosen Resmi TI (CRUD Lengkap) -->
      <div id="subtable-dosen" class="master-subtable hidden overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 text-zinc-600 font-bold border-b border-zinc-200">
            <tr>
              <th class="p-3">No</th>
              <th class="p-3">Inisial</th>
              <th class="p-3">Nama Dosen</th>
              <th class="p-3">Bidang Keahlian</th>
              <th class="p-3 text-right">Beban Mengajar</th>
              <th class="p-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="tbodyMasterDosen" class="divide-y divide-zinc-100">
            <% dosenList.forEach(function(d, idx) { %>
              <tr id="dosen-row-<%= d.id %>" class="master-row hover:bg-zinc-50/50" data-id="<%= d.id %>" data-inisial="<%= d.inisial %>" data-nama="<%= d.nama %>" data-keahlian="<%= d.keahlian %>" data-sks="<%= d.bebanSks %>">
                <td class="p-3 font-mono text-zinc-400 tabular-nums cell-idx"><%= idx + 1 %></td>
                <td class="p-3 font-mono font-bold text-zinc-900 cell-inisial"><%= d.inisial %></td>
                <td class="p-3 font-semibold text-zinc-900 cell-nama"><%= d.nama %></td>
                <td class="p-3 text-zinc-600 cell-keahlian"><%= d.keahlian %></td>
                <td class="p-3 text-right font-mono text-zinc-700 tabular-nums cell-sks"><%= d.bebanSks %> SKS</td>
                <td class="p-3 text-right whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5 justify-end">
                    <button type="button" onclick="openEditDosenModal(<%= d.id %>)" class="btn-press px-2.5 py-1 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-800 font-semibold text-[11px] inline-flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                      Edit
                    </button>
                    <button type="button" onclick="deleteDosenItem(<%= d.id %>)" class="btn-press px-2.5 py-1 rounded-lg bg-zinc-100 hover:bg-red-50 hover:text-red-700 text-zinc-600 font-semibold text-[11px] inline-flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      Hapus
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Master Subtable: Ruangan F4 & F6 -->
      <div id="subtable-ruangan" class="master-subtable hidden overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 text-zinc-600 font-bold border-b border-zinc-200">
            <tr>
              <th class="p-3">Kode Ruang</th>
              <th class="p-3">Nama Ruangan</th>
              <th class="p-3">Gedung</th>
              <th class="p-3">Tipe</th>
              <th class="p-3 text-right">Kapasitas</th>
            </tr>
          </thead>
          <tbody id="tbodyMasterRuangan" class="divide-y divide-zinc-100">
            <% ruanganList.forEach(function(r) { %>
              <tr class="master-row hover:bg-zinc-50/50">
                <td class="p-3 font-mono font-bold text-zinc-900"><%= r.kode %></td>
                <td class="p-3 font-semibold text-zinc-900"><%= r.nama %></td>
                <td class="p-3 font-bold text-zinc-700"><%= r.gedung %></td>
                <td class="p-3 text-zinc-600"><%= r.tipe %></td>
                <td class="p-3 text-right font-mono text-zinc-700 tabular-nums"><%= r.kapasitas %> Kursi</td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Hard & Soft Constraint Rules (PRD F-02, US-02) -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4">
      <h3 class="text-lg font-bold tracking-tight text-zinc-900 pb-3 border-b border-zinc-100">
        Konfigurasi Hard &amp; Soft Constraints (US-02)
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200 space-y-3">
          <span class="text-xs font-bold text-zinc-900 uppercase tracking-wider block">Hard Constraints (Wajib 100%)</span>
          <% constraints.hardConstraints.forEach(function(hc) { %>
            <div class="p-3 rounded-lg bg-white border border-zinc-200/80 space-y-1">
              <div class="flex justify-between items-center font-bold text-zinc-900">
                <span><%= hc.nama %></span>
                <button onclick="toggleHardConstraint('<%= hc.id %>', this)" data-active="<%= hc.isActive %>" class="btn-press text-[10px] px-2.5 py-0.5 rounded bg-zinc-900 text-white font-mono">
                  <%= hc.isActive ? 'Aktif' : 'Nonaktif' %>
                </button>
              </div>
              <p class="text-zinc-500 text-[11px]"><%= hc.deskripsi %></p>
            </div>
          <% }); %>
        </div>

        <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200 space-y-3">
          <span class="text-xs font-bold text-zinc-900 uppercase tracking-wider block">Soft Constraints (Preferensi Dosen &ge; 85%)</span>
          <div id="softConstraintListContainer" class="space-y-3">
            <% constraints.softConstraints.forEach(function(sc) { %>
              <div class="p-3 rounded-lg bg-white border border-zinc-200/80 space-y-1">
                <div class="flex justify-between items-center font-semibold text-zinc-900">
                  <span><%= sc.dosenNama %></span>
                  <span class="text-[10px] px-2 py-0.5 rounded bg-zinc-100 text-zinc-800 font-mono">Terakomodir</span>
                </div>
                <p class="text-zinc-500 text-[11px]">
                  <% if (sc.hariOff) { %>
                    Hari Off: <strong><%= sc.hariOff %></strong> (<%= sc.alasan %>)
                  <% } else { %>
                    <%= sc.preferensiWaktu %>
                  <% } %>
                </p>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- ==================== PANEL 3: DOSEN ==================== -->
  <section id="view-dosen" class="spa-view hidden space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-medium mb-1">
          <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
          <span>Dosen: Muhammad Abdul Haq, S.Tr.T., M.Eng. Ph.D. (HQ)</span>
          <span>&middot;</span>
          <span class="font-mono tabular-nums">Beban: 24 SKS</span>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900">
          Jadwal Mengajar &amp; Preferensi Riset
        </h2>
        <p class="text-xs text-zinc-500 mt-1">
          Atur hari riset dan preferensi waktu mengajar agar diakomodasi oleh AI solver.
        </p>
      </div>

      <button onclick="openModal('modal-preferensi-dosen')" class="btn-press px-4 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-semibold">
        Edit Preferensi Mengajar
      </button>
    </div>

    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4">
      <h3 class="text-lg font-bold tracking-tight text-zinc-900 pb-3 border-b border-zinc-100">
        Jadwal Mengajar Saya (Muhammad Abdul Haq, S.Tr.T., M.Eng. Ph.D. / Inisial HQ)
      </h3>

      <div class="space-y-3">
        <% jadwal.filter(j => j.dosenInisial.includes('HQ')).forEach(function(sesi) { %>
          <div class="p-4 rounded-xl border border-zinc-200 bg-zinc-50 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div class="space-y-1">
              <div class="flex items-center space-x-2">
                <span class="px-2 py-0.5 rounded bg-zinc-200 text-zinc-800 font-bold"><%= sesi.hari %></span>
                <span class="font-mono tabular-nums font-bold text-zinc-900"><%= sesi.jamMulai %> &ndash; <%= sesi.jamSelesai %></span>
                <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-700">Kelas <%= sesi.kelas %></span>
              </div>
              <div class="text-sm font-bold text-zinc-900"><%= sesi.mataKuliah %> (<%= sesi.kodeMatkul %>)</div>
              <div class="text-zinc-500">Ruang <%= sesi.ruang %> &middot; <%= sesi.sks %> SKS &middot; Pengampu: <%= sesi.dosenInisial %></div>
            </div>
            <span class="px-3 py-1 rounded-lg bg-zinc-900 text-white font-mono text-xs self-start sm:self-center">
              Terpublikasi
            </span>
          </div>
        <% }); %>

        <div id="dosenOffDayBanner" class="p-4 rounded-xl border border-dashed border-zinc-300 bg-white text-xs text-zinc-600">
          Hari <strong id="dosenOffDayLabel">Jumat</strong> telah dikonfigurasi sebagai hari bebas mengajar (<span id="dosenOffReasonLabel">Alokasi Waktu Riset &amp; Penelitian Laboratorium</span>).
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PANEL 4: SISTEM & REST API ==================== -->
  <section id="view-system" class="spa-view hidden space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900">
          Status Sistem &amp; REST Endpoints
        </h2>
        <p class="text-xs text-zinc-500 mt-1">
          Dataset riil TI UMY terhubung ke REST API (<code class="font-mono text-[11px] bg-zinc-100 px-1 py-0.5 rounded">logs/logger.md</code>).
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 text-xs">
        <button onclick="testApiEndpoint('/api/status')" class="btn-press px-3 py-1.5 rounded-lg bg-zinc-900 text-white font-semibold">
          /api/status
        </button>
        <button onclick="testApiEndpoint('/api/jadwal')" class="btn-press px-3 py-1.5 rounded-lg bg-zinc-100 hover-surface text-zinc-800 font-semibold">
          /api/jadwal
        </button>
        <button onclick="testApiEndpoint('/api/master')" class="btn-press px-3 py-1.5 rounded-lg bg-zinc-100 hover-surface text-zinc-800 font-semibold">
          /api/master
        </button>
        <button onclick="testApiEndpoint('/api/constraints')" class="btn-press px-3 py-1.5 rounded-lg bg-zinc-100 hover-surface text-zinc-800 font-semibold">
          /api/constraints
        </button>
        <button onclick="testApiEndpoint('/api/produk')" class="btn-press px-3 py-1.5 rounded-lg bg-zinc-100 hover-surface text-zinc-800 font-semibold">
          /api/produk
        </button>
      </div>
    </div>

    <div class="bg-zinc-900 rounded-2xl p-5 border border-zinc-800 shadow-mac text-zinc-300 font-mono text-xs">
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800 mb-3 text-zinc-400">
        <div class="flex items-center space-x-2">
          <span class="text-white font-bold" id="sys-endpoint-url">/api/status</span>
          <span class="text-zinc-600">|</span>
          <span class="text-[11px] text-zinc-500 tabular-nums" id="sys-response-time">- ms</span>
        </div>
        <button onclick="copySysOutput()" class="btn-press text-zinc-400 hover:text-white text-[11px]">
          Salin JSON
        </button>
      </div>

      <pre id="sys-json-output" class="overflow-x-auto max-h-80 leading-relaxed text-zinc-200">// Memuat response...</pre>
    </div>

    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4">
      <h3 class="text-lg font-bold tracking-tight text-zinc-900 pb-3 border-b border-zinc-100">
        Spesifikasi Fitur PRD (MoSCoW)
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
        <% produk.forEach(function(f) { %>
          <div class="p-3.5 rounded-xl border border-zinc-200 bg-zinc-50 space-y-1">
            <div class="flex justify-between items-center font-bold text-zinc-900">
              <span><%= f.kode %> &middot; <%= f.nama %></span>
              <span class="px-2 py-0.5 rounded text-[10px] font-mono <%= f.prioritas === 'Must' ? 'bg-zinc-900 text-white' : 'bg-zinc-200 text-zinc-800' %>">
                <%= f.prioritas %>
              </span>
            </div>
            <p class="text-zinc-500 text-[11px]"><%= f.deskripsi %></p>
            <div class="text-[10px] text-zinc-400 pt-1 font-mono">Terkait <%= f.terkaitUS %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

</main>

<!-- ==================== TOAST FEEDBACK ==================== -->
<div id="appToast" role="status" aria-live="polite" class="app-toast fixed bottom-5 right-5 z-50 max-w-sm bg-zinc-900 text-white px-4 py-3 rounded-2xl shadow-mac-lg border border-zinc-800 flex items-center space-x-3 text-xs">
  <span class="w-2 h-2 rounded-full bg-white shrink-0"></span>
