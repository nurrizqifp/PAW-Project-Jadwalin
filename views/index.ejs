<!-- ==================== MODAL: PREFERENSI DOSEN ==================== -->
<div id="modal-preferensi-dosen" data-open="false" class="modal-backdrop fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" onclick="if(event.target === this) closeModal('modal-preferensi-dosen')">
  <div class="modal-panel bg-white rounded-2xl max-w-sm w-full p-6 shadow-mac-lg border border-zinc-200 space-y-4 text-xs">
    <div class="flex justify-between items-center pb-2 border-b border-zinc-100">
      <h3 class="text-base font-bold text-zinc-900">Preferensi Waktu Mengajar</h3>
      <button onclick="closeModal('modal-preferensi-dosen')" class="text-zinc-400 hover:text-zinc-700 text-lg font-bold leading-none">&times;</button>
    </div>

    <form onsubmit="saveDosenPref(event)" class="space-y-3">
      <div>
        <label class="font-bold text-zinc-800 block mb-1">Hari Bebas Mengajar (Off Day):</label>
        <select id="pref-hari-off" class="w-full py-2 px-3 rounded-lg border border-zinc-300 bg-white font-semibold">
