<script>
  // State API Console
  let activeApiEndpoint = '/api/status';

  // Cek Status Server saat pertama load
  async function checkServerStatus() {
    const uptimeEl = document.getElementById('uptime-text');
    const badgeEl = document.getElementById('nav-status-badge');
    try {
      uptimeEl.innerText = 'Ping...';
      const res = await fetch('/api/status');
      const data = await res.json();
      uptimeEl.innerText = `${data.uptimeDetik}s (${data.status.toUpperCase()})`;
      if (badgeEl) badgeEl.innerText = 'API Aktif (' + data.uptimeDetik + 's)';
    } catch (e) {
      uptimeEl.innerText = 'Offline';
      if (badgeEl) badgeEl.innerText = 'API Offline';
    }
  }

  // API Console Switcher
  function switchApiTab(key) {
    document.querySelectorAll('[id^="tab-btn-"]').forEach(btn => {
      btn.className = 'px-3.5 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition-all';
    });
    const activeBtn = document.getElementById('tab-btn-' + key);
    if (activeBtn) {
      activeBtn.className = 'px-3.5 py-1.5 rounded-lg bg-white text-slate-900 shadow-sm transition-all';
    }

    if (key === 'status') activeApiEndpoint = '/api/status';
    if (key === 'produk') activeApiEndpoint = '/api/produk';
    if (key === 'jadwal') activeApiEndpoint = '/api/jadwal';

    document.getElementById('api-url-text').innerText = activeApiEndpoint;
    document.getElementById('api-direct-link').href = activeApiEndpoint;
    executeCurrentApi();
  }

  async function executeCurrentApi() {
    const outputEl = document.getElementById('api-console-output');
    const msEl = document.getElementById('api-ms');
    outputEl.innerText = '// Memuat request dari ' + activeApiEndpoint + '...';
    
    const t0 = performance.now();
    try {
      const res = await fetch(activeApiEndpoint);
      const data = await res.json();
      const t1 = performance.now();
      msEl.innerText = (t1 - t0).toFixed(1) + ' ms';
      outputEl.innerText = JSON.stringify(data, null, 2);
    } catch (err) {
      outputEl.innerText = 'Error: ' + err.message;
      msEl.innerText = 'Gagal';
    }
  }

  function copyApiOutput() {
    const text = document.getElementById('api-console-output').innerText;
    navigator.clipboard.writeText(text).then(() => {
      alert('JSON berhasil disalin ke clipboard!');
    });
  }

  // Modal Detail Handler
  function toggleModal(id) {
    const m = document.getElementById(id);
    m.classList.toggle('hidden');
  }

  function previewProdukDetail(p) {
    document.getElementById('modal-title').innerText = p.nama;
    document.getElementById('modal-desc').innerText = p.deskripsi;
    document.getElementById('modal-kategori-badge').innerText = p.kategori;
    document.getElementById('modal-kategori').innerText = p.kategori;
    document.getElementById('modal-fitur').innerText = p.fiturUtama;
    document.getElementById('modal-stok').innerText = p.stok + ' Kuota Tersedia';
    document.getElementById('modal-harga').innerText = 'Rp ' + Number(p.harga).toLocaleString('id-ID');
    toggleModal('modal-detail');
  }

  // Filter Produk by Search & Category
  function filterProducts() {
    const query = document.getElementById('productSearch').value.toLowerCase();
    const cards = document.querySelectorAll('.product-card');
    cards.forEach(card => {
      const nama = card.getAttribute('data-nama');
      if (nama.includes(query)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  function setCategoryFilter(cat) {
    document.querySelectorAll('.cat-pill').forEach(btn => {
      btn.className = 'cat-pill px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-all';
    });
    const activeBtn = document.querySelector(`.cat-pill[data-cat="${cat}"]`);
    if (activeBtn) {
      activeBtn.className = 'cat-pill active px-3.5 py-1.5 rounded-full bg-brand-600 text-white shadow-sm transition-all';
    }

    const cards = document.querySelectorAll('.product-card');
    cards.forEach(card => {
      const cardCat = card.getAttribute('data-kategori');
      if (cat === 'all' || cardCat === cat) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // ================= WIREFRAME SIMULATOR LOGIC =================
  function openWireframeStep(stepId) {
    // Hide all sub-screens
    document.querySelectorAll('.wf-screen').forEach(el => el.classList.add('hidden'));
    
    // Show selected
    const target = document.getElementById(stepId);
    if (target) target.classList.remove('hidden');

    // Update tab styles
    document.querySelectorAll('.wf-tab').forEach(tab => {
      tab.className = 'wf-tab px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 transition-all';
    });

    if (stepId === 'step-welcome') document.getElementById('btn-tab-welcome').className = 'wf-tab px-4 py-2 rounded-xl bg-brand-600 text-white transition-all';
    if (stepId === 'step-onboarding') document.getElementById('btn-tab-onboarding').className = 'wf-tab px-4 py-2 rounded-xl bg-brand-600 text-white transition-all';
    if (stepId === 'step-active-card') document.getElementById('btn-tab-active').className = 'wf-tab px-4 py-2 rounded-xl bg-brand-600 text-white transition-all';
    if (stepId === 'step-full-schedule') document.getElementById('btn-tab-full').className = 'wf-tab px-4 py-2 rounded-xl bg-brand-600 text-white transition-all';
  }

  function adjustSimSemester(delta) {
    const input = document.getElementById('sim-semester');
    let val = parseInt(input.value || 1, 10) + delta;
    if (val < 1) val = 1;
    if (val > 12) val = 12;
    input.value = val;
  }

  function updateSimNim() {
    const angkatan = document.getElementById('sim-angkatan').value || '2024';
    document.getElementById('sim-nim-prefix').innerText = angkatan + '0140';
  }

  function handleSimulatorSubmit(e) {
    e.preventDefault();
    const semester = parseInt(document.getElementById('sim-semester').value, 10);
    const nama = document.getElementById('sim-nama').value.trim();
    const suffix = document.getElementById('sim-nim-suffix').value.trim();
    const feedback = document.getElementById('sim-feedback');

    if (semester < 1 || semester > 12 || isNaN(semester)) {
      feedback.className = 'p-3 rounded-xl text-xs bg-red-100 text-red-700 border border-red-200';
      feedback.innerText = 'Validasi Gagal: Semester harus integer 1 s.d. 12.';
      feedback.classList.remove('hidden');
      return;
    }

    if (nama.length < 3) {
      feedback.className = 'p-3 rounded-xl text-xs bg-red-100 text-red-700 border border-red-200';
      feedback.innerText = 'Validasi Gagal: Nama minimal 3 karakter huruf kapital.';
      feedback.classList.remove('hidden');
      return;
    }

    if (suffix.length !== 3) {
      feedback.className = 'p-3 rounded-xl text-xs bg-red-100 text-red-700 border border-red-200';
      feedback.innerText = 'Validasi Gagal: NIM harus 3 digit angka belakang.';
      feedback.classList.remove('hidden');
      return;
    }

    // Set greeting on active card screen
    document.getElementById('user-greeting').innerText = `Selamat Pagi, ${nama}!`;

    feedback.className = 'p-3 rounded-xl text-xs bg-emerald-100 text-emerald-800 border border-emerald-200';
    feedback.innerText = `Validasi Sukses! Membuka dashboard jadwal untuk ${nama}...`;
    feedback.classList.remove('hidden');

    setTimeout(() => {
      openWireframeStep('step-active-card');
      feedback.classList.add('hidden');
    }, 700);
  }

  // Live countdown timer ticker (42:15 left ticking down)
  let countdownSeconds = 42 * 60 + 15;
  setInterval(() => {
    if (countdownSeconds > 0) {
      countdownSeconds--;
      const m = Math.floor(countdownSeconds / 60);
      const s = countdownSeconds % 60;
      const formatted = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} left`;
      const badge = document.getElementById('countdown-badge');
      if (badge) badge.innerText = formatted;
    }
  }, 1000);

  // Inisialisasi saat halaman dibuka
  document.addEventListener('DOMContentLoaded', () => {
    checkServerStatus();
    executeCurrentApi();
  });
</script>

