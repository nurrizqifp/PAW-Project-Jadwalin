<!-- ==================== CLIENT SPA CONTROLLER ==================== -->
<script>
  let toastTimer = null;

  function showToast(message) {
    const toast = document.getElementById('appToast');
    const msgEl = document.getElementById('appToastMessage');
    if (!toast || !msgEl) return;
    msgEl.textContent = message;
    toast.setAttribute('data-visible', 'true');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.setAttribute('data-visible', 'false');
    }, 3200);
  }

  function switchView(targetId) {
    document.querySelectorAll('.spa-view').forEach(v => v.classList.add('hidden'));
    const target = document.getElementById(targetId);
    if (target) target.classList.remove('hidden');

    document.querySelectorAll('.nav-segment').forEach(b => {
      b.className = 'nav-segment px-3.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 flex items-center gap-1.5';
    });
    const key = targetId.replace('view-', '');
    const activeDesktop = document.getElementById('nav-btn-' + key);
    if (activeDesktop) {
      activeDesktop.className = 'nav-segment px-3.5 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm flex items-center gap-1.5';
    }

    document.querySelectorAll('.mob-segment').forEach(b => {
      b.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg text-zinc-600 text-center whitespace-nowrap';
    });
    const activeMobile = document.getElementById('mob-btn-' + key);
    if (activeMobile) {
      activeMobile.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg bg-white text-zinc-900 shadow-sm text-center whitespace-nowrap';
    }

    const badge = document.getElementById('activePersonaBadge');
    if (badge) {
      if (key === 'mahasiswa') badge.textContent = 'Mahasiswa: Andi Pratama';
      if (key === 'akademik') badge.textContent = 'Staf: Rina Wulandari';
      if (key === 'dosen') badge.textContent = 'Dosen: Muhammad Abdul Haq, Ph.D.';
      if (key === 'system') badge.textContent = 'Administrator Sistem';
    }

    if (targetId === 'view-system') {
      testApiEndpoint('/api/status');
    }
  }

  function scrollToFullSchedule() {
    switchView('view-mahasiswa');
    const el = document.getElementById('fullScheduleTable');
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  }

  function switchMasterTab(tabName) {
    document.querySelectorAll('.master-tab-btn').forEach(b => {
      b.className = 'master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900';
    });
    const active = document.getElementById('m-tab-' + tabName);
    if (active) active.className = 'master-tab-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm';

    document.querySelectorAll('.master-subtable').forEach(t => t.classList.add('hidden'));
    const target = document.getElementById('subtable-' + tabName);
    if (target) target.classList.remove('hidden');
  }

  let currentFilterDay = 'Semua';
  function filterDay(day) {
    currentFilterDay = day;
    document.querySelectorAll('.filter-day-btn').forEach(b => {
      b.className = 'filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap';
    });
    const active = document.querySelector(`.filter-day-btn[data-day="${day}"]`);
    if (active) active.className = 'filter-day-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm whitespace-nowrap';

    applyMahasiswaScheduleFilter();
  }

  function applyMahasiswaScheduleFilter() {
    const kFilter = document.getElementById('modal-kelas')?.value || 'B';
    const pemFilter = document.getElementById('modal-peminatan')?.value || 'PR';

    let visibleCount = 0;
    document.querySelectorAll('.schedule-item-row').forEach(row => {
      const rowDay = row.getAttribute('data-day');
      const rowKelas = row.getAttribute('data-kelas') || '';
      const rowPem = row.getAttribute('data-peminatan') || '';

      const matchDay = (currentFilterDay === 'Semua' || rowDay === currentFilterDay);
      // Kelas cocok jika kelas gabungan memuat kFilter atau sama persis
      const matchKelas = rowKelas.includes(kFilter);
      // Peminatan cocok jika bukan matkul pilihan atau peminatan sama
      const matchPem = !rowPem || rowPem === pemFilter;

      const show = matchDay && matchKelas && matchPem;
      row.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    });

    const emptyEl = document.getElementById('emptyScheduleDay');
    if (emptyEl) emptyEl.classList.toggle('hidden', visibleCount > 0);
  }

  function applyPreviewFilter() {
    const qDosen = (document.getElementById('previewFilterDosen')?.value || '').toLowerCase().trim();
    const qRuang = (document.getElementById('previewFilterRuang')?.value || '').toLowerCase().trim();
    const qKelas = (document.getElementById('previewFilterKelas')?.value || '').toLowerCase().trim();

    document.querySelectorAll('.preview-row').forEach(row => {
      const d = row.getAttribute('data-dosen') || '';
      const r = row.getAttribute('data-ruang') || '';
      const k = row.getAttribute('data-kelas') || '';
      const match = (!qDosen || d.includes(qDosen)) && (!qRuang || r.includes(qRuang)) && (!qKelas || k.includes(qKelas));
      row.classList.toggle('hidden', !match);
    });
  }

  function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.setAttribute('data-open', 'true');
  }
  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.setAttribute('data-open', 'false');
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-backdrop[data-open="true"]').forEach(m => {
        m.setAttribute('data-open', 'false');
      });
    }
  });

  // Pra-KRS & Peminatan
  async function savePrakrs(e) {
    e.preventDefault();
    const sem = document.getElementById('modal-sem').value;
    const kelas = document.getElementById('modal-kelas').value;
    const peminatan = document.getElementById('modal-peminatan').value;
    const nama = document.getElementById('modal-nama').value.trim();
    const suffix = document.getElementById('modal-nim-suffix').value.padStart(3, '0');

    document.getElementById('mhsGreeting').textContent = `Selamat Pagi, ${nama}`;
    document.getElementById('mhsSemesterText').textContent = `Semester ${sem}`;
    document.getElementById('mhsKelasBadge').textContent = `Kelas ${kelas}`;
    document.getElementById('mhsPeminatanBadge').textContent = `Peminatan: ${peminatan}`;
    document.getElementById('mhsNimText').textContent = `NIM: 20240140${suffix}`;

    // Ambil daftar kurikulum semester terpilih
    try {
      const res = await fetch(`/api/master?semester=${sem}&peminatan=${peminatan}`);
      const data = await res.json();
      if (res.ok && Array.isArray(data.kurikulum)) {
        const box = document.getElementById('mhsPlanContainer');
        box.replaceChildren();
        let totalSks = 0;
        data.kurikulum.forEach(m => {
          totalSks += m.sks;
          const card = document.createElement('div');
          card.className = 'p-2.5 rounded-xl bg-zinc-50 border border-zinc-200/80 flex items-center justify-between';
          const left = document.createElement('div');
          const title = document.createElement('div'); title.className = 'font-bold text-zinc-900'; title.textContent = m.nama;
          const sub = document.createElement('div'); sub.className = 'font-mono text-[11px] text-zinc-500'; sub.textContent = `${m.kode} · ${m.kategori}`;
          left.append(title, sub);
          const right = document.createElement('span');
          right.className = 'font-mono font-bold text-zinc-700 tabular-nums shrink-0 ml-2';
          right.textContent = `${m.sks} SKS`;
          card.append(left, right);
          box.appendChild(card);
        });
        document.getElementById('mhsTotalSksBadge').textContent = `${totalSks} SKS`;
      }
    } catch (err) {
      console.warn('Gagal memuat kurikulum semester:', err);
    }

    applyMahasiswaScheduleFilter();
    closeModal('modal-prakrs');
    showToast(`Rencana studi Semester ${sem} (Kelas ${kelas}, Peminatan ${peminatan}) berhasil diterapkan.`);
  }

  async function runAIGenerate() {
    const btn = document.getElementById('btnGenerateAI');
    const spanText = btn.querySelector('span');
    if (spanText) spanText.textContent = 'Menyusun Jadwal (AI)...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/generate', { method: 'POST' });
      const data = await res.json();
      document.getElementById('valTotalKonflik').textContent = '0 Bentrok';
      document.getElementById('subTotalKonflik').textContent = 'Hard constraints terpenuhi';
      showToast(data.result.message);
    } catch (err) {
      showToast('Gagal: ' + err.message);
    } finally {
      if (spanText) spanText.textContent = 'Generate Jadwal (AI)';
      btn.disabled = false;
    }
  }

  function openRevisiModal(id, matkul, hari, mulai, selesai, ruang) {
    document.getElementById('rev-id').value = id;
    document.getElementById('rev-matkul-label').textContent = matkul;
    document.getElementById('rev-hari').value = hari;
    document.getElementById('rev-mulai').value = mulai;
    document.getElementById('rev-selesai').value = selesai;
    document.getElementById('rev-ruang').value = ruang;
    openModal('modal-revisi-jadwal');
  }

  async function submitRevisiJadwal(e) {
    e.preventDefault();
    const id = Number(document.getElementById('rev-id').value);
    const hari = document.getElementById('rev-hari').value;
    const jamMulai = document.getElementById('rev-mulai').value;
    const jamSelesai = document.getElementById('rev-selesai').value;
    const ruang = document.getElementById('rev-ruang').value;

    try {
      const res = await fetch('/api/jadwal/revisi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, hari, jamMulai, jamSelesai, ruang })
      });
      const data = await res.json();
      if (!res.ok) return showToast(data.pesan);

      closeModal('modal-revisi-jadwal');
      showToast(data.pesan);
      setTimeout(() => location.reload(), 1000);
    } catch (err) {
      showToast('Gagal menyimpan revisi: ' + err.message);
    }
  }

  async function saveDosenPref(e) {
    e.preventDefault();
    const hariOff = document.getElementById('pref-hari-off').value;
    const alasan = document.getElementById('pref-alasan').value.trim();

    try {
      const res = await fetch('/api/constraints/preferensi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          dosenNama: 'Muhammad Abdul Haq, S.Tr.T., M.Eng. Ph.D.',
          hariOff,
          alasan
        })
      });
      const data = await res.json();
      if (!res.ok) return showToast(data.pesan);

      document.getElementById('dosenOffDayLabel').textContent = hariOff;
      document.getElementById('dosenOffReasonLabel').textContent = alasan;
      closeModal('modal-preferensi-dosen');
      showToast(data.pesan);
    } catch (err) {
      showToast('Gagal: ' + err.message);
    }
  }

  async function publishSchedule() {
    try {
      const res = await fetch('/api/jadwal/publish', { method: 'POST' });
      const data = await res.json();
      showToast(data.pesan || data.message);
    } catch (err) {
      showToast('Gagal publikasi: ' + err.message);
    }
  }

  async function testApiEndpoint(ep) {
    document.getElementById('sys-endpoint-url').textContent = ep;
    const jsonEl = document.getElementById('sys-json-output');
    const msEl = document.getElementById('sys-response-time');
    jsonEl.textContent = '// Memuat...';

    const t0 = performance.now();
    try {
      const res = await fetch(ep);
      const data = await res.json();
      const t1 = performance.now();
      msEl.textContent = (t1 - t0).toFixed(1) + ' ms';
      jsonEl.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      jsonEl.textContent = 'Error: ' + err.message;
    }
  }

  function copySysOutput() {
    const text = document.getElementById('sys-json-output').textContent;
    navigator.clipboard.writeText(text);
    showToast('JSON disalin ke clipboard.');
  }

  let tickerSeconds = 42 * 60 + 15;
  setInterval(() => {
    if (tickerSeconds > 0) {
      tickerSeconds--;
      const m = Math.floor(tickerSeconds / 60);
      const s = tickerSeconds % 60;
      const el = document.getElementById('countdownTicker');
      if (el) el.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} left`;
    }
  }, 1000);

  // Jalankan filter awal
  applyMahasiswaScheduleFilter();
</script>

