<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

  <!-- ==================== BANNER NOTIFIKASI PERUBAHAN JADWAL ==================== -->
  <div id="notifBanner" class="mb-6 bg-white rounded-2xl p-4 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
    <div class="flex items-start sm:items-center gap-3">
      <span class="px-2 py-1 rounded-lg bg-zinc-900 text-white font-mono font-bold text-[10px] uppercase tracking-wider shrink-0">
        Notifikasi TI UMY
      </span>
      <div>
        <div class="font-bold text-zinc-900" id="notifTitle">
          <%= notifikasiList[0] ? `${notifikasiList[0].kodeMatkul} — ${notifikasiList[0].mataKuliah}` : 'Sistem Jadwal Aktif' %>
        </div>
        <p class="text-zinc-500 mt-0.5" id="notifDesc">
          <%= notifikasiList[0] ? notifikasiList[0].perubahan : 'Belum ada perubahan jadwal baru.' %>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-3 self-end sm:self-center shrink-0">
      <span class="font-mono text-[11px] text-zinc-400 tabular-nums" id="notifTime">
        <%= notifikasiList[0] ? notifikasiList[0].waktu : '-' %>
      </span>
      <button onclick="openModal('modal-riwayat-notif')" class="btn-press px-3 py-1.5 rounded-xl bg-zinc-100 hover-surface text-zinc-800 font-semibold">
        Riwayat (<span id="notifCountBadge" class="tabular-nums"><%= notifikasiList.length %></span>)
      </button>
    </div>
  </div>

  <!-- ==================== PANEL 1: MAHASISWA (ANDI PRATAMA) ==================== -->
  <section id="view-mahasiswa" class="spa-view space-y-6">
    
    <!-- Header Banner Profil & Pra-KRS -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-medium mb-1">
          <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
          <span id="mhsSemesterText">Semester 4</span>
          <span>&middot;</span>
          <span id="mhsKelasBadge" class="px-2 py-0.5 rounded bg-zinc-100 font-bold text-zinc-900">Kelas B</span>
          <span>&middot;</span>
          <span id="mhsPeminatanBadge" class="px-2 py-0.5 rounded bg-zinc-900 text-white font-mono text-[11px]">Peminatan: Programming (PR)</span>
          <span>&middot;</span>
          <span id="mhsNimText" class="font-mono tabular-nums">NIM: 20240140093</span>
        </div>
        <h1 id="mhsGreeting" class="text-2xl font-bold tracking-tight text-zinc-900">
          Selamat Pagi, Andi Pratama
        </h1>
        <p class="text-xs text-zinc-500 mt-1">
          Jadwal perkuliahan TI UMY telah disinkronkan dengan 0 bentrok dosen dan ruangan.
        </p>
      </div>

      <div class="flex items-center space-x-2">
        <button onclick="openModal('modal-prakrs')" class="btn-press px-3.5 py-2 rounded-xl bg-zinc-100 hover-surface text-zinc-900 text-xs font-semibold flex items-center space-x-1.5">
          <svg class="w-3.5 h-3.5 text-zinc-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <span>Ubah Semester & Peminatan</span>
        </button>

        <button onclick="scrollToFullSchedule()" class="btn-press px-3.5 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-semibold flex items-center space-x-1.5">
          <span>Semua Sesi</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Active Class Card & Upcoming Queue -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Prominent Active Card (2 cols) -->
      <div class="lg:col-span-2 bg-white rounded-2xl p-6 sm:p-7 border border-app-border shadow-mac flex flex-col justify-between">
        <div>
          <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-zinc-100">
            <div class="flex items-center space-x-2">
              <span class="inline-block w-2 h-2 rounded-full bg-zinc-900"></span>
              <span class="text-xs font-bold text-zinc-900 uppercase tracking-wider">
                Sesi Berlangsung Sekarang
              </span>
            </div>

            <div class="flex items-center space-x-2">
              <span class="text-sm font-bold font-mono tabular-nums text-zinc-900">08:50 &ndash; 11:30</span>
              <span id="countdownTicker" class="px-2.5 py-1 rounded-lg bg-zinc-900 text-white font-mono tabular-nums text-xs font-bold">
                42:15 left
              </span>
            </div>
          </div>

          <div class="py-5">
            <div class="text-xs font-medium text-zinc-400 font-mono">TI501 &middot; 3 SKS &middot; Teori</div>
            <h2 class="text-2xl font-bold tracking-tight text-zinc-900 mt-1">
              Pengembangan Aplikasi Web
            </h2>
          </div>

          <div class="flex flex-wrap items-center gap-2 pt-2 text-xs">
            <div class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 border border-zinc-200">
              <span class="text-zinc-500">Kelas</span>
              <span class="font-bold text-zinc-900">B</span>
            </div>
            <div class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 border border-zinc-200">
              <span class="text-zinc-500">Ruang</span>
              <span class="font-bold text-zinc-900 font-mono">F6.003</span>
            </div>
            <div class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 border border-zinc-200">
              <span class="text-zinc-500">Dosen</span>
              <span class="font-semibold text-zinc-900">Ir. Asroni, S.T., M.Eng</span>
            </div>
          </div>
        </div>

        <div class="pt-6 mt-6 border-t border-zinc-100">
          <div class="flex justify-between text-xs text-zinc-500 font-medium mb-1.5">
            <span>Durasi Berjalan</span>
            <span class="font-bold text-zinc-900 tabular-nums">68%</span>
          </div>
          <div class="w-full bg-zinc-100 h-1.5 rounded-full overflow-hidden">
            <div class="bg-zinc-900 h-full rounded-full" style="width: 68%;"></div>
          </div>
        </div>
      </div>

      <!-- Paket Rencana Studi Semester Terpilih (KRS & Peminatan) -->
      <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-zinc-100 mb-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-500">
              Kurikulum Semester Aktif
            </h3>
            <span id="mhsTotalSksBadge" class="text-xs font-bold font-mono text-zinc-900">20 SKS</span>
          </div>

          <div id="mhsPlanContainer" class="space-y-2 max-h-60 overflow-y-auto text-xs pr-1">
            <% defaultMahasiswaMatkul.forEach(function(m) { %>
              <div class="p-2.5 rounded-xl bg-zinc-50 border border-zinc-200/80 flex items-center justify-between">
                <div>
                  <div class="font-bold text-zinc-900"><%= m.nama %></div>
                  <div class="font-mono text-[11px] text-zinc-500"><%= m.kode %> &middot; <%= m.kategori %></div>
                </div>
                <span class="font-mono font-bold text-zinc-700 tabular-nums shrink-0 ml-2"><%= m.sks %> SKS</span>
              </div>
            <% }); %>
          </div>
        </div>

        <button onclick="openModal('modal-prakrs')" class="w-full mt-4 py-2 rounded-xl bg-zinc-100 hover-surface text-xs font-semibold text-zinc-800 text-center">
          Sesuaikan Peminatan &rarr;
        </button>
      </div>

    </div>

    <!-- Complete Semester Timetable (Senin - Sabtu) -->
    <div id="fullScheduleTable" class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-zinc-100 gap-3">
        <div>
          <h3 class="text-lg font-bold tracking-tight text-zinc-900">
            Jadwal Perkuliahan Terpublikasi (111 Sesi TI UMY)
          </h3>
          <p class="text-xs text-zinc-500">
            Jadwal perkuliahan di Gedung F4 & F6 bebas bentrok dosen dan ruangan.
          </p>
        </div>

        <div class="flex items-center bg-zinc-100 p-1 rounded-xl text-xs font-semibold text-zinc-600 overflow-x-auto no-scrollbar">
          <button onclick="filterDay('Semua')" class="filter-day-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm whitespace-nowrap" data-day="Semua">
            Semua
          </button>
          <button onclick="filterDay('Senin')" class="filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Senin">
            Senin
          </button>
          <button onclick="filterDay('Selasa')" class="filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Selasa">
            Selasa
          </button>
          <button onclick="filterDay('Rabu')" class="filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Rabu">
            Rabu
          </button>
          <button onclick="filterDay('Kamis')" class="filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Kamis">
            Kamis
          </button>
          <button onclick="filterDay('Jumat')" class="filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Jumat">
            Jumat
          </button>
          <button onclick="filterDay('Sabtu')" class="filter-day-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap" data-day="Sabtu">
            Sabtu
          </button>
        </div>
      </div>

      <div id="mhsScheduleContainer" class="divide-y divide-zinc-100">
        <% jadwal.forEach(function(item) { %>
          <div class="schedule-item-row py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs" data-day="<%= item.hari %>" data-id="<%= item.id %>" data-kelas="<%= item.kelas %>" data-peminatan="<%= item.peminatanKode || '' %>">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-800 font-semibold text-[11px] row-hari">
                  <%= item.hari %>
                </span>
                <span class="font-mono tabular-nums font-bold text-zinc-900 row-jam">
                  <%= item.jamMulai %> &ndash; <%= item.jamSelesai %>
                </span>
                <span class="font-mono text-[11px] text-zinc-400">
                  <%= item.kodeMatkul %>
                </span>
                <% if (item.isPilihan) { %>
                  <span class="px-2 py-0.5 rounded bg-zinc-900 text-white font-mono text-[10px]">
                    MK Pilihan (<%= item.peminatanKode %>)
                  </span>
                <% } %>
                <% if (item.melewatiIstirahat) { %>
                  <span class="px-1.5 py-0.5 rounded border border-zinc-300 text-zinc-600 text-[10px]">
                    Jeda <%= item.melewatiIstirahat %>
                  </span>
                <% } %>
              </div>
              <div class="text-sm font-bold text-zinc-900">
                <%= item.mataKuliah %>
              </div>
              <div class="text-zinc-500">
                <%= item.dosen %>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 self-start sm:self-center">
              <span class="px-2.5 py-1 rounded-lg bg-zinc-50 border border-zinc-200 font-mono font-bold text-zinc-800 row-ruang">
                <%= item.ruang %> (<%= item.gedung %>)
              </span>
              <span class="px-2 py-1 rounded-lg bg-zinc-100 border border-zinc-200 font-bold text-zinc-900">
                Kelas <%= item.kelas %>
              </span>
              <span class="text-zinc-400 font-mono tabular-nums">
                <%= item.sks %> SKS
              </span>
            </div>
          </div>
        <% }); %>
      </div>

      <div id="emptyScheduleDay" class="hidden py-8 text-center text-xs text-zinc-500 bg-zinc-50 rounded-xl border border-dashed border-zinc-200">
        <p class="font-semibold text-zinc-800">Tidak ada perkuliahan pada filter yang dipilih.</p>
      </div>
    </div>

  </section>

  <!-- ==================== PANEL 2: STAF AKADEMIK ==================== -->
  <section id="view-akademik" class="spa-view hidden space-y-6">
    
    <!-- Top AI Generator Bar -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500 font-medium mb-1">
          <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
          <span>Panel Staf Akademik: Rina Wulandari</span>
          <span>&middot;</span>
          <span id="genStatusBadge" class="font-semibold text-zinc-900"><%= jadwalStatus.status %></span>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900">
          Otomatisasi Penjadwalan TI UMY (111 Sesi Pertemuan)
        </h2>
        <p class="text-xs text-zinc-500 mt-1">
          Sistem solver berbasis constraint menghasilkan 0 bentrok dosen & ruangan pada seluruh Gedung F4 & F6.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <button onclick="simulasiKonflik()" class="btn-press px-3 py-2.5 rounded-xl bg-zinc-100 hover-surface text-zinc-700 text-xs font-semibold">
          Uji Konflik
        </button>

        <button onclick="runAIGenerate()" id="btnGenerateAI" class="btn-press px-4 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-bold flex items-center space-x-2">
          <svg class="w-4 h-4 text-zinc-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          </svg>
          <span>Generate Jadwal (AI)</span>
        </button>

        <button onclick="publishSchedule()" class="btn-press px-3.5 py-2.5 rounded-xl bg-zinc-100 hover-surface text-zinc-900 text-xs font-semibold">
          Publikasikan
        </button>
      </div>
    </div>

    <!-- AI Quality Indicators -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Waktu Generate (M-01)</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums">&lt; 15 Menit</span>
        <span class="text-[11px] text-zinc-500">Real-time solver: 1.2 detik</span>
      </div>

      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Bentrok Dosen/Ruang (M-02)</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums" id="valTotalKonflik">0 Bentrok</span>
        <span class="text-[11px] text-zinc-500" id="subTotalKonflik">Hard constraints terpenuhi</span>
      </div>

      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Total Sesi Terjadwal</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums"><%= jadwal.length %> Sesi</span>
        <span class="text-[11px] text-zinc-500">Gedung F4 & F6</span>
      </div>

      <div class="bg-white p-4 rounded-xl border border-app-border shadow-mac text-xs">
        <span class="text-zinc-400 font-medium block">Preferensi Dosen (M-04)</span>
        <span class="text-lg font-bold text-zinc-900 mt-0.5 block tabular-nums">92.4%</span>
        <span class="text-[11px] text-zinc-500">Target &ge; 85% terlampaui</span>
      </div>
    </div>

    <!-- Preview & Filter Jadwal Multi-Dimensi -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4 text-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-zinc-100">
        <div>
          <h3 class="text-lg font-bold tracking-tight text-zinc-900">
            Preview & Filter Jadwal Perkuliahan
          </h3>
          <p class="text-xs text-zinc-500">
            Filter multi-dimensi per dosen, ruang F4/F6, atau kelas.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <input id="previewFilterDosen" type="text" placeholder="Cari dosen / inisial..." oninput="applyPreviewFilter()" class="py-1.5 px-3 rounded-xl border border-zinc-300 bg-zinc-50 text-xs w-36">
          <select id="previewFilterRuang" onchange="applyPreviewFilter()" class="py-1.5 px-3 rounded-xl border border-zinc-300 bg-zinc-50 text-xs font-medium">
            <option value="">Semua Ruangan</option>
            <% ruanganList.forEach(function(r) { %>
              <option value="<%= r.kode %>"><%= r.kode %> (<%= r.gedung %>)</option>
            <% }); %>
          </select>
          <select id="previewFilterKelas" onchange="applyPreviewFilter()" class="py-1.5 px-3 rounded-xl border border-zinc-300 bg-zinc-50 text-xs font-medium">
            <option value="">Semua Kelas</option>
            <option value="A">Kelas A</option>
            <option value="B">Kelas B</option>
            <option value="C">Kelas C</option>
            <option value="D">Kelas D</option>
            <option value="E">Kelas E</option>
            <option value="F">Kelas F</option>
          </select>
        </div>
      </div>

      <div class="overflow-x-auto max-h-96">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 text-zinc-600 font-bold border-b border-zinc-200 sticky top-0">
            <tr>
              <th class="p-3">Hari & Jam</th>
              <th class="p-3">Mata Kuliah</th>
              <th class="p-3">Dosen</th>
              <th class="p-3">Kelas</th>
              <th class="p-3">Ruangan</th>
              <th class="p-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="previewTableBody" class="divide-y divide-zinc-100">
            <% jadwal.forEach(function(item) { %>
              <tr class="preview-row hover:bg-zinc-50/50" data-id="<%= item.id %>" data-dosen="<%= item.dosen.toLowerCase() %> <%= item.dosenInisial.toLowerCase() %>" data-ruang="<%= item.ruang.toLowerCase() %>" data-kelas="<%= item.kelas.toLowerCase() %>">
                <td class="p-3 font-mono tabular-nums whitespace-nowrap">
                  <span class="font-bold text-zinc-900 preview-hari"><%= item.hari %></span>
                  <span class="text-zinc-500 ml-1 preview-jam"><%= item.jamMulai %>&ndash;<%= item.jamSelesai %></span>
                </td>
                <td class="p-3">
                  <span class="font-bold text-zinc-900"><%= item.mataKuliah %></span>
                  <span class="text-zinc-400 font-mono ml-1">(<%= item.kodeMatkul %>)</span>
                </td>
                <td class="p-3 text-zinc-700"><%= item.dosen %></td>
                <td class="p-3 font-bold text-zinc-900"><%= item.kelas %></td>
                <td class="p-3 font-mono font-semibold text-zinc-900 preview-ruang"><%= item.ruang %></td>
                <td class="p-3 text-right">
                  <button onclick="openRevisiModal('<%= item.id %>', '<%= item.mataKuliah %>', '<%= item.hari %>', '<%= item.jamMulai %>', '<%= item.jamSelesai %>', '<%= item.ruang %>')" class="btn-press px-2.5 py-1 rounded-lg bg-zinc-100 hover-surface text-zinc-800 font-semibold">
                    Ubah
                  </button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Master Data Management Tables: Dosen, Kurikulum Semester 1-8, Peminatan, Ruangan -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-zinc-100 gap-3">
        <div>
          <h3 class="text-lg font-bold tracking-tight text-zinc-900">
            Data Master Kurikulum & Akademik TI UMY
          </h3>
          <p class="text-xs text-zinc-500">
            Total <%= masterSummary.totalDosen %> Dosen Riil, <%= masterSummary.totalMatkul %> Kurikulum Sem 1-8, <%= masterSummary.totalPeminatan %> MK Pilihan Peminatan, dan <%= masterSummary.totalRuangan %> Ruangan.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center bg-zinc-100 p-1 rounded-xl text-xs font-semibold text-zinc-600">
            <button onclick="switchMasterTab('kurikulum')" id="m-tab-kurikulum" class="master-tab-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm">
              Kurikulum Sem 1-8 (<%= masterSummary.totalMatkul %>)
            </button>
            <button onclick="switchMasterTab('peminatan')" id="m-tab-peminatan" class="master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900">
              Peminatan (<%= masterSummary.totalPeminatan %>)
            </button>
            <button onclick="switchMasterTab('dosen')" id="m-tab-dosen" class="master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900">
              Dosen (<%= masterSummary.totalDosen %>)
            </button>
            <button onclick="switchMasterTab('ruangan')" id="m-tab-ruangan" class="master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900">
              Ruangan (<%= masterSummary.totalRuangan %>)
            </button>
          </div>
        </div>
      </div>

      <!-- Master Subtable: Kurikulum Semester 1-8 -->
      <div id="subtable-kurikulum" class="master-subtable overflow-x-auto max-h-96">
        <table class="w-full text-left text-xs">
