<%- include('partials/head', { judul: typeof judul !=='undefined' ? judul
  : 'Jadwalin — Jadwal Kuliah TI UMY Bebas Bentrok' }) %>
  <%- include('partials/navbar') %>

    <!-- ==================== ANIMATED BRAND AURORA HERO SECTION ==================== -->
    <section class="relative hero-cosmic-aurora border-b border-zinc-200/80 dark:border-zinc-800/80 py-16 sm:py-24 overflow-hidden transition-colors">
      <!-- Glow Aurora Blobs: Deep Navy Blue (Left) & Amber Gold (Right) -->
      <div class="aurora-blob-blue"></div>
      <div class="aurora-blob-yellow"></div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-6">

        <!-- Academic Badge (Badge Elegan) -->
        <div
          class="inline-flex items-center gap-2 rounded-full border border-blue-200/80 bg-blue-50/80 px-4 py-1.5 text-xs font-semibold text-blue-900 dark:border-blue-800/60 dark:bg-blue-950/75 dark:text-blue-200 shadow-xs backdrop-blur-md">
          <span class="rounded bg-amber-100 px-2 py-0.5 text-[10px] font-mono font-bold text-amber-900 border border-amber-300/60 dark:bg-amber-400/20 dark:text-amber-300 dark:border-amber-400/30">
            <%= typeof appVersion !== 'undefined' ? appVersion : 'v.21' %>
          </span>
          <span class="text-blue-900 dark:text-blue-200">Bebas Tabrakan Ruang & Dosen</span>
        </div>

        <!-- Punchy Headline with Brand Colors & Wavy Underline -->
        <div class="space-y-3">
          <h1
            class="font-heading text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-zinc-900 dark:text-white leading-tight">
            Temukan Jadwal Kuliahmu <br class="hidden sm:inline">
            Secara <span class="relative inline-block text-amber-600 dark:text-amber-400 font-extrabold whitespace-nowrap">
              Instan & Pasti
              <!-- Garis Meliuk-Liuk (Wavy Underline) -->
              <svg class="absolute -bottom-2.5 left-0 w-full h-3 text-amber-500 dark:text-amber-400 overflow-visible" viewBox="0 0 120 12"
                fill="none" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 7C18 1 32 13 48 7C64 1 78 13 94 7C104 3 112 5 118 7" stroke="currentColor" stroke-width="3.5"
                  stroke-linecap="round" />
              </svg>
            </span>.
          </h1>
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 max-w-2xl mx-auto leading-relaxed">
            Distribusi jadwal kuliah resmi Prodi Teknologi Informasi UMY. Masuk ke akun civitas untuk melihat jadwal perkuliahan, pengisian Pra-KRS, dan pengelolaan akademik.
          </p>
        </div>

        <!-- Hero CTA Actions (Least Privilege: Akses Jadwal & Pra-KRS melalui Login) -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
          <a href="/login"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-[#0c2b5e] hover:bg-[#081d40] px-6 py-2.5 text-xs sm:text-sm font-semibold text-white shadow-md border border-blue-900/40 transition-all">
            <i class="ph ph-sign-in text-base text-amber-400"></i>
            <span>Masuk Sistem</span>
          </a>
          <a href="/info"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-zinc-200 bg-white/90 hover:bg-zinc-50 px-5 py-2.5 text-xs sm:text-sm font-semibold text-zinc-800 dark:border-zinc-700 dark:bg-zinc-900/90 dark:text-zinc-100 dark:hover:bg-zinc-800 shadow-xs transition-all">
            <i class="ph ph-book-open text-base text-amber-500"></i>
            <span>Panduan Akademik</span>
          </a>
        </div>

      </div>
    </section>

    <%- include('partials/footer') %>