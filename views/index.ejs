    <!-- Client-side Interactive Filter Script for Search Bar & Filters -->
    <script>
      (function () {
        const input = document.getElementById('quick-search-input');
        const clearBtn = document.getElementById('quick-clear-btn');
        const dayBtns = document.querySelectorAll('.filter-day-btn');
        const classSelect = document.getElementById('filter-kelas-select');
        const ruangSelect = document.getElementById('filter-ruang-select');
        const peminatanSelect = document.getElementById('filter-peminatan-select');
        const cards = document.querySelectorAll('.schedule-card');
        const countBadge = document.getElementById('result-count-badge');
        const emptyState = document.getElementById('schedule-empty-state');
        const resetBtn = document.getElementById('btn-reset-filter');

        let activeDay = '';
        let activeClass = 'B';
        let activeRuang = '';
        let activePeminatan = '';

        function filterCards() {
          const q = (input.value || '').trim().toLowerCase();
          if (clearBtn) {
            clearBtn.classList.toggle('hidden', q.length === 0);
          }

          let visibleCount = 0;
          cards.forEach(card => {
            const cardDay = card.getAttribute('data-day') || '';
            const cardClass = card.getAttribute('data-class') || '';
            const cardRuang = card.getAttribute('data-ruang') || '';
            const cardPeminatan = card.getAttribute('data-peminatan') || '';
            const cardSearch = card.getAttribute('data-search') || '';

            const matchDay = !activeDay || cardDay === activeDay;
            const matchClass = !activeClass || cardClass === activeClass;
            const matchRuang = !activeRuang || cardRuang === activeRuang;
            const matchPeminatan = !activePeminatan || cardPeminatan === activePeminatan;
            const matchQuery = !q || cardSearch.includes(q);

            if (matchDay && matchClass && matchRuang && matchPeminatan && matchQuery) {
              card.classList.remove('hidden');
              visibleCount++;
            } else {
              card.classList.add('hidden');
            }
          });

          if (countBadge) {
            countBadge.textContent = `${visibleCount} Sesi Ditemukan`;
          }

          if (emptyState) {
            emptyState.classList.toggle('hidden', visibleCount > 0);
          }
        }

        if (input) input.addEventListener('input', filterCards);
        if (clearBtn) clearBtn.addEventListener('click', () => {
          input.value = '';
          filterCards();
          input.focus();
        });

        const activeDayBtnClass = 'filter-day-btn px-3.5 py-1.5 rounded-md text-xs font-bold bg-[#0c2b5e] text-white dark:bg-white dark:text-zinc-950 shadow-xs transition-colors shrink-0';
        const inactiveDayBtnClass = 'filter-day-btn px-3 py-1.5 rounded-md text-xs font-medium text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:text-white dark:hover:bg-zinc-800 transition-colors shrink-0';

        dayBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            dayBtns.forEach(b => {
              b.className = inactiveDayBtnClass;
            });
            btn.className = activeDayBtnClass;
            activeDay = btn.getAttribute('data-filter-day');
            filterCards();
          });
        });

        if (classSelect) {
          classSelect.addEventListener('change', (e) => {
            activeClass = e.target.value;
            filterCards();
          });
        }

        if (ruangSelect) {
          ruangSelect.addEventListener('change', (e) => {
            activeRuang = e.target.value;
            filterCards();
          });
        }

        if (peminatanSelect) {
          peminatanSelect.addEventListener('change', (e) => {
            activePeminatan = e.target.value;
            filterCards();
          });
        }

        if (resetBtn) {
          resetBtn.addEventListener('click', () => {
            if (input) input.value = '';
            activeDay = '';
            activeClass = '';
            activeRuang = '';
            activePeminatan = '';
            if (classSelect) classSelect.value = '';
            if (ruangSelect) ruangSelect.value = '';
            if (peminatanSelect) peminatanSelect.value = '';
            dayBtns.forEach((b, idx) => {
              if (idx === 0) {
                b.className = activeDayBtnClass;
              } else {
                b.className = inactiveDayBtnClass;
              }
            });
            filterCards();
          });
        }

        // Trigger initial filter
        filterCards();
      })();
    </script>

