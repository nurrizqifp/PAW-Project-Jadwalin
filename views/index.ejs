<%- include('partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Jadwalin — AI Powered Smart Course Scheduling TI UMY' }) %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-12">

  <!-- ==================== HERO SECTION ==================== -->
  <section class="text-center max-w-3xl mx-auto space-y-5">
    <div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-white px-3 py-1 text-xs font-medium text-zinc-700 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-mono text-[11px]">Semester Ganjil 2026/2027</span>
      <span class="text-zinc-300 dark:text-zinc-700">·</span>
      <span>Kurikulum TI UMY</span>
    </div>

    <h1 class="font-heading text-4xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight">
      Sistem Penjadwalan Kuliah Cerdas & Bebas Bentrok
    </h1>

    <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
      Platform terintegrasi untuk mahasiswa, dosen, dan staf akademik Program Studi Teknologi Informasi FT UMY. Ditenagai optimasi kombinatorial AI untuk menjamin jadwal tanpa tabrakan dosen maupun ruangan.
    </p>

    <!-- Quick CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a href="/login" class="inline-flex min-h-[44px] items-center gap-2 rounded-md bg-zinc-900 px-6 py-2.5 text-xs font-semibold text-white shadow-sm hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-all">
        <i class="ph ph-sign-in text-base"></i>
        <span>Masuk ke Akun</span>
      </a>
      <a href="/mahasiswa/jadwal" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-zinc-200 bg-white px-5 py-2.5 text-xs font-semibold text-zinc-800 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-all">
        <i class="ph ph-calendar text-base"></i>
        <span>Lihat Jadwal Kuliah</span>
      </a>
      <a href="/mahasiswa/prakrs" class="inline-flex min-h-[44px] items-center gap-2 rounded-md border border-zinc-200 bg-white px-5 py-2.5 text-xs font-semibold text-zinc-800 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-all">
        <i class="ph ph-sparkle text-base"></i>
        <span>Simulasi Pra-KRS</span>
      </a>
    </div>
  </section>

  <!-- ==================== THREE ROLE PORTAL CARDS ==================== -->
  <section class="space-y-4">
    <div class="text-center space-y-1">
      <h2 class="font-heading text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Pilih Portal Berdasarkan Peran Civitas
      </h2>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">
        Navigasi terpisah yang disesuaikan dengan kebutuhan alur kerja setiap pengguna akademik.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">

      <!-- 1. Portal Mahasiswa -->
      <div class="group rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-zinc-100 text-zinc-900 group-hover:bg-zinc-900 group-hover:text-white dark:bg-zinc-800 dark:text-zinc-100 dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-900 transition-colors">
            <i class="ph ph-student text-2xl"></i>
          </div>
          <div>
            <span class="font-mono text-[11px] font-semibold text-zinc-400 uppercase tracking-wider">Peran Mahasiswa</span>
            <h3 class="font-heading text-lg font-bold text-zinc-900 dark:text-zinc-100 pt-0.5">Portal Mahasiswa</h3>
          </div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Akses jadwal kuliah mingguan, pantau countdown sesi aktif harian, isi formulir Pra-KRS fleksibel, dan dapatkan notifikasi perubahan ruangan.
          </p>
          <ul class="space-y-1.5 text-xs text-zinc-500 dark:text-zinc-400 pt-1">
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Countdown sesi kuliah aktif (Live)</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Tampilan Grid Mingguan & Agenda Harian</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Wizard Pra-KRS bebas tabrakan</span>
            </li>
          </ul>
        </div>

        <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800">
          <a href="/mahasiswa/dashboard" class="inline-flex w-full min-h-[40px] items-center justify-center gap-2 rounded-md bg-zinc-900 px-4 py-2 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors">
            <span>Buka Dashboard Mahasiswa</span>
            <i class="ph ph-arrow-right text-sm"></i>
          </a>
        </div>
      </div>

      <!-- 2. Portal Dosen -->
      <div class="group rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-zinc-100 text-zinc-900 group-hover:bg-zinc-900 group-hover:text-white dark:bg-zinc-800 dark:text-zinc-100 dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-900 transition-colors">
            <i class="ph ph-chalkboard-teacher text-2xl"></i>
          </div>
          <div>
            <span class="font-mono text-[11px] font-semibold text-zinc-400 uppercase tracking-wider">Peran Dosen</span>
            <h3 class="font-heading text-lg font-bold text-zinc-900 dark:text-zinc-100 pt-0.5">Portal Dosen</h3>
          </div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Tinjau alokasi jadwal mengajar personal, ajukan preferensi hari/waktu berhalangan (soft constraints), dan koordinasikan sesi perkuliahan.
          </p>
          <ul class="space-y-1.5 text-xs text-zinc-500 dark:text-zinc-400 pt-1">
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Jadwal mengajar personal & beban SKS</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Formulir preferensi waktu berhalangan</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Pusat notifikasi pergeseran jadwal</span>
            </li>
          </ul>
        </div>

        <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800">
          <a href="/dosen/dashboard" class="inline-flex w-full min-h-[40px] items-center justify-center gap-2 rounded-md border border-zinc-200 bg-white px-4 py-2 text-xs font-semibold text-zinc-800 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors">
            <span>Buka Portal Dosen</span>
            <i class="ph ph-arrow-right text-sm"></i>
          </a>
        </div>
      </div>

      <!-- 3. Panel Admin Akademik -->
      <div class="group rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 transition-all flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-zinc-100 text-zinc-900 group-hover:bg-zinc-900 group-hover:text-white dark:bg-zinc-800 dark:text-zinc-100 dark:group-hover:bg-zinc-100 dark:group-hover:text-zinc-900 transition-colors">
            <i class="ph ph-shield-check text-2xl"></i>
          </div>
          <div>
            <span class="font-mono text-[11px] font-semibold text-zinc-400 uppercase tracking-wider">Peran Staf Akademik</span>
            <h3 class="font-heading text-lg font-bold text-zinc-900 dark:text-zinc-100 pt-0.5">Panel Staf Akademik</h3>
          </div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Kelola master data dosen, matkul, ruangan, konfigurasikan aturan hard/soft constraints (jeda Dhuhur HC-03), dan jalankan AI Generator solver.
          </p>
          <ul class="space-y-1.5 text-xs text-zinc-500 dark:text-zinc-400 pt-1">
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>CRUD Dosen, Matkul, Ruangan, Mahasiswa</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Penegakan jeda Dhuhur (11:30 - 12:10)</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="ph ph-check text-emerald-600 text-sm"></i>
              <span>Gemini AI Solver & Matriks Publikasi</span>
            </li>
          </ul>
        </div>

        <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800">
          <a href="/admin/dashboard" class="inline-flex w-full min-h-[40px] items-center justify-center gap-2 rounded-md border border-zinc-200 bg-white px-4 py-2 text-xs font-semibold text-zinc-800 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors">
            <span>Buka Panel Admin</span>
            <i class="ph ph-arrow-right text-sm"></i>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== SYSTEM KEY METRICS ==================== -->
  <section class="rounded-2xl border border-zinc-200 bg-zinc-50/75 p-6 sm:p-8 dark:border-zinc-800 dark:bg-zinc-900/40">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div class="space-y-1">
        <p class="font-mono text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">21</p>
        <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">Dosen Pengampu TI</p>
      </div>
      <div class="space-y-1">
        <p class="font-mono text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">77</p>
        <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">Mata Kuliah Aktif</p>
      </div>
      <div class="space-y-1">
        <p class="font-mono text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">12</p>
        <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">Ruangan & Lab Komputer</p>
      </div>
      <div class="space-y-1">
        <p class="font-mono text-3xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400">Zero Clash</p>
        <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">100% Kepatuhan HC</p>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
