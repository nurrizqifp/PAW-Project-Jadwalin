<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">

  <!-- ==================== VIEW 1: JADWAL KULIAH (DEFAULT SPA PANEL) ==================== -->
  <section id="view-jadwal" class="spa-view space-y-6">
    
    <!-- Top Bar: Greeting & AI Affirmation -->
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center space-x-2 text-xs text-zinc-500 font-medium mb-1">
          <span class="w-2 h-2 rounded-full bg-zinc-900"></span>
          <span>Semester 4</span>
          <span>&middot;</span>
          <span>Senin, 08:50 WIB</span>
        </div>
        <h1 id="userGreeting" class="text-2xl font-bold tracking-tight text-zinc-900">
          Selamat Pagi, Andi Pratama
        </h1>
        <p class="text-xs text-zinc-500 mt-1">
          Jadwal kamu saat ini. Semua sesi hari ini telah diverifikasi tanpa bentrok.
        </p>
      </div>

      <!-- Quick Controls -->
      <div class="flex items-center space-x-2">
        <button onclick="switchView('view-prakrs')" class="px-3.5 py-2 rounded-xl bg-zinc-100 hover:bg-zinc-200 text-zinc-900 text-xs font-semibold transition-all flex items-center space-x-1.5 active:scale-[0.98]">
          <svg class="w-3.5 h-3.5 text-zinc-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span>Atur Pra-KRS</span>
        </button>

        <button onclick="scrollToScheduleTable()" class="px-3.5 py-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-semibold transition-all flex items-center space-x-1.5 active:scale-[0.98]">
          <span>Semua Sesi</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Active Class Card (Apple Style) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Primary Card (2 cols) -->
      <div class="lg:col-span-2 bg-white rounded-2xl p-6 sm:p-7 border border-app-border shadow-mac flex flex-col justify-between">
        <div>
          <!-- Header -->
          <div class="flex items-center justify-between pb-4 border-b border-zinc-100">
            <div class="flex items-center space-x-2">
              <span class="inline-block w-2 h-2 rounded-full bg-zinc-900 animate-pulse"></span>
              <span class="text-xs font-bold text-zinc-900 uppercase tracking-wider">
                Sesi Berlangsung
              </span>
            </div>

            <!-- Monospaced Countdown -->
            <div class="flex items-center space-x-2">
              <span class="text-sm font-bold font-mono text-zinc-900">08:50 &ndash; 11:30</span>
              <span id="countdownPill" class="px-2.5 py-1 rounded-lg bg-zinc-900 text-white font-mono text-xs font-bold">
                42:15 left
              </span>
            </div>
          </div>

          <!-- Course Title -->
          <div class="py-5">
            <div class="text-xs font-medium text-zinc-400 font-mono">TI401 &middot; 3 SKS</div>
            <h2 class="text-2xl font-bold tracking-tight text-zinc-900 mt-1">
              Pengembangan Aplikasi Web
            </h2>
          </div>

          <!-- Meta Pill Tags -->
          <div class="flex flex-wrap items-center gap-2 pt-2 text-xs">
            <!-- Class Badge -->
            <div class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 border border-zinc-200">
              <span class="text-zinc-500">Kelas</span>
              <span class="font-bold text-zinc-900">B</span>
            </div>

            <!-- Room Badge -->
            <div class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 border border-zinc-200">
              <span class="text-zinc-500">Ruang</span>
              <span class="font-bold text-zinc-900 font-mono">F6.003</span>
            </div>

            <!-- Lecturer Badge -->
            <div class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-zinc-100 border border-zinc-200">
              <span class="text-zinc-500">Dosen</span>
              <span class="font-semibold text-zinc-900">Ir. Asroni, S.T., M.Eng.</span>
            </div>
          </div>
        </div>

        <!-- Duration Progress Bar -->
        <div class="pt-6 mt-6 border-t border-zinc-100">
          <div class="flex justify-between text-xs text-zinc-500 font-medium mb-1.5">
            <span>Durasi Berjalan</span>
            <span class="font-bold text-zinc-900">68%</span>
          </div>
          <div class="w-full bg-zinc-100 h-1.5 rounded-full overflow-hidden">
            <div class="bg-zinc-900 h-full rounded-full transition-all" style="width: 68%;"></div>
          </div>
        </div>
      </div>

      <!-- Secondary Next Queue (1 col) -->
      <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-zinc-100 mb-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-500">
              Sesi Hari Ini Berikutnya
            </h3>
            <span class="text-xs font-bold text-zinc-900">2 Sesi</span>
          </div>

          <div class="space-y-3">
            <div class="p-3.5 rounded-xl bg-zinc-50 border border-zinc-200/80 text-xs">
              <div class="flex justify-between items-baseline mb-1">
                <span class="font-mono font-bold text-zinc-900">13:20 &ndash; 15:00</span>
                <span class="font-semibold text-zinc-500">Kelas A</span>
              </div>
              <div class="font-bold text-zinc-900 text-sm">Pengembangan Web Service</div>
              <div class="text-zinc-500 mt-1">Dr. Ir. Dwijoko Purbohadi &middot; F6.003</div>
            </div>

            <div class="p-3.5 rounded-xl bg-zinc-50 border border-zinc-200/80 text-xs">
              <div class="flex justify-between items-baseline mb-1">
                <span class="font-mono font-bold text-zinc-900">16:20 &ndash; 18:00</span>
                <span class="font-semibold text-zinc-500">Kelas C</span>
              </div>
              <div class="font-bold text-zinc-900 text-sm">WAN dan Teknologi Jaringan</div>
              <div class="text-zinc-500 mt-1">Ir. Eko Prasetyo &middot; Lab F6.004</div>
            </div>
          </div>
        </div>

        <button onclick="scrollToScheduleTable()" class="w-full mt-4 py-2 text-xs font-semibold text-zinc-600 hover:text-zinc-900 text-center transition-colors">
          Lihat Seluruh Tabel Sesi &darr;
        </button>
      </div>

    </div>

    <!-- Complete Schedule Table -->
    <div id="scheduleTableSection" class="bg-white rounded-2xl p-6 border border-app-border shadow-mac space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-zinc-100 gap-3">
        <div>
          <h3 class="text-lg font-bold tracking-tight text-zinc-900">
            Daftar Sesi Kuliah Semester
          </h3>
          <p class="text-xs text-zinc-500">
            Seluruh mata kuliah telah terpetakan tanpa konflik ruangan dan waktu.
          </p>
        </div>

        <!-- Minimal Day Filter -->
        <div class="flex items-center bg-zinc-100 p-1 rounded-xl text-xs font-semibold text-zinc-600">
          <button onclick="filterDay('Semua')" class="filter-day-pill px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm" data-day="Semua">
            Semua
          </button>
          <button onclick="filterDay('Senin')" class="filter-day-pill px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900" data-day="Senin">
            Senin
          </button>
          <button onclick="filterDay('Selasa')" class="filter-day-pill px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900" data-day="Selasa">
            Selasa
          </button>
          <button onclick="filterDay('Rabu')" class="filter-day-pill px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900" data-day="Rabu">
            Rabu
          </button>
          <button onclick="filterDay('Kamis')" class="filter-day-pill px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900" data-day="Kamis">
            Kamis
          </button>
        </div>
      </div>

      <!-- Schedule Cards -->
      <div class="divide-y divide-zinc-100">
        <% jadwal.forEach(function(item) { %>
          <div class="session-row py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs" data-day="<%= item.hari %>">
            <div class="space-y-1">
              <div class="flex items-center space-x-2">
                <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-800 font-semibold text-[11px]">
                  <%= item.hari %>
                </span>
                <span class="font-mono font-bold text-zinc-900">
                  <%= item.jamMulai %> &ndash; <%= item.jamSelesai %>
                </span>
                <% if (item.isActiveNow) { %>
                  <span class="px-2 py-0.5 rounded bg-zinc-900 text-white font-bold text-[10px]">
                    Aktif
                  </span>
                <% } %>
              </div>
              <div class="text-sm font-bold text-zinc-900">
                <%= item.mataKuliah %>
              </div>
              <div class="text-zinc-500">
                <%= item.dosen %>
              </div>
            </div>

            <div class="flex items-center space-x-3 self-start sm:self-center">
              <span class="px-2.5 py-1 rounded-lg bg-zinc-50 border border-zinc-200 font-mono font-bold text-zinc-800">
                Ruang <%= item.ruang %>
              </span>
              <span class="w-6 h-6 rounded-lg bg-zinc-100 border border-zinc-200 font-bold flex items-center justify-center text-zinc-900">
                <%= item.kelas %>
              </span>
              <span class="text-zinc-400 font-mono">
                <%= item.sks %> SKS
              </span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

  </section>

  <!-- ==================== VIEW 2: ONBOARDING & PRA-KRS ==================== -->
  <section id="view-prakrs" class="spa-view hidden space-y-6">
    <div class="bg-white rounded-2xl p-6 sm:p-8 border border-app-border shadow-mac max-w-2xl mx-auto">
      
      <div class="pb-4 border-b border-zinc-100 mb-6">
        <h2 class="text-xl font-bold tracking-tight text-zinc-900">
          Preferensi & Pra-KRS Mahasiswa
        </h2>
        <p class="text-xs text-zinc-500 mt-1">
          Konfigurasi semester, angkatan, identitas NIM, dan pemilihan mata kuliah terverifikasi AI.
        </p>
      </div>

      <form id="prakrsForm" onsubmit="handlePrakrsSubmit(event)" class="space-y-5 text-xs">
        
        <!-- 1. Semester Picker (Stepper 1-12) -->
        <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/80 space-y-2">
          <label class="block font-bold text-zinc-900">
            1. Semester Berjalan
          </label>
          <p class="text-zinc-500">Pilih rentang semester aktif 1 sampai 12.</p>
          
          <div class="flex items-center space-x-2 pt-1">
            <button type="button" onclick="stepSemester(-1)" class="w-9 h-9 rounded-lg bg-white border border-zinc-300 font-bold text-zinc-800 hover:bg-zinc-100 active:scale-95 transition-all">-</button>
            <input id="form-semester" type="number" min="1" max="12" value="4" required class="w-20 text-center font-bold text-sm py-2 rounded-lg border border-zinc-300 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900">
            <button type="button" onclick="stepSemester(1)" class="w-9 h-9 rounded-lg bg-white border border-zinc-300 font-bold text-zinc-800 hover:bg-zinc-100 active:scale-95 transition-all">+</button>
            <span class="text-zinc-500 font-medium ml-2">Semester</span>
          </div>
        </div>

        <!-- 2. Angkatan Picker -->
        <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/80 space-y-2">
          <label class="block font-bold text-zinc-900">
            2. Tahun Angkatan
          </label>
          <input id="form-angkatan" type="number" min="2018" max="2026" value="2024" class="w-36 font-semibold py-2 px-3 rounded-lg border border-zinc-300 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900" oninput="updateNimString()">
        </div>

        <!-- 3. Nama & NIM -->
        <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/80 space-y-3">
          <label class="block font-bold text-zinc-900">
            3. Identitas Pengguna
          </label>
          
          <div>
            <label class="block text-zinc-500 mb-1">Nama Lengkap (Otomatis Kapital):</label>
            <input id="form-nama" type="text" value="ANDI PRATAMA" required class="w-full uppercase font-bold py-2 px-3 rounded-lg border border-zinc-300 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900" oninput="this.value = this.value.toUpperCase()">
          </div>

          <div>
            <label class="block text-zinc-500 mb-1">3 Digit Terakhir NIM:</label>
            <div class="flex items-center space-x-2">
              <span id="nim-prefix-display" class="font-mono font-bold bg-zinc-200 px-3 py-2 rounded-lg text-zinc-700">20240140</span>
              <input id="form-nim-suffix" type="text" maxlength="3" value="093" required class="w-20 font-mono font-bold text-center py-2 px-3 rounded-lg border border-zinc-300 bg-white focus:outline-none focus:ring-1 focus:ring-zinc-900" oninput="this.value = this.value.replace(/[^0-9]/g, ''); updateNimString()">
            </div>
          </div>
        </div>

        <!-- 4. Pra-KRS Matrix -->
        <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/80 space-y-3">
          <label class="block font-bold text-zinc-900">
            4. Pemetaan Pra-KRS & Saran Kelas AI
          </label>
          
          <div class="bg-white rounded-lg border border-zinc-200 overflow-hidden">
            <table class="w-full text-left text-xs">
              <thead class="bg-zinc-100 text-zinc-700 font-bold">
                <tr>
                  <th class="p-2.5">Ambil</th>
                  <th class="p-2.5">Mata Kuliah</th>
                  <th class="p-2.5">Rekomendasi Sesi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100">
                <tr>
                  <td class="p-2.5"><input type="checkbox" checked class="w-4 h-4 rounded text-zinc-900"></td>
                  <td class="p-2.5 font-semibold text-zinc-900">Pengembangan Aplikasi Web</td>
                  <td class="p-2.5 text-zinc-600 font-mono">Kelas B &middot; F6.003</td>
                </tr>
                <tr>
                  <td class="p-2.5"><input type="checkbox" checked class="w-4 h-4 rounded text-zinc-900"></td>
                  <td class="p-2.5 font-semibold text-zinc-900">Pengembangan Web Service</td>
                  <td class="p-2.5 text-zinc-600 font-mono">Kelas A &middot; F6.003</td>
                </tr>
                <tr>
                  <td class="p-2.5"><input type="checkbox" checked class="w-4 h-4 rounded text-zinc-900"></td>
                  <td class="p-2.5 font-semibold text-zinc-900">WAN dan Teknologi Jaringan</td>
                  <td class="p-2.5 text-zinc-600 font-mono">Kelas C &middot; Lab F6.004</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <button type="submit" class="w-full py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white font-bold text-xs transition-all active:scale-[0.98]">
          Simpan Preferensi & Update Jadwal
        </button>

        <div id="prakrs-alert" class="hidden p-3 rounded-lg text-xs font-medium"></div>

      </form>
    </div>
  </section>

  <!-- ==================== VIEW 3: MODUL & LAYANAN (DATA DARI MODEL BACKEND) ==================== -->
  <section id="view-modul" class="spa-view hidden space-y-6">
    
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-zinc-900">
          Modul & Layanan Sistem
        </h2>
        <p class="text-xs text-zinc-500 mt-0.5">
          Data modul berikut dikelola langsung dari backend <code class="font-mono text-[11px] bg-zinc-100 px-1 py-0.5 rounded">models/produkModel.js</code>.
        </p>
      </div>

      <div class="flex items-center space-x-2">
        <input type="text" id="filterModulInput" oninput="filterModulList()" placeholder="Cari modul..." class="text-xs px-3 py-1.5 rounded-lg border border-zinc-300 focus:outline-none focus:ring-1 focus:ring-zinc-900 w-44">
        <a href="/api/produk" target="_blank" class="px-3 py-1.5 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-900 text-xs font-semibold transition-colors">
          /api/produk JSON
        </a>
      </div>
    </div>

    <!-- Product Cards Grid (Monochrome Apple Style) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% produk.forEach(function(item) { %>
        <div class="modul-card bg-white rounded-2xl p-6 border border-app-border shadow-mac hover:border-zinc-400 transition-all flex flex-col justify-between" data-title="<%= item.nama.toLowerCase() %>">
          <div>
            <div class="flex items-center justify-between mb-3 text-xs">
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-100 text-zinc-800 font-semibold">
                <%= item.kategori %>
              </span>
              <% if (item.badge) { %>
                <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-wider">
                  <%= item.badge %>
                </span>
              <% } %>
            </div>

            <h3 class="text-base font-bold text-zinc-900 leading-snug">
              <%= item.nama %>
            </h3>
            
            <p class="text-xs text-zinc-500 mt-2 leading-relaxed">
              <%= item.deskripsi %>
            </p>

            <div class="mt-4 pt-3 border-t border-zinc-100 text-xs text-zinc-500 space-y-1">
              <div class="flex justify-between">
                <span>Fitur:</span>
                <span class="font-medium text-zinc-800 text-right truncate max-w-[170px]"><%= item.fiturUtama %></span>
              </div>
              <div class="flex justify-between">
                <span>Kuota:</span>
                <span class="font-bold text-zinc-900"><%= item.stok %> Unit</span>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-3 border-t border-zinc-100 flex items-center justify-between">
            <span class="text-sm font-bold text-zinc-900">
              <%= formatRupiah(item.harga) %>
            </span>
            <button onclick="showDetailModal(<%= JSON.stringify(item) %>)" class="px-3 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-semibold transition-colors active:scale-95">
              Detail
            </button>
          </div>
        </div>
      <% }); %>
    </div>

  </section>

  <!-- ==================== VIEW 4: STATUS API & LOGGER ==================== -->
  <section id="view-status" class="spa-view hidden space-y-6">
    
    <div class="bg-white rounded-2xl p-6 border border-app-border shadow-mac flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-zinc-900">
          Status Layanan & REST API
        </h2>
        <p class="text-xs text-zinc-500 mt-0.5">
          Setiap request HTTP diproses oleh middleware logger dan dicatat ke <code class="font-mono text-[11px] bg-zinc-100 px-1 py-0.5 rounded">logs/logger.md</code>.
        </p>
      </div>

      <div class="flex items-center space-x-2 text-xs">
        <button onclick="inspectEndpoint('/api/status')" class="px-3 py-1.5 rounded-lg bg-zinc-900 text-white font-semibold hover:bg-zinc-800">
          /api/status
        </button>
        <button onclick="inspectEndpoint('/api/produk')" class="px-3 py-1.5 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-800 font-semibold">
          /api/produk
        </button>
        <button onclick="inspectEndpoint('/api/jadwal')" class="px-3 py-1.5 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-800 font-semibold">
          /api/jadwal
        </button>
      </div>
    </div>

    <!-- Terminal Code Block (Mac Style) -->
    <div class="bg-zinc-900 rounded-2xl p-5 border border-zinc-800 shadow-mac text-zinc-300 font-mono text-xs">
      <div class="flex items-center justify-between pb-3 border-b border-zinc-800 mb-3 text-zinc-400">
        <div class="flex items-center space-x-2">
          <span class="text-white font-bold" id="terminal-endpoint">/api/status</span>
          <span class="text-zinc-600">|</span>
          <span class="text-[11px] text-zinc-500" id="terminal-ms">- ms</span>
        </div>
        <button onclick="copyOutput()" class="text-zinc-400 hover:text-white transition-colors text-[11px]">
          Salin JSON
        </button>
      </div>

      <pre id="terminal-json" class="overflow-x-auto max-h-72 leading-relaxed text-zinc-200">
// Memuat data dari server...
      </pre>
    </div>

  </section>

</main>

<!-- Detail Modal (Minimalist Monochrome) -->
<div id="modal-container" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-mac-lg border border-zinc-200 space-y-4 text-xs">
    <div class="flex justify-between items-start pb-2 border-b border-zinc-100">
      <div>
        <span id="m-category" class="text-[10px] font-bold text-zinc-500 uppercase tracking-wider"></span>
        <h3 id="m-title" class="text-base font-bold text-zinc-900 mt-0.5"></h3>
      </div>
      <button onclick="closeDetailModal()" class="text-zinc-400 hover:text-zinc-700 text-lg font-bold leading-none">&times;</button>
    </div>

    <p id="m-desc" class="text-zinc-600 leading-relaxed"></p>

    <div class="p-3 bg-zinc-50 rounded-xl border border-zinc-200/80 space-y-1.5">
      <div class="flex justify-between">
        <span class="text-zinc-500">Fitur:</span>
        <span id="m-feature" class="font-semibold text-zinc-900 text-right"></span>
      </div>
      <div class="flex justify-between">
        <span class="text-zinc-500">Kapasitas:</span>
        <span id="m-stock" class="font-bold text-zinc-900"></span>
      </div>
      <div class="flex justify-between pt-1 border-t border-zinc-200">
        <span class="text-zinc-700 font-semibold">Harga:</span>
        <span id="m-price" class="font-bold text-zinc-900 text-sm"></span>
      </div>
    </div>

    <button onclick="closeDetailModal()" class="w-full py-2 bg-zinc-900 text-white font-bold rounded-xl active:scale-[0.98]">
      Tutup
    </button>
  </div>
</div>

<!-- Client SPA Controller -->
<script>
  // SPA View Switcher
  function switchView(targetId) {
    // Hide all views
    document.querySelectorAll('.spa-view').forEach(v => v.classList.add('hidden'));

    // Show target view
    const target = document.getElementById(targetId);
    if (target) target.classList.remove('hidden');

    // Update Desktop Nav
    document.querySelectorAll('.nav-segment').forEach(btn => {
      btn.className = 'nav-segment px-3.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 transition-all flex items-center gap-1.5';
    });
    const key = targetId.replace('view-', '');
    const activeDesktop = document.getElementById('nav-btn-' + key);
    if (activeDesktop) {
      activeDesktop.className = 'nav-segment px-3.5 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm transition-all flex items-center gap-1.5';
    }

    // Update Mobile Nav
    document.querySelectorAll('.mob-segment').forEach(btn => {
      btn.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg text-zinc-600 text-center whitespace-nowrap';
    });
    const activeMobile = document.getElementById('mob-btn-' + key);
    if (activeMobile) {
      activeMobile.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg bg-white text-zinc-900 shadow-sm text-center whitespace-nowrap';
    }

    if (targetId === 'view-status') {
      inspectEndpoint('/api/status');
    }
  }

  function scrollToScheduleTable() {
    switchView('view-jadwal');
    const el = document.getElementById('scheduleTableSection');
    if (el) el.scrollIntoView({ behavior: 'smooth' });
  }

  // Filter Schedule Days
  function filterDay(day) {
    document.querySelectorAll('.filter-day-pill').forEach(btn => {
      btn.className = 'filter-day-pill px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900';
    });
    const activeBtn = document.querySelector(`.filter-day-pill[data-day="${day}"]`);
    if (activeBtn) {
      activeBtn.className = 'filter-day-pill px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm';
    }

    document.querySelectorAll('.session-row').forEach(row => {
      const rowDay = row.getAttribute('data-day');
      if (day === 'Semua' || rowDay === day) {
        row.classList.remove('hidden');
      } else {
        row.classList.add('hidden');
      }
    });
  }

  // Live Countdown (42:15)
  let countSec = 42 * 60 + 15;
  setInterval(() => {
    if (countSec > 0) {
      countSec--;
      const m = Math.floor(countSec / 60);
      const s = countSec % 60;
      const formatted = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} left`;
      const pill = document.getElementById('countdownPill');
      if (pill) pill.innerText = formatted;
    }
  }, 1000);

  // Pra-KRS Stepper
  function stepSemester(delta) {
    const el = document.getElementById('form-semester');
    let v = parseInt(el.value || 1, 10) + delta;
    if (v < 1) v = 1;
    if (v > 12) v = 12;
    el.value = v;
  }

  function updateNimString() {
    const angkatan = document.getElementById('form-angkatan').value || '2024';
    document.getElementById('nim-prefix-display').innerText = angkatan + '0140';
  }

  function handlePrakrsSubmit(e) {
    e.preventDefault();
    const sem = parseInt(document.getElementById('form-semester').value, 10);
    const nama = document.getElementById('form-nama').value.trim();
    const suffix = document.getElementById('form-nim-suffix').value.trim();
    const alertEl = document.getElementById('prakrs-alert');

    if (sem < 1 || sem > 12 || isNaN(sem)) {
      alertEl.className = 'p-3 rounded-lg text-xs font-medium bg-zinc-100 text-zinc-900 border border-zinc-300';
      alertEl.innerText = 'Semester harus bernilai integer 1 s.d. 12.';
      alertEl.classList.remove('hidden');
      return;
    }

    if (nama.length < 3) {
      alertEl.className = 'p-3 rounded-lg text-xs font-medium bg-zinc-100 text-zinc-900 border border-zinc-300';
      alertEl.innerText = 'Nama minimal 3 karakter huruf kapital.';
      alertEl.classList.remove('hidden');
      return;
    }

    if (suffix.length !== 3) {
      alertEl.className = 'p-3 rounded-lg text-xs font-medium bg-zinc-100 text-zinc-900 border border-zinc-300';
      alertEl.innerText = 'NIM harus terdiri dari 3 digit akhir.';
      alertEl.classList.remove('hidden');
      return;
    }

    document.getElementById('userGreeting').innerText = `Selamat Pagi, ${nama}`;
    alertEl.className = 'p-3 rounded-lg text-xs font-medium bg-zinc-900 text-white';
    alertEl.innerText = 'Preferensi tersimpan. Memperbarui tampilan jadwal...';
    alertEl.classList.remove('hidden');

    setTimeout(() => {
      switchView('view-jadwal');
      alertEl.classList.add('hidden');
    }, 700);
  }

  // Modul Filter
  function filterModulList() {
    const q = document.getElementById('filterModulInput').value.toLowerCase();
    document.querySelectorAll('.modul-card').forEach(card => {
      const title = card.getAttribute('data-title');
      if (title.includes(q)) {
        card.classList.remove('hidden');
      } else {
        card.classList.add('hidden');
      }
    });
  }

  // Modal Detail
  function showDetailModal(item) {
    document.getElementById('m-title').innerText = item.nama;
    document.getElementById('m-category').innerText = item.kategori;
    document.getElementById('m-desc').innerText = item.deskripsi;
    document.getElementById('m-feature').innerText = item.fiturUtama;
    document.getElementById('m-stock').innerText = item.stok + ' Unit';
    document.getElementById('m-price').innerText = 'Rp ' + Number(item.harga).toLocaleString('id-ID');
    document.getElementById('modal-container').classList.remove('hidden');
  }

  function closeDetailModal() {
    document.getElementById('modal-container').classList.add('hidden');
  }

  // Terminal API Inspector
  async function inspectEndpoint(endpoint) {
    document.getElementById('terminal-endpoint').innerText = endpoint;
    const jsonEl = document.getElementById('terminal-json');
    const msEl = document.getElementById('terminal-ms');
    jsonEl.innerText = '// Mengambil data dari ' + endpoint + '...';

    const t0 = performance.now();
    try {
      const res = await fetch(endpoint);
      const data = await res.json();
      const t1 = performance.now();
      msEl.innerText = (t1 - t0).toFixed(1) + ' ms';
      jsonEl.innerText = JSON.stringify(data, null, 2);
    } catch (err) {
      jsonEl.innerText = 'Error: ' + err.message;
    }
  }

  function copyOutput() {
    const text = document.getElementById('terminal-json').innerText;
    navigator.clipboard.writeText(text);
  }

  // Init Status Ping
  async function initStatus() {
    try {
      const res = await fetch('/api/status');
      const data = await res.json();
      const el = document.getElementById('nav-status-text');
      if (el) el.innerText = `Online (${data.uptimeDetik}s)`;
    } catch (e) {
      const el = document.getElementById('nav-status-text');
      if (el) el.innerText = 'Offline';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initStatus();
  });
</script>

<%- include('partials/footer') %>
