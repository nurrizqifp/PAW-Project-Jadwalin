<%- include('partials/head', { judul: judul }) %>
<%- include('partials/navbar') %>

<main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

  <!-- ==================== TAB 1: SISTEM JADWAL KULIAH (DEFAULT VIEW) ==================== -->
  <div id="tab-content-jadwal" class="app-tab-pane space-y-6">
    
    <!-- Greeting & System Status Banner (Wireframe 3 & 4) -->
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="px-2.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[11px] font-bold">
            Jadwal Terpublikasi • 0 Bentrok
          </span>
          <span class="text-xs text-slate-400">•</span>
          <span class="text-xs text-slate-500 font-medium">Semester Genap 2026/2027</span>
        </div>
        <h1 id="main-greeting" class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Selamat Pagi, Andi Pratama!
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Jadwal kamu saat ini. <span class="text-brand-600 font-semibold">[Affirmative text by AI: <em>"Tetap fokus dan maksimalkan belajarmu hari ini!"</em>]</span>
        </p>
      </div>

      <!-- Quick Action Badges -->
      <div class="flex items-center gap-2.5 shrink-0">
        <button onclick="switchAppTab('onboarding')" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          <span>Ubah Pra-KRS</span>
        </button>
        <button onclick="scrollToFullSchedule()" class="px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold shadow-sm transition-colors flex items-center gap-1.5">
          <span>Lihat Jadwal Lengkap</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Active Class Card (Wireframe 3: WhatsApp Image 13.53.02) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Big Prominent Card (2 Cols) -->
      <div class="lg:col-span-2 bg-gradient-to-br from-white via-white to-brand-50/40 rounded-3xl p-6 sm:p-8 border-2 border-slate-900 shadow-md flex flex-col justify-between relative overflow-hidden">
        
        <div>
          <!-- Top Row: Status, Jam, Countdown -->
          <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-xs font-black uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
                Kuliah Berlangsung Sekarang
              </span>
            </div>
            
            <div class="flex items-center gap-2">
              <span class="text-2xl sm:text-3xl font-black text-slate-900 font-mono tracking-tight">
                08:50 – 11:30
              </span>
              <span id="live-countdown" class="px-3 py-1 rounded-full bg-slate-900 text-white font-mono text-xs font-bold shadow-sm animate-pulse">
                42:15 left
              </span>
            </div>
          </div>

          <!-- Mata Kuliah Name -->
          <div class="my-4">
            <span class="text-xs font-bold text-slate-400 font-mono">KODE: TI401 • 3 SKS</span>
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-0.5">
              Pengembangan Aplikasi Web
            </h2>
          </div>

          <!-- Class Badges from Wireframe 3: [B] | F6.003 | Ir. Asroni, S.T., M.Eng. -->
          <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-slate-200/90 text-sm">
            <span class="inline-flex items-center justify-center w-10 h-10 rounded-2xl bg-slate-900 text-white font-black text-base shadow-sm">
              B
            </span>
            <div class="bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200">
              <span class="text-[10px] text-slate-400 block font-semibold uppercase">Ruang Kuliah</span>
              <span class="font-extrabold text-slate-900 font-mono text-sm">F6.003</span>
            </div>
            <div class="bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 flex-1 min-w-[200px]">
              <span class="text-[10px] text-slate-400 block font-semibold uppercase">Dosen Pengampu</span>
              <span class="font-bold text-slate-800 text-sm truncate block">Ir. Asroni, S.T., M.Eng.</span>
            </div>
          </div>
        </div>

        <!-- Progress Bar & Footer info -->
        <div class="mt-6 pt-4 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between text-xs text-slate-500 gap-2">
          <div class="w-full sm:max-w-xs">
            <div class="flex justify-between text-[11px] mb-1 font-semibold">
              <span>Durasi Berjalan</span>
              <span class="text-brand-600 font-bold">68%</span>
            </div>
            <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
              <div class="bg-brand-600 h-full rounded-full transition-all" style="width: 68%;"></div>
            </div>
          </div>
          <span class="font-medium text-slate-600">
            Laboratorium & Komputasi TI UMY
          </span>
        </div>

      </div>

      <!-- Upcoming Lecture Queue (1 Col) -->
      <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-4">
            <h3 class="font-black text-slate-900 text-sm uppercase tracking-wide">
              Mata Kuliah Berikutnya Hari Ini
            </h3>
            <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[10px] font-bold">Senin</span>
          </div>

          <div class="space-y-3">
            <!-- Next 1 -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-colors">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-mono font-bold text-brand-700 bg-brand-50 px-2 py-0.5 rounded">13:20 – 15:00</span>
                <span class="font-bold text-slate-500">Kelas A</span>
              </div>
              <h4 class="font-bold text-slate-900 text-sm">Pengembangan Web Service</h4>
              <p class="text-xs text-slate-500 mt-1">Dr. Ir. Dwijoko Purbohadi, M.T. • Ruang F6.003</p>
            </div>

            <!-- Next 2 -->
            <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-slate-300 transition-colors">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="font-mono font-bold text-cyan-700 bg-cyan-50 px-2 py-0.5 rounded">16:20 – 18:00</span>
                <span class="font-bold text-slate-500">Kelas C</span>
              </div>
              <h4 class="font-bold text-slate-900 text-sm">WAN & Teknologi Jaringan</h4>
              <p class="text-xs text-slate-500 mt-1">Ir. Eko Prasetyo, M.Eng., Ph.D. • Lab F6.004</p>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 text-center">
          <button onclick="scrollToFullSchedule()" class="text-xs text-brand-600 hover:text-brand-800 font-bold">
            Buka Tabel Seluruh Semester &rarr;
          </button>
        </div>
      </div>

    </div>

    <!-- Full Schedule Stack (Wireframe 4: WhatsApp Image 13.53.14) -->
    <div id="full-schedule-section" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-200 gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
            Jadwal Kuliah Kamu, Andi!
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            [Affirmative text by AI: <em>"Semua jadwal hari ini 0 bentrok & terverifikasi."</em>]
          </p>
        </div>

        <!-- Filter Hari -->
        <div class="flex items-center gap-1.5 overflow-x-auto text-xs font-bold no-scrollbar">
          <button onclick="filterDaySchedule('Semua')" class="day-filter-btn px-3 py-1.5 rounded-xl bg-slate-900 text-white" data-day="Semua">
            Semua Hari
          </button>
          <button onclick="filterDaySchedule('Senin')" class="day-filter-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200" data-day="Senin">
            Senin
          </button>
          <button onclick="filterDaySchedule('Selasa')" class="day-filter-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200" data-day="Selasa">
            Selasa
          </button>
          <button onclick="filterDaySchedule('Rabu')" class="day-filter-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200" data-day="Rabu">
            Rabu
          </button>
          <button onclick="filterDaySchedule('Kamis')" class="day-filter-btn px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200" data-day="Kamis">
            Kamis
          </button>
        </div>
      </div>

      <!-- Schedule Cards List (Wireframe 4 Exact Style) -->
      <div id="scheduleGrid" class="space-y-3.5">
        <% jadwal.forEach(function(item) { %>
          <div class="schedule-card rounded-2xl border-2 border-slate-900 bg-white p-4 sm:p-5 shadow-sm hover:shadow-md transition-shadow flex flex-col md:flex-row md:items-center justify-between gap-4" data-day="<%= item.hari %>">
            
            <div class="space-y-1.5">
              <div class="flex items-center space-x-2.5">
                <span class="px-2.5 py-0.5 rounded-lg bg-slate-100 font-mono text-xs font-black text-slate-800">
                  <%= item.hari %>
                </span>
                <span class="text-base sm:text-lg font-black text-slate-900 font-mono">
                  <%= item.jamMulai %> – <%= item.jamSelesai %>
                </span>
                <% if (item.isActiveNow) { %>
                  <span class="px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-bold">
                    Sedang Berlangsung
                  </span>
                <% } %>
              </div>

              <h3 class="text-base sm:text-lg font-black text-slate-900">
                <%= item.mataKuliah %>
              </h3>

              <div class="flex items-center space-x-2.5 text-xs text-slate-600">
                <span class="w-6 h-6 rounded-md border border-slate-900 font-black flex items-center justify-center text-xs bg-slate-50">
                  <%= item.kelas %>
                </span>
                <span class="font-extrabold text-slate-900"><%= item.ruang %></span>
                <span class="text-slate-300">|</span>
                <span><%= item.dosen %></span>
              </div>
            </div>

            <div class="flex items-center gap-3 self-start md:self-center">
              <span class="px-3 py-1 rounded-xl bg-slate-100 border border-slate-200 text-xs font-semibold text-slate-700">
                <%= item.jenis %>
              </span>
              <span class="font-mono text-xs font-bold text-slate-400">
                <%= item.sks %> SKS
              </span>
            </div>

          </div>
        <% }); %>
      </div>

    </div>

  </div>

  <!-- ==================== TAB 2: ONBOARDING & PRA-KRS (Wireframe 2: WhatsApp Image 13.52.50) ==================== -->
  <div id="tab-content-onboarding" class="app-tab-pane hidden space-y-6">
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm max-w-3xl mx-auto">
      
      <div class="pb-4 border-b border-slate-200 mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">
            Pengaturan Profil & Pra-KRS Mahasiswa
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Form validasi data onboarding sesuai aturan dokumen sketsa prodi TI UMY.
          </p>
        </div>
        <span class="px-3 py-1 rounded-full bg-brand-100 text-brand-800 text-xs font-bold">
          4 Aturan Input
        </span>
      </div>

      <form id="onboardingForm" onsubmit="handleOnboardingSubmit(event)" class="space-y-6 text-xs sm:text-sm">
        
        <!-- 1. Semester Picker (1-12, klik atas bawah, no dropdown) -->
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <label class="block font-black text-slate-800">
            1. Kamu saat ini semester berapa?
          </label>
          <p class="text-xs text-slate-500">
            Only 1–12 (bisa klik atas bawah dan input divalidasi tidak bisa angka selain integer 1–12, jangan dropdown).
          </p>
          <div class="flex items-center space-x-3 pt-1">
            <button type="button" onclick="adjustSemester(-1)" class="w-10 h-10 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 font-black text-lg text-slate-700 shadow-sm active:scale-95 transition-all">-</button>
            <input id="input-semester" type="number" min="1" max="12" value="4" required class="w-24 text-center font-black text-lg py-2 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none bg-white">
            <button type="button" onclick="adjustSemester(1)" class="w-10 h-10 rounded-xl bg-white border border-slate-300 hover:bg-slate-100 font-black text-lg text-slate-700 shadow-sm active:scale-95 transition-all">+</button>
            <span class="text-xs text-slate-600 font-medium">Semester Aktif</span>
          </div>
        </div>

        <!-- 2. Angkatan Year Picker -->
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <label class="block font-black text-slate-800">
            2. Angkatan berapa?
          </label>
          <p class="text-xs text-slate-500">
            Pilih tahun masuk perkuliahan (Year Picker).
          </p>
          <input id="input-angkatan" type="number" min="2018" max="2026" value="2024" class="w-40 font-bold text-base py-2 px-3.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none bg-white" oninput="updateNimPreview()">
        </div>

        <!-- 3. Nama & NIM -->
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <label class="block font-black text-slate-800">
            3. Nama dan NIM Mahasiswa
          </label>
          
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Lengkap:</label>
            <input id="input-nama" type="text" value="ANDI PRATAMA" required class="w-full font-bold uppercase py-2 px-3.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none bg-white text-sm" oninput="this.value = this.value.toUpperCase()">
            <p class="text-[11px] text-slate-500 mt-1">Aturan: Hanya allow string input otomatis menjadi huruf besar, minimal 3 huruf.</p>
          </div>

          <div class="pt-2">
            <label class="block text-xs font-semibold text-slate-600 mb-1">Nomor Induk Mahasiswa (NIM):</label>
            <div class="flex items-center space-x-2">
              <span id="nim-prefix" class="font-mono text-sm font-black bg-slate-200 px-3.5 py-2 rounded-xl border border-slate-300 text-slate-700">20240140</span>
              <input id="input-nim-suffix" type="text" maxlength="3" value="093" required class="w-20 font-mono font-black text-center text-sm py-2 px-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-brand-500 focus:outline-none bg-white" oninput="this.value = this.value.replace(/[^0-9]/g, ''); updateNimPreview()">
            </div>
            <p class="text-[11px] text-slate-500 mt-1">Aturan: Hanya input 3 NIM belakang (depannya dipastikan [angkatan]0140[3NIM]).</p>
          </div>
        </div>

        <!-- 4. Pra KRS Grid Mapping -->
        <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <label class="block font-black text-slate-800">
            4. Masukkan Pra-KRS Semester Ini
          </label>
          <p class="text-xs text-slate-500">
            Tabel pilih matkul pakai grid view dikelompokkan berdasar kategori & otomatis mapping ke saran kelas AI berdasar dataset bebas bentrok.
          </p>

          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden text-xs">
            <table class="w-full text-left">
              <thead class="bg-slate-100 text-slate-700 font-bold">
                <tr>
                  <th class="p-3">Pilih</th>
                  <th class="p-3">Mata Kuliah</th>
                  <th class="p-3">Kategori</th>
                  <th class="p-3">Saran AI (Kelas & Ruang)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <tr>
                  <td class="p-3"><input type="checkbox" checked class="w-4 h-4 rounded text-brand-600"></td>
                  <td class="p-3 font-bold">Pengembangan Aplikasi Web</td>
                  <td class="p-3 text-slate-500">Praktikum / Pemrograman</td>
                  <td class="p-3 font-semibold text-brand-600">Kelas B • F6.003</td>
                </tr>
                <tr>
                  <td class="p-3"><input type="checkbox" checked class="w-4 h-4 rounded text-brand-600"></td>
                  <td class="p-3 font-bold">Pengembangan Web Service</td>
                  <td class="p-3 text-slate-500">Teori / Backend</td>
                  <td class="p-3 font-semibold text-brand-600">Kelas A • F6.003</td>
                </tr>
                <tr>
                  <td class="p-3"><input type="checkbox" checked class="w-4 h-4 rounded text-brand-600"></td>
                  <td class="p-3 font-bold">WAN dan Teknologi Jaringan</td>
                  <td class="p-3 text-slate-500">Praktikum Laboratorium</td>
                  <td class="p-3 font-semibold text-cyan-600">Kelas C • Lab Jaringan F6.004</td>
                </tr>
                <tr>
                  <td class="p-3"><input type="checkbox" class="w-4 h-4 rounded text-brand-600"></td>
                  <td class="p-3 font-bold">Kecerdasan Buatan</td>
                  <td class="p-3 text-slate-500">Teori AI</td>
                  <td class="p-3 font-semibold text-slate-600">Kelas A • F6.002</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-2xl bg-slate-900 hover:bg-brand-600 text-white font-black text-sm shadow-md transition-all">
          Simpan Profil & Perbarui Jadwal Kuliah
        </button>
        <div id="onboarding-feedback" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>

      </form>

    </div>
  </div>

  <!-- ==================== TAB 3: MODUL & PRODUK SISTEM (Data dari Backend Model) ==================== -->
  <div id="tab-content-produk" class="app-tab-pane hidden space-y-6">
    
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 rounded-full bg-brand-600"></span>
          <span class="text-xs uppercase tracking-wider font-extrabold text-brand-600">Data Model Backend</span>
        </div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
          Modul & Layanan Sistem Jadwalin
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Data produk dikelola dari backend <code class="font-mono bg-slate-100 text-brand-700 px-1.5 py-0.5 rounded font-bold">models/produkModel.js</code> dan dirender langsung melalui controller EJS.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <input type="text" id="prodSearchInput" oninput="filterProductCards()" placeholder="Cari modul..." class="text-xs px-3.5 py-2 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 w-48">
        <a href="/api/produk" target="_blank" class="px-3.5 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800 transition-colors">
          /api/produk JSON
        </a>
      </div>
    </div>

    <!-- Grid Produk Cards EJS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% produk.forEach(function(item) { %>
        <div class="product-item bg-white rounded-3xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between" data-name="<%= item.nama.toLowerCase() %>">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-brand-50 text-brand-700 border border-brand-200/60">
                <%= item.kategori %>
              </span>
              <% if (item.badge) { %>
                <span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-amber-50 text-amber-700 border border-amber-200">
                  <%= item.badge %>
                </span>
              <% } %>
            </div>

            <h3 class="text-lg font-black text-slate-900"><%= item.nama %></h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed"><%= item.deskripsi %></p>

            <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500 space-y-1.5">
              <div class="flex justify-between">
                <span>Fitur Inti:</span>
                <span class="font-semibold text-slate-800 text-right truncate max-w-[180px]"><%= item.fiturUtama %></span>
              </div>
              <div class="flex justify-between">
                <span>Kapasitas:</span>
                <span class="font-bold text-slate-800"><%= item.stok %> Kuota</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-slate-400 block font-bold uppercase">Estimasi Nilai</span>
              <span class="text-base font-black text-slate-900"><%= formatRupiah(item.harga) %></span>
            </div>
            <button onclick="previewProdukDetail(<%= JSON.stringify(item) %>)" class="px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-800 text-xs font-bold transition-colors">
              Detail Modul
            </button>
          </div>
        </div>
      <% }); %>
    </div>

  </div>

  <!-- ==================== TAB 4: STATUS SERVER & REST API EXPLORER ==================== -->
  <div id="tab-content-api" class="app-tab-pane hidden space-y-6">
    
    <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-black text-slate-900 tracking-tight">
          Status Server & API Explorer
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Setiap request otomatis dicatat oleh middleware logger ke <code class="font-mono bg-slate-100 text-brand-700 px-1 py-0.5 rounded font-bold">logs/logger.md</code>.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button onclick="triggerApiCall('/api/status')" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-colors">
          GET /api/status
        </button>
        <button onclick="triggerApiCall('/api/produk')" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-colors">
          GET /api/produk
        </button>
        <button onclick="triggerApiCall('/api/jadwal')" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-colors">
          GET /api/jadwal
        </button>
      </div>
    </div>

    <!-- API Output Console Card -->
    <div class="bg-surface-900 rounded-3xl p-6 sm:p-7 text-white border border-slate-800 shadow-xl">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
        <div class="flex items-center space-x-2">
          <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono text-xs font-bold">GET</span>
          <span id="console-endpoint-url" class="font-mono text-sm font-bold text-slate-300">/api/status</span>
        </div>
        <span id="console-latency" class="text-xs font-mono text-slate-400">Response: - ms</span>
      </div>

      <pre id="api-output" class="bg-surface-950 p-4 rounded-2xl font-mono text-xs text-emerald-400 overflow-x-auto max-h-80 leading-relaxed border border-slate-800">
// Memuat response...
      </pre>
    </div>

  </div>

</main>

