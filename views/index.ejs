<!-- ==================== MODAL: RIWAYAT NOTIFIKASI ==================== -->
<div id="modal-riwayat-notif" data-open="false" class="modal-backdrop fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" onclick="if(event.target === this) closeModal('modal-riwayat-notif')">
  <div class="modal-panel bg-white rounded-2xl max-w-md w-full p-6 shadow-mac-lg border border-zinc-200 space-y-4 text-xs">
    <div class="flex justify-between items-center pb-2 border-b border-zinc-100">
      <h3 class="text-base font-bold text-zinc-900">Riwayat Notifikasi Jadwal TI UMY</h3>
      <button onclick="closeModal('modal-riwayat-notif')" class="text-zinc-400 hover:text-zinc-700 text-lg font-bold leading-none">&times;</button>
    </div>

    <div id="notifHistoryList" class="space-y-2.5 max-h-80 overflow-y-auto">
      <% notifikasiList.forEach(function(n) { %>
        <div class="p-3 rounded-xl bg-zinc-50 border border-zinc-200 space-y-1">
          <div class="flex justify-between items-center">
            <span class="font-bold text-zinc-900"><%= n.kodeMatkul %> &middot; <%= n.mataKuliah %></span>
            <span class="font-mono text-[10px] text-zinc-400 tabular-nums"><%= n.waktu %></span>
          </div>
          <p class="text-zinc-600"><%= n.perubahan %></p>
        </div>
      <% }); %>
    </div>
  </div>
</div>

<!-- ==================== CLIENT SPA CONTROLLER ==================== -->
<script>
  let toastTimer = null;
  let currentObStep = 1;
  let isDemoReadOnly = false;
  let currentVariasiIdx = 0;
  let showAllCatalogMode = false;
  let selectedCodesForSchedule = ['TI501', 'TI502', 'TI503', 'TI504', 'TI505', 'TI506', 'TI507', 'TI508'];
  let currentMahasiswaSessions = <%- JSON.stringify((typeof defaultPrakrs !== 'undefined' && defaultPrakrs && defaultPrakrs.rekomendasiSesi) ? defaultPrakrs.rekomendasiSesi : []) %>;

  function getGreetingWaktu() {
    const hr = new Date().getHours();
    if (hr < 11) return 'Pagi';
    if (hr < 15) return 'Siang';
    if (hr < 18) return 'Sore';
    return 'Malam';
  }

  function updatePersonalGreetings(namaUser) {
    const waktu = getGreetingWaktu();
    const cleanName = (namaUser || 'ANDI PRATAMA').toUpperCase();
    const gEl = document.getElementById('mhsGreeting');
    const fEl = document.getElementById('mhsFullTitle');
    if (gEl) gEl.textContent = `Selamat ${waktu}, ${cleanName}!`;
    if (fEl) fEl.textContent = `Jadwal Kuliah Kamu, ${cleanName}!`;
  }

  function showToast(message) {
    const toast = document.getElementById('appToast');
    const msgEl = document.getElementById('appToastMessage');
    if (!toast || !msgEl) return;
    msgEl.textContent = message;
    toast.setAttribute('data-visible', 'true');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.setAttribute('data-visible', 'false');
    }, 3200);
  }

  // 4 Layar Utama Mahasiswa (Lampiran 1 -> 2 -> 3 <-> 4)
  function showLandingView() {
    switchView('view-mahasiswa');
    const lEl = document.getElementById('mhs-subview-landing');
    const oEl = document.getElementById('mhs-subview-onboarding');
    const cEl = document.getElementById('mhs-subview-current');
    const fEl = document.getElementById('mhs-subview-full');
    if (lEl) lEl.classList.remove('hidden');
    if (oEl) oEl.classList.add('hidden');
    if (cEl) cEl.classList.add('hidden');
    if (fEl) fEl.classList.add('hidden');
    const nb = document.getElementById('notifBanner');
    if (nb) nb.classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showOnboardingView(demoMode = false) {
    switchView('view-mahasiswa');
    const lEl = document.getElementById('mhs-subview-landing');
    const oEl = document.getElementById('mhs-subview-onboarding');
    const cEl = document.getElementById('mhs-subview-current');
    const fEl = document.getElementById('mhs-subview-full');
    if (lEl) lEl.classList.add('hidden');
    if (oEl) oEl.classList.remove('hidden');
    if (cEl) cEl.classList.add('hidden');
    if (fEl) fEl.classList.add('hidden');
    const nb = document.getElementById('notifBanner');
    if (nb) nb.classList.add('hidden');
    setupOnboardingState(demoMode);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showCurrentScheduleView() {
    switchView('view-mahasiswa');
    const lEl = document.getElementById('mhs-subview-landing');
    const oEl = document.getElementById('mhs-subview-onboarding');
    const cEl = document.getElementById('mhs-subview-current');
    const fEl = document.getElementById('mhs-subview-full');
    if (lEl) lEl.classList.add('hidden');
    if (oEl) oEl.classList.add('hidden');
    if (cEl) cEl.classList.remove('hidden');
    if (fEl) fEl.classList.add('hidden');
    const nb = document.getElementById('notifBanner');
    if (nb) nb.classList.remove('hidden');
    applyMahasiswaScheduleFilter();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showFullScheduleView() {
    switchView('view-mahasiswa');
    const lEl = document.getElementById('mhs-subview-landing');
    const oEl = document.getElementById('mhs-subview-onboarding');
    const cEl = document.getElementById('mhs-subview-current');
    const fEl = document.getElementById('mhs-subview-full');
    if (lEl) lEl.classList.add('hidden');
    if (oEl) oEl.classList.add('hidden');
    if (cEl) cEl.classList.add('hidden');
    if (fEl) fEl.classList.remove('hidden');
    const nb = document.getElementById('notifBanner');
    if (nb) nb.classList.remove('hidden');
    applyMahasiswaScheduleFilter();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function handleLandingLogin() {
    showCurrentScheduleView();
    showToast('Login berhasil sebagai ANDI PRATAMA (20240140093).');
  }

  function startDemoTutorial() {
    showOnboardingView(true);
  }

  function startRegisterOnboarding() {
    showOnboardingView(false);
  }

  function openLandingOverlay() {
    showLandingView();
  }

  function openOnboarding(demoMode = false) {
    showOnboardingView(demoMode);
  }

  function setupOnboardingState(demoMode = false) {
    isDemoReadOnly = Boolean(demoMode);
    currentObStep = 1;
    const badge = document.getElementById('onboardingModeBadge');
    const demoNotice = document.getElementById('demoReadOnlyNotice');

    if (isDemoReadOnly) {
      if (badge) badge.textContent = 'Mode Coba Demo (Read-Only)';
      if (demoNotice) demoNotice.classList.remove('hidden');
    } else {
      if (badge) badge.textContent = 'Mode Interaktif';
      if (demoNotice) demoNotice.classList.add('hidden');
    }

    // Kunci atau buka seluruh kontrol input sesuai spesifikasi Lampiran 1
    const lockIds = ['modal-sem', 'btnSemUp', 'btnSemDown', 'modal-nama', 'modal-nim-suffix', 'modal-peminatan', 'modal-kelas', 'modal-pref-hari', 'modal-pref-waktu', 'btnVariasiLain'];
    lockIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.disabled = isDemoReadOnly;
    });
    document.querySelectorAll('.year-picker-btn').forEach(btn => {
      btn.disabled = isDemoReadOnly;
    });

    renderOnboardingStep();
    loadPrakrsGrid();
  }

  function renderOnboardingStep() {
    for (let i = 1; i <= 4; i++) {
      const panel = document.getElementById('ob-panel-' + i);
      const pill = document.getElementById('ob-step-pill-' + i);
      if (panel) panel.classList.toggle('hidden', i !== currentObStep);
      if (pill) {
        pill.className = i === currentObStep
          ? 'p-2.5 rounded-xl bg-zinc-900 text-white text-center font-bold'
          : (i < currentObStep ? 'p-2.5 rounded-xl bg-zinc-200 text-zinc-900 text-center font-semibold' : 'p-2.5 rounded-xl bg-zinc-100 text-zinc-500 text-center');
      }
    }

    // Callout text untuk Demo tutorial per langkah
    const guideText = document.getElementById('demoStepGuideText');
    if (guideText && isDemoReadOnly) {
      if (currentObStep === 1) {
        guideText.innerHTML = '<strong>Langkah 1 dari 4 (Semester):</strong> Input semester dikunci pada angka 5. Klik <strong>Next &rarr;</strong> di bawah untuk lanjut ke pemilihan Angkatan.';
      } else if (currentObStep === 2) {
        guideText.innerHTML = '<strong>Langkah 2 dari 4 (Angkatan):</strong> Tahun angkatan dikunci pada 2024 (awalan NIM: 20240140). Klik <strong>Next &rarr;</strong> untuk lanjut ke profil Nama &amp; NIM.';
      } else if (currentObStep === 3) {
        guideText.innerHTML = '<strong>Langkah 3 dari 4 (Nama &amp; NIM):</strong> Nama dikunci pada "ANDI PRATAMA" dan akhiran NIM "093". Klik <strong>Next &rarr;</strong> untuk masuk ke pemilihan Pra-KRS.';
      } else if (currentObStep === 4) {
        guideText.innerHTML = '<strong>Langkah 4 dari 4 (Pra-KRS &amp; AI Mapping):</strong> AI memetakan mata kuliah ke Kelas B (Variasi #1) bebas bentrok. Klik <strong>Selesai Demo &amp; Lihat Jadwal</strong> untuk melihat kartu jadwal kamu!';
      }
    }

    const btnPrev = document.getElementById('btnObPrev');
    const btnNext = document.getElementById('btnObNext');
    const btnSubmit = document.getElementById('btnObSubmit');

    if (btnPrev) btnPrev.classList.toggle('hidden', currentObStep === 1);
    if (btnNext) btnNext.classList.toggle('hidden', currentObStep === 4);
    if (btnSubmit) {
      btnSubmit.classList.toggle('hidden', currentObStep !== 4);
      btnSubmit.textContent = isDemoReadOnly ? 'Selesai Demo & Lihat Jadwal' : 'Simpan & Terapkan Jadwal';
    }
  }

  function stepOnboarding(delta) {
    if (delta > 0 && !isDemoReadOnly) {
      // Validasi step aktif sebelum lanjut
      if (currentObStep === 1) {
        const semVal = Number(document.getElementById('modal-sem').value);
        if (!Number.isInteger(semVal) || semVal < 1 || semVal > 12) {
          document.getElementById('semErrorMsg').classList.remove('hidden');
          return;
        }
      }
      if (currentObStep === 3) {
        const namaVal = document.getElementById('modal-nama').value.trim();
        const nimVal = document.getElementById('modal-nim-suffix').value.trim();
        if (namaVal.length < 3 || !/^[A-Z\s'.]+$/.test(namaVal)) {
          document.getElementById('namaErrorMsg').classList.remove('hidden');
          return;
        }
        if (!/^[0-9]{3}$/.test(nimVal)) {
          showToast('3 digit belakang NIM wajib berupa 3 angka.');
          return;
        }
      }
    }
    currentObStep = Math.max(1, Math.min(4, currentObStep + delta));
    if (currentObStep === 4) {
      loadPrakrsGrid();
    }
    renderOnboardingStep();
  }

  // Step 1: Validasi Semester Integer 1-12 (Bukan Dropdown)
  function stepSem(d) {
    if (isDemoReadOnly) return;
    const el = document.getElementById('modal-sem');
    let v = parseInt(el.value || '5', 10) + d;
    if (v < 1) v = 1;
    if (v > 12) v = 12;
    el.value = v;
    document.getElementById('semErrorMsg').classList.add('hidden');
  }

  function validateSemesterInput(inputEl) {
    const raw = inputEl.value.replace(/[^0-9]/g, '');
    if (!raw) {
      inputEl.value = '';
      document.getElementById('semErrorMsg').classList.remove('hidden');
      return;
    }
    let num = parseInt(raw, 10);
    if (num < 1) num = 1;
    if (num > 12) num = 12;
    inputEl.value = num;
    document.getElementById('semErrorMsg').classList.add('hidden');
  }

  // Step 2: Year Picker Angkatan
  function selectYearPicker(yr) {
    if (isDemoReadOnly) return;
    document.getElementById('modal-angkatan').value = yr;
    document.querySelectorAll('.year-picker-btn').forEach(btn => {
      const isSelected = btn.getAttribute('data-year') === String(yr);
      btn.className = isSelected
        ? 'year-picker-btn btn-press py-3 px-3 rounded-xl border font-mono font-bold text-sm tabular-nums bg-zinc-900 text-white border-zinc-900 shadow-sm'
        : 'year-picker-btn btn-press py-3 px-3 rounded-xl border font-mono font-bold text-sm tabular-nums bg-white text-zinc-800 border-zinc-300 hover-surface';
    });
    updateNimPreview();
  }

  // Step 3: Sanitasi Nama (String Only, Auto Uppercase, Min 3) & NIM ([angkatan]0140[3NIM])
  function sanitizeNamaInput(inputEl) {
    inputEl.value = inputEl.value.replace(/[^a-zA-Z\s'.]/g, '').toUpperCase();
    const valid = inputEl.value.trim().length >= 3;
    document.getElementById('namaErrorMsg').classList.toggle('hidden', valid);
  }

  function sanitizeNimSuffix(inputEl) {
    inputEl.value = inputEl.value.replace(/[^0-9]/g, '').slice(0, 3);
    updateNimPreview();
  }

  function updateNimPreview() {
    const ang = document.getElementById('modal-angkatan').value || '2024';
    const suf = (document.getElementById('modal-nim-suffix').value || '093').padStart(3, '0');
    document.getElementById('modal-nim-prefix').textContent = `${ang}0140`;
    document.getElementById('modal-nim-preview').textContent = `${ang}0140${suf}`;
  }

  // Step 4: Load Grid Pra-KRS Dikelompokkan Berdasarkan Kategori
  async function loadPrakrsGrid() {
    const semRaw = parseInt(document.getElementById('modal-sem').value || '5', 10);
    const semKurikulum = Math.min(Math.max(semRaw, 1), 8);
    const peminatan = document.getElementById('modal-peminatan').value || 'PR';
    const gridEl = document.getElementById('prakrsCategoryGrid');
    if (!gridEl) return;

    try {
      const res = await fetch(`/api/master?semester=${semKurikulum}&peminatan=${peminatan}`);
      const data = await res.json();
      const list = data.kurikulumMahasiswa || data.kurikulum || [];

      // Kelompokkan berdasarkan kategori
      const groups = {};
      list.forEach(m => {
        const kat = m.isPilihan ? `Pilihan Peminatan (${peminatan})` : (m.kode.startsWith('MKWU') ? 'MKWU (Wajib Universitas)' : m.kategori);
        if (!groups[kat]) groups[kat] = [];
        groups[kat].push(m);
      });

      gridEl.replaceChildren();
      Object.keys(groups).forEach(katName => {
        const box = document.createElement('div');
        box.className = 'p-3.5 rounded-2xl bg-white border border-zinc-200 space-y-2';

        const header = document.createElement('div');
        header.className = 'font-bold text-zinc-900 text-[11px] uppercase tracking-wider pb-1.5 border-b border-zinc-100';
        header.textContent = katName;
        box.appendChild(header);

        groups[katName].forEach(mk => {
          const label = document.createElement('label');
          label.className = 'flex items-start justify-between gap-2 text-xs cursor-pointer py-1';

          const left = document.createElement('div');
          left.className = 'flex items-start gap-2';

          const cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.className = 'prakrs-mk-cb mt-0.5 rounded border-zinc-400 text-zinc-900';
          cb.value = mk.kode;
          cb.setAttribute('data-sks', mk.sks);
          cb.checked = true;
          cb.disabled = isDemoReadOnly;
          cb.addEventListener('change', () => requestAiPrakrsMapping(currentVariasiIdx));

          const txtWrap = document.createElement('div');
          const tName = document.createElement('div');
          tName.className = 'font-semibold text-zinc-900 leading-tight';
          tName.textContent = mk.nama;
          const tCode = document.createElement('div');
          tCode.className = 'font-mono text-[10px] text-zinc-400';
          tCode.textContent = mk.kodeAsli ? `${mk.kodeAsli} -> ${mk.kode}` : mk.kode;
          txtWrap.append(tName, tCode);

          left.append(cb, txtWrap);

          const sksBadge = document.createElement('span');
          sksBadge.className = 'font-mono text-[11px] font-bold text-zinc-700 tabular-nums shrink-0';
          sksBadge.textContent = `${mk.sks} SKS`;

          label.append(left, sksBadge);
          box.appendChild(label);
        });

        gridEl.appendChild(box);
      });

      await requestAiPrakrsMapping(0);
    } catch (err) {
      console.warn('Gagal memuat grid Pra-KRS:', err);
    }
  }

  function getCheckedPrakrsCodes() {
    const cbs = Array.from(document.querySelectorAll('.prakrs-mk-cb:checked'));
    return cbs.map(c => c.value);
  }

  function getCheckedTotalSks() {
    const cbs = Array.from(document.querySelectorAll('.prakrs-mk-cb:checked'));
    return cbs.reduce((acc, c) => acc + (parseInt(c.getAttribute('data-sks') || '0', 10)), 0);
  }

  async function requestAiPrakrsMapping(varIdx = 0) {
    currentVariasiIdx = varIdx;
    const semester = parseInt(document.getElementById('modal-sem').value || '5', 10);
    const angkatan = parseInt(document.getElementById('modal-angkatan').value || '2024', 10);
    const nama = document.getElementById('modal-nama').value.trim() || 'ANDI PRATAMA';
    const nimSuffix = (document.getElementById('modal-nim-suffix').value || '093').padStart(3, '0');
    const prefKelas = document.getElementById('modal-kelas').value || 'B';
    const prefHari = document.getElementById('modal-pref-hari').value || 'Semua';
    const prefWaktu = document.getElementById('modal-pref-waktu').value || 'Semua';
    const kodeMatkulList = getCheckedPrakrsCodes();

    try {
      const res = await fetch('/api/jadwal/prakrs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          semester,
          angkatan,
          nama,
          nimSuffix,
          kodeMatkulList,
          prefKelas,
          prefHari,
          prefWaktu,
          variasiIndex: currentVariasiIdx
        })
      });
      const data = await res.json();
      if (res.ok && data.sukses) {
        document.getElementById('aiPrakrsFeedbackText').textContent = data.aiFeedback;
        document.getElementById('modal-kelas').value = data.targetKelas;
        if (Array.isArray(data.rekomendasiSesi)) {
          currentMahasiswaSessions = data.rekomendasiSesi;
          renderPrakrsAiPreview(data.rekomendasiSesi);
        }
      }
    } catch (err) {
      console.warn('Gagal meminta rekomendasi AI:', err);
    }
  }

  function renderPrakrsAiPreview(sesiList = []) {
    const previewList = document.getElementById('prakrsAiPreviewList');
    const previewCount = document.getElementById('prakrsAiPreviewCount');
    if (!previewList) return;
    if (previewCount) previewCount.textContent = `${sesiList.length} Sesi`;
    previewList.replaceChildren();

    sesiList.forEach(s => {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between p-2 rounded-xl bg-zinc-50 border border-zinc-200 text-xs';
      row.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="font-bold text-zinc-900 tabular-nums">${s.hari} ${s.jamMulai}-${s.jamSelesai}</span>
          <span class="font-medium text-zinc-700 truncate max-w-[200px]">${s.mataKuliah}</span>
        </div>
        <span class="font-mono px-2 py-0.5 rounded bg-zinc-200 text-zinc-800 text-[10px] font-bold">
          [${s.kelas}] ${s.ruang}
        </span>
      `;
      previewList.appendChild(row);
    });
  }

  function cycleAiVariasi() {
    if (isDemoReadOnly) return;
    currentVariasiIdx = (currentVariasiIdx + 1) % 6;
    requestAiPrakrsMapping(currentVariasiIdx);
  }

  // Simpan Pra-KRS & Terapkan ke Dashboard Lampiran 3 & 4
  async function savePrakrs(e) {
    if (e) e.preventDefault();
    const sem = parseInt(document.getElementById('modal-sem').value || '5', 10);
    const angkatan = document.getElementById('modal-angkatan').value || '2024';
    const kelas = document.getElementById('modal-kelas').value || 'B';
    const peminatan = document.getElementById('modal-peminatan').value || 'PR';
    const nama = (document.getElementById('modal-nama').value.trim() || 'ANDI PRATAMA').toUpperCase();
    const suffix = (document.getElementById('modal-nim-suffix').value || '093').padStart(3, '0');
    const totalSks = getCheckedTotalSks() || 20;

    selectedCodesForSchedule = getCheckedPrakrsCodes();
    showAllCatalogMode = false;

    updatePersonalGreetings(nama);
    const sEl = document.getElementById('mhsSemesterText');
    const aEl = document.getElementById('mhsAngkatanText');
    const kEl = document.getElementById('mhsKelasBadge');
    const pEl = document.getElementById('mhsPeminatanBadge');
    const nEl = document.getElementById('mhsNimText');
    const tEl = document.getElementById('mhsTotalSksBadge');
    const vEl = document.getElementById('mhsVariasiLabel');
    const pbEl = document.getElementById('activePersonaBadge');

    if (sEl) sEl.textContent = `Semester ${sem}`;
    if (aEl) aEl.textContent = `Angkatan ${angkatan}`;
    if (kEl) kEl.textContent = `Kelas ${kelas}`;
    if (pEl) pEl.textContent = `Peminatan: ${peminatan}`;
    if (nEl) nEl.textContent = `NIM: ${angkatan}0140${suffix}`;
    if (tEl) tEl.textContent = `${totalSks} SKS`;
    if (vEl) vEl.textContent = `Rekomendasi AI: Kelas ${kelas} (Variasi #${currentVariasiIdx + 1})`;
    if (pbEl) pbEl.textContent = `Mahasiswa: ${nama}`;

    await requestAiPrakrsMapping(currentVariasiIdx);
    applyMahasiswaScheduleFilter();
    showCurrentScheduleView();
    showToast(isDemoReadOnly ? 'Tutorial Coba Demo selesai!' : `Pra-KRS ${nama} (${angkatan}0140${suffix}) berhasil diterapkan.`);
  }

  let currentFilterDay = 'Semua';
  function filterDay(day) {
    currentFilterDay = day;
    document.querySelectorAll('.filter-day-btn').forEach(b => {
      b.className = 'filter-day-btn px-2.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap';
    });
    const active = document.querySelector(`.filter-day-btn[data-day="${day}"]`);
    if (active) active.className = 'filter-day-btn px-2.5 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm whitespace-nowrap';

    applyMahasiswaScheduleFilter();
  }

  function toggleShowAllCatalog() {
    showAllCatalogMode = !showAllCatalogMode;
    const btn = document.getElementById('btnToggleAllCatalog');
    if (btn) {
      btn.textContent = showAllCatalogMode ? 'Kembali ke Filter Pra-KRS Saya' : 'Tampilkan Semua 111 Sesi Prodi';
    }
    const dynContainer = document.getElementById('mhsScheduleContainer');
    const staticContainer = document.getElementById('mhsStaticCatalogContainer');
    if (dynContainer) dynContainer.classList.toggle('hidden', showAllCatalogMode);
    if (staticContainer) staticContainer.classList.toggle('hidden', !showAllCatalogMode);
    applyMahasiswaScheduleFilter();
  }

  function applyMahasiswaScheduleFilter() {
    const kFilter = document.getElementById('modal-kelas')?.value || 'B';
    const container = document.getElementById('mhsScheduleContainer');
    const emptyEl = document.getElementById('emptyScheduleDay');
    if (!container) return;

    if (showAllCatalogMode) {
      let staticCount = 0;
      document.querySelectorAll('.schedule-item-row-static').forEach(row => {
        const rowDay = row.getAttribute('data-day');
        const show = (currentFilterDay === 'Semua' || rowDay === currentFilterDay);
        row.classList.toggle('hidden', !show);
        if (show) staticCount++;
      });
      if (emptyEl) emptyEl.classList.toggle('hidden', staticCount > 0);
      return;
    }

    // Render sesi dinamis hasil pemetaan Pra-KRS mahasiswa
    const filtered = currentMahasiswaSessions.filter(s => currentFilterDay === 'Semua' || s.hari === currentFilterDay);
    container.replaceChildren();

    filtered.forEach(item => {
      const card = document.createElement('div');
      card.className = 'schedule-item-row rounded-2xl p-5 border border-zinc-300 bg-white hover-surface space-y-2.5';
      card.setAttribute('data-day', item.hari);
      card.setAttribute('data-id', item.id);
      card.setAttribute('data-kode', item.kodeMatkul);
      card.setAttribute('data-kelas', item.kelas);
      card.setAttribute('data-peminatan', item.peminatanKode || '');

      card.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <span class="text-xl sm:text-2xl font-extrabold font-mono tabular-nums text-zinc-900 row-jam">
              ${item.jamMulai} - ${item.jamSelesai}
            </span>
            <span class="px-2.5 py-0.5 rounded-lg bg-zinc-100 text-zinc-800 font-semibold text-xs row-hari">
              ${item.hari}
            </span>
          </div>
          <div class="flex items-center gap-2 text-xs">
            <span class="font-mono text-zinc-400">${item.kodeMatkul} &middot; ${item.sks} SKS</span>
            ${item.isPilihan ? `<span class="px-2 py-0.5 rounded bg-zinc-900 text-white font-mono text-[10px]">Peminatan ${item.peminatanKode || ''}</span>` : ''}
          </div>
        </div>
        <div class="text-base sm:text-lg font-bold text-zinc-900">
          ${item.mataKuliah}
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-1 text-xs sm:text-sm">
          <span class="w-7 h-7 rounded-lg border-2 border-zinc-900 bg-zinc-50 font-mono font-bold text-zinc-900 flex items-center justify-center">
            ${item.kelas}
          </span>
          <span class="font-mono font-bold text-zinc-900 row-ruang">
            ${item.ruang}
          </span>
          <span class="text-zinc-300">|</span>
          <span class="text-zinc-700 font-medium">
            ${item.dosen}
          </span>
        </div>
      `;
      container.appendChild(card);
    });

    if (emptyEl) emptyEl.classList.toggle('hidden', filtered.length > 0);

    // Update Kartu Utama di Layar 3
    const activeSession = currentMahasiswaSessions[0];
    if (activeSession) {
      const jamEl = document.getElementById('activeCardTime');
      const titleEl = document.getElementById('activeCardTitle');
      const ruangEl = document.getElementById('activeCardRuang');
      const dosenEl = document.getElementById('activeCardDosen');
      const kelasEl = document.getElementById('activeCardKelas');
      if (jamEl) jamEl.textContent = `${activeSession.jamMulai} - ${activeSession.jamSelesai}`;
      if (titleEl) titleEl.textContent = activeSession.mataKuliah;
      if (ruangEl) ruangEl.textContent = activeSession.ruang;
      if (dosenEl) dosenEl.textContent = activeSession.dosen;
      if (kelasEl) kelasEl.textContent = activeSession.kelas;
    }
  }

  function switchView(targetId) {
    document.querySelectorAll('.spa-view').forEach(v => v.classList.add('hidden'));
    const target = document.getElementById(targetId);
    if (target) target.classList.remove('hidden');

    document.querySelectorAll('.nav-segment').forEach(b => {
      b.className = 'nav-segment px-3.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 flex items-center gap-1.5';
    });
    const key = targetId.replace('view-', '');
    const activeDesktop = document.getElementById('nav-btn-' + key);
    if (activeDesktop) {
      activeDesktop.className = 'nav-segment px-3.5 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm flex items-center gap-1.5';
    }

    document.querySelectorAll('.mob-segment').forEach(b => {
      b.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg text-zinc-600 text-center whitespace-nowrap';
    });
    const activeMobile = document.getElementById('mob-btn-' + key);
    if (activeMobile) {
      activeMobile.className = 'mob-segment flex-1 py-1.5 px-2 rounded-lg bg-white text-zinc-900 shadow-sm text-center whitespace-nowrap';
    }

    const badge = document.getElementById('activePersonaBadge');
    if (badge) {
      if (key === 'mahasiswa') badge.textContent = 'Mahasiswa: ' + (document.getElementById('modal-nama')?.value || 'ANDI PRATAMA');
      if (key === 'akademik') badge.textContent = 'Staf: Rina Wulandari';
      if (key === 'dosen') badge.textContent = 'Dosen: Muhammad Abdul Haq, Ph.D.';
      if (key === 'system') badge.textContent = 'Administrator Sistem';
    }

    if (targetId === 'view-system') {
      testApiEndpoint('/api/status');
    }
  }

  function switchMasterTab(tabName) {
    document.querySelectorAll('.master-tab-btn').forEach(b => {
      b.className = 'master-tab-btn px-3 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 whitespace-nowrap';
    });
    const active = document.getElementById('m-tab-' + tabName);
    if (active) active.className = 'master-tab-btn px-3 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm whitespace-nowrap';

    document.querySelectorAll('.master-subtable').forEach(t => t.classList.add('hidden'));
    const target = document.getElementById('subtable-' + tabName);
    if (target) target.classList.remove('hidden');
    filterMasterRows();
  }

  function filterMasterRows() {
    const q = (document.getElementById('masterSearchInput')?.value || '').toLowerCase().trim();
    document.querySelectorAll('.master-subtable:not(.hidden) .master-row').forEach(row => {
      const txt = row.textContent.toLowerCase();
      row.classList.toggle('hidden', q !== '' && !txt.includes(q));
    });
  }

  function applyPreviewFilter() {
    const qDosen = (document.getElementById('previewFilterDosen')?.value || '').toLowerCase().trim();
    const qRuang = (document.getElementById('previewFilterRuang')?.value || '').toLowerCase().trim();
    const qKelas = (document.getElementById('previewFilterKelas')?.value || '').toLowerCase().trim();

    document.querySelectorAll('.preview-row').forEach(row => {
      const d = row.getAttribute('data-dosen') || '';
      const r = row.getAttribute('data-ruang') || '';
      const k = row.getAttribute('data-kelas') || '';
      const match = (!qDosen || d.includes(qDosen)) && (!qRuang || r.includes(qRuang)) && (!qKelas || k.includes(qKelas));
      row.classList.toggle('hidden', !match);
    });
  }

  function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.setAttribute('data-open', 'true');
  }
  function closeModal(id) {
    const el = document.getElementById(id);
    if (el) el.setAttribute('data-open', 'false');
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-backdrop[data-open="true"]').forEach(m => {
        m.setAttribute('data-open', 'false');
      });
    }
  });

  function renderKonflikState(totalKonflik, daftarKonflik = [], statusJadwal = 'Terpublikasi') {
    document.getElementById('genStatusBadge').textContent = statusJadwal;
    document.getElementById('valTotalKonflik').textContent = `${totalKonflik} Bentrok`;
    document.getElementById('subTotalKonflik').textContent = totalKonflik === 0 ? 'Hard constraints terpenuhi' : 'Perlu resolusi sebelum terbit';
    document.getElementById('navZeroClashText').textContent = totalKonflik === 0 ? 'Zero Clash Active' : `${totalKonflik} Clash Detected`;

    const box = document.getElementById('conflictReportBox');
    const listEl = document.getElementById('conflictListContainer');
    if (!box || !listEl) return;

    if (totalKonflik > 0 && Array.isArray(daftarKonflik)) {
      box.classList.remove('hidden');
      listEl.replaceChildren();
      daftarKonflik.forEach(k => {
        const item = document.createElement('div');
        item.className = 'p-3.5 rounded-xl bg-zinc-800 border border-zinc-700 space-y-1';
        const head = document.createElement('div');
        head.className = 'font-bold text-white';
        head.textContent = `[${k.kode}] ${k.jenis}: ${k.deskripsi}`;
        const saran = document.createElement('div');
        saran.className = 'text-zinc-300 text-[11px]';
        saran.textContent = `Saran Perbaikan: ${k.saran}`;
        item.append(head, saran);
        listEl.appendChild(item);
      });
    } else {
      box.classList.add('hidden');
      listEl.replaceChildren();
    }
  }

  async function simulasiKonflik() {
    try {
      const res = await fetch('/api/jadwal/revisi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: 2, hari: 'Senin', jamMulai: '07:00', jamSelesai: '08:40', ruang: 'F6.001' })
      });
      const data = await res.json();
      renderKonflikState(data.totalKonflik, data.konflik, data.status);
      showToast(data.pesan);
    } catch (err) {
      showToast('Gagal menguji konflik: ' + err.message);
    }
  }

  async function runAIGenerate() {
    const btn = document.getElementById('btnGenerateAI');
    const spanText = btn.querySelector('span');
    if (spanText) spanText.textContent = 'Menyusun Jadwal (AI)...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/generate', { method: 'POST' });
      const data = await res.json();
      renderKonflikState(0, [], data.result.status);
      showToast(data.result.message);
    } catch (err) {
      showToast('Gagal: ' + err.message);
    } finally {
      if (spanText) spanText.textContent = 'Generate Jadwal (AI)';
      btn.disabled = false;
    }
  }

  async function toggleHardConstraint(id, btnEl) {
    const current = btnEl.getAttribute('data-active') === 'true';
    const nextState = !current;
    try {
      const res = await fetch('/api/constraints/hard', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, isActive: nextState })
      });
      const data = await res.json();
      if (!res.ok) return showToast(data.pesan);
      btnEl.setAttribute('data-active', String(nextState));
      btnEl.textContent = nextState ? 'Aktif' : 'Nonaktif';
      btnEl.className = nextState
        ? 'btn-press text-[10px] px-2.5 py-0.5 rounded bg-zinc-900 text-white font-mono'
        : 'btn-press text-[10px] px-2.5 py-0.5 rounded bg-zinc-200 text-zinc-700 font-mono';
      showToast(`${data.constraint.nama}: ${nextState ? 'Diaktifkan' : 'Dinonaktifkan'}`);
    } catch (err) {
      showToast('Gagal mengubah constraint: ' + err.message);
    }
  }

  function switchMasterFormFields() {
    const kat = document.getElementById('master-form-kategori').value;
    document.getElementById('fields-master-dosen').classList.toggle('hidden', kat !== 'dosen');
    document.getElementById('fields-master-matkul').classList.toggle('hidden', kat !== 'matkul');
    document.getElementById('fields-master-ruangan').classList.toggle('hidden', kat !== 'ruangan');
    document.getElementById('masterFormError').classList.add('hidden');
  }

  async function submitMasterForm(e) {
    e.preventDefault();
    const kategori = document.getElementById('master-form-kategori').value;
    const errEl = document.getElementById('masterFormError');
    errEl.classList.add('hidden');

    let payload = { kategori };
    if (kategori === 'dosen') {
      payload.inisial = document.getElementById('in-dosen-inisial').value.trim();
      payload.nama = document.getElementById('in-dosen-nama').value.trim();
      payload.keahlian = document.getElementById('in-dosen-keahlian').value.trim();
      payload.bebanSks = document.getElementById('in-dosen-sks').value;
    } else if (kategori === 'matkul') {
      payload.kode = document.getElementById('in-mk-kode').value.trim();
      payload.nama = document.getElementById('in-mk-nama').value.trim();
      payload.sks = document.getElementById('in-mk-sks').value;
      payload.semester = document.getElementById('in-mk-sem').value;
    } else {
      payload.kode = document.getElementById('in-ruang-kode').value.trim();
      payload.nama = document.getElementById('in-ruang-nama').value.trim();
      payload.kapasitas = document.getElementById('in-ruang-kapasitas').value;
      payload.gedung = document.getElementById('in-ruang-gedung').value;
    }

    try {
      const res = await fetch('/api/master', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) {
        errEl.textContent = data.pesan;
        errEl.classList.remove('hidden');
        return;
      }

      // Jika menambah dosen, langsung perbarui tabel dosen di DOM
      if (kategori === 'dosen' && data.item) {
        appendDosenToTable(data.item);
      }

      // Reset form fields
      if (kategori === 'dosen') {
        document.getElementById('in-dosen-inisial').value = '';
        document.getElementById('in-dosen-nama').value = '';
        document.getElementById('in-dosen-keahlian').value = '';
        document.getElementById('in-dosen-sks').value = '12';
      }

      closeModal('modal-tambah-master');
      showToast(data.pesan);
    } catch (err) {
      showToast('Gagal menyimpan data master: ' + err.message);
    }
  }

  function appendDosenToTable(item) {
    const tbody = document.getElementById('tbodyMasterDosen');
    if (!tbody) return;
    const currentRows = tbody.querySelectorAll('tr.master-row');
    const newIdx = currentRows.length + 1;

    const tr = document.createElement('tr');
    tr.id = `dosen-row-${item.id}`;
    tr.className = 'master-row hover:bg-zinc-50/50';
    tr.setAttribute('data-id', item.id);
    tr.setAttribute('data-inisial', item.inisial || '');
    tr.setAttribute('data-nama', item.nama || '');
    tr.setAttribute('data-keahlian', item.keahlian || '');
    tr.setAttribute('data-sks', item.bebanSks || 12);

    tr.innerHTML = `
      <td class="p-3 font-mono text-zinc-400 tabular-nums cell-idx">${newIdx}</td>
      <td class="p-3 font-mono font-bold text-zinc-900 cell-inisial">${escapeHtml(item.inisial || '')}</td>
      <td class="p-3 font-semibold text-zinc-900 cell-nama">${escapeHtml(item.nama || '')}</td>
      <td class="p-3 text-zinc-600 cell-keahlian">${escapeHtml(item.keahlian || '')}</td>
      <td class="p-3 text-right font-mono text-zinc-700 tabular-nums cell-sks">${item.bebanSks || 12} SKS</td>
      <td class="p-3 text-right whitespace-nowrap">
        <div class="inline-flex items-center gap-1.5 justify-end">
          <button type="button" onclick="openEditDosenModal(${item.id})" class="btn-press px-2.5 py-1 rounded-lg bg-zinc-100 hover:bg-zinc-200 text-zinc-800 font-semibold text-[11px] inline-flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            Edit
          </button>
          <button type="button" onclick="deleteDosenItem(${item.id})" class="btn-press px-2.5 py-1 rounded-lg bg-zinc-100 hover:bg-red-50 hover:text-red-700 text-zinc-600 font-semibold text-[11px] inline-flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            Hapus
          </button>
        </div>
      </td>
    `;
    tbody.appendChild(tr);

    // Update count dosen
    const countEl = document.getElementById('countDosen');
    if (countEl) countEl.textContent = newIdx;
  }

  function openEditDosenModal(id) {
    const row = document.getElementById(`dosen-row-${id}`);
    if (!row) return;

    document.getElementById('edit-dosen-id').value = id;
    document.getElementById('edit-dosen-inisial').value = row.getAttribute('data-inisial') || '';
    document.getElementById('edit-dosen-nama').value = row.getAttribute('data-nama') || '';
    document.getElementById('edit-dosen-keahlian').value = row.getAttribute('data-keahlian') || '';
    document.getElementById('edit-dosen-sks').value = row.getAttribute('data-sks') || '12';

    const errEl = document.getElementById('editDosenError');
    if (errEl) errEl.classList.add('hidden');

    openModal('modal-edit-dosen');
  }

  async function submitEditDosen(e) {
    e.preventDefault();
    const id = document.getElementById('edit-dosen-id').value;
    const inisial = document.getElementById('edit-dosen-inisial').value.trim();
    const nama = document.getElementById('edit-dosen-nama').value.trim();
    const keahlian = document.getElementById('edit-dosen-keahlian').value.trim();
    const bebanSks = parseInt(document.getElementById('edit-dosen-sks').value, 10);
    const errEl = document.getElementById('editDosenError');
    const btnSubmit = document.getElementById('btnSubmitEditDosen');

    if (errEl) errEl.classList.add('hidden');
    if (btnSubmit) btnSubmit.disabled = true;

    try {
      const res = await fetch(`/api/master/dosen/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ inisial, nama, keahlian, bebanSks })
      });
      const data = await res.json();
      if (!res.ok) {
        if (errEl) {
          errEl.textContent = data.pesan || 'Gagal memperbarui data dosen.';
          errEl.classList.remove('hidden');
        }
        return;
      }

      // Update row di DOM
      const row = document.getElementById(`dosen-row-${id}`);
      if (row) {
        row.setAttribute('data-inisial', inisial);
        row.setAttribute('data-nama', nama);
        row.setAttribute('data-keahlian', keahlian);
        row.setAttribute('data-sks', bebanSks);

        const cInisial = row.querySelector('.cell-inisial');
        const cNama = row.querySelector('.cell-nama');
        const cKeahlian = row.querySelector('.cell-keahlian');
        const cSks = row.querySelector('.cell-sks');

        if (cInisial) cInisial.textContent = inisial;
        if (cNama) cNama.textContent = nama;
        if (cKeahlian) cKeahlian.textContent = keahlian;
        if (cSks) cSks.textContent = `${bebanSks} SKS`;
      }

      closeModal('modal-edit-dosen');
      showToast(data.pesan || 'Data dosen berhasil diperbarui.');
    } catch (err) {
      if (errEl) {
        errEl.textContent = 'Gagal menyimpan: ' + err.message;
        errEl.classList.remove('hidden');
      }
    } finally {
      if (btnSubmit) btnSubmit.disabled = false;
    }
  }

  async function deleteDosenItem(id) {
    const row = document.getElementById(`dosen-row-${id}`);
    const nama = row ? (row.getAttribute('data-nama') || `ID ${id}`) : `ID ${id}`;

    if (!confirm(`Hapus data dosen "${nama}" dari Data Master?`)) {
      return;
    }

    try {
      const res = await fetch(`/api/master/dosen/${id}`, {
        method: 'DELETE'
      });
      const data = await res.json();
      if (!res.ok) {
        return showToast(data.pesan || 'Gagal menghapus dosen.');
      }

      // Hapus row dari DOM
      if (row) row.remove();

      // Re-index nomor urut tabel dosen
      const tbody = document.getElementById('tbodyMasterDosen');
      if (tbody) {
        const rows = tbody.querySelectorAll('tr.master-row');
        rows.forEach((r, idx) => {
          const idxCell = r.querySelector('.cell-idx');
          if (idxCell) idxCell.textContent = idx + 1;
        });
        const countEl = document.getElementById('countDosen');
        if (countEl) countEl.textContent = rows.length;
      }

      showToast(data.pesan || `Dosen ${nama} berhasil dihapus.`);
    } catch (err) {
      showToast('Gagal menghapus dosen: ' + err.message);
    }
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function openRevisiModal(id, matkul, hari, mulai, selesai, ruang) {
    document.getElementById('rev-id').value = id;
    document.getElementById('rev-matkul-label').textContent = matkul;
    document.getElementById('rev-hari').value = hari;
    document.getElementById('rev-mulai').value = mulai;
    document.getElementById('rev-selesai').value = selesai;
    document.getElementById('rev-ruang').value = ruang;
    openModal('modal-revisi-jadwal');
  }

  async function submitRevisiJadwal(e) {
    e.preventDefault();
    const id = Number(document.getElementById('rev-id').value);
    const hari = document.getElementById('rev-hari').value;
    const jamMulai = document.getElementById('rev-mulai').value;
    const jamSelesai = document.getElementById('rev-selesai').value;
    const ruang = document.getElementById('rev-ruang').value;

    try {
      const res = await fetch('/api/jadwal/revisi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, hari, jamMulai, jamSelesai, ruang })
      });
      const data = await res.json();
      if (!res.ok) return showToast(data.pesan);

      renderKonflikState(data.totalKonflik, data.konflik, data.status);
      closeModal('modal-revisi-jadwal');
      showToast(data.pesan);
    } catch (err) {
      showToast('Gagal menyimpan revisi: ' + err.message);
    }
  }

  async function saveDosenPref(e) {
    e.preventDefault();
    const hariOff = document.getElementById('pref-hari-off').value;
    const alasan = document.getElementById('pref-alasan').value.trim();

    try {
      const res = await fetch('/api/constraints/preferensi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          dosenNama: 'Muhammad Abdul Haq, S.Tr.T., M.Eng. Ph.D.',
          hariOff,
          alasan
        })
      });
      const data = await res.json();
      if (!res.ok) return showToast(data.pesan);

      document.getElementById('dosenOffDayLabel').textContent = hariOff;
      document.getElementById('dosenOffReasonLabel').textContent = alasan;
      closeModal('modal-preferensi-dosen');
      showToast(data.pesan);
    } catch (err) {
      showToast('Gagal: ' + err.message);
    }
  }

  async function publishSchedule() {
    try {
      const res = await fetch('/api/jadwal/publish', { method: 'POST' });
      const data = await res.json();
      showToast(data.pesan || data.message);
    } catch (err) {
      showToast('Gagal publikasi: ' + err.message);
    }
  }

  async function testApiEndpoint(ep) {
    document.getElementById('sys-endpoint-url').textContent = ep;
    const jsonEl = document.getElementById('sys-json-output');
    const msEl = document.getElementById('sys-response-time');
    jsonEl.textContent = '// Memuat...';

    const t0 = performance.now();
    try {
      const res = await fetch(ep);
      const data = await res.json();
      const t1 = performance.now();
      msEl.textContent = (t1 - t0).toFixed(1) + ' ms';
      jsonEl.textContent = JSON.stringify(data, null, 2);
    } catch (err) {
      jsonEl.textContent = 'Error: ' + err.message;
    }
  }

  function copySysOutput() {
    const text = document.getElementById('sys-json-output').textContent;
    navigator.clipboard.writeText(text);
    showToast('JSON disalin ke clipboard.');
  }

  // Countdown Ticker Format HH:MM:SS left (Sesuai Lampiran 3: xx:xx:xx left)
  let tickerSeconds = 42 * 60 + 15;
  setInterval(() => {
    if (tickerSeconds > 0) {
      tickerSeconds--;
      const h = Math.floor(tickerSeconds / 3600);
      const m = Math.floor((tickerSeconds % 3600) / 60);
      const s = tickerSeconds % 60;
      const el = document.getElementById('countdownTicker');
      if (el) {
        el.textContent = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} left`;
      }
    }
  }, 1000);

  // Inisialisasi awal: Buka Layar 1 (Landing Jadwalin) secara linear
  updatePersonalGreetings('ANDI PRATAMA');
  applyMahasiswaScheduleFilter();
  showLandingView();
</script>

