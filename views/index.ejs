<!-- ==================== MODAL: TAMBAH DATA MASTER (US-01) ==================== -->
<div id="modal-tambah-master" data-open="false" class="modal-backdrop fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" onclick="if(event.target === this) closeModal('modal-tambah-master')">
  <div class="modal-panel bg-white rounded-2xl max-w-md w-full p-6 shadow-mac-lg border border-zinc-200 space-y-4 text-xs">
    <div class="flex justify-between items-center pb-2 border-b border-zinc-100">
      <h3 class="text-base font-bold text-zinc-900">Tambah Data Master Akademik</h3>
      <button onclick="closeModal('modal-tambah-master')" class="text-zinc-400 hover:text-zinc-700 text-lg font-bold leading-none">&times;</button>
    </div>

    <form onsubmit="submitMasterForm(event)" class="space-y-3">
      <div>
        <label class="font-bold text-zinc-800 block mb-1">Kategori Data:</label>
        <select id="master-form-kategori" onchange="switchMasterFormFields()" class="w-full py-2 px-3 rounded-lg border border-zinc-300 bg-white font-semibold">
          <option value="dosen">Dosen</option>
          <option value="matkul">Mata Kuliah</option>
          <option value="ruangan">Ruangan</option>
        </select>
      </div>

      <div id="fields-master-dosen" class="space-y-2.5">
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="font-bold text-zinc-800 block mb-1">Inisial:</label>
            <input id="in-dosen-inisial" type="text" placeholder="HW" maxlength="4" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 font-mono uppercase">
          </div>
          <div>
            <label class="font-bold text-zinc-800 block mb-1">Beban SKS:</label>
            <input id="in-dosen-sks" type="number" min="1" max="48" value="12" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 tabular-nums">
          </div>
        </div>
        <div>
          <label class="font-bold text-zinc-800 block mb-1">Nama Lengkap &amp; Gelar:</label>
          <input id="in-dosen-nama" type="text" placeholder="Dr. Hendrawan, S.T., M.Kom." class="w-full py-1.5 px-3 rounded-lg border border-zinc-300">
        </div>
        <div>
          <label class="font-bold text-zinc-800 block mb-1">Bidang Keahlian:</label>
          <input id="in-dosen-keahlian" type="text" placeholder="Keamanan Jaringan" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300">
        </div>
      </div>

      <div id="fields-master-matkul" class="hidden space-y-2.5">
        <div>
          <label class="font-bold text-zinc-800 block mb-1">Kode Mata Kuliah:</label>
          <input id="in-mk-kode" type="text" placeholder="TI509" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 font-mono uppercase">
        </div>
        <div>
          <label class="font-bold text-zinc-800 block mb-1">Nama Mata Kuliah:</label>
          <input id="in-mk-nama" type="text" placeholder="Arsitektur Cloud Lanjut" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300">
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="font-bold text-zinc-800 block mb-1">SKS:</label>
            <input id="in-mk-sks" type="number" min="1" max="6" value="3" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 tabular-nums">
          </div>
          <div>
            <label class="font-bold text-zinc-800 block mb-1">Semester:</label>
            <input id="in-mk-sem" type="number" min="1" max="8" value="5" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 tabular-nums">
          </div>
        </div>
      </div>

      <div id="fields-master-ruangan" class="hidden space-y-2.5">
        <div>
          <label class="font-bold text-zinc-800 block mb-1">Kode Ruang:</label>
          <input id="in-ruang-kode" type="text" placeholder="F6.204" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 font-mono">
        </div>
        <div>
          <label class="font-bold text-zinc-800 block mb-1">Nama Ruangan:</label>
          <input id="in-ruang-nama" type="text" placeholder="Ruang Kuliah F6.204" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300">
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="font-bold text-zinc-800 block mb-1">Kapasitas:</label>
            <input id="in-ruang-kapasitas" type="number" min="10" max="200" value="40" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 tabular-nums">
          </div>
          <div>
            <label class="font-bold text-zinc-800 block mb-1">Gedung:</label>
            <select id="in-ruang-gedung" class="w-full py-1.5 px-3 rounded-lg border border-zinc-300 bg-white">
              <option value="F6">F6</option>
              <option value="F4">F4</option>
            </select>
          </div>
        </div>
      </div>

      <div id="masterFormError" class="hidden p-2.5 rounded-lg bg-zinc-100 border border-zinc-300 text-zinc-900 font-semibold text-[11px]"></div>

      <button type="submit" class="btn-press w-full py-2.5 rounded-xl bg-zinc-900 text-white font-bold">
        Simpan ke Data Master
      </button>
    </form>
  </div>
</div>

<!-- ==================== MODAL: EDIT DATA DOSEN (CRUD) ==================== -->
<div id="modal-edit-dosen" data-open="false" class="modal-backdrop fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4" onclick="if(event.target === this) closeModal('modal-edit-dosen')">
