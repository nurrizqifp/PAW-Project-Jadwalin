<%- include('../partials/head', { judul: '500 — Terjadi Kesalahan Server · Jadwalin' }) %>

<div class="min-h-screen flex items-center justify-center p-4">
  <div class="text-center bg-white dark:bg-zinc-900 p-8 rounded-2xl shadow-sm border border-zinc-200 dark:border-zinc-800 max-w-md w-full space-y-4">
    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-rose-50 text-rose-600 dark:bg-rose-950/50 dark:text-rose-400">
      <i class="ph ph-warning-octagon text-2xl"></i>
    </div>
    
    <div>
      <span class="font-mono text-xs font-semibold uppercase tracking-widest text-rose-500">Error 500</span>
      <h1 class="font-heading text-xl font-bold text-zinc-900 dark:text-zinc-50 mt-1">Kendala Pemrosesan Server</h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2 leading-relaxed">
        <%= typeof pesanError !== 'undefined' ? pesanError : 'Terjadi kendala pada sistem backend. Silakan coba kembali beberapa saat lagi.' %>
      </p>
    </div>

    <div class="pt-2 flex items-center justify-center gap-2">
      <a href="/" class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 text-white rounded-md text-xs font-medium hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors">
        <i class="ph ph-house"></i>
        <span>Kembali ke Beranda</span>
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
