<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Preview & Publikasi Jadwal — Jadwalin' }) %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/sidebar', { activeMenu: 'jadwal' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
    <div class="max-w-6xl mx-auto space-y-6">

      <!-- Header & Status Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="rounded bg-emerald-100 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
              STATUS: PUBLISHED (v1.0)
            </span>
            <span class="text-xs text-zinc-400 font-mono">0 Konflik Hard Constraint</span>
          </div>
          <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
            Matriks Jadwal Perkuliahan Resmi
          </h1>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Tinjau seluruh alokasi slot perkuliahan semester ganjil sebelum atau sesudah publikasi.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button type="button" class="inline-flex min-h-[40px] items-center gap-2 rounded-md border border-zinc-200 bg-white px-3.5 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200">
            <i class="ph ph-file-arrow-down text-base"></i>
            <span>Export Excel</span>
          </button>
          <button type="button" class="inline-flex min-h-[40px] items-center gap-2 rounded-md bg-zinc-900 px-4 py-2 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors">
            <i class="ph ph-broadcast text-base"></i>
            <span>Publikasikan Jadwal</span>
          </button>
        </div>
      </div>

      <!-- Matriks Jadwal Table Container -->
      <div class="rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
              <tr>
                <th class="px-4 py-3 font-semibold">Hari & Jam</th>
                <th class="px-4 py-3 font-semibold">Mata Kuliah</th>
                <th class="px-4 py-3 font-semibold">Kelas</th>
                <th class="px-4 py-3 font-semibold">Dosen Pengampu</th>
                <th class="px-4 py-3 font-semibold">Ruangan</th>
                <th class="px-4 py-3 font-semibold">Kesesuaian Tipe</th>
                <th class="px-4 py-3 font-semibold text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
              <tr>
                <td class="px-4 py-3 font-mono">Senin, 08:00 - 09:40</td>
                <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">Pemrograman Berorientasi Objek</td>
                <td class="px-4 py-3 font-mono">B</td>
                <td class="px-4 py-3">Dr. Ir. Bambang Triatmaja, M.Kom.</td>
                <td class="px-4 py-3 font-mono">Lab Multimedia</td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1 font-mono text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">
                    <i class="ph ph-check-circle"></i> Lab Match
                  </span>
                </td>
                <td class="px-4 py-3 text-right">
                  <button type="button" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1">
                    <i class="ph ph-pencil-simple text-base"></i>
                  </button>
                </td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-mono">Senin, 10:00 - 11:40</td>
                <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">Kecerdasan Buatan</td>
                <td class="px-4 py-3 font-mono">B</td>
                <td class="px-4 py-3">Hendra Prasetyo, Ph.D.</td>
                <td class="px-4 py-3 font-mono">Ruang F3-202</td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1 font-mono text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">
                    <i class="ph ph-check-circle"></i> Regular Match
                  </span>
                </td>
                <td class="px-4 py-3 text-right">
                  <button type="button" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1">
                    <i class="ph ph-pencil-simple text-base"></i>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
  </div>
</div>

<%- include('../partials/footer') %>
