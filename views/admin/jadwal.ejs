<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Preview & Publikasi Jadwal — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'jadwal' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-7xl mx-auto space-y-6">

        <!-- Header & Action Status Bar -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2">
              <span class="rounded bg-emerald-100 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-800 dark:bg-emerald-950/80 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                STATUS: PUBLISHED (v1.0)
              </span>
              <span class="text-xs text-zinc-500 dark:text-zinc-400 font-mono flex items-center gap-1">
                <i class="ph ph-shield-check text-emerald-500"></i> 0 Konflik Hard Constraint
              </span>
            </div>
            <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
              Matriks Jadwal Perkuliahan Resmi
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Tinjau seluruh alokasi slot perkuliahan semester ganjil dalam mode Kalender Grid Mingguan atau Tabel Rinci.
            </p>
          </div>

          <!-- Group CTA Kanan yang Rapi & Proporsional -->
          <div class="flex items-center gap-3 shrink-0">
            <button type="button"
              onclick="window.showConfirmDialog('Export Matriks Jadwal', 'Unduh jadwal lengkap 111 sesi perkuliahan dalam format spreadsheet Excel (.xlsx)?', null, 'Unduh Excel', true)"
              class="inline-flex h-9 items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-700 transition-colors shadow-xs">
              <i class="ph ph-file-arrow-down text-base text-emerald-600 dark:text-emerald-400"></i>
              <span>Export Excel</span>
            </button>
            <button type="button"
              onclick="window.showConfirmDialog('Sinkronisasi & Publikasi Jadwal', 'Publikasikan jadwal versi terbaru ke seluruh mahasiswa dan dosen TI UMY?', () => {}, 'Publikasikan Sekarang')"
              class="inline-flex h-9 items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 text-xs font-semibold text-white shadow-sm border border-blue-900/40 transition-colors">
              <i class="ph ph-broadcast text-amber-400 text-sm"></i>
              <span>Publikasikan Jadwal</span>
            </button>
          </div>
        </div>

        <!-- Filter, View Switcher & Search Toolbar -->
        <div class="flex flex-col lg:flex-row items-center justify-between gap-3 rounded-xl border border-zinc-200 bg-white p-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          
          <!-- View Switcher Segmented Control (Grid vs Tabel) -->
          <div class="inline-flex w-full sm:w-auto rounded-lg border border-zinc-200 bg-zinc-100 p-1 dark:border-zinc-800 dark:bg-zinc-800/80">
            <button id="btn-view-grid" type="button"
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-xs dark:bg-zinc-900 dark:text-zinc-50 transition-all">
              <i class="ph ph-calendar-blank text-sm text-[#0c2b5e] dark:text-blue-400"></i>
              <span>Grid Mingguan</span>
            </button>
            <button id="btn-view-table" type="button"
              class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all">
              <i class="ph ph-table text-sm"></i>
              <span>Tabel Rinci</span>
            </button>
          </div>

          <!-- Search & Filter Options -->
          <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full lg:w-auto">
            <div class="relative w-full sm:w-64">
              <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
              <input id="jadwal-search-input" type="text" placeholder="Cari matkul, dosen, ruang..."
                class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border border-zinc-200 bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
              <select id="filter-hari-select"
                class="flex-1 sm:flex-initial text-xs rounded-lg border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 px-2.5 py-1.5 focus:outline-none">
                <option value="Semua">Semua Hari</option>
                <option value="Senin">Senin</option>
                <option value="Selasa">Selasa</option>
                <option value="Rabu">Rabu</option>
                <option value="Kamis">Kamis</option>
                <option value="Jumat">Jumat</option>
                <option value="Sabtu">Sabtu</option>
              </select>

              <select id="filter-tipe-select"
                class="flex-1 sm:flex-initial text-xs rounded-lg border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 px-2.5 py-1.5 focus:outline-none">
                <option value="Semua">Semua Jenis</option>
                <option value="Teori">Teori</option>
                <option value="Praktikum">Praktikum Lab</option>
              </select>

              <span class="text-xs font-mono text-zinc-400 px-1 hidden xl:inline">
                <strong class="text-zinc-700 dark:text-zinc-200"><%= jadwal ? jadwal.length : 0 %></strong> Sesi
              </span>
            </div>
          </div>

        </div>
          <div class="relative w-full sm:w-80">
            <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
            <input id="jadwal-search-input" type="text" placeholder="Cari matkul, dosen, atau ruang..."
              class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border border-zinc-200 bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-zinc-400">
          </div>

          <div class="flex items-center gap-2 w-full sm:w-auto overflow-x-auto">
            <select id="filter-hari-select"
              class="text-xs rounded-lg border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 px-2.5 py-1.5 focus:outline-none">
              <option value="Semua">Semua Hari</option>
              <option value="Senin">Senin</option>
              <option value="Selasa">Selasa</option>
              <option value="Rabu">Rabu</option>
              <option value="Kamis">Kamis</option>
              <option value="Jumat">Jumat</option>
              <option value="Sabtu">Sabtu</option>
            </select>

            <select id="filter-tipe-select"
              class="text-xs rounded-lg border border-zinc-200 bg-white dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 px-2.5 py-1.5 focus:outline-none">
              <option value="Semua">Semua Jenis</option>
              <option value="Teori">Teori (Kelas Reguler/RKB)</option>
              <option value="Praktikum">Praktikum (Lab Komputer)</option>
            </select>

            <span class="text-xs font-mono text-zinc-400 px-1 hidden md:inline">
              Total: <strong class="text-zinc-700 dark:text-zinc-200"><%= jadwal ? jadwal.length : 0 %></strong> Sesi
            </span>
          </div>
        </div>

        <!-- ---------------------------------------------------- -->
        <!-- VIEW 1: CALENDAR GRID VIEW (Grid Mingguan)           -->
        <!-- ---------------------------------------------------- -->
        <div id="container-grid-view" class="space-y-4">
          <div class="rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-left min-w-[900px]">
                <thead>
                  <tr class="border-b border-zinc-200 bg-zinc-50/80 dark:border-zinc-800 dark:bg-zinc-800/60 font-mono text-xs uppercase text-zinc-500">
                    <th class="sticky left-0 z-10 w-28 border-r border-zinc-200 bg-zinc-50/95 px-3 py-3 text-center dark:border-zinc-800 dark:bg-zinc-900/95">
                      Waktu
                    </th>
                    <% const namaHari = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu']; %>
                    <% namaHari.forEach(hari => { %>
                      <th class="border-r border-zinc-200 px-3 py-3 text-center dark:border-zinc-800">
                        <span class="font-bold text-zinc-800 dark:text-zinc-200"><%= hari %></span>
                      </th>
                    <% }); %>
                  </tr>
                </thead>
                <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 text-xs">

                  <!-- Slot 1: 07:00 - 08:40 -->
                  <tr class="h-28">
                    <td class="sticky left-0 z-10 border-r border-zinc-200 bg-zinc-50/90 px-3 py-2 font-mono text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900/90 align-top text-center">
                      <div class="font-semibold text-zinc-700 dark:text-zinc-300">07:00</div>
                      <div class="text-[10px] text-zinc-400">08:40</div>
                    </td>
                    <% namaHari.forEach(hari => { %>
                      <% const slotJadwal = (jadwal || []).filter(j => j.hari === hari && j.jamMulai.startsWith('07:')); %>
                      <td class="border-r border-zinc-200 p-1.5 dark:border-zinc-800 align-top <%= slotJadwal.length === 0 ? 'bg-zinc-50/20 dark:bg-zinc-950/20' : '' %>">
                        <div class="space-y-1.5">
                          <% slotJadwal.forEach(item => { %>
                            <div onclick="openEditModal('<%= item.mataKuliah %> (Kelas <%= item.kelas %>)', '<%= item.dosen %>', '<%= item.ruang %>', '<%= item.hari %>', '<%= item.jamMulai %>')"
                              class="cursor-pointer rounded-lg border p-2 shadow-xs transition-all hover:scale-[1.01] <%= item.jenis === 'Praktikum' ? 'border-amber-300 bg-amber-50/90 text-amber-950 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200' : 'border-blue-200 bg-blue-50/80 text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-200' %>">
                              <div class="flex items-center justify-between gap-1">
                                <span class="font-semibold truncate leading-tight font-heading text-[11px]"><%= item.mataKuliah %></span>
                                <span class="text-[9px] font-mono px-1 rounded <%= item.jenis === 'Praktikum' ? 'bg-amber-200/80 text-amber-900 dark:bg-amber-900/60 dark:text-amber-200' : 'bg-blue-200/80 text-blue-900 dark:bg-blue-900/60 dark:text-blue-200' %>">
                                  Kls <%= item.kelas %>
                                </span>
                              </div>
                              <div class="mt-1 flex items-center justify-between text-[10px] font-mono opacity-80">
                                <span><%= item.ruang %></span>
                                <span><%= item.sks %> SKS</span>
                              </div>
                              <div class="text-[10px] truncate text-zinc-600 dark:text-zinc-400 pt-0.5">
                                <%= item.dosen.split(',')[0] %>
                              </div>
                            </div>
                          <% }); %>
                        </div>
                      </td>
                    <% }); %>
                  </tr>

                  <!-- Slot 2: 08:50 - 11:30 -->
                  <tr class="h-28">
                    <td class="sticky left-0 z-10 border-r border-zinc-200 bg-zinc-50/90 px-3 py-2 font-mono text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900/90 align-top text-center">
                      <div class="font-semibold text-zinc-700 dark:text-zinc-300">08:50</div>
                      <div class="text-[10px] text-zinc-400">11:30</div>
                    </td>
                    <% namaHari.forEach(hari => { %>
                      <% const slotJadwal = (jadwal || []).filter(j => j.hari === hari && (j.jamMulai.startsWith('08:') || j.jamMulai.startsWith('09:') || j.jamMulai.startsWith('10:'))); %>
                      <td class="border-r border-zinc-200 p-1.5 dark:border-zinc-800 align-top <%= slotJadwal.length === 0 ? 'bg-zinc-50/20 dark:bg-zinc-950/20' : '' %>">
                        <div class="space-y-1.5">
                          <% slotJadwal.forEach(item => { %>
                            <div onclick="openEditModal('<%= item.mataKuliah %> (Kelas <%= item.kelas %>)', '<%= item.dosen %>', '<%= item.ruang %>', '<%= item.hari %>', '<%= item.jamMulai %>')"
                              class="cursor-pointer rounded-lg border p-2 shadow-xs transition-all hover:scale-[1.01] <%= item.jenis === 'Praktikum' ? 'border-amber-300 bg-amber-50/90 text-amber-950 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200' : 'border-blue-200 bg-blue-50/80 text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-200' %>">
                              <div class="flex items-center justify-between gap-1">
                                <span class="font-semibold truncate leading-tight font-heading text-[11px]"><%= item.mataKuliah %></span>
                                <span class="text-[9px] font-mono px-1 rounded <%= item.jenis === 'Praktikum' ? 'bg-amber-200/80 text-amber-900 dark:bg-amber-900/60 dark:text-amber-200' : 'bg-blue-200/80 text-blue-900 dark:bg-blue-900/60 dark:text-blue-200' %>">
                                  Kls <%= item.kelas %>
                                </span>
                              </div>
                              <div class="mt-1 flex items-center justify-between text-[10px] font-mono opacity-80">
                                <span><%= item.ruang %></span>
                                <span><%= item.sks %> SKS</span>
                              </div>
                              <div class="text-[10px] truncate text-zinc-600 dark:text-zinc-400 pt-0.5">
                                <%= item.dosen.split(',')[0] %>
                              </div>
                            </div>
                          <% }); %>
                        </div>
                      </td>
                    <% }); %>
                  </tr>

                  <!-- JEDA SHOLAT DHUHUR (Hard Constraint HC-03) -->
                  <tr class="bg-amber-50/50 dark:bg-amber-950/20 border-y border-amber-200/60 dark:border-amber-900/40">
                    <td class="sticky left-0 z-10 border-r border-zinc-200 bg-amber-50/80 px-3 py-2 font-mono text-zinc-600 text-center dark:border-zinc-800 dark:bg-amber-950/40 text-[11px]">
                      11:30–12:10
                    </td>
                    <td colspan="6" class="px-4 py-2 text-center font-mono text-xs text-amber-900 dark:text-amber-300">
                      <i class="ph ph-moon-stars mr-1.5 text-amber-500"></i>
                      <span>Jeda Ibadah Sholat Dhuhur & Istirahat (Hard Constraint HC-03 Terpenuhi)</span>
                    </td>
                  </tr>

                  <!-- Slot 3: 12:10 - 14:40 -->
                  <tr class="h-28">
                    <td class="sticky left-0 z-10 border-r border-zinc-200 bg-zinc-50/90 px-3 py-2 font-mono text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900/90 align-top text-center">
                      <div class="font-semibold text-zinc-700 dark:text-zinc-300">12:10</div>
                      <div class="text-[10px] text-zinc-400">14:40</div>
                    </td>
                    <% namaHari.forEach(hari => { %>
                      <% const slotJadwal = (jadwal || []).filter(j => j.hari === hari && (j.jamMulai.startsWith('12:') || j.jamMulai.startsWith('13:'))); %>
                      <td class="border-r border-zinc-200 p-1.5 dark:border-zinc-800 align-top <%= slotJadwal.length === 0 ? 'bg-zinc-50/20 dark:bg-zinc-950/20' : '' %>">
                        <div class="space-y-1.5">
                          <% slotJadwal.forEach(item => { %>
                            <div onclick="openEditModal('<%= item.mataKuliah %> (Kelas <%= item.kelas %>)', '<%= item.dosen %>', '<%= item.ruang %>', '<%= item.hari %>', '<%= item.jamMulai %>')"
                              class="cursor-pointer rounded-lg border p-2 shadow-xs transition-all hover:scale-[1.01] <%= item.jenis === 'Praktikum' ? 'border-amber-300 bg-amber-50/90 text-amber-950 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200' : 'border-blue-200 bg-blue-50/80 text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-200' %>">
                              <div class="flex items-center justify-between gap-1">
                                <span class="font-semibold truncate leading-tight font-heading text-[11px]"><%= item.mataKuliah %></span>
                                <span class="text-[9px] font-mono px-1 rounded <%= item.jenis === 'Praktikum' ? 'bg-amber-200/80 text-amber-900 dark:bg-amber-900/60 dark:text-amber-200' : 'bg-blue-200/80 text-blue-900 dark:bg-blue-900/60 dark:text-blue-200' %>">
                                  Kls <%= item.kelas %>
                                </span>
                              </div>
                              <div class="mt-1 flex items-center justify-between text-[10px] font-mono opacity-80">
                                <span><%= item.ruang %></span>
                                <span><%= item.sks %> SKS</span>
                              </div>
                              <div class="text-[10px] truncate text-zinc-600 dark:text-zinc-400 pt-0.5">
                                <%= item.dosen.split(',')[0] %>
                              </div>
                            </div>
                          <% }); %>
                        </div>
                      </td>
                    <% }); %>
                  </tr>

                  <!-- Slot 4: 14:50 - 17:20 -->
                  <tr class="h-28">
                    <td class="sticky left-0 z-10 border-r border-zinc-200 bg-zinc-50/90 px-3 py-2 font-mono text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900/90 align-top text-center">
                      <div class="font-semibold text-zinc-700 dark:text-zinc-300">14:50</div>
                      <div class="text-[10px] text-zinc-400">17:20</div>
                    </td>
                    <% namaHari.forEach(hari => { %>
                      <% const slotJadwal = (jadwal || []).filter(j => j.hari === hari && (j.jamMulai.startsWith('14:') || j.jamMulai.startsWith('15:') || j.jamMulai.startsWith('16:'))); %>
                      <td class="border-r border-zinc-200 p-1.5 dark:border-zinc-800 align-top <%= slotJadwal.length === 0 ? 'bg-zinc-50/20 dark:bg-zinc-950/20' : '' %>">
                        <div class="space-y-1.5">
                          <% slotJadwal.forEach(item => { %>
                            <div onclick="openEditModal('<%= item.mataKuliah %> (Kelas <%= item.kelas %>)', '<%= item.dosen %>', '<%= item.ruang %>', '<%= item.hari %>', '<%= item.jamMulai %>')"
                              class="cursor-pointer rounded-lg border p-2 shadow-xs transition-all hover:scale-[1.01] <%= item.jenis === 'Praktikum' ? 'border-amber-300 bg-amber-50/90 text-amber-950 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200' : 'border-blue-200 bg-blue-50/80 text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-200' %>">
                              <div class="flex items-center justify-between gap-1">
                                <span class="font-semibold truncate leading-tight font-heading text-[11px]"><%= item.mataKuliah %></span>
                                <span class="text-[9px] font-mono px-1 rounded <%= item.jenis === 'Praktikum' ? 'bg-amber-200/80 text-amber-900 dark:bg-amber-900/60 dark:text-amber-200' : 'bg-blue-200/80 text-blue-900 dark:bg-blue-900/60 dark:text-blue-200' %>">
                                  Kls <%= item.kelas %>
                                </span>
                              </div>
                              <div class="mt-1 flex items-center justify-between text-[10px] font-mono opacity-80">
                                <span><%= item.ruang %></span>
                                <span><%= item.sks %> SKS</span>
                              </div>
                              <div class="text-[10px] truncate text-zinc-600 dark:text-zinc-400 pt-0.5">
                                <%= item.dosen.split(',')[0] %>
                              </div>
                            </div>
                          <% }); %>
                        </div>
                      </td>
                    <% }); %>
                  </tr>

                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ---------------------------------------------------- -->
        <!-- VIEW 2: TABEL RINCI (List View dengan Filter Cepat)  -->
        <!-- ---------------------------------------------------- -->
        <div id="container-table-view" class="hidden space-y-4">
          <div class="rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs" id="jadwal-data-table">
                <thead class="border-b border-zinc-200 bg-zinc-50/80 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
                  <tr>
                    <th class="px-4 py-3 font-semibold">Hari & Jam</th>
                    <th class="px-4 py-3 font-semibold">Mata Kuliah</th>
                    <th class="px-4 py-3 font-semibold">Kelas & SKS</th>
                    <th class="px-4 py-3 font-semibold">Dosen Pengampu</th>
                    <th class="px-4 py-3 font-semibold">Ruangan</th>
                    <th class="px-4 py-3 font-semibold">Kategori</th>
                    <th class="px-4 py-3 font-semibold text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800" id="jadwal-tbody">
                  <% (jadwal || []).forEach(item => { %>
                    <tr class="jadwal-row hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 transition-colors"
                      data-hari="<%= item.hari %>"
                      data-jenis="<%= item.jenis %>"
                      data-search="<%= (item.mataKuliah + ' ' + item.dosen + ' ' + item.ruang + ' ' + item.kelas).toLowerCase() %>">
                      <td class="px-4 py-3 font-mono font-medium whitespace-nowrap text-zinc-700 dark:text-zinc-300">
                        <span class="inline-block w-14 font-semibold"><%= item.hari %>,</span>
                        <span><%= item.jamMulai %> - <%= item.jamSelesai %></span>
                      </td>
                      <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">
                        <%= item.mataKuliah %>
                      </td>
                      <td class="px-4 py-3 font-mono text-zinc-600 dark:text-zinc-400">
                        Kelas <%= item.kelas %> (<%= item.sks %> SKS)
                      </td>
                      <td class="px-4 py-3 text-zinc-700 dark:text-zinc-300 max-w-[220px] truncate" title="<%= item.dosen %>">
                        <%= item.dosen %>
                      </td>
                      <td class="px-4 py-3 font-mono text-zinc-700 dark:text-zinc-300">
                        <%= item.ruang %>
                      </td>
                      <td class="px-4 py-3">
                        <% if (item.jenis === 'Praktikum') { %>
                          <span class="inline-flex items-center gap-1 font-mono text-[10px] text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/60 px-2 py-0.5 rounded border border-amber-200 dark:border-amber-800 font-semibold">
                            <i class="ph ph-flask"></i> Praktikum Lab
                          </span>
                        <% } else { %>
                          <span class="inline-flex items-center gap-1 font-mono text-[10px] text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/60 px-2 py-0.5 rounded border border-blue-200 dark:border-blue-900 font-semibold">
                            <i class="ph ph-chalkboard"></i> Kuliah Teori
                          </span>
                        <% } %>
                      </td>
                      <td class="px-4 py-3 text-right">
                        <button type="button"
                          onclick="openEditModal('<%= item.mataKuliah %> (Kelas <%= item.kelas %>)', '<%= item.dosen %>', '<%= item.ruang %>', '<%= item.hari %>', '<%= item.jamMulai %>')"
                          class="inline-flex items-center gap-1 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 px-2 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                          <i class="ph ph-pencil-simple text-sm"></i>
                          <span>Edit</span>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  // Logika Switcher Grid vs Tabel
  (function initJadwalSwitcher() {
    const btnGrid = document.getElementById('btn-view-grid');
    const btnTable = document.getElementById('btn-view-table');
    const gridView = document.getElementById('container-grid-view');
    const tableView = document.getElementById('container-table-view');

    if (btnGrid && btnTable && gridView && tableView) {
      btnGrid.addEventListener('click', () => {
        gridView.classList.remove('hidden');
        tableView.classList.add('hidden');
        btnGrid.className = 'inline-flex items-center gap-1.5 rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-zinc-900 shadow-sm dark:bg-zinc-900 dark:text-zinc-50 transition-all';
        btnTable.className = 'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
      });

      btnTable.addEventListener('click', () => {
        gridView.classList.add('hidden');
        tableView.classList.remove('hidden');
        btnTable.className = 'inline-flex items-center gap-1.5 rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-zinc-900 shadow-sm dark:bg-zinc-900 dark:text-zinc-50 transition-all';
        btnGrid.className = 'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
      });
    }

    // Filter Interaktif pada Tabel Rinci
    const searchInput = document.getElementById('jadwal-search-input');
    const filterHari = document.getElementById('filter-hari-select');
    const filterTipe = document.getElementById('filter-tipe-select');
    const rows = document.querySelectorAll('.jadwal-row');

    function applyFilter() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const hari = filterHari?.value || 'Semua';
      const tipe = filterTipe?.value || 'Semua';

      rows.forEach(row => {
        const text = row.getAttribute('data-search') || '';
        const rowHari = row.getAttribute('data-hari') || '';
        const rowTipe = row.getAttribute('data-jenis') || '';

        const matchSearch = !q || text.includes(q);
        const matchHari = hari === 'Semua' || rowHari === hari;
        const matchTipe = tipe === 'Semua' || rowTipe === tipe;

        row.style.display = (matchSearch && matchHari && matchTipe) ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', applyFilter);
    filterHari?.addEventListener('change', applyFilter);
    filterTipe?.addEventListener('change', applyFilter);
  })();
</script>
