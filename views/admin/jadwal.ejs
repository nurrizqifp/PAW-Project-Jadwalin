                                                data-hari="<%= item.hari %>" data-jenis="<%= item.jenis %>"
                                                data-conflict="<%= isBentrok ? 'true' : 'false' %>"
                                                data-search="<%= ((item.kodeMatkul || '') + ' ' + item.mataKuliah + ' ' + item.dosen + ' ' + item.ruang + ' ' + item.kelas + (isBentrok ? ' bentrok konflik error' : '')).toLowerCase() %>">
                                                <div class="flex items-center justify-between gap-1">
                                                  <span
                                                    class="font-mono text-[9px] font-bold px-1 rounded <%= isBentrok ? 'bg-rose-600 text-white' : (item.jenis === 'Praktikum' ? 'bg-amber-200/80 text-amber-900 dark:bg-amber-900 dark:text-amber-200' : 'bg-blue-200/80 text-blue-900 dark:bg-blue-900 dark:text-blue-200') %>">
                                                    <%= item.kodeMatkul || 'TI261' %>
                                                  </span>
                                                  <% if (isBentrok) { %>
                                                    <span
                                                      class="text-[9px] font-mono font-bold text-rose-700 dark:text-rose-300 flex items-center gap-0.5">
                                                      <i class="ph ph-warning-octagon"></i> KONFLIK
                                                    </span>
                                                    <% } else { %>
                                                      <span class="text-[9px] font-mono font-semibold opacity-90">Kls
                                                        <%= item.kelas %>
                                                      </span>
                                                      <% } %>
                                                </div>
                                                <h4
                                                  class="font-heading font-semibold text-[11px] leading-tight pt-1 truncate"
                                                  title="<%= item.mataKuliah %>">
                                                  <%= item.mataKuliah %>
                                                </h4>
                                                <% if (isBentrok && item.conflictReasons && item.conflictReasons.length>
                                                  0) { %>
                                                  <p class="text-[9px] font-mono text-rose-700 dark:text-rose-300 font-semibold truncate pt-0.5"
                                                    title="<%= item.conflictReasons.join(' | ') %>">
                                                    <i class="ph ph-warning"></i>
                                                    <%= item.conflictReasons[0] %>
                                                  </p>
                                                  <% } %>
                                                    <div
                                                      class="mt-1 flex items-center justify-between text-[10px] font-mono opacity-80">
                                                      <span
                                                        class="<%= isBentrok ? 'font-bold underline text-rose-700 dark:text-rose-300' : '' %>">
                                                        <%= item.ruang %>
                                                      </span>
                                                      <span>
                                                        <%= item.sks %> SKS
                                                      </span>
                                                    </div>
                                              </div>
                                              <% }); %>
                                        </div>
                                      </td>
                                      <% }); %>
                                </tr>

                                <!-- Slot 4: 14:50 - 17:20 -->
                                <tr class="min-h-24">
                                  <td
                                    class="border-r border-zinc-200 bg-zinc-50/90 px-2 py-3 font-mono text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900/90 align-top text-center">
