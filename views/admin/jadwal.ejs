                                    <div class="text-[10px] text-zinc-400">17:20</div>
                                  </td>
                                  <% daysOfWeek.forEach(hari=> { %>
                                    <% const slotJadwal=(jadwal || []).filter(j=> j.hari === hari &&
                                      (j.jamMulai.startsWith('14:') || j.jamMulai.startsWith('15:') ||
                                      j.jamMulai.startsWith('16:'))); %>
                                      <td
                                        class="border-r border-zinc-200 p-1.5 dark:border-zinc-800 align-top last:border-r-0 <%= slotJadwal.length === 0 ? 'bg-zinc-50/20 dark:bg-zinc-950/20' : '' %>">
                                        <div class="space-y-1.5">
                                          <% slotJadwal.forEach(item=> { %>
                                            <% const isBentrok=Boolean(item.isConflict); const cardBorderBg=isBentrok
                                              ? 'border-rose-400 bg-rose-50/95 text-rose-950 dark:border-rose-700 dark:bg-rose-950/80 dark:text-rose-100 ring-2 ring-rose-500/40'
                                              : (item.jenis==='Praktikum'
                                              ? 'border-amber-300 bg-amber-50/90 text-amber-950 dark:border-amber-700/60 dark:bg-amber-950/40 dark:text-amber-200'
                                              : 'border-blue-200 bg-blue-50/80 text-blue-950 dark:border-blue-900/60 dark:bg-blue-950/40 dark:text-blue-200'
                                              ); %>
                                              <div
                                                onclick="openEditModal('<%= item.mataKuliah %> (Kelas <%= item.kelas %>)', '<%= item.dosen %>', '<%= item.ruang %>', '<%= item.hari %>', '<%= item.jamMulai %>', '<%= item.id %>', '<%= isBentrok ? (item.conflictReasons || []).join('; ') : '' %>')"
                                                class="grid-slot-card cursor-pointer rounded-lg border p-2 shadow-xs transition-transform hover:scale-[1.01] <%= cardBorderBg %>"
                                                data-hari="<%= item.hari %>" data-jenis="<%= item.jenis %>"
                                                data-conflict="<%= isBentrok ? 'true' : 'false' %>"
                                                data-search="<%= ((item.kodeMatkul || '') + ' ' + item.mataKuliah + ' ' + item.dosen + ' ' + item.ruang + ' ' + item.kelas + (isBentrok ? ' bentrok konflik error' : '')).toLowerCase() %>">
                                                <div class="flex items-center justify-between gap-1">
                                                  <span
                                                    class="font-mono text-[9px] font-bold px-1 rounded <%= isBentrok ? 'bg-rose-600 text-white' : (item.jenis === 'Praktikum' ? 'bg-amber-200/80 text-amber-900 dark:bg-amber-900 dark:text-amber-200' : 'bg-blue-200/80 text-blue-900 dark:bg-blue-900 dark:text-blue-200') %>">
                                                    <%= item.kodeMatkul || 'TI261' %>
                                                  </span>
                                                  <% if (isBentrok) { %>
                                                    <span
                                                      class="text-[9px] font-mono font-bold text-rose-700 dark:text-rose-300 flex items-center gap-0.5">
                                                      <i class="ph ph-warning-octagon"></i> KONFLIK
                                                    </span>
                                                    <% } else { %>
                                                      <span class="text-[9px] font-mono font-semibold opacity-90">Kls
                                                        <%= item.kelas %>
                                                      </span>
                                                      <% } %>
                                                </div>
                                                <h4
                                                  class="font-heading font-semibold text-[11px] leading-tight pt-1 truncate"
                                                  title="<%= item.mataKuliah %>">
                                                  <%= item.mataKuliah %>
                                                </h4>
                                                <% if (isBentrok && item.conflictReasons && item.conflictReasons.length>
                                                  0) { %>
                                                  <p class="text-[9px] font-mono text-rose-700 dark:text-rose-300 font-semibold truncate pt-0.5"
                                                    title="<%= item.conflictReasons.join(' | ') %>">
                                                    <i class="ph ph-warning"></i>
                                                    <%= item.conflictReasons[0] %>
                                                  </p>
                                                  <% } %>
                                                    <div
                                                      class="mt-1 flex items-center justify-between text-[10px] font-mono opacity-80">
                                                      <span
                                                        class="<%= isBentrok ? 'font-bold underline text-rose-700 dark:text-rose-300' : '' %>">
                                                        <%= item.ruang %>
                                                      </span>
                                                      <span>
                                                        <%= item.sks %> SKS
                                                      </span>
                                                    </div>
                                              </div>
                                              <% }); %>
                                        </div>
                                      </td>
                                      <% }); %>
                                </tr>

                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>

                      <!-- ---------------------------------------------------- -->
                      <!-- VIEW 2: TABEL RINCI (Lengkap Kolom Kode MK)          -->
                      <!-- ---------------------------------------------------- -->
                      <div id="container-table-view" class="hidden space-y-4">
                        <div
                          class="rounded-xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
                          <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs" id="jadwal-data-table">
                              <thead
                                class="border-b border-zinc-200 bg-zinc-50/80 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
                                <tr>
                                  <th class="px-4 py-3 font-semibold">Kode MK</th>
                                  <th class="px-4 py-3 font-semibold">Mata Kuliah</th>
                                  <th class="px-4 py-3 font-semibold">Hari & Jam</th>
                                  <th class="px-4 py-3 font-semibold">Kelas & SKS</th>
                                  <th class="px-4 py-3 font-semibold">Dosen Pengampu</th>
                                  <th class="px-4 py-3 font-semibold">Ruangan</th>
                                  <th class="px-4 py-3 font-semibold">Kategori</th>
                                  <th class="px-4 py-3 font-semibold text-right">Aksi</th>
                                </tr>
                              </thead>
                              <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800" id="jadwal-tbody">
                                <% (jadwal || []).forEach(item=> { %>
                                  <% const isBentrok=Boolean(item.isConflict); %>
                                    <tr
                                      class="jadwal-row transition-colors <%= isBentrok ? 'bg-rose-50/90 dark:bg-rose-950/40 border-l-4 border-l-rose-600 hover:bg-rose-100/70 dark:hover:bg-rose-900/40 text-rose-950 dark:text-rose-100' : 'hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40' %>"
                                      data-hari="<%= item.hari %>" data-jenis="<%= item.jenis %>"
                                      data-conflict="<%= isBentrok ? 'true' : 'false' %>"
                                      data-search="<%= ((item.kodeMatkul || '') + ' ' + item.mataKuliah + ' ' + item.dosen + ' ' + item.ruang + ' ' + item.kelas + (isBentrok ? ' bentrok konflik error' : '')).toLowerCase() %>">
                                      <td
                                        class="px-4 py-3 font-mono font-bold <%= isBentrok ? 'text-rose-700 dark:text-rose-300' : 'text-zinc-900 dark:text-zinc-100' %>">
                                        <%= item.kodeMatkul || 'TI261' %>
                                          <% if (isBentrok) { %>
                                            <span
                                              class="block text-[9px] font-mono font-bold text-rose-600 dark:text-rose-400">KONFLIK</span>
                                            <% } %>
                                      </td>
                                      <td class="px-4 py-3">
                                        <div
                                          class="font-semibold <%= isBentrok ? 'text-rose-900 dark:text-rose-100 font-bold' : 'text-zinc-900 dark:text-zinc-100' %>">
                                          <%= item.mataKuliah %>
                                        </div>
                                        <% if (isBentrok && item.conflictReasons && item.conflictReasons.length> 0) { %>
                                          <div
                                            class="text-[10px] font-mono text-rose-600 dark:text-rose-400 mt-0.5 flex items-center gap-1 font-semibold">
                                            <i class="ph ph-warning-octagon"></i>
                                            <span>
                                              <%= item.conflictReasons.join('; ') %></span>
                          </div>
                        <% } %>
                      </td>
                      <td class="px-4 py-3 font-mono font-medium whitespace-nowrap <%= isBentrok ? ' text-rose-800
                                                dark:text-rose-200' : 'text-zinc-700 dark:text-zinc-300' %>">
                                                <span class="inline-block w-14 font-semibold">
                                                  <%= item.hari %>,
                                                </span>
                                                <span>
                                                  <%= item.jamMulai %> - <%= item.jamSelesai %>
                                                </span>
                                      </td>
                                      <td
                                        class="px-4 py-3 font-mono <%= isBentrok ? 'text-rose-800 dark:text-rose-200' : 'text-zinc-600 dark:text-zinc-400' %>">
                                        Kls <%= item.kelas %> (<%= item.sks %> SKS)
                                      </td>
                                      <td
                                        class="px-4 py-3 <%= isBentrok ? 'text-rose-800 dark:text-rose-200' : 'text-zinc-700 dark:text-zinc-300' %> max-w-[200px] truncate"
                                        title="<%= item.dosen %>">
                                        <%= item.dosen %>
                                      </td>
                                      <td
                                        class="px-4 py-3 font-mono <%= isBentrok ? 'font-bold text-rose-700 dark:text-rose-300 underline' : 'text-zinc-700 dark:text-zinc-300' %>">
                                        <%= item.ruang %>
                                      </td>
                                      <td class="px-4 py-3">
                                        <% if (isBentrok) { %>
                                          <span
                                            class="inline-flex items-center gap-1 font-mono text-[10px] text-rose-700 dark:text-rose-300 bg-rose-100/80 dark:bg-rose-950/80 px-2 py-0.5 rounded border border-rose-300 dark:border-rose-800 font-bold">
                                            <i class="ph ph-warning-octagon"></i> Konflik Hard
                                          </span>
                                          <% } else if (item.jenis==='Praktikum' ) { %>
                                            <span
                                              class="inline-flex items-center gap-1 font-mono text-[10px] text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/60 px-2 py-0.5 rounded border border-amber-200 dark:border-amber-800 font-semibold">
                                              <i class="ph ph-flask"></i> Praktikum
                                            </span>
                                            <% } else { %>
                                              <span
                                                class="inline-flex items-center gap-1 font-mono text-[10px] text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/60 px-2 py-0.5 rounded border border-blue-200 dark:border-blue-900 font-semibold">
                                                <i class="ph ph-chalkboard"></i> Teori
                                              </span>
                                              <% } %>
                                      </td>
                                      <td class="px-4 py-3 text-right">
                                        <button type="button"
                                          onclick="openEditModal('<%= item.mataKuliah %> (Kelas <%= item.kelas %>)', '<%= item.dosen %>', '<%= item.ruang %>', '<%= item.hari %>', '<%= item.jamMulai %>', '<%= item.id %>', '<%= isBentrok ? (item.conflictReasons || []).join('; ') : '' %>')"
                                          class="inline-flex items-center gap-1 <%= isBentrok ? 'text-rose-700 hover:text-rose-900 dark:text-rose-300 font-bold' : 'text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100' %> px-2 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                                          <i class="ph ph-pencil-simple text-sm"></i>
                                          <span>Edit</span>
                                        </button>
                                      </td>
                                    </tr>
                                    <% }); %>
                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>

            </div>
          </main>

          <%- include('../partials/admin-footer') %>
      </div>
  </div>

  <script>
    (function initJadwalSwitcher() {
      const btnGrid = document.getElementById('btn-view-grid');
      const btnTable = document.getElementById('btn-view-table');
      const gridView = document.getElementById('container-grid-view');
      const tableView = document.getElementById('container-table-view');

      if (btnGrid && btnTable && gridView && tableView) {
        btnGrid.addEventListener('click', () => {
          gridView.classList.remove('hidden');
          tableView.classList.add('hidden');
          btnGrid.className = 'flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-xs dark:bg-zinc-900 dark:text-zinc-50 transition-all';
          btnTable.className = 'flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
        });

        btnTable.addEventListener('click', () => {
          gridView.classList.add('hidden');
          tableView.classList.remove('hidden');
          btnTable.className = 'flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-xs dark:bg-zinc-900 dark:text-zinc-50 transition-all';
          btnGrid.className = 'flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
        });
      }

      const searchInput = document.getElementById('jadwal-search-input');
      const filterHari = document.getElementById('filter-hari-select');
      const filterTipe = document.getElementById('filter-tipe-select');
      const filterStatus = document.getElementById('filter-status-select');
      const rows = document.querySelectorAll('.jadwal-row');
      const gridCards = document.querySelectorAll('.grid-slot-card');

      function applyFilter() {
        const q = (searchInput?.value || '').toLowerCase().trim();
        const hari = filterHari?.value || 'Semua';
        const tipe = filterTipe?.value || 'Semua';
        const status = filterStatus?.value || 'Semua';

        // Filter baris Tabel Rinci
        rows.forEach(row => {
          const text = row.getAttribute('data-search') || '';
          const rowHari = row.getAttribute('data-hari') || '';
          const rowTipe = row.getAttribute('data-jenis') || '';
          const rowConflict = row.getAttribute('data-conflict') === 'true';

          const matchSearch = !q || text.includes(q);
          const matchHari = hari === 'Semua' || rowHari === hari;
          const matchTipe = tipe === 'Semua' || rowTipe === tipe;
          const matchStatus = status === 'Semua' || (status === 'Konflik' && rowConflict) || (status === 'Aman' && !rowConflict);

          row.style.display = (matchSearch && matchHari && matchTipe && matchStatus) ? '' : 'none';
        });

        // Filter kartu di Kalender Grid Mingguan
        gridCards.forEach(card => {
          const text = card.getAttribute('data-search') || '';
          const cardHari = card.getAttribute('data-hari') || '';
          const cardTipe = card.getAttribute('data-jenis') || '';
          const cardConflict = card.getAttribute('data-conflict') === 'true';

          const matchSearch = !q || text.includes(q);
          const matchHari = hari === 'Semua' || cardHari === hari;
          const matchTipe = tipe === 'Semua' || cardTipe === tipe;
          const matchStatus = status === 'Semua' || (status === 'Konflik' && cardConflict) || (status === 'Aman' && !cardConflict);

          card.style.display = (matchSearch && matchHari && matchTipe && matchStatus) ? '' : 'none';
        });
      }

      searchInput?.addEventListener('input', applyFilter);
      filterHari?.addEventListener('change', applyFilter);
      filterTipe?.addEventListener('change', applyFilter);
      filterStatus?.addEventListener('change', applyFilter);

      window.focusToConflicts = function () {
        if (filterStatus) filterStatus.value = 'Konflik';
        if (searchInput) searchInput.value = '';
        applyFilter();
        // Beralih ke Tabel Rinci agar baris merah langsung terlihat utuh
        if (btnTable) btnTable.click();
      };

      window.filterJadwalByKeyword = function (keyword) {
        if (searchInput) {
          searchInput.value = keyword;
          applyFilter();
          if (btnTable) btnTable.click();
        }
      };
    })();
  </script>