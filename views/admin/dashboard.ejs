<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Panel Administrasi Akademik — Jadwalin' }) %>

<!-- Chart.js CDN for shadcn styled analytics charts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="flex-1 flex overflow-hidden">
  <%- include('../partials/admin-sidebar', { activeMenu: 'dashboard' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <!-- Header Banner -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">
              Pusat Kendali Jadwal
            </span>
            <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
              Dashboard Analitik Staf Akademik
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Monitor distribusi beban ruang, jam dosen, kepatuhan constraint, dan optimasi jadwal otomatis.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <a href="/admin/jadwal" class="inline-flex min-h-[38px] items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
              <i class="ph ph-calendar-check text-base"></i>
              <span>Matriks Jadwal</span>
            </a>
            <a href="/admin/generate" class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-sm border border-blue-900/40 transition-colors">
              <i class="ph ph-cpu text-base text-amber-400"></i>
              <span>Jalankan AI Solver</span>
            </a>
          </div>
        </div>

        <!-- Metric Cards Grid (Shadcn KPI Style) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Dosen Pengampu Aktif</span>
              <i class="ph ph-chalkboard-teacher text-zinc-400 text-lg"></i>
            </div>
            <p class="font-mono text-2xl font-bold text-zinc-900 dark:text-zinc-50 pt-2">21</p>
            <p class="text-[11px] text-zinc-500 dark:text-zinc-400 pt-1">100% verifikasi NIDN & beban</p>
          </div>

          <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Total Mata Kuliah</span>
              <i class="ph ph-book-open text-zinc-400 text-lg"></i>
            </div>
            <p class="font-mono text-2xl font-bold text-zinc-900 dark:text-zinc-50 pt-2">77</p>
            <p class="text-[11px] text-zinc-500 dark:text-zinc-400 pt-1">Kurikulum TI Berbasis OBE 2024</p>
          </div>

          <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Ruangan & Lab</span>
              <i class="ph ph-door text-zinc-400 text-lg"></i>
            </div>
            <p class="font-mono text-2xl font-bold text-zinc-900 dark:text-zinc-50 pt-2">12</p>
            <p class="text-[11px] text-zinc-500 dark:text-zinc-400 pt-1">4 Lab Komputer + 8 Ruang Teori</p>
          </div>

          <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-zinc-500 dark:text-zinc-400">Status Hard Constraint</span>
              <i class="ph ph-shield-check text-emerald-500 text-lg"></i>
            </div>
            <p class="font-mono text-2xl font-bold text-emerald-600 dark:text-emerald-400 pt-2">Zero Clash</p>
            <p class="text-[11px] text-zinc-500 dark:text-zinc-400 pt-1">0 bentrok ruangan & jam dosen</p>
          </div>
        </div>

        <!-- ---------------------------------------------------- -->
        <!-- SHADCN-STYLE CHARTS SECTION                          -->
        <!-- ---------------------------------------------------- -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
          <!-- Chart 1: Sebaran Sesi Per Hari (Bar Chart) -->
          <div class="lg:col-span-2 rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
                <div>
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Sebaran Beban Perkuliahan Mingguan
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Jumlah alokasi sesi mata kuliah aktif hari Senin hingga Sabtu
                  </p>
                </div>
                <span class="font-mono text-[11px] bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 rounded text-zinc-600 dark:text-zinc-300">
                  Total 111 Sesi
                </span>
              </div>
              <div class="pt-4 h-64 relative">
                <canvas id="chart-sebaran-mingguan"></canvas>
              </div>
            </div>
            <div class="pt-3 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between text-[11px] text-zinc-500 font-mono">
              <span>Beban Puncak: Senin & Selasa</span>
              <span>Jeda Dhuhur: 100% Terpenuhi</span>
            </div>
          </div>

          <!-- Chart 2: Komposisi Jenis Mata Kuliah (Donut Chart) -->
          <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
                <div>
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Komposisi Sesi Kuliah
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Rasio Praktikum Lab vs Kuliah Teori
                  </p>
                </div>
              </div>
              <div class="pt-4 h-52 relative flex items-center justify-center">
                <canvas id="chart-komposisi-matkul"></canvas>
              </div>
            </div>
            <div class="pt-3 border-t border-zinc-100 dark:border-zinc-800 space-y-1.5 text-xs">
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-2 text-zinc-600 dark:text-zinc-400">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#0c2b5e]"></span> Kuliah Teori (Reguler)
                </span>
                <span class="font-mono font-bold text-zinc-900 dark:text-zinc-100">72%</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-2 text-zinc-600 dark:text-zinc-400">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#f59e0b]"></span> Praktikum (Lab Komputer)
                </span>
                <span class="font-mono font-bold text-zinc-900 dark:text-zinc-100">28%</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 3: Utilisasi Ruangan Perkuliahan (Progress Bars ala Shadcn) -->
        <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-zinc-100 dark:border-zinc-800">
            <div>
              <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                Tingkat Utilisasi Ruang Perkuliahan Unggulan
              </h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">
                Persentase okupansi slot jam efektif 07:00 – 17:20 WIB
              </p>
            </div>
            <a href="/admin/master/ruangan" class="text-xs text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 font-medium">
              <span>Detail Ruangan</span>
              <i class="ph ph-arrow-right"></i>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <!-- Lab 1 -->
            <div class="space-y-1.5 p-3 rounded-lg border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/40">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-zinc-900 dark:text-zinc-100 font-mono">F4.LAB1 — Lab Pemrograman & Basis Data</span>
                <span class="font-mono text-zinc-600 dark:text-zinc-400 font-bold">85%</span>
              </div>
              <div class="w-full bg-zinc-200 dark:bg-zinc-700 h-2 rounded-full overflow-hidden">
                <div class="bg-[#f59e0b] h-full rounded-full" style="width: 85%"></div>
              </div>
              <p class="text-[10px] text-zinc-500">Kapasitas: 35 PC · Terpakai: 17 dari 20 slot mingguan</p>
            </div>

            <!-- Lab 2 -->
            <div class="space-y-1.5 p-3 rounded-lg border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/40">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-zinc-900 dark:text-zinc-100 font-mono">F4.LAB2 — Lab Multimedia & Jaringan</span>
                <span class="font-mono text-zinc-600 dark:text-zinc-400 font-bold">75%</span>
              </div>
              <div class="w-full bg-zinc-200 dark:bg-zinc-700 h-2 rounded-full overflow-hidden">
                <div class="bg-[#f59e0b] h-full rounded-full" style="width: 75%"></div>
              </div>
              <p class="text-[10px] text-zinc-500">Kapasitas: 35 PC · Terpakai: 15 dari 20 slot mingguan</p>
            </div>

            <!-- RKB F6.001 -->
            <div class="space-y-1.5 p-3 rounded-lg border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/40">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-zinc-900 dark:text-zinc-100 font-mono">F6.001 — Ruang Kuliah Bersama (RKB Teori)</span>
                <span class="font-mono text-zinc-600 dark:text-zinc-400 font-bold">90%</span>
              </div>
              <div class="w-full bg-zinc-200 dark:bg-zinc-700 h-2 rounded-full overflow-hidden">
                <div class="bg-[#0c2b5e] h-full rounded-full" style="width: 90%"></div>
              </div>
              <p class="text-[10px] text-zinc-500">Kapasitas: 80 Mahasiswa · Terpakai: 18 dari 20 slot mingguan</p>
            </div>

            <!-- Reguler F4.003 -->
            <div class="space-y-1.5 p-3 rounded-lg border border-zinc-100 bg-zinc-50/60 dark:border-zinc-800 dark:bg-zinc-800/40">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-zinc-900 dark:text-zinc-100 font-mono">F4.003 — Kelas Reguler Kurikulum TI</span>
                <span class="font-mono text-zinc-600 dark:text-zinc-400 font-bold">65%</span>
              </div>
              <div class="w-full bg-zinc-200 dark:bg-zinc-700 h-2 rounded-full overflow-hidden">
                <div class="bg-[#0c2b5e] h-full rounded-full" style="width: 65%"></div>
              </div>
              <p class="text-[10px] text-zinc-500">Kapasitas: 45 Mahasiswa · Terpakai: 13 dari 20 slot mingguan</p>
            </div>
          </div>
        </div>

        <!-- Quick Nav Action Panels -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1">
          <a href="/admin/master/dosen" class="group rounded-xl border border-zinc-200 bg-white p-5 shadow-sm hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 transition-all">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-zinc-100 text-zinc-900 group-hover:bg-[#0c2b5e] group-hover:text-white dark:bg-zinc-800 dark:text-zinc-100 dark:group-hover:bg-[#0c2b5e] transition-colors">
                <i class="ph ph-database text-xl"></i>
              </div>
              <div>
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Data Master</p>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Dosen, Matkul, Ruangan, Mahasiswa</p>
              </div>
            </div>
          </a>

          <a href="/admin/constraints" class="group rounded-xl border border-zinc-200 bg-white p-5 shadow-sm hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 transition-all">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-zinc-100 text-zinc-900 group-hover:bg-[#0c2b5e] group-hover:text-white dark:bg-zinc-800 dark:text-zinc-100 dark:group-hover:bg-[#0c2b5e] transition-colors">
                <i class="ph ph-sliders text-xl"></i>
              </div>
              <div>
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Aturan Constraints</p>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Hard constraint & jeda Dhuhur</p>
              </div>
            </div>
          </a>

          <a href="/admin/settings" class="group rounded-xl border border-zinc-200 bg-white p-5 shadow-sm hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700 transition-all">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-zinc-100 text-zinc-900 group-hover:bg-[#0c2b5e] group-hover:text-white dark:bg-zinc-800 dark:text-zinc-100 dark:group-hover:bg-[#0c2b5e] transition-colors">
                <i class="ph ph-gear text-xl"></i>
              </div>
              <div>
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Pengaturan Sistem</p>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Periode akademik & kalender</p>
              </div>
            </div>
          </a>
        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  // Render Chart.js dengan Style Minimalis Shadcn
  document.addEventListener('DOMContentLoaded', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const textColor = isDark ? '#a1a1aa' : '#71717a';
    const gridColor = isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(0, 0, 0, 0.06)';

    // 1. Chart Sebaran Mingguan
    const ctxBar = document.getElementById('chart-sebaran-mingguan')?.getContext('2d');
    if (ctxBar) {
      new Chart(ctxBar, {
        type: 'bar',
        data: {
          labels: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'],
          datasets: [{
            label: 'Jumlah Sesi Perkuliahan',
            data: [25, 23, 22, 19, 14, 8],
            backgroundColor: '#0c2b5e',
            hoverBackgroundColor: '#1d4ed8',
            borderRadius: 6,
            barThickness: 32,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: isDark ? '#18181b' : '#ffffff',
              titleColor: isDark ? '#f4f4f5' : '#18181b',
              bodyColor: isDark ? '#d4d4d8' : '#3f3f46',
              borderColor: isDark ? '#27272a' : '#e4e4e7',
              borderWidth: 1,
              padding: 10,
              boxPadding: 4,
              displayColors: false,
              callbacks: {
                label: (ctx) => `${ctx.parsed.y} Sesi Terjadwal`
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { color: textColor, font: { family: 'Plus Jakarta Sans', size: 11 } }
            },
            y: {
              grid: { color: gridColor },
              ticks: { color: textColor, font: { family: 'JetBrains Mono', size: 10 }, stepSize: 5 }
            }
          }
        }
      });
    }

    // 2. Chart Komposisi Matkul (Donut)
    const ctxPie = document.getElementById('chart-komposisi-matkul')?.getContext('2d');
    if (ctxPie) {
      new Chart(ctxPie, {
        type: 'doughnut',
        data: {
          labels: ['Kuliah Teori', 'Praktikum Lab'],
          datasets: [{
            data: [80, 31],
            backgroundColor: ['#0c2b5e', '#f59e0b'],
            borderColor: isDark ? '#18181b' : '#ffffff',
            borderWidth: 3,
            hoverOffset: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '72%',
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: isDark ? '#18181b' : '#ffffff',
              titleColor: isDark ? '#f4f4f5' : '#18181b',
              bodyColor: isDark ? '#d4d4d8' : '#3f3f46',
              borderColor: isDark ? '#27272a' : '#e4e4e7',
              borderWidth: 1,
              padding: 10
            }
          }
        }
      });
    }
  });
</script>
