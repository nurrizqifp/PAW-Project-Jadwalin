<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'AI Generator Solver — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'generate' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
    <div class="max-w-6xl mx-auto space-y-6">

      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">
            Powered by Gemini API
          </span>
          <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
            AI Automated Schedule Generator
          </h1>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Optimasi kombinatorial jadwal perkuliahan bebas tabrakan (Zero Hard-Constraint Violations).
          </p>
        </div>

        <button id="btn-run-solver" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-md bg-zinc-900 px-5 py-2 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors">
          <i class="ph ph-sparkle text-base"></i>
          <span>Mulai Generate Jadwal</span>
        </button>
      </div>

      <!-- Parameter Card -->
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
        <h2 class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50 border-b border-zinc-100 pb-3 dark:border-zinc-800">
          Parameter Eksekusi Solver
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="target-semester" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">Target Periode Akademik</label>
            <select id="target-semester" class="w-full min-h-[42px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200">
              <option value="20261" selected>Semester Ganjil 2026/2027</option>
              <option value="20262">Semester Genap 2026/2027</option>
            </select>
          </div>
          <div>
            <label for="ai-model" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">Model AI Engine</label>
            <input id="ai-model" type="text" value="gemini-1.5-flash (Gratis/Free Tier)" readonly class="w-full min-h-[42px] rounded-md border border-zinc-200 bg-zinc-50 px-3 py-2 text-xs font-mono text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400">
          </div>
          <div>
            <label for="max-iterations" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1">Maksimal Upaya Repair</label>
            <input id="max-iterations" type="number" value="3" class="w-full min-h-[42px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs font-mono text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200">
          </div>
        </div>
      </div>

      <!-- Execution Console Log Output -->
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50">
            Log Konsol Solver & Verifikasi
          </h2>
          <span class="font-mono text-[11px] text-zinc-400">Status: Siap dijalankan</span>
        </div>

        <div class="rounded-xl bg-zinc-950 p-4 font-mono text-xs text-zinc-300 space-y-1.5 min-h-[160px] overflow-y-auto">
          <p class="text-zinc-500">// Menunggu instruksi trigger solver...</p>
          <p class="text-zinc-500">// Dataset siap: 21 Dosen, 77 Mata Kuliah, 12 Ruangan.</p>
          <p class="text-zinc-500">// Hard Constraints: HC-01 (Dosen), HC-02 (Ruangan), HC-03 (Jeda Dhuhur 11:30-12:10) AKTIF.</p>
        </div>
      </div>

    </div>
  </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>
