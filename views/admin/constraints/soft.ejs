<%- include('../../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Soft Constraints — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../../partials/admin-sidebar', { activeMenu: 'constraints' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2">
              <span class="rounded bg-amber-100 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-800 dark:bg-amber-950/80 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                OPTIMASI BOBOT PENALTI
              </span>
              <span class="text-xs text-zinc-500 font-mono">Preferensi Fleksibel</span>
            </div>
            <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
              Soft Constraints (Preferensi Jadwal)
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Kriteria yang diupayakan maksimal terpenuhi oleh AI solver. Dilengkapi skor penalti jika terlanggar.
            </p>
          </div>

          <div class="flex items-center gap-2.5">
            <div class="inline-flex rounded-lg border border-zinc-200 bg-zinc-100 p-1 dark:border-zinc-800 dark:bg-zinc-800">
              <a href="/admin/constraints" class="rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors">
                Hard Constraints
              </a>
              <a href="/admin/constraints/soft" class="rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-xs dark:bg-zinc-900 dark:text-zinc-100">
                Soft Constraints
              </a>
            </div>

            <button type="button" onclick="openSoftDrawer('create')"
              class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
              <i class="ph ph-plus text-base text-amber-400"></i>
              <span>Tambah Preferensi</span>
            </button>
          </div>
        </div>

        <div class="space-y-4">
          <% const scList = (typeof constraints !== 'undefined' && constraints?.softConstraints) ? constraints.softConstraints : []; %>
          <% const dsnOpts = (typeof dosenList !== 'undefined' && Array.isArray(dosenList)) ? dosenList : []; %>
          <% scList.forEach(function(sc) { %>
            <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold text-zinc-900 dark:text-zinc-100"><%= sc.dosenNama %></span>
                  <span class="rounded bg-amber-100 px-2 py-0.5 font-mono text-[10px] font-semibold text-amber-800 dark:bg-amber-950 dark:text-amber-300">
                    <%= sc.hariOff ? ('Libur ' + sc.hariOff) : (sc.preferensiWaktu || 'Preferensi Waktu') %>
                  </span>
                </div>
                <p class="text-xs text-zinc-600 dark:text-zinc-400">Alasan: <%= sc.alasan || '-' %></p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button type="button" onclick="openSoftDrawer('edit', '<%= sc.dosenId || '' %>', '<%= sc.hariOff || 'Jumat' %>', '<%= (sc.alasan || '').replace(/'/g, "\\'") %>', '<%= sc.dbId || '' %>')"
                  class="inline-flex min-h-[34px] items-center gap-1.5 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-50 px-3 text-xs font-semibold text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
                  <i class="ph ph-pencil-simple"></i>
                  <span>Edit</span>
                </button>
                <% if (sc.dbId) { %>
                  <button type="button" onclick="deleteSoftConstraint(<%= sc.dbId %>, '<%= sc.dosenNama.replace(/'/g, "\\'") %>')"
                    class="inline-flex min-h-[34px] items-center gap-1.5 rounded-lg border border-zinc-200 bg-white hover:bg-rose-50 px-3 text-xs font-semibold text-rose-600 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-rose-950/40 dark:text-rose-400 transition-colors">
                    <i class="ph ph-trash"></i>
                  </button>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>

      </div>
    </main>

    <%- include('../../partials/admin-footer') %>
  </div>
</div>

<!-- Drawer Slide-over CRUD Soft Constraint -->
<div id="drawer-soft-overlay"
  class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs transition-opacity duration-150 opacity-0 pointer-events-none">
  <div id="drawer-soft-panel"
    class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl border-l border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800 flex flex-col transform translate-x-full transition-transform duration-200 ease-in-out">

    <div class="flex items-center justify-between p-4 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <h3 id="soft-drawer-title" class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">Tambah Soft Constraint Baru</h3>
        <p class="text-xs text-zinc-500">Konfigurasi bobot preferensi optimasi</p>
      </div>
      <button onclick="closeSoftDrawer()" type="button"
        class="h-8 w-8 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 flex items-center justify-center">
        <i class="ph ph-x text-base"></i>
      </button>
    </div>

    <form onsubmit="handleSaveSoft(event)" class="flex-1 overflow-y-auto p-5 space-y-4 text-xs">
      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Dosen Pengampu</label>
        <select id="soft-input-dosen" required class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
          <% dsnOpts.forEach(function(d) { %>
            <option value="<%= d.id %>"><%= d.nama %> (<%= d.inisial %>)</option>
          <% }); %>
        </select>
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Hari Bebas Mengajar (Off Day)</label>
        <select id="soft-input-hari" required class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
          <option value="Senin">Senin</option>
          <option value="Selasa">Selasa</option>
          <option value="Rabu">Rabu</option>
          <option value="Kamis">Kamis</option>
          <option value="Jumat" selected>Jumat</option>
          <option value="Sabtu">Sabtu</option>
        </select>
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Alasan / Kebijakan (Maks 80 Karakter)</label>
        <textarea id="soft-input-desc" rows="3" required minlength="3" maxlength="80" placeholder="Contoh: Alokasi Waktu Riset Laboratorium"
          class="w-full rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100"></textarea>
      </div>

      <div class="pt-4 flex items-center justify-end gap-2 border-t border-zinc-100 dark:border-zinc-800">
        <button type="button" onclick="closeSoftDrawer()"
          class="inline-flex min-h-[36px] items-center rounded-lg border border-zinc-200 px-3.5 font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">
          Batal
        </button>
        <button type="submit"
          class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs">
          <i class="ph ph-check text-amber-400"></i>
          <span>Simpan Preferensi</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  let editingSoftId = null;

  function openSoftDrawer(mode, dosenId = '', hariOff = 'Jumat', desc = '', dbId = null) {
    editingSoftId = dbId ? Number(dbId) : null;
    const overlay = document.getElementById('drawer-soft-overlay');
    const panel = document.getElementById('drawer-soft-panel');
    const title = document.getElementById('soft-drawer-title');
    const inputDosen = document.getElementById('soft-input-dosen');
    const inputHari = document.getElementById('soft-input-hari');
    const inputDesc = document.getElementById('soft-input-desc');

    if (title) title.textContent = mode === 'create' ? 'Tambah Soft Constraint Baru' : 'Edit Soft Constraint';
    if (inputDosen && dosenId) inputDosen.value = dosenId;
    if (inputHari) inputHari.value = hariOff || 'Jumat';
    if (inputDesc) inputDesc.value = desc || '';

    if (overlay && panel) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
    }
  }

  function closeSoftDrawer() {
    const overlay = document.getElementById('drawer-soft-overlay');
    const panel = document.getElementById('drawer-soft-panel');
    if (overlay && panel) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
    }
  }

  async function handleSaveSoft(e) {
    e.preventDefault();
    try {
      const res = await fetch('/api/constraints/preferensi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...(editingSoftId ? { id: editingSoftId } : {}),
          dosenId: Number(document.getElementById('soft-input-dosen')?.value),
          hariOff: document.getElementById('soft-input-hari')?.value,
          alasan: document.getElementById('soft-input-desc')?.value.trim()
        })
      });
      const data = await res.json();
      if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menyimpan preferensi.');
      closeSoftDrawer();
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
      setTimeout(() => window.location.reload(), 400);
    } catch (err) {
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
    }
  }

  function deleteSoftConstraint(id, nama) {
    const execDel = async () => {
      try {
        const res = await fetch(`/api/constraints/preferensi/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menghapus preferensi.');
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
        setTimeout(() => window.location.reload(), 400);
      } catch (err) {
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
      }
    };
    if (window.showConfirmDialog) {
      window.showConfirmDialog('Hapus Constraint', `Hapus preferensi untuk ${nama}?`, execDel, 'Hapus');
    } else if (confirm(`Hapus preferensi ${nama}?`)) {
      execDel();
    }
  }
</script>
