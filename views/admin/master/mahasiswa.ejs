<%- include('../../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Master Data Mahasiswa — Jadwalin' }) %>
<%- include('../../partials/navbar') %>

<div class="flex-1 flex overflow-hidden">
  <%- include('../../partials/sidebar', { activeMenu: 'mahasiswa' }) %>

  <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
    <div class="max-w-6xl mx-auto space-y-6">

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
            Master Data Mahasiswa & Rombel
          </h1>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Kelola data mahasiswa aktif, penempatan kelas fleksibel per angkatan, dan preferensi peminatan.
          </p>
        </div>

        <button type="button" class="inline-flex min-h-[40px] items-center gap-2 rounded-md bg-zinc-900 px-4 py-2 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors">
          <i class="ph ph-plus text-base"></i>
          <span>Tambah Mahasiswa</span>
        </button>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
              <tr>
                <th class="px-4 py-3 font-semibold">NIM</th>
                <th class="px-4 py-3 font-semibold">Nama Mahasiswa</th>
                <th class="px-4 py-3 font-semibold">Angkatan</th>
                <th class="px-4 py-3 font-semibold">Semester</th>
                <th class="px-4 py-3 font-semibold">Rombel Default</th>
                <th class="px-4 py-3 font-semibold">Peminatan</th>
                <th class="px-4 py-3 font-semibold text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
              <tr>
                <td class="px-4 py-3 font-mono font-semibold">20240140093</td>
                <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">Haidar Yahya Mudhofar</td>
                <td class="px-4 py-3 font-mono">2024</td>
                <td class="px-4 py-3 font-mono">5</td>
                <td class="px-4 py-3 font-mono">Kelas B</td>
                <td class="px-4 py-3">Software Engineering</td>
                <td class="px-4 py-3 text-right">
                  <button type="button" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1">
                    <i class="ph ph-pencil-simple text-base"></i>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('../../partials/footer') %>
