<%- include('../../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Master Data Mahasiswa — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../../partials/admin-sidebar', { activeMenu: 'mahasiswa' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <div>
            <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Master Data Mahasiswa
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Daftar mahasiswa aktif prodi TI, NIM, angkatan, semester, dan peminatan kurikulum.
            </p>
          </div>

          <button type="button" onclick="openMahasiswaDrawer('Tambah Mahasiswa Baru', '', '', '5', '2024', 'SE')"
            class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
            <i class="ph ph-plus text-base text-amber-400"></i>
            <span>Tambah Mahasiswa</span>
          </button>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
          <%- include('../../partials/table-pagination', {
            tableId: 'table-mahasiswa',
            part: 'toolbar',
            searchPlaceholder: 'Cari mahasiswa berdasarkan nama atau NIM...',
            filterOptions: [
              {
                id: 'filter-semester-mhs',
                label: 'Semester',
                dataAttr: 'semester',
                options: [
                  { value: 'Semua', text: 'Semua Semester' },
                  { value: '1', text: 'Semester 1' },
                  { value: '2', text: 'Semester 2' },
                  { value: '3', text: 'Semester 3' },
                  { value: '4', text: 'Semester 4' },
                  { value: '5', text: 'Semester 5' },
                  { value: '6', text: 'Semester 6' },
                  { value: '7', text: 'Semester 7' },
                  { value: '8', text: 'Semester 8' }
                ]
              },
              {
                id: 'filter-kelas-mhs',
                label: 'Kelas',
                dataAttr: 'kelas',
                options: [
                  { value: 'Semua', text: 'Semua Kelas' },
                  { value: 'SE', text: 'Kelas SE' },
                  { value: 'AI', text: 'Kelas AI' },
                  { value: 'NET', text: 'Kelas NET' }
                ]
              }
            ]
          }) %>

          <div class="overflow-x-auto">
            <table id="table-mahasiswa" class="w-full text-left text-xs paginated-table">
              <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
                <tr>
                  <th class="px-4 py-3 font-semibold">NIM</th>
                  <th class="px-4 py-3 font-semibold">Nama Lengkap</th>
                  <th class="px-4 py-3 font-semibold">Semester</th>
                  <th class="px-4 py-3 font-semibold">Angkatan</th>
                  <th class="px-4 py-3 font-semibold">Kelas Teori</th>
                  <th class="px-4 py-3 font-semibold text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                <% const listMhs = (typeof mahasiswaList !== 'undefined' && Array.isArray(mahasiswaList)) ? mahasiswaList : []; %>
                <% if (listMhs.length === 0) { %>
                  <tr class="table-empty-row">
                    <td colspan="6" class="px-4 py-6 text-center text-zinc-500">Belum ada data mahasiswa di database.</td>
                  </tr>
                <% } else { %>
                  <% listMhs.forEach(function(mhs) { %>
                    <tr data-semester="<%= mhs.semesterAktif %>" data-kelas="<%= mhs.kodePeminatan || 'SE' %>">
                      <td class="px-4 py-3 font-mono font-bold text-zinc-900 dark:text-zinc-100"><%= mhs.nim %></td>
                      <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100"><%= mhs.nama %></td>
                      <td class="px-4 py-3 font-mono">Semester <%= mhs.semesterAktif %></td>
                      <td class="px-4 py-3 font-mono"><%= mhs.angkatan %></td>
                      <td class="px-4 py-3 font-mono"><%= mhs.kodePeminatan || 'SE' %></td>
                      <td class="px-4 py-3 text-right space-x-1">
                        <button type="button" onclick="openMahasiswaDrawer('Edit Mahasiswa', '<%= mhs.nim %>', '<%= mhs.nama.replace(/'/g, "\\'") %>', '<%= mhs.semesterAktif %>', '<%= mhs.angkatan %>', '<%= mhs.kodePeminatan || 'SE' %>', '<%= mhs.id %>')" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1" title="Edit">
                          <i class="ph ph-pencil-simple text-base"></i>
                        </button>
                        <button type="button" onclick="deleteMahasiswa(<%= mhs.id %>, '<%= mhs.nama.replace(/'/g, "\\'") %>')" class="text-zinc-400 hover:text-rose-600 p-1" title="Hapus">
                          <i class="ph ph-trash text-base"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>

          <%- include('../../partials/table-pagination', {
            tableId: 'table-mahasiswa',
            part: 'pagination',
            defaultPageSize: 10
          }) %>
        </div>

      </div>
    </main>

    <%- include('../../partials/admin-footer') %>
  </div>
</div>

<!-- Drawer Slide-Over CRUD Mahasiswa -->
<div id="drawer-mhs-overlay"
  class="fixed inset-0 z-50 bg-black/40 transition-opacity duration-150 opacity-0 pointer-events-none">
  <div id="drawer-mhs-panel"
    class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl border-l border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800 flex flex-col transform translate-x-full transition-transform duration-200 ease-in-out">

    <div class="flex items-center justify-between p-4 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <h3 id="mhs-drawer-title" class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">Form Mahasiswa</h3>
        <p class="text-xs text-zinc-500">Kelola data peserta perkuliahan</p>
      </div>
      <button onclick="closeMahasiswaDrawer()" type="button"
        class="h-8 w-8 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 flex items-center justify-center">
        <i class="ph ph-x text-base"></i>
      </button>
    </div>

    <form onsubmit="handleSaveMahasiswa(event)" class="flex-1 overflow-y-auto p-5 space-y-4 text-xs">
      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Nomor Induk Mahasiswa / NIM (11 Digit Angka)</label>
        <input id="input-mhs-nim" type="text" required minlength="11" maxlength="11" pattern="\d{11}" inputmode="numeric" title="NIM wajib tepat 11 digit angka standar TI UMY (contoh: 20240140056)" placeholder="Contoh: 20240140093"
          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Nama Lengkap Mahasiswa (Maks. 60 Karakter)</label>
        <input id="input-mhs-name" type="text" required minlength="3" maxlength="60" placeholder="Contoh: Haidar Yahya Mudhofar"
          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Semester (<%= (typeof activePeriode !== 'undefined' && activePeriode) ? activePeriode.semesterTipe : 'Aktif' %>)</label>
          <input id="input-mhs-sem" type="number" required value="<%= (typeof activePeriode !== 'undefined' && activePeriode && activePeriode.semesterTipe === 'Genap') ? 4 : 5 %>" min="1" max="8"
            class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
        </div>
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Angkatan (4 Digit)</label>
          <input id="input-mhs-ang" type="number" required value="2024" min="2019" max="2030"
            class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
        </div>
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Jalur Peminatan</label>
          <select id="input-mhs-cls" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
            <option value="SE">SE (Software Engineering)</option>
            <option value="NS">NS (Network &amp; Cyber Security)</option>
          </select>
        </div>
      </div>

      <div class="pt-4 flex items-center justify-end gap-2 border-t border-zinc-100 dark:border-zinc-800">
        <button type="button" onclick="closeMahasiswaDrawer()"
          class="inline-flex min-h-[36px] items-center rounded-lg border border-zinc-200 px-3.5 font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">
          Batal
        </button>
        <button type="submit"
          class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs">
          <i class="ph ph-check text-amber-400"></i>
          <span>Simpan Mahasiswa</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  let editingMhsId = null;

  function openMahasiswaDrawer(title, nim, name, sem, ang, cls, id = null) {
    editingMhsId = id ? Number(id) : null;
    const overlay = document.getElementById('drawer-mhs-overlay');
    const panel = document.getElementById('drawer-mhs-panel');
    const titleEl = document.getElementById('mhs-drawer-title');
    const nimEl = document.getElementById('input-mhs-nim');
    const nameEl = document.getElementById('input-mhs-name');
    const semEl = document.getElementById('input-mhs-sem');
    const angEl = document.getElementById('input-mhs-ang');
    const clsEl = document.getElementById('input-mhs-cls');

    if (titleEl) titleEl.textContent = title;
    if (nimEl) nimEl.value = nim || '';
    if (nameEl) nameEl.value = name || '';
    if (semEl) semEl.value = sem || '5';
    if (angEl) angEl.value = ang || '2024';
    if (clsEl) clsEl.value = cls || 'SE';

    if (overlay && panel) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
    }
  }

  function closeMahasiswaDrawer() {
    const overlay = document.getElementById('drawer-mhs-overlay');
    const panel = document.getElementById('drawer-mhs-panel');
    if (overlay && panel) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
    }
  }

  async function handleSaveMahasiswa(e) {
    e.preventDefault();
    const payload = {
      kategori: 'mahasiswa',
      nim: document.getElementById('input-mhs-nim')?.value.trim(),
      nama: document.getElementById('input-mhs-name')?.value.trim(),
      semesterAktif: Number(document.getElementById('input-mhs-sem')?.value || 5),
      angkatan: Number(document.getElementById('input-mhs-ang')?.value || 2024),
      kodePeminatan: document.getElementById('input-mhs-cls')?.value || 'SE'
    };

    try {
      const url = editingMhsId ? `/api/master/mahasiswa/${editingMhsId}` : '/api/master';
      const method = editingMhsId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menyimpan mahasiswa.');
      closeMahasiswaDrawer();
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
      setTimeout(() => window.location.reload(), 400);
    } catch (err) {
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
      else alert(err.message);
    }
  }

  function deleteMahasiswa(id, nama) {
    const execDelete = async () => {
      try {
        const res = await fetch(`/api/master/mahasiswa/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menghapus mahasiswa.');
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
        setTimeout(() => window.location.reload(), 400);
      } catch (err) {
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
      }
    };
    if (window.showConfirmDialog) {
      window.showConfirmDialog('Hapus Mahasiswa', `Yakin ingin menghapus ${nama}?`, execDelete, 'Hapus');
    } else if (confirm(`Hapus ${nama}?`)) {
      execDelete();
    }
  }
</script>
