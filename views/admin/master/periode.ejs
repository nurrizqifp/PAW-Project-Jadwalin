<%- include('../../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Master Data Periode & Semester — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../../partials/admin-sidebar', { activeMenu: 'periode' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2">
              <span class="rounded bg-blue-100 px-2 py-0.5 font-mono text-[10px] font-bold text-blue-800 dark:bg-blue-950/80 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
                SIKLUS AKADEMIK
              </span>
              <span class="text-xs text-zinc-500 font-mono">Tahun Ajaran & Semester</span>
            </div>
            <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
              Master Periode & Semester Akademik
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Kelola tahun ajaran, semester berjalan, batas waktu Pra-KRS, serta status kunci jadwal akademik.
            </p>
          </div>

          <button type="button" onclick="openPeriodeDrawer('Tambah Periode Baru', '20262', '2026/2027', 'Genap', '2027-02-15', 'Terpublikasi')"
            class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
            <i class="ph ph-plus text-base text-amber-400"></i>
            <span>Tambah Periode Baru</span>
          </button>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
                <tr>
                  <th class="px-4 py-3 font-semibold">Kode Periode</th>
                  <th class="px-4 py-3 font-semibold">Tahun Akademik</th>
                  <th class="px-4 py-3 font-semibold">Semester</th>
                  <th class="px-4 py-3 font-semibold">Batas Waktu Pra-KRS</th>
                  <th class="px-4 py-3 font-semibold">Status Portal</th>
                  <th class="px-4 py-3 font-semibold text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                <% const listPer = (typeof periodeList !== 'undefined' && Array.isArray(periodeList)) ? periodeList : []; %>
                <% listPer.forEach(function(per) {
                  const isActive = per.status !== 'Arsip';
                %>
                  <tr class="hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 transition-colors <%= isActive ? '' : 'opacity-75' %>">
                    <td class="px-4 py-3 font-mono font-bold <%= isActive ? 'text-[#0c2b5e] dark:text-blue-300' : 'text-zinc-500' %>"><%= per.kode %></td>
                    <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100"><%= per.tahunAkademik %></td>
                    <td class="px-4 py-3 font-semibold text-zinc-800 dark:text-zinc-200">
                      <span class="inline-flex items-center gap-1.5 font-mono text-xs">
                        <span class="h-2 w-2 rounded-full <%= isActive ? 'bg-emerald-500' : 'bg-zinc-400' %>"></span>
                        Semester <%= per.semesterTipe %>
                      </span>
                    </td>
                    <td class="px-4 py-3 font-mono text-zinc-600 dark:text-zinc-400"><%= per.publishedAt || '2026-09-01' %></td>
                    <td class="px-4 py-3">
                      <span class="rounded <%= isActive ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-bold' : 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400 font-semibold' %> px-2 py-0.5 font-mono text-[10px]">
                        <%= per.status %>
                      </span>
                    </td>
                    <td class="px-4 py-3 text-right space-x-1">
                      <button type="button" onclick="openPeriodeDrawer('Edit Periode <%= per.kode %>', '<%= per.kode %>', '<%= per.tahunAkademik %>', '<%= per.semesterTipe %>', '<%= per.publishedAt || '2026-09-01' %>', '<%= per.status %>', '<%= per.id %>')" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1" title="Edit">
                        <i class="ph ph-pencil-simple text-base"></i>
                      </button>
                      <button type="button" onclick="deletePeriode(<%= per.id %>, '<%= per.nama %>')" class="text-zinc-400 hover:text-rose-600 p-1" title="Hapus">
                        <i class="ph ph-trash text-base"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>

    <%- include('../../partials/admin-footer') %>
  </div>
</div>

<!-- Drawer Slide-Over CRUD Periode & Semester -->
<div id="drawer-periode-overlay"
  class="fixed inset-0 z-50 bg-black/40 transition-opacity duration-150 opacity-0 pointer-events-none">
  <div id="drawer-periode-panel"
    class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl border-l border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800 flex flex-col transform translate-x-full transition-transform duration-200 ease-in-out">

    <div class="flex items-center justify-between p-4 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <h3 id="periode-drawer-title" class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">Form Periode Akademik</h3>
        <p class="text-xs text-zinc-500">Kelola tahun ajaran dan status semester</p>
      </div>
      <button onclick="closePeriodeDrawer()" type="button"
        class="h-8 w-8 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 flex items-center justify-center">
        <i class="ph ph-x text-base"></i>
      </button>
    </div>

    <form onsubmit="handleSavePeriode(event)" class="flex-1 overflow-y-auto p-5 space-y-4 text-xs">
      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Kode Periode (5 Digit)</label>
        <input id="input-per-code" type="text" required minlength="5" maxlength="5" pattern="\d{4}[12]" placeholder="Contoh: 20261"
          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Tahun Akademik</label>
          <input id="input-per-year" type="text" required minlength="9" maxlength="9" pattern="\d{4}/\d{4}" value="2026/2027" placeholder="2026/2027"
            class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
        </div>
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Semester</label>
          <select id="input-per-sem" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
            <option value="Ganjil">Semester Ganjil (Gasal)</option>
            <option value="Genap">Semester Genap</option>
          </select>
        </div>
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Batas Waktu Pra-KRS Mahasiswa</label>
        <input id="input-per-date" type="date" required value="2026-09-01"
          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Status Akses Mahasiswa</label>
        <select id="input-per-status" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
          <option value="Terpublikasi">Terpublikasi (Aktif &amp; Terbuka)</option>
          <option value="Draft">Draft (Persiapan Jadwal)</option>
          <option value="Arsip">Arsip (Terkunci)</option>
        </select>
      </div>

      <div class="pt-4 flex items-center justify-end gap-2 border-t border-zinc-100 dark:border-zinc-800">
        <button type="button" onclick="closePeriodeDrawer()"
          class="inline-flex min-h-[36px] items-center rounded-lg border border-zinc-200 px-3.5 font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">
          Batal
        </button>
        <button type="submit"
          class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs">
          <i class="ph ph-check text-amber-400"></i>
          <span>Simpan Periode</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  let editingPeriodeId = null;

  function openPeriodeDrawer(title, code, year, sem, date, status, id = null) {
    editingPeriodeId = id ? Number(id) : null;
    const overlay = document.getElementById('drawer-periode-overlay');
    const panel = document.getElementById('drawer-periode-panel');
    const titleEl = document.getElementById('periode-drawer-title');
    const codeEl = document.getElementById('input-per-code');
    const yearEl = document.getElementById('input-per-year');
    const semEl = document.getElementById('input-per-sem');
    const dateEl = document.getElementById('input-per-date');
    const statusEl = document.getElementById('input-per-status');

    if (titleEl) titleEl.textContent = title;
    if (codeEl) codeEl.value = code || '';
    if (yearEl) yearEl.value = year || '2026/2027';
    if (semEl) semEl.value = sem || 'Ganjil';
    if (dateEl) dateEl.value = date || '2026-09-01';
    if (statusEl) statusEl.value = /arsip|locked/i.test(status || '') ? 'Arsip' : (/draft/i.test(status || '') ? 'Draft' : 'Terpublikasi');

    if (overlay && panel) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
    }
  }

  function closePeriodeDrawer() {
    const overlay = document.getElementById('drawer-periode-overlay');
    const panel = document.getElementById('drawer-periode-panel');
    if (overlay && panel) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
    }
  }

  async function handleSavePeriode(e) {
    e.preventDefault();
    const payload = {
      kategori: 'periode',
      tahunAkademik: document.getElementById('input-per-year')?.value.trim(),
      semesterTipe: document.getElementById('input-per-sem')?.value || 'Ganjil',
      batasWaktu: document.getElementById('input-per-date')?.value || '2026-09-01',
      status: document.getElementById('input-per-status')?.value || 'Terpublikasi'
    };

    try {
      const url = editingPeriodeId ? `/api/master/periode/${editingPeriodeId}` : '/api/master';
      const method = editingPeriodeId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menyimpan periode.');
      closePeriodeDrawer();
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
      setTimeout(() => window.location.reload(), 400);
    } catch (err) {
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
      else alert(err.message);
    }
  }

  function deletePeriode(id, nama) {
    const execDelete = async () => {
      try {
        const res = await fetch(`/api/master/periode/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menghapus periode.');
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
        setTimeout(() => window.location.reload(), 400);
      } catch (err) {
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
      }
    };
    if (window.showConfirmDialog) {
      window.showConfirmDialog('Hapus Periode', `Yakin ingin menghapus ${nama}?`, execDelete, 'Hapus');
    } else if (confirm(`Hapus ${nama}?`)) {
      execDelete();
    }
  }
</script>
