<%- include('../../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Master Data Ruangan & Lab — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../../partials/admin-sidebar', { activeMenu: 'ruangan' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <div>
            <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Master Data Ruangan & Laboratorium
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Daftar 12 Ruang Kuliah (4 Lab Komputer F4, 2 RKB Teori F6, dan 6 Kelas Reguler).
            </p>
          </div>

          <button type="button" onclick="openRuanganDrawer('Tambah Ruang / Lab Baru', '', 'F4', 'Kelas Reguler', '45')"
            class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
            <i class="ph ph-plus text-base text-amber-400"></i>
            <span>Tambah Ruangan</span>
          </button>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
          <%- include('../../partials/table-pagination', {
            tableId: 'table-ruangan',
            part: 'toolbar',
            searchPlaceholder: 'Cari ruangan atau kode...',
            filterOptions: [
              {
                id: 'filter-gedung',
                label: 'Gedung',
                dataAttr: 'gedung',
                options: [
                  { value: 'Semua', text: 'Semua Gedung' },
                  { value: 'F4', text: 'Gedung F4' },
                  { value: 'F6', text: 'Gedung F6' }
                ]
              },
              {
                id: 'filter-tipe',
                label: 'Tipe',
                dataAttr: 'tipe',
                options: [
                  { value: 'Semua', text: 'Semua Fasilitas' },
                  { value: 'Lab', text: 'Laboratorium (PC)' },
                  { value: 'Reguler', text: 'Kelas Reguler (Kursi)' }
                ]
              }
            ]
          }) %>

          <div class="overflow-x-auto">
            <table id="table-ruangan" class="w-full text-left text-xs paginated-table">
              <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
                <tr>
                  <th class="px-4 py-3 font-semibold">Nama / Kode Ruang</th>
                  <th class="px-4 py-3 font-semibold">Gedung</th>
                  <th class="px-4 py-3 font-semibold">Tipe Fasilitas</th>
                  <th class="px-4 py-3 font-semibold">Kapasitas</th>
                  <th class="px-4 py-3 font-semibold text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                <% const listRg = (typeof ruanganList !== 'undefined' && Array.isArray(ruanganList)) ? ruanganList : []; %>
                <% listRg.forEach(function(rg) {
                  const isLab = String(rg.tipe || '').toLowerCase().includes('lab');
                %>
                  <tr data-gedung="<%= rg.gedung || 'F6' %>" data-tipe="<%= isLab ? 'Lab' : 'Reguler' %>">
                    <td class="px-4 py-3 font-mono font-bold <%= isLab ? 'text-amber-600 dark:text-amber-400' : 'text-[#0c2b5e] dark:text-blue-300' %>"><%= rg.kode %></td>
                    <td class="px-4 py-3 font-mono">Gedung <%= rg.gedung || 'F6' %></td>
                    <td class="px-4 py-3">
                      <span class="rounded <%= isLab ? 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300' : 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300' %> px-2 py-0.5 font-mono text-[10px] font-semibold"><%= rg.tipe %></span>
                    </td>
                    <td class="px-4 py-3 font-mono"><%= rg.kapasitas %> <%= isLab ? 'PC' : 'Kursi' %></td>
                    <td class="px-4 py-3 text-right space-x-1">
                      <button type="button" onclick="openRuanganDrawer('Edit Ruangan <%= rg.kode %>', '<%= rg.kode %>', '<%= rg.gedung || 'F6' %>', '<%= rg.tipe %>', '<%= rg.kapasitas %>', '<%= rg.id %>')" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1" title="Edit">
                        <i class="ph ph-pencil-simple text-base"></i>
                      </button>
                      <button type="button" onclick="deleteRuangan(<%= rg.id %>, '<%= rg.kode %>')" class="text-zinc-400 hover:text-rose-600 p-1" title="Hapus">
                        <i class="ph ph-trash text-base"></i>
                      </button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <%- include('../../partials/table-pagination', {
            tableId: 'table-ruangan',
            part: 'pagination',
            defaultPageSize: 10
          }) %>
        </div>

      </div>
    </main>

    <%- include('../../partials/admin-footer') %>
  </div>
</div>

<!-- Drawer Slide-Over CRUD Ruangan -->
<div id="drawer-ruangan-overlay"
  class="fixed inset-0 z-50 bg-black/40 transition-opacity duration-150 opacity-0 pointer-events-none">
  <div id="drawer-ruangan-panel"
    class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl border-l border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800 flex flex-col transform translate-x-full transition-transform duration-200 ease-in-out">

    <div class="flex items-center justify-between p-4 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <h3 id="ruangan-drawer-title" class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">Form Ruangan & Lab</h3>
        <p class="text-xs text-zinc-500">Kelola alokasi fisik perkuliahan</p>
      </div>
      <button onclick="closeRuanganDrawer()" type="button"
        class="h-8 w-8 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 flex items-center justify-center">
        <i class="ph ph-x text-base"></i>
      </button>
    </div>

    <form onsubmit="handleSaveRuangan(event)" class="flex-1 overflow-y-auto p-5 space-y-4 text-xs">
      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Nama / Kode Ruang (Format F4/F6, Maks. 10 Karakter)</label>
        <input id="input-ruang-code" type="text" required minlength="4" maxlength="10" pattern="F[46]\.[A-Za-z0-9]{2,6}" title="Format ruang wajib F4.xxx atau F6.xxx (contoh: F4.LAB1, F6.201)" placeholder="Contoh: F4.LAB3 atau F4.004"
          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono uppercase text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Gedung</label>
          <select id="input-ruang-building" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
            <option value="F4">Gedung F4 (Teknik)</option>
            <option value="F6">Gedung F6 (Dasar)</option>
          </select>
        </div>
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Kapasitas Maksimal</label>
          <input id="input-ruang-cap" type="number" required value="40" min="10" max="120"
            class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
        </div>
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Tipe Fasilitas Ruangan</label>
        <select id="input-ruang-type" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
          <option value="Laboratorium">Laboratorium (Khusus Praktikum)</option>
          <option value="Ruang Kuliah Besar">Ruang Kuliah Besar (RKB Teori Kapasitas Besar)</option>
          <option value="Ruang Kuliah">Ruang Kuliah (Teori Standar)</option>
        </select>
      </div>

      <div class="pt-4 flex items-center justify-end gap-2 border-t border-zinc-100 dark:border-zinc-800">
        <button type="button" onclick="closeRuanganDrawer()"
          class="inline-flex min-h-[36px] items-center rounded-lg border border-zinc-200 px-3.5 font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">
          Batal
        </button>
        <button type="submit"
          class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs">
          <i class="ph ph-check text-amber-400"></i>
          <span>Simpan Ruangan</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  let editingRuanganId = null;

  function openRuanganDrawer(title, code, building, type, cap, id = null) {
    editingRuanganId = id ? Number(id) : null;
    const overlay = document.getElementById('drawer-ruangan-overlay');
    const panel = document.getElementById('drawer-ruangan-panel');
    const titleEl = document.getElementById('ruangan-drawer-title');
    const codeEl = document.getElementById('input-ruang-code');
    const buildingEl = document.getElementById('input-ruang-building');
    const typeEl = document.getElementById('input-ruang-type');
    const capEl = document.getElementById('input-ruang-cap');

    if (titleEl) titleEl.textContent = title;
    if (codeEl) codeEl.value = code || '';
    if (buildingEl) buildingEl.value = building || 'F6';
    if (typeEl) typeEl.value = type || 'Ruang Kuliah';
    if (capEl) capEl.value = cap || '40';

    if (overlay && panel) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
    }
  }

  function closeRuanganDrawer() {
    const overlay = document.getElementById('drawer-ruangan-overlay');
    const panel = document.getElementById('drawer-ruangan-panel');
    if (overlay && panel) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
    }
  }

  async function handleSaveRuangan(e) {
    e.preventDefault();
    const kode = document.getElementById('input-ruang-code')?.value.trim();
    const payload = {
      kategori: 'ruangan',
      kode,
      nama: `Ruang ${kode}`,
      gedung: document.getElementById('input-ruang-building')?.value || 'F6',
      tipe: document.getElementById('input-ruang-type')?.value || 'Reguler',
      kapasitas: Number(document.getElementById('input-ruang-cap')?.value || 40)
    };

    try {
      const url = editingRuanganId ? `/api/master/ruangan/${editingRuanganId}` : '/api/master';
      const method = editingRuanganId ? 'PUT' : 'POST';
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menyimpan ruangan.');
      closeRuanganDrawer();
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
      setTimeout(() => window.location.reload(), 400);
    } catch (err) {
      if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
      else alert(err.message);
    }
  }

  function deleteRuangan(id, kode) {
    const execDelete = async () => {
      try {
        const res = await fetch(`/api/master/ruangan/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menghapus ruangan.');
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(data.pesan, 'success');
        setTimeout(() => window.location.reload(), 400);
      } catch (err) {
        if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show(err.message, 'error');
      }
    };
    if (window.showConfirmDialog) {
      window.showConfirmDialog('Hapus Ruangan', `Yakin ingin menghapus ruang ${kode}?`, execDelete, 'Hapus');
    } else if (confirm(`Hapus ruang ${kode}?`)) {
      execDelete();
    }
  }
</script>
