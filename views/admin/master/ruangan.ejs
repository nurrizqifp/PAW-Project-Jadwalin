<%- include('../../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Master Data Ruangan & Lab — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../../partials/admin-sidebar', { activeMenu: 'ruangan' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
    <div class="max-w-6xl mx-auto space-y-6">

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
            Master Data Ruangan & Laboratorium
          </h1>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Kelola data 12 sarana ruang perkuliahan, laboratorium komputer, dan kapasitas kursi mahasiswa.
          </p>
        </div>

        <button type="button" class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
          <i class="ph ph-plus text-base text-amber-400"></i>
          <span>Tambah Ruangan / Lab</span>
        </button>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
              <tr>
                <th class="px-4 py-3 font-semibold">Kode Ruang</th>
                <th class="px-4 py-3 font-semibold">Nama Ruangan</th>
                <th class="px-4 py-3 font-semibold">Tipe Fasilitas</th>
                <th class="px-4 py-3 font-semibold">Kapasitas</th>
                <th class="px-4 py-3 font-semibold">Status</th>
                <th class="px-4 py-3 font-semibold text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
              <tr>
                <td class="px-4 py-3 font-mono font-semibold">LAB-01</td>
                <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">Lab Komputer Multimedia</td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1 rounded bg-zinc-100 px-2 py-0.5 font-mono text-[10px] text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">
                    <i class="ph ph-desktop"></i>
                    Laboratorium
                  </span>
                </td>
                <td class="px-4 py-3 font-mono">40 Kursi</td>
                <td class="px-4 py-3">
                  <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Aktif</span>
                </td>
                <td class="px-4 py-3 text-right">
                  <button type="button" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1">
                    <i class="ph ph-pencil-simple text-base"></i>
                  </button>
                </td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-mono font-semibold">F3-201</td>
                <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">Ruang Kuliah F3.201</td>
                <td class="px-4 py-3">
                  <span class="inline-flex items-center gap-1 rounded bg-zinc-100 px-2 py-0.5 font-mono text-[10px] text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">
                    <i class="ph ph-chalkboard"></i>
                    Reguler
                  </span>
                </td>
                <td class="px-4 py-3 font-mono">50 Kursi</td>
                <td class="px-4 py-3">
                  <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Aktif</span>
                </td>
                <td class="px-4 py-3 text-right">
                  <button type="button" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1">
                    <i class="ph ph-pencil-simple text-base"></i>
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

    <%- include('../../partials/admin-footer') %>
  </div>
</div>
