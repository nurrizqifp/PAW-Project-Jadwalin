<%- include('../../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Master Data Mata Kuliah — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../../partials/admin-sidebar', { activeMenu: 'matkul' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <div>
            <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Master Data Mata Kuliah
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Daftar 77 Mata Kuliah Kurikulum TI 2024, bobot SKS, semester, dan jenis ruang (Teori/Lab).
            </p>
          </div>

          <button type="button" onclick="openMatkulDrawer('Tambah Mata Kuliah Baru', '', '', '3', '3', 'Teori')"
            class="inline-flex min-h-[38px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
            <i class="ph ph-plus text-base text-amber-400"></i>
            <span>Tambah Mata Kuliah</span>
          </button>
        </div>

        <div class="rounded-xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-zinc-200 bg-zinc-50/75 dark:border-zinc-800 dark:bg-zinc-800/50 font-mono text-[11px] uppercase text-zinc-500">
                <tr>
                  <th class="px-4 py-3 font-semibold">Kode MK</th>
                  <th class="px-4 py-3 font-semibold">Nama Mata Kuliah</th>
                  <th class="px-4 py-3 font-semibold">SKS</th>
                  <th class="px-4 py-3 font-semibold">Semester</th>
                  <th class="px-4 py-3 font-semibold">Tipe Ruang</th>
                  <th class="px-4 py-3 font-semibold text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                <tr>
                  <td class="px-4 py-3 font-mono font-bold text-[#0c2b5e] dark:text-blue-300">TI26101</td>
                  <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">Fisika dan Elektronika TI</td>
                  <td class="px-4 py-3 font-mono">2 SKS</td>
                  <td class="px-4 py-3 font-mono">Semester 1</td>
                  <td class="px-4 py-3">
                    <span class="rounded bg-blue-100 px-2 py-0.5 font-mono text-[10px] text-blue-800 dark:bg-blue-950 dark:text-blue-300 font-semibold">Teori (RKB)</span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <button type="button" onclick="openMatkulDrawer('Edit Mata Kuliah TI26101', 'TI26101', 'Fisika dan Elektronika TI', '2', '1', 'Teori')" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1">
                      <i class="ph ph-pencil-simple text-base"></i>
                    </button>
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-mono font-bold text-amber-600 dark:text-amber-400">TI26105</td>
                  <td class="px-4 py-3 font-semibold text-zinc-900 dark:text-zinc-100">Pemrograman Berorientasi Objek</td>
                  <td class="px-4 py-3 font-mono">3 SKS</td>
                  <td class="px-4 py-3 font-mono">Semester 3</td>
                  <td class="px-4 py-3">
                    <span class="rounded bg-amber-100 px-2 py-0.5 font-mono text-[10px] text-amber-800 dark:bg-amber-950 dark:text-amber-300 font-semibold">Praktikum (Lab)</span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <button type="button" onclick="openMatkulDrawer('Edit Mata Kuliah TI26105', 'TI26105', 'Pemrograman Berorientasi Objek', '3', '3', 'Praktikum')" class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-200 p-1">
                      <i class="ph ph-pencil-simple text-base"></i>
                    </button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>

    <%- include('../../partials/admin-footer') %>
  </div>
</div>

<!-- Drawer Slide-Over CRUD Mata Kuliah -->
<div id="drawer-matkul-overlay"
  class="fixed inset-0 z-50 bg-black/40 transition-opacity duration-150 opacity-0 pointer-events-none">
  <div id="drawer-matkul-panel"
    class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl border-l border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800 flex flex-col transform translate-x-full transition-transform duration-200 ease-in-out">

    <div class="flex items-center justify-between p-4 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <h3 id="matkul-drawer-title" class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">Form Mata Kuliah</h3>
        <p class="text-xs text-zinc-500">Kelola kurikulum dan bobot perkuliahan</p>
      </div>
      <button onclick="closeMatkulDrawer()" type="button"
        class="h-8 w-8 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 flex items-center justify-center">
        <i class="ph ph-x text-base"></i>
      </button>
    </div>

    <form onsubmit="handleSaveMatkul(event)" class="flex-1 overflow-y-auto p-5 space-y-4 text-xs">
      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Kode Mata Kuliah</label>
        <input id="input-mk-code" type="text" required placeholder="Contoh: TI26105"
          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Nama Mata Kuliah</label>
        <input id="input-mk-name" type="text" required placeholder="Contoh: Pemrograman Berorientasi Objek"
          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Bobot SKS</label>
          <input id="input-mk-sks" type="number" required value="3" min="1" max="6"
            class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
        </div>
        <div class="space-y-1">
          <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Semester</label>
          <select id="input-mk-sem" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
            <option value="1">Semester 1</option>
            <option value="2">Semester 2</option>
            <option value="3">Semester 3</option>
            <option value="4">Semester 4</option>
            <option value="5">Semester 5</option>
            <option value="6">Semester 6</option>
            <option value="7">Semester 7</option>
            <option value="8">Semester 8</option>
          </select>
        </div>
      </div>

      <div class="space-y-1">
        <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Tipe Ruangan Dibutuhkan</label>
        <select id="input-mk-type" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100">
          <option value="Teori">Teori (Kelas Reguler atau RKB)</option>
          <option value="Praktikum">Praktikum (Wajib 4 Lab Komputer F4)</option>
        </select>
      </div>

      <div class="pt-4 flex items-center justify-end gap-2 border-t border-zinc-100 dark:border-zinc-800">
        <button type="button" onclick="closeMatkulDrawer()"
          class="inline-flex min-h-[36px] items-center rounded-lg border border-zinc-200 px-3.5 font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800">
          Batal
        </button>
        <button type="submit"
          class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs">
          <i class="ph ph-check text-amber-400"></i>
          <span>Simpan Mata Kuliah</span>
        </button>
      </div>
    </form>

  </div>
</div>

<script>
  function openMatkulDrawer(title, code, name, sks, sem, type) {
    const overlay = document.getElementById('drawer-matkul-overlay');
    const panel = document.getElementById('drawer-matkul-panel');
    const titleEl = document.getElementById('matkul-drawer-title');
    const codeEl = document.getElementById('input-mk-code');
    const nameEl = document.getElementById('input-mk-name');
    const sksEl = document.getElementById('input-mk-sks');
    const semEl = document.getElementById('input-mk-sem');
    const typeEl = document.getElementById('input-mk-type');

    if (titleEl) titleEl.textContent = title;
    if (codeEl) codeEl.value = code;
    if (nameEl) nameEl.value = name;
    if (sksEl) sksEl.value = sks;
    if (semEl) semEl.value = sem;
    if (typeEl) typeEl.value = type;

    if (overlay && panel) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      panel.classList.remove('translate-x-full');
    }
  }

  function closeMatkulDrawer() {
    const overlay = document.getElementById('drawer-matkul-overlay');
    const panel = document.getElementById('drawer-matkul-panel');
    if (overlay && panel) {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.add('translate-x-full');
    }
  }

  function handleSaveMatkul(e) {
    e.preventDefault();
    closeMatkulDrawer();
    window.showConfirmDialog('Mata Kuliah Disimpan', 'Data mata kuliah kurikulum berhasil disimpan.', null, 'Selesai', true);
  }
</script>
