<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Pengaturan & Profil Pengelola — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: typeof activeMenu !== 'undefined' ? activeMenu : 'settings' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <!-- Header -->
        <div class="border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-blue-900 dark:bg-blue-950 dark:text-blue-300">
            Pusat Pengaturan
          </span>
          <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
            Pengaturan Sistem & Profil Pengelola
          </h1>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Kelola profil staf, kalender akademik semester aktif, kebijakan solver jadwal, dan keamanan akun.
          </p>
        </div>

        <!-- Layout Tab Menu Vertikal (Shadcn Settings Style) -->
        <div class="flex flex-col md:flex-row gap-6 items-start">
          
          <!-- SISI KIRI: Vertical Tabs Nav -->
          <nav class="w-full md:w-60 shrink-0 space-y-1 rounded-xl border border-zinc-200 bg-white p-2 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 text-xs font-medium">
            <button type="button" onclick="switchSettingsTab('profil')" id="tab-btn-profil"
              class="settings-tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors <%= typeof defaultTab !== 'undefined' && defaultTab === 'profil' ? 'bg-[#0c2b5e] text-white font-semibold shadow-xs' : 'text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800' %>">
              <i class="ph ph-user-circle text-base"></i>
              <span>Profil Staf</span>
            </button>

            <button type="button" onclick="switchSettingsTab('periode')" id="tab-btn-periode"
              class="settings-tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors <%= typeof defaultTab === 'undefined' || defaultTab === 'periode' || defaultTab === 'settings' ? 'bg-[#0c2b5e] text-white font-semibold shadow-xs' : 'text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800' %>">
              <i class="ph ph-calendar text-base"></i>
              <span>Periode & Semester</span>
            </button>

            <button type="button" onclick="switchSettingsTab('solver')" id="tab-btn-solver"
              class="settings-tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">
              <i class="ph ph-sliders text-base"></i>
              <span>Kebijakan Solver</span>
            </button>

            <button type="button" onclick="switchSettingsTab('keamanan')" id="tab-btn-keamanan"
              class="settings-tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">
              <i class="ph ph-lock-key text-base"></i>
              <span>Keamanan Akun</span>
            </button>

            <button type="button" onclick="switchSettingsTab('log')" id="tab-btn-log"
              class="settings-tab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">
              <i class="ph ph-clock-counter-clockwise text-base"></i>
              <span>Log & Cadangan</span>
            </button>
          </nav>

          <!-- SISI KANAN: Tab Content Panels -->
          <div class="flex-1 w-full space-y-6">

            <!-- ============================================== -->
            <!-- TAB 1: PROFIL STAF                             -->
            <!-- ============================================== -->
            <div id="settings-tab-profil" class="settings-tab-pane <%= typeof defaultTab !== 'undefined' && defaultTab === 'profil' ? '' : 'hidden' %> space-y-5">
              <!-- Profil Card Hero -->
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900">
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">
                  <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[#0c2b5e] text-white font-heading font-bold text-2xl shadow-sm border border-amber-400/40">
                    RW
                  </div>
                  <div class="space-y-1 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h2 class="font-heading text-lg font-bold text-zinc-900 dark:text-zinc-100">
                        Rina Wulandari, S.T.
                      </h2>
                      <span class="rounded bg-emerald-100 px-2 py-0.5 text-[10px] font-mono font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                        Aktif · Super Admin
                      </span>
                    </div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                      NIP: 19880415 201404 2 001 · Staf Kurikulum & Administrasi TI UMY
                    </p>
                  </div>
                </div>
              </div>

              <!-- Form Identitas & Kontak -->
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
                <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100 border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  Data Identitas & Kontak Resmi
                </h3>
                <form onsubmit="event.preventDefault(); window.showConfirmDialog('Profil Disimpan', 'Pembaruan data profil pengelola telah berhasil disimpan.', null, 'Selesai', true);" class="space-y-4 text-xs">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Nama Lengkap & Gelar</label>
                      <input type="text" value="Rina Wulandari, S.T."
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                    </div>
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">NIP Pegawai</label>
                      <input type="text" value="19880415 201404 2 001" readonly
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 font-mono text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-zinc-400">
                    </div>
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Email Kampus</label>
                      <input type="email" value="rina.wulandari@ft.umy.ac.id"
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                    </div>
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Nomor Telepon / WhatsApp</label>
                      <input type="text" value="+62 812-3456-7890"
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                    </div>
                  </div>
                  <div class="flex justify-end pt-2">
                    <button type="submit"
                      class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs transition-colors">
                      <i class="ph ph-check text-amber-400"></i>
                      <span>Simpan Profil</span>
                    </button>
                  </div>
                </form>
              </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 2: PERIODE & SEMESTER AKADEMIK             -->
            <!-- ============================================== -->
            <div id="settings-tab-periode" class="settings-tab-pane <%= typeof defaultTab === 'undefined' || defaultTab === 'periode' || defaultTab === 'settings' ? '' : 'hidden' %> space-y-5">
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
                <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Pengaturan Periode Akademik & Semester Berjalan
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Menentukan semester acuan untuk penjadwalan dan pemilihan paket Pra-KRS mahasiswa.
                  </p>
                </div>

                <form onsubmit="event.preventDefault(); window.showConfirmDialog('Periode Akademik Diperbarui', 'Pengaturan semester aktif berhasil disinkronkan ke seluruh sistem.', null, 'Selesai', true);" class="space-y-4 text-xs">
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Tahun Akademik</label>
                      <select class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <option value="2026/2027" selected>2026/2027</option>
                        <option value="2025/2026">2025/2026</option>
                      </select>
                    </div>

                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Semester Aktif</label>
                      <select class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <option value="Ganjil" selected>Semester Ganjil (Gasal)</option>
                        <option value="Genap">Semester Genap</option>
                      </select>
                    </div>

                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Batas Maksimal SKS</label>
                      <input type="number" value="24" min="12" max="24"
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                    </div>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Batas Akhir Pra-KRS Mahasiswa</label>
                      <input type="date" value="2026-09-01"
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                    </div>
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Status Akses Mahasiswa</label>
                      <select class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <option value="open" selected>Dibuka (Simulasi Pra-KRS Aktif)</option>
                        <option value="locked">Terkunci (Hanya Mode Baca Jadwal)</option>
                      </select>
                    </div>
                  </div>

                  <div class="flex justify-end pt-2">
                    <button type="submit"
                      class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs transition-colors">
                      <i class="ph ph-check text-amber-400"></i>
                      <span>Simpan Periode</span>
                    </button>
                  </div>
                </form>
              </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 3: KEBIJAKAN SOLVER (TOGGLE TANPA SUBMIT)   -->
            <!-- ============================================== -->
            <div id="settings-tab-solver" class="settings-tab-pane hidden space-y-5">
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
                <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Konfigurasi Otomatis Solver Jadwal
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Pengaturan di bawah ini menggunakan saklar instan. Perubahan status langsung aktif secara otomatis tanpa tombol simpan.
                  </p>
                </div>

                <div class="space-y-4 text-xs">
                  <!-- Toggle 1: Jeda Sholat Dhuhur -->
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Hard Constraint HC-03: Jeda Sholat Dhuhur (11:30–12:10)</span>
                        <span class="rounded bg-emerald-100 px-1.5 py-0.2 font-mono text-[9px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Wajib</span>
                      </div>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Memastikan tidak ada slot perkuliahan maupun praktikum di seluruh gedung F4 & F6 saat jam ibadah.
                      </p>
                    </div>
                    <!-- iOS / Shadcn Style Toggle Switch -->
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Jeda Sholat Dhuhur (HC-03)')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>

                  <!-- Toggle 2: Lab Matching -->
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Hard Constraint HC-02: Lab Matching Otomatis</span>
                        <span class="rounded bg-emerald-100 px-1.5 py-0.2 font-mono text-[9px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Wajib</span>
                      </div>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Mata kuliah bertipe Praktikum wajib dialokasikan ke 4 Laboratorium Komputer Gedung F4.
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Lab Matching (HC-02)')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>

                  <!-- Toggle 3: Soft Constraint Prioritas Dosen -->
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Soft Constraint SC-01: Prioritas Hari Bebas Mengajar Dosen</span>
                        <span class="rounded bg-amber-100 px-1.5 py-0.2 font-mono text-[9px] font-bold text-amber-800 dark:bg-amber-950 dark:text-amber-300">Optimasi</span>
                      </div>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Hindari jadwal mengajar pada hari yang diajukan dosen untuk tugas riset atau pengabdian masyarakat.
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Prioritas Hari Bebas Dosen (SC-01)')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>

                  <!-- Toggle 4: Notifikasi Real-time -->
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <span class="font-semibold text-zinc-900 dark:text-zinc-100">Broadcast Notifikasi Instan Perubahan Jadwal</span>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Kirimkan sinyal pembaruan otomatis ke dashboard mahasiswa dan dosen saat admin mempublikasikan jadwal baru.
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Broadcast Notifikasi Instan')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>
                </div>

                <!-- Toast Indikator Auto-Save Status -->
                <div id="toggle-toast-indicator" class="hidden p-3 rounded-lg bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 flex items-center justify-between text-xs">
                  <span id="toggle-toast-msg" class="flex items-center gap-1.5 font-medium">
                    <i class="ph ph-check-circle text-base"></i> Pengaturan berhasil diperbarui secara otomatis.
                  </span>
                  <span class="font-mono text-[10px] opacity-75">Tersimpan</span>
                </div>
              </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 4: KEAMANAN AKUN (TOGGLE EYE PASSWORD)     -->
            <!-- ============================================== -->
            <div id="settings-tab-keamanan" class="settings-tab-pane hidden space-y-5">
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
                <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Keamanan Akun & Perubahan Kata Sandi
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Gunakan kata sandi kombinasi huruf, angka, dan simbol untuk menjaga keamanan portal akademik.
                  </p>
                </div>

                <form onsubmit="event.preventDefault(); window.showConfirmDialog('Kata Sandi Berhasil Diperbarui', 'Kata sandi akun Anda telah diperbarui dengan aman.', null, 'Selesai', true);" class="space-y-4 text-xs">
                  
                  <!-- Input Password Saat Ini -->
                  <div class="space-y-1">
                    <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Kata Sandi Saat Ini</label>
                    <div class="relative">
                      <input id="input-current-pass" type="password" required placeholder="Masukkan kata sandi saat ini"
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white pl-3 pr-10 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                      <button type="button" onclick="togglePasswordEye('input-current-pass', 'eye-icon-current')"
                        class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 p-1">
                        <i id="eye-icon-current" class="ph ph-eye text-base"></i>
                      </button>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Input Password Baru -->
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Kata Sandi Baru</label>
                      <div class="relative">
                        <input id="input-new-pass" type="password" required minlength="8" placeholder="Minimal 8 karakter"
                          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white pl-3 pr-10 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <button type="button" onclick="togglePasswordEye('input-new-pass', 'eye-icon-new')"
                          class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 p-1">
                          <i id="eye-icon-new" class="ph ph-eye text-base"></i>
                        </button>
                      </div>
                    </div>

                    <!-- Konfirmasi Password Baru -->
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Konfirmasi Kata Sandi Baru</label>
                      <div class="relative">
                        <input id="input-confirm-pass" type="password" required minlength="8" placeholder="Ulangi kata sandi baru"
                          class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white pl-3 pr-10 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <button type="button" onclick="togglePasswordEye('input-confirm-pass', 'eye-icon-confirm')"
                          class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 p-1">
