<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Pengaturan Sistem — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'settings' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">

        <!-- Header -->
        <div class="border-b border-zinc-200 pb-5 dark:border-zinc-800">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200">
            Konfigurasi Sistem
          </span>
          <h1 class="font-heading text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 pt-1">
            Pengaturan Sistem Jadwalin
          </h1>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Kelola parameter operasional, kebijakan solver, integrasi pengumuman, dan pemeliharaan basis data.
          </p>
        </div>

        <!-- Layout Tab Menu Vertikal di Halaman Pengaturan -->
        <div class="flex flex-col md:flex-row gap-6 items-start">
          
          <!-- SISI KIRI: Vertical Tabs Nav -->
          <nav class="w-full md:w-56 shrink-0 space-y-1 rounded-xl border border-zinc-200 bg-white p-2 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 text-xs font-medium">
            <button type="button" onclick="switchSettingsVerticalTab('periode')" id="set-tab-btn-periode"
              class="settings-vtab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors bg-[#0c2b5e] text-white font-semibold shadow-xs">
              <i class="ph ph-calendar text-base"></i>
              <span>Periode Akademik</span>
            </button>

            <button type="button" onclick="switchSettingsVerticalTab('solver')" id="set-tab-btn-solver"
              class="settings-vtab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">
              <i class="ph ph-sliders text-base"></i>
              <span>Aturan Solver AI</span>
            </button>

            <button type="button" onclick="switchSettingsVerticalTab('notifikasi')" id="set-tab-btn-notifikasi"
              class="settings-vtab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">
              <i class="ph ph-bell text-base"></i>
              <span>Integrasi & Notifikasi</span>
            </button>

            <button type="button" onclick="switchSettingsVerticalTab('pemeliharaan')" id="set-tab-btn-pemeliharaan"
              class="settings-vtab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800">
              <i class="ph ph-database text-base"></i>
              <span>Cadangan & Basis Data</span>
            </button>
          </nav>

          <!-- SISI KANAN: Tab Content Panels -->
          <div class="flex-1 w-full space-y-6">

            <!-- TAB 1: PERIODE AKADEMIK -->
            <div id="set-panel-periode" class="settings-vtab-pane space-y-5">
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
                <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Periode Akademik & Semester Aktif
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Menentukan semester acuan untuk penjadwalan dan pemilihan paket Pra-KRS mahasiswa.
                  </p>
                </div>

                <%
                  const setPer = (typeof activePeriode !== 'undefined' && activePeriode) ? activePeriode : { id: 1, tahunAkademik: '2026/2027', semesterTipe: 'Ganjil', publishedAt: '2026-12-31', status: 'Terpublikasi' };
                %>
                <form onsubmit="handleSaveSettingsPeriode(event, <%= setPer.id || 1 %>)" class="space-y-4 text-xs">
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Tahun Akademik</label>
                      <select id="set-per-year" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <option value="2026/2027" <%= setPer.tahunAkademik === '2026/2027' ? 'selected' : '' %>>2026/2027</option>
                        <option value="2025/2026" <%= setPer.tahunAkademik === '2025/2026' ? 'selected' : '' %>>2025/2026</option>
                      </select>
                    </div>

                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Semester Berjalan</label>
                      <select id="set-per-sem" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <option value="Ganjil" <%= setPer.semesterTipe === 'Ganjil' ? 'selected' : '' %>>Semester Ganjil (Gasal)</option>
                        <option value="Genap" <%= setPer.semesterTipe === 'Genap' ? 'selected' : '' %>>Semester Genap</option>
                      </select>
                    </div>

                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Batas Maksimal SKS (12–24)</label>
                      <input id="set-per-sks" type="number" required value="24" min="12" max="24"
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                    </div>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Batas Akhir Pra-KRS Mahasiswa</label>
                      <input id="set-per-date" type="date" required value="<%= setPer.publishedAt || '2026-12-31' %>"
                        class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                    </div>
                    <div class="space-y-1">
                      <label class="block font-semibold text-zinc-700 dark:text-zinc-300">Status Akses Mahasiswa</label>
                      <select id="set-per-status" class="w-full min-h-[38px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
                        <option value="Terpublikasi" <%= setPer.status !== 'Arsip' ? 'selected' : '' %>>Terpublikasi (Pengisian Pra-KRS Aktif)</option>
                        <option value="Arsip" <%= setPer.status === 'Arsip' ? 'selected' : '' %>>Arsip (Terkunci / Hanya Baca Jadwal)</option>
                      </select>
                    </div>
                  </div>

                  <div class="flex justify-end pt-2">
                    <button type="submit"
                      class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 font-semibold text-white shadow-xs transition-colors">
                      <i class="ph ph-check text-amber-400"></i>
                      <span>Simpan Periode</span>
                    </button>
                  </div>
                </form>
              </div>
            </div>

            <!-- TAB 2: ATURAN SOLVER AI (TOGGLE TANPA SUBMIT) -->
            <div id="set-panel-solver" class="settings-vtab-pane hidden space-y-5">
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
                <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Konfigurasi Otomatis Solver Jadwal
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Pengaturan di bawah ini menggunakan saklar instan. Perubahan status langsung aktif tanpa tombol simpan.
                  </p>
                </div>

                <div class="space-y-4 text-xs">
                  <!-- Toggle 1: Jeda Sholat Dhuhur -->
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Hard Constraint HC-03: Jeda Sholat Dhuhur (11:30–12:10)</span>
                        <span class="rounded bg-emerald-100 px-1.5 py-0.2 font-mono text-[9px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Wajib</span>
                      </div>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Memastikan tidak ada slot perkuliahan maupun praktikum di seluruh gedung F4 & F6 saat jam ibadah.
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Jeda Sholat Dhuhur (HC-03)')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>

                  <!-- Toggle 2: Lab Matching -->
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Hard Constraint HC-02: Lab Matching Otomatis</span>
                        <span class="rounded bg-emerald-100 px-1.5 py-0.2 font-mono text-[9px] font-bold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">Wajib</span>
                      </div>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Mata kuliah bertipe Praktikum wajib dialokasikan ke 4 Laboratorium Komputer Gedung F4.
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Lab Matching (HC-02)')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>

                  <!-- Toggle 3: Soft Constraint Prioritas Dosen -->
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <div class="flex items-center gap-2">
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Soft Constraint SC-01: Prioritas Hari Bebas Mengajar Dosen</span>
                        <span class="rounded bg-amber-100 px-1.5 py-0.2 font-mono text-[9px] font-bold text-amber-800 dark:bg-amber-950 dark:text-amber-300">Optimasi</span>
                      </div>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Hindari jadwal mengajar pada hari yang diajukan dosen untuk tugas riset atau pengabdian masyarakat.
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Prioritas Hari Bebas Dosen (SC-01)')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>

                  <!-- Range Slider 1: Batas Iterasi Solver -->
                  <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40 space-y-2">
                    <div class="flex items-center justify-between">
                      <div>
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Batas Maksimal Siklus Iterasi AI Solver</span>
                        <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Makin tinggi iterasi, semakin optimal solusi penataan ruang & waktu.</p>
                      </div>
                      <span id="iterasi-val" class="font-mono font-bold text-xs px-2.5 py-1 rounded bg-blue-100 dark:bg-blue-950 text-[#0c2b5e] dark:text-amber-400 border border-blue-200 dark:border-blue-900">
                        5.000 Siklus
                      </span>
                    </div>
                    <div class="pt-1">
                      <input type="range" min="1000" max="15000" step="500" value="5000"
                        oninput="document.getElementById('iterasi-val').textContent = Number(this.value).toLocaleString('id-ID') + ' Siklus'"
                        onchange="handleInstantToggle(this, 'Batas Iterasi Solver: ' + Number(this.value).toLocaleString('id-ID'))">
                    </div>
                  </div>

                  <!-- Range Slider 2: Bobot Penalti Pelanggaran Soft Constraint -->
                  <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40 space-y-2">
                    <div class="flex items-center justify-between">
                      <div>
                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">Bobot Penalti Pelanggaran Preferensi Waktu</span>
                        <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Tingkat kompromi AI saat kondisi ruang dan slot jadwal sangat padat.</p>
                      </div>
                      <span id="bobot-val" class="font-mono font-bold text-xs px-2.5 py-1 rounded bg-amber-100 dark:bg-amber-950 text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-900">
                        Tingkat 6 / 10
                      </span>
                    </div>
                    <div class="pt-1">
                      <input type="range" min="1" max="10" step="1" value="6"
                        oninput="document.getElementById('bobot-val').textContent = 'Tingkat ' + this.value + ' / 10'"
                        onchange="handleInstantToggle(this, 'Bobot Penalti: ' + this.value)">
                    </div>
                  </div>
                </div>

                <!-- Toast Indikator Auto-Save Status -->
                <div id="toggle-toast-indicator" class="hidden p-3 rounded-lg bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 flex items-center justify-between text-xs">
                  <span id="toggle-toast-msg" class="flex items-center gap-1.5 font-medium">
                    <i class="ph ph-check-circle text-base"></i> Pengaturan berhasil diperbarui secara otomatis.
                  </span>
                  <span class="font-mono text-[10px] opacity-75">Tersimpan</span>
                </div>
              </div>
            </div>

            <!-- TAB 3: INTEGRASI & NOTIFIKASI -->
            <div id="set-panel-notifikasi" class="settings-vtab-pane hidden space-y-5">
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-5">
                <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    Integrasi Kanal Informasi & Notifikasi
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Konfigurasi otomatisasi siaran jadwal ke portal mahasiswa, dosen, dan kanal pengumuman fakultas.
                  </p>
                </div>

                <div class="space-y-4 text-xs">
                  <div class="flex items-center justify-between p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
                    <div class="space-y-0.5 pr-4">
                      <span class="font-semibold text-zinc-900 dark:text-zinc-100">Broadcast Notifikasi Instan Perubahan Jadwal</span>
                      <p class="text-zinc-500 dark:text-zinc-400">
                        Kirimkan sinyal pembaruan otomatis ke dashboard mahasiswa dan dosen saat jadwal baru dipublikasikan.
                      </p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer shrink-0">
                      <input type="checkbox" checked onchange="handleInstantToggle(this, 'Broadcast Notifikasi')" class="sr-only peer">
                      <div class="w-11 h-6 bg-zinc-200 peer-focus:outline-none rounded-full peer dark:bg-zinc-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-zinc-600 peer-checked:bg-[#0c2b5e]"></div>
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <!-- TAB 4: CADANGAN & BASIS DATA POSTGRESQL -->
            <div id="set-panel-pemeliharaan" class="settings-vtab-pane hidden space-y-5">
              <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
                <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800">
                  <div class="flex items-center gap-2">
                    <span class="rounded bg-blue-100 px-2 py-0.5 font-mono text-[10px] font-bold text-blue-900 dark:bg-blue-950 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
                      POSTGRESQL 16
                    </span>
                    <span class="text-xs text-emerald-600 dark:text-emerald-400 font-mono flex items-center gap-1">
                      <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Connected: jadwalin_db (Port 5432)
                    </span>
                  </div>
                  <h3 class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100 pt-2">
                    Cadangan & Pemeliharaan Basis Data PostgreSQL
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">
                    Utilitas pencadangan snapshot data relasional PostgreSQL (jadwalin_db.sql) untuk tabel master dosen, ruangan, mata kuliah, jadwal perkuliahan, dan constraints.
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-3 pt-1">
                  <a href="/api/admin/backup-postgres" download
                    class="inline-flex min-h-[36px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 text-xs font-semibold text-white transition-colors shadow-xs border border-blue-900/40">
                    <i class="ph ph-database text-base text-amber-400"></i>
                    <span>Download Backup PostgreSQL (.sql)</span>
                  </a>

                  <button type="button"
                    onclick="window.showConfirmDialog('Pembersihan Cache', 'Cache session dan memori koneksi pool database akan disegarkan kembali.', () => { window.toast ? window.toast.success('Cache berhasil disegarkan.') : null; }, 'Bersihkan', true)"
                    class="inline-flex min-h-[36px] items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors shadow-xs">
                    <i class="ph ph-arrow-clockwise text-base text-amber-500"></i>
                    <span>Bersihkan Cache Pool</span>
                  </button>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  function switchSettingsVerticalTab(tabId) {
    document.querySelectorAll('.settings-vtab-pane').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.settings-vtab-btn').forEach(btn => {
      btn.className = 'settings-vtab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800';
    });

    const pane = document.getElementById(`set-panel-${tabId}`);
    const btn = document.getElementById(`set-tab-btn-${tabId}`);

    if (pane) pane.classList.remove('hidden');
    if (btn) {
      btn.className = 'settings-vtab-btn w-full flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-left transition-colors bg-[#0c2b5e] text-white font-semibold shadow-xs';
    }
  }

  async function handleSaveSettingsPeriode(e, periodeId) {
    e.preventDefault();
    const payload = {
      tahunAkademik: document.getElementById('set-per-year')?.value || '2026/2027',
      semesterTipe: document.getElementById('set-per-sem')?.value || 'Ganjil',
      batasWaktu: document.getElementById('set-per-date')?.value || '2026-12-31',
      status: document.getElementById('set-per-status')?.value || 'Terpublikasi'
    };
    try {
      const res = await fetch(`/api/master/periode/${periodeId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok || !data.sukses) throw new Error(data.pesan || 'Gagal menyimpan periode.');
      if (window.showConfirmDialog) {
        window.showConfirmDialog('Periode Akademik Diperbarui', data.pesan, () => window.location.reload(), 'Selesai', true);
      } else {
        window.location.reload();
      }
    } catch (err) {
      if (window.showConfirmDialog) window.showConfirmDialog('Gagal Menyimpan Periode', err.message, null, 'Tutup', true);
      else alert(err.message);
    }
  }

  async function handleInstantToggle(checkbox, featureName) {
    const toast = document.getElementById('toggle-toast-indicator');
    const msg = document.getElementById('toggle-toast-msg');
    const status = checkbox.checked ? 'diaktifkan' : 'dinonaktifkan';

    const hcMatch = String(featureName).match(/HC-0[123]/);
    if (hcMatch && typeof checkbox.checked === 'boolean') {
      try {
        await fetch('/api/constraints/hard', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: hcMatch[0], isActive: checkbox.checked })
        });
      } catch (_) {}
    }

    if (toast && msg) {
      msg.innerHTML = `<i class="ph ph-check-circle text-base"></i> Aturan <strong>${featureName}</strong> berhasil <strong>${status}</strong>.`;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3500);
    }
  }
</script>
