<header
  class="sticky top-0 z-40 w-full border-b border-zinc-200/80 bg-white/95 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/95 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-4">

      <!-- Brand Logo & Role Context Badge -->
      <div class="flex items-center space-x-3">
        <a href="/" class="flex items-center space-x-2.5 group">
          <img src="/logo.png" alt="Logo Jadwalin"
            class="h-8 sm:h-9 w-auto object-contain group-hover:scale-105 transition-transform">
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-50 font-heading leading-tight">
              Jadwalin
            </span>
          </div>
        </a>
      </div>

      <!-- Center: Role-Aware Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 text-xs font-semibold text-zinc-600 dark:text-zinc-300">
        <% if (typeof currentRole !=='undefined' && currentRole==='mahasiswa' ) { %>
          <a href="/"
            class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
            Beranda
          </a>
          <a href="/mahasiswa/jadwal"
            class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors <%= typeof judul !== 'undefined' && judul.includes('Jadwal') ? 'bg-zinc-100 dark:bg-zinc-800 text-[#0c2b5e] dark:text-amber-400' : '' %>">
            Jadwal Kuliah
          </a>
          <a href="/mahasiswa/prakrs"
            class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors <%= typeof judul !== 'undefined' && judul.includes('Pra-KRS') ? 'bg-zinc-100 dark:bg-zinc-800 text-[#0c2b5e] dark:text-amber-400' : '' %>">
            Simulasi Pra-KRS
          </a>
          <% } else if (typeof currentRole !=='undefined' && currentRole==='dosen' ) { %>
            <a href="/"
              class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
              Beranda
            </a>
            <a href="/dosen/jadwal"
              class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors <%= typeof judul !== 'undefined' && judul.includes('Jadwal Mengajar') ? 'bg-zinc-100 dark:bg-zinc-800 text-amber-700 dark:text-amber-400' : '' %>">
              Jadwal Mengajar (Grid)
            </a>
            <a href="/dosen/preferensi"
              class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors <%= typeof judul !== 'undefined' && judul.includes('Preferensi') ? 'bg-zinc-100 dark:bg-zinc-800 text-amber-700 dark:text-amber-400' : '' %>">
              Form Preferensi
            </a>
            <a href="/dosen/notifikasi"
              class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors <%= typeof judul !== 'undefined' && judul.includes('Notifikasi') ? 'bg-zinc-100 dark:bg-zinc-800 text-amber-700 dark:text-amber-400' : '' %>">
              Notifikasi
            </a>
            <% } else { %>
              <a href="/"
                class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
                Beranda
              </a>
              <a href="/mahasiswa/jadwal"
                class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
                Jadwal Perkuliahan
              </a>
              <a href="/mahasiswa/prakrs"
                class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
                Simulasi Pra-KRS
              </a>
              <% } %>
      </nav>

      <!-- Right Action Toolbar -->
      <div class="flex items-center space-x-2.5 text-xs shrink-0">

        <!-- Dark/Light Mode Switcher -->
        <button id="theme-toggle-btn" data-toggle-theme type="button"
          onclick="window.toggleTheme ? window.toggleTheme() : (window.JadwalinUI ? window.JadwalinUI.theme.toggle() : document.documentElement.classList.toggle('dark'))"
          aria-label="Ganti Mode Tampilan"
          class="h-8 w-8 rounded-md border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center transition-colors">
          <i id="theme-icon" class="theme-toggle-icon ph ph-moon text-base"></i>
        </button>

        <% if (typeof currentRole !=='undefined' && currentRole==='mahasiswa' ) { %>
          <!-- User Chip Mahasiswa -->
          <div class="flex items-center gap-2 pl-1">
            <div
              class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 py-1 px-2.5 dark:border-zinc-700 dark:bg-zinc-800">
              <div
                class="flex h-5 w-5 items-center justify-center rounded-full bg-[#0c2b5e] text-white text-[10px] font-bold">
                H
              </div>
              <span class="font-medium text-xs text-zinc-800 dark:text-zinc-200 hidden sm:inline">Haidar</span>
            </div>
            <a href="/login" title="Keluar Akun"
              class="h-8 w-8 rounded-md border border-zinc-200 bg-white hover:bg-rose-50 text-zinc-500 hover:text-rose-600 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-rose-950/40 dark:text-zinc-400 dark:hover:text-rose-400 flex items-center justify-center transition-colors">
              <i class="ph ph-sign-out text-base"></i>
            </a>
          </div>
          <% } else if (typeof currentRole !=='undefined' && currentRole==='dosen' ) { %>
            <!-- User Chip Dosen -->
            <div class="flex items-center gap-2 pl-1">
              <div
                class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 py-1 px-2.5 dark:border-zinc-700 dark:bg-zinc-800">
                <div
                  class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-600 text-white text-[10px] font-bold">
                  BT
                </div>
                <span class="font-medium text-xs text-zinc-800 dark:text-zinc-200 hidden sm:inline">Dr. Bambang</span>
              </div>
              <a href="/login" title="Keluar Akun"
                class="h-8 w-8 rounded-md border border-zinc-200 bg-white hover:bg-rose-50 text-zinc-500 hover:text-rose-600 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-rose-950/40 dark:text-zinc-400 dark:hover:text-rose-400 flex items-center justify-center transition-colors">
                <i class="ph ph-sign-out text-base"></i>
              </a>
            </div>
            <% } else { %>
              <!-- Login Button -->
              <a href="/login"
                class="inline-flex min-h-[34px] items-center gap-1.5 rounded-md bg-[#0c2b5e] hover:bg-[#081d40] px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-all border border-blue-900/40">
                <i class="ph ph-sign-in text-sm text-amber-400"></i>
                <span>Masuk Sistem</span>
              </a>
              <% } %>

      </div>

    </div>

    <!-- Mobile Sub-bar -->
    <div
      class="md:hidden flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 overflow-x-auto space-x-2">
      <% if (typeof currentRole !=='undefined' && currentRole==='mahasiswa' ) { %>
        <a href="/mahasiswa/dashboard"
          class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Dashboard</a>
        <a href="/mahasiswa/jadwal"
          class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Kalender Grid</a>
        <a href="/mahasiswa/prakrs"
          class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Pra-KRS</a>
        <a href="/mahasiswa/notifikasi"
          class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Notifikasi</a>
        <% } else if (typeof currentRole !=='undefined' && currentRole==='dosen' ) { %>
          <a href="/dosen/dashboard"
            class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Dashboard Dosen</a>
          <a href="/dosen/jadwal"
            class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Jadwal Mengajar</a>
          <a href="/dosen/preferensi"
            class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Preferensi</a>
          <a href="/dosen/notifikasi"
            class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Notifikasi</a>
          <% } else { %>
            <a href="/"
              class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Beranda</a>
            <a href="/mahasiswa/jadwal"
              class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Jadwal Kuliah</a>
            <a href="/mahasiswa/prakrs"
              class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Pra-KRS</a>
            <a href="/login"
              class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Masuk</a>
            <% } %>
    </div>
  </div>
</header>
</div>

</div>
</header>