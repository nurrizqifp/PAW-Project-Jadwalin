<header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand & System Title -->
      <div class="flex items-center space-x-3.5">
        <a href="/" class="flex items-center space-x-2.5 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-600 flex items-center justify-center text-white shadow-sm font-black text-xl group-hover:scale-105 transition-transform">
            J
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">
                Jadwalin
              </span>
              <span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-brand-50 text-brand-700 border border-brand-200">
                Sistem Akademik
              </span>
            </div>
            <p class="text-[11px] text-slate-500 font-medium -mt-0.5">
              Teknologi Informasi • Universitas Muhammadiyah Yogyakarta
            </p>
          </div>
        </a>
      </div>

      <!-- Center: Navigation Tabs -->
      <nav class="hidden md:flex items-center space-x-1 text-xs font-bold bg-slate-100 p-1.5 rounded-xl border border-slate-200/80">
        <button onclick="switchAppTab('jadwal')" id="nav-tab-jadwal" class="app-nav-btn px-4 py-2 rounded-lg bg-white text-slate-900 shadow-sm transition-all flex items-center gap-1.5">
          <span>🗓️ Jadwal Kuliah</span>
        </button>
        <button onclick="switchAppTab('onboarding')" id="nav-tab-onboarding" class="app-nav-btn px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-1.5">
          <span>⚙️ Onboarding & Pra-KRS</span>
        </button>
        <button onclick="switchAppTab('produk')" id="nav-tab-produk" class="app-nav-btn px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-1.5">
          <span>📦 Modul Produk</span>
          <span class="px-1.5 py-0.2 rounded-full bg-slate-200 text-slate-700 text-[10px]"><%= produk.length %></span>
        </button>
        <button onclick="switchAppTab('api')" id="nav-tab-api" class="app-nav-btn px-4 py-2 rounded-lg text-slate-600 hover:text-slate-900 transition-all flex items-center gap-1.5">
          <span>🔌 Status Server & API</span>
        </button>
      </nav>

      <!-- Right: User Profile & Demo Switcher -->
      <div class="flex items-center space-x-3">
        <!-- Live Server Status Indicator -->
        <a href="/api/status" target="_blank" title="Cek status server JSON" class="hidden lg:inline-flex items-center px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition-colors">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-1.5"></span>
          <span id="nav-uptime-status">Online</span>
        </a>

        <!-- Demo Mode Quick Button (Wireframe 1) -->
        <button onclick="openDemoModal()" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-900 text-white hover:bg-brand-600 transition-all flex items-center gap-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Demo Walkthrough</span>
        </button>

        <!-- User Profile Pill -->
        <div class="flex items-center space-x-2 pl-2 border-l border-slate-200">
          <div class="w-8 h-8 rounded-full bg-brand-100 text-brand-700 font-black text-xs flex items-center justify-center border border-brand-300">
            AP
          </div>
          <div class="hidden sm:block text-left">
            <span class="block text-xs font-bold text-slate-800 leading-tight">Andi Pratama</span>
            <span class="block text-[10px] text-slate-500 font-mono">20240140093 • Smt 4</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Mobile Sub-navigation Bar -->
    <div class="md:hidden flex items-center space-x-1 py-2 border-t border-slate-100 overflow-x-auto text-xs font-bold no-scrollbar">
      <button onclick="switchAppTab('jadwal')" id="mob-nav-jadwal" class="mob-nav-btn px-3 py-1.5 rounded-lg bg-brand-600 text-white whitespace-nowrap">
        Jadwal Kuliah
      </button>
      <button onclick="switchAppTab('onboarding')" id="mob-nav-onboarding" class="mob-nav-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 whitespace-nowrap">
        Onboarding
      </button>
      <button onclick="switchAppTab('produk')" id="mob-nav-produk" class="mob-nav-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 whitespace-nowrap">
        Modul Produk (<%= produk.length %>)
      </button>
      <button onclick="switchAppTab('api')" id="mob-nav-api" class="mob-nav-btn px-3 py-1.5 rounded-lg text-slate-600 hover:bg-slate-100 whitespace-nowrap">
        API Status
      </button>
    </div>
  </div>
</header>
