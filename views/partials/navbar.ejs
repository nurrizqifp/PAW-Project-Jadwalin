<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3.5 group">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand-600 via-brand-500 to-accent-500 flex items-center justify-center text-white shadow-md shadow-brand-500/25 group-hover:scale-105 group-hover:shadow-glow-indigo transition-all duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
            <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 group-hover:text-brand-600 transition-colors">
              Jadwalin
            </span>
            <span class="px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider rounded-full bg-brand-50 text-brand-700 border border-brand-200/60">
              AI v1.1
            </span>
          </div>
          <span class="text-[11px] font-medium text-slate-400">
            Smart Course Scheduling • TI UMY
          </span>
        </div>
      </a>

      <!-- Desktop Navigation links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 text-sm font-semibold text-slate-600">
        <a href="#beranda" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition-colors">
          Beranda
        </a>
        <a href="#produk" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition-colors flex items-center gap-1.5">
          <span>Modul Produk</span>
          <span class="px-1.5 py-0.5 text-[10px] font-bold rounded-md bg-slate-200 text-slate-700">6</span>
        </a>
        <a href="#simulator" class="px-3.5 py-2 rounded-xl hover:bg-brand-50 hover:text-brand-700 text-brand-600 transition-colors flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          <span>Simulator Wireframe</span>
        </a>
        <a href="#api" class="px-3.5 py-2 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition-colors">
          REST API
        </a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center space-x-2.5 sm:space-x-3">
        <!-- Live API status indicator -->
        <a href="/api/status" target="_blank" title="Buka API Status JSON" class="hidden sm:inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-xl bg-emerald-50/80 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition-all">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse mr-2"></span>
          <span id="nav-status-badge">API Aktif</span>
        </a>

        <!-- Quick Demo CTA Button -->
        <a href="#simulator" onclick="openWireframeStep('step-welcome')" class="inline-flex items-center gap-1.5 px-4 py-2 sm:px-4.5 sm:py-2.5 text-xs sm:text-sm font-bold rounded-xl bg-slate-900 text-white hover:bg-brand-600 hover:shadow-lg hover:shadow-brand-500/25 transition-all duration-200">
          <span>Coba Demo</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <!-- Mobile hamburger toggle button -->
        <button onclick="toggleMobileMenu()" type="button" class="md:hidden p-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors" aria-label="Toggle menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white/95 backdrop-blur-md px-4 pt-3 pb-4 space-y-2 text-sm font-semibold">
    <a href="#beranda" onclick="toggleMobileMenu()" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100">Beranda</a>
    <a href="#produk" onclick="toggleMobileMenu()" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100">Modul Produk (Backend)</a>
    <a href="#simulator" onclick="toggleMobileMenu()" class="block px-3 py-2 rounded-lg text-brand-600 hover:bg-brand-50">Simulator Wireframe</a>
    <a href="#api" onclick="toggleMobileMenu()" class="block px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100">REST API & Logger</a>
    <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
      <a href="/api/status" target="_blank" class="text-emerald-600 font-semibold">/api/status</a>
      <a href="/api/produk" target="_blank" class="text-brand-600 font-semibold">/api/produk</a>
    </div>
  </div>
</header>

<script>
  function toggleMobileMenu() {
    const el = document.getElementById('mobile-menu');
    el.classList.toggle('hidden');
  }
</script>
