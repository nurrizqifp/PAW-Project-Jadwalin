<header class="sticky top-0 z-40 w-full border-b border-zinc-200/80 bg-white/95 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/95 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-4">
      
      <!-- Brand & Version Pill -->
      <div class="flex items-center space-x-3 shrink-0">
        <a href="/" class="flex items-center space-x-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 font-extrabold text-sm flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
            J
          </div>
          <div class="flex flex-col">
            <span class="text-base font-bold tracking-tight text-zinc-900 dark:text-zinc-50 font-heading leading-tight">
              Jadwalin
            </span>
            <span class="text-[10px] text-zinc-500 dark:text-zinc-400 font-mono leading-none">
              TI UMY · TA 2026/2027
            </span>
          </div>
        </a>
      </div>

      <!-- Center: Feature Quick Navigation -->
      <nav class="hidden lg:flex items-center space-x-1 text-xs font-semibold text-zinc-600 dark:text-zinc-300">
        <a href="/#schedule-finder" class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
          Pencarian Jadwal
        </a>
        <a href="/mahasiswa/jadwal" class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
          Matriks Lengkap
        </a>
        <a href="/mahasiswa/prakrs" class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
          Simulasi Pra-KRS
        </a>
        <a href="/login" class="px-3 py-1.5 rounded-md text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors inline-flex items-center gap-1.5">
          <i class="ph ph-lock-key text-xs"></i>
          <span>Portal Dosen & Staf</span>
        </a>
      </nav>

      <!-- Right Action Toolbar -->
      <div class="flex items-center space-x-2.5 text-xs shrink-0">
        
        <!-- Live System Metric Pill -->
        <div class="hidden sm:inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-md bg-zinc-100 dark:bg-zinc-900 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800 font-mono text-[11px] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Zero-Clash Verified</span>
        </div>

        <!-- Dark/Light Mode Switcher -->
        <button onclick="if(window.JadwalinUI) window.JadwalinUI.theme.toggle(); else document.documentElement.classList.toggle('dark');" aria-label="Ganti Mode Tampilan" class="h-8 w-8 rounded-md border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center transition-colors">
          <i class="theme-toggle-icon ph ph-moon text-base"></i>
        </button>

        <!-- Login / Portal Entry Button -->
        <a href="/login" class="inline-flex min-h-[34px] items-center gap-1.5 rounded-md bg-zinc-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors shadow-sm">
          <i class="ph ph-sign-in text-sm"></i>
          <span>Masuk Sistem</span>
        </a>
      </div>

    </div>

    <!-- Mobile Sub-bar -->
    <div class="lg:hidden flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 overflow-x-auto space-x-2">
      <a href="/#schedule-finder" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Pencarian</a>
      <a href="/mahasiswa/jadwal" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Matriks Jadwal</a>
      <a href="/mahasiswa/prakrs" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Pra-KRS</a>
      <a href="/login" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap inline-flex items-center gap-1">
        <i class="ph ph-lock-key text-xs"></i>
        <span>Portal Civitas</span>
      </a>
    </div>

  </div>
</header>
