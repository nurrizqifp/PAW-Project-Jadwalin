<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-zinc-200 dark:border-zinc-800 dark:bg-zinc-900/90 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 sm:h-16">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-2.5">
        <span class="w-7 h-7 rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-bold text-sm flex items-center justify-center">
          J
        </span>
        <div class="flex flex-col">
          <span class="text-base font-bold tracking-tight text-zinc-900 dark:text-zinc-50 font-heading leading-tight">
            Jadwalin
          </span>
          <span class="text-[10px] text-zinc-400 dark:text-zinc-500 font-mono hidden sm:inline leading-none">
            TI UMY
          </span>
        </div>
      </a>

      <!-- Center Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 text-xs font-medium text-zinc-600 dark:text-zinc-300">
        <a href="/mahasiswa/dashboard" class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
          Mahasiswa
        </a>
        <a href="/dosen/dashboard" class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
          Dosen
        </a>
        <a href="/admin/dashboard" class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
          Staf Akademik
        </a>
        <a href="/mahasiswa/prakrs" class="px-3 py-1.5 rounded-md hover:bg-zinc-100 hover:text-zinc-900 dark:hover:bg-zinc-800 dark:hover:text-zinc-50 transition-colors">
          Pra-KRS
        </a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center space-x-2.5 text-xs">
        <!-- Zero Clash Status Pill -->
        <div class="hidden sm:inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 font-mono text-[11px] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Zero Clash</span>
        </div>

        <!-- Dark Mode Toggle Button -->
        <button onclick="if(window.JadwalinUI) window.JadwalinUI.theme.toggle(); else document.documentElement.classList.toggle('dark');" aria-label="Ganti Mode Tampilan" class="h-8 w-8 rounded-md border border-zinc-200 bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 flex items-center justify-center hover:bg-zinc-100 dark:hover:bg-zinc-700 transition-colors">
          <i class="theme-toggle-icon ph ph-moon text-base"></i>
        </button>

        <!-- Login / Masuk Button -->
        <a href="/login" class="inline-flex min-h-[34px] items-center gap-1.5 rounded-md bg-zinc-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors">
          <i class="ph ph-sign-in text-sm"></i>
          <span>Masuk</span>
        </a>
      </div>

    </div>

    <!-- Mobile Navigation Bar -->
    <div class="md:hidden flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 overflow-x-auto space-x-2">
      <a href="/mahasiswa/dashboard" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Mahasiswa</a>
      <a href="/dosen/dashboard" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Dosen</a>
      <a href="/admin/dashboard" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Admin</a>
      <a href="/mahasiswa/prakrs" class="px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap">Pra-KRS</a>
    </div>

  </div>
</header>
