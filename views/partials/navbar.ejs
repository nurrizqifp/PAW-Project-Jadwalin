<header class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-app-border transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 sm:h-16">
      
      <!-- Brand & macOS dots -->
      <div class="flex items-center space-x-4">
        <!-- macOS window dots -->
        <div class="hidden sm:flex items-center space-x-1.5" aria-hidden="true">
          <span class="w-3 h-3 rounded-full bg-zinc-300"></span>
          <span class="w-3 h-3 rounded-full bg-zinc-300"></span>
          <span class="w-3 h-3 rounded-full bg-zinc-300"></span>
        </div>

        <a href="/" class="flex items-center space-x-2">
          <span class="w-7 h-7 rounded-lg bg-zinc-900 text-white font-bold text-sm flex items-center justify-center">
            J
          </span>
          <span class="text-base font-bold tracking-tight text-zinc-900">
            Jadwalin
          </span>
        </a>
      </div>

      <!-- Center: macOS Segmented Control -->
      <nav class="hidden md:flex items-center bg-zinc-100 p-1 rounded-xl border border-zinc-200/80 text-xs font-semibold text-zinc-600">
        <button onclick="switchView('view-jadwal')" id="nav-btn-jadwal" class="nav-segment px-3.5 py-1.5 rounded-lg bg-white text-zinc-900 shadow-sm transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Jadwal</span>
        </button>

        <button onclick="switchView('view-prakrs')" id="nav-btn-prakrs" class="nav-segment px-3.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"></path>
          </svg>
          <span>Pra-KRS</span>
        </button>

        <button onclick="switchView('view-modul')" id="nav-btn-modul" class="nav-segment px-3.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"></path>
          </svg>
          <span>Modul</span>
          <span class="w-4 h-4 rounded-full bg-zinc-200 text-zinc-800 text-[10px] flex items-center justify-center font-bold">
            <%= produk.length %>
          </span>
        </button>

        <button onclick="switchView('view-status')" id="nav-btn-status" class="nav-segment px-3.5 py-1.5 rounded-lg text-zinc-600 hover:text-zinc-900 transition-all flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <span>Status API</span>
        </button>
      </nav>

      <!-- Right: User Avatar & Status -->
      <div class="flex items-center space-x-3 text-xs">
        <!-- Live status dot -->
        <div class="hidden sm:flex items-center space-x-1.5 px-2.5 py-1 rounded-full bg-zinc-100 text-zinc-700 border border-zinc-200 font-medium text-[11px]">
          <span class="w-1.5 h-1.5 rounded-full bg-zinc-900"></span>
          <span id="nav-status-text">Terkoneksi</span>
        </div>

        <!-- User pill -->
        <div class="flex items-center space-x-2 pl-2">
          <div class="w-7 h-7 rounded-full bg-zinc-900 text-white font-bold text-xs flex items-center justify-center">
            AP
          </div>
          <span class="font-medium text-zinc-900 text-xs hidden sm:inline">Andi Pratama</span>
        </div>
      </div>

    </div>

    <!-- Mobile Segmented Bar -->
    <div class="md:hidden flex items-center bg-zinc-100 p-1 rounded-xl border border-zinc-200 my-2 text-xs font-semibold overflow-x-auto no-scrollbar">
      <button onclick="switchView('view-jadwal')" id="mob-btn-jadwal" class="mob-segment flex-1 py-1.5 px-2 rounded-lg bg-white text-zinc-900 shadow-sm text-center whitespace-nowrap">
        Jadwal
      </button>
      <button onclick="switchView('view-prakrs')" id="mob-btn-prakrs" class="mob-segment flex-1 py-1.5 px-2 rounded-lg text-zinc-600 text-center whitespace-nowrap">
        Pra-KRS
      </button>
      <button onclick="switchView('view-modul')" id="mob-btn-modul" class="mob-segment flex-1 py-1.5 px-2 rounded-lg text-zinc-600 text-center whitespace-nowrap">
        Modul (<%= produk.length %>)
      </button>
      <button onclick="switchView('view-status')" id="mob-btn-status" class="mob-segment flex-1 py-1.5 px-2 rounded-lg text-zinc-600 text-center whitespace-nowrap">
        API
      </button>
    </div>

  </div>
</header>
