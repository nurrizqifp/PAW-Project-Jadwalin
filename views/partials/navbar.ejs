<header
  class="sticky top-0 z-40 w-full border-b border-zinc-200/80 bg-white/95 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-950/95 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 sm:h-16 gap-4">

      <!-- Brand Logo & Role Context Badge -->
      <div class="flex items-center space-x-3">
        <a href="/" class="flex items-center space-x-2.5 group">
          <img src="/logo.png" alt="Logo Jadwalin"
            class="h-8 sm:h-9 w-auto object-contain group-hover:scale-105 transition-transform">
          <div class="flex flex-col">
            <span class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-50 font-heading leading-tight">
              Jadwalin
            </span>
          </div>
        </a>

        <% if (typeof currentRole !== 'undefined' && currentRole === 'mahasiswa') { %>
          <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-blue-100 text-[#0c2b5e] dark:bg-blue-950 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
            PORTAL MAHASISWA
          </span>
        <% } else if (typeof currentRole !== 'undefined' && currentRole === 'dosen') { %>
          <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300 border border-amber-200 dark:border-amber-900">
            PORTAL DOSEN
          </span>
        <% } %>
      </div>

      <!-- Center: Role-Aware Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 text-xs font-semibold">
        <% 
          const currentActive = typeof activeMenu !== 'undefined' ? activeMenu : '';
          const getLinkClass = (targetMenu) => {
            const isActive = currentActive === targetMenu;
            return isActive 
              ? 'px-3 py-1.5 rounded-md bg-blue-50 text-[#0c2b5e] font-bold dark:bg-zinc-800 dark:text-amber-400 border border-blue-200/70 dark:border-zinc-700 shadow-2xs transition-colors' 
              : 'px-3 py-1.5 rounded-md text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:text-zinc-50 dark:hover:bg-zinc-800/80 transition-colors';
          };
        %>

        <% if (typeof currentRole !== 'undefined' && currentRole === 'mahasiswa') { %>
          <a href="/" class="<%= getLinkClass('beranda') %>">
            Beranda
          </a>
          <a href="/mahasiswa/jadwal" class="<%= getLinkClass('jadwal') %>">
            Jadwal Kuliah
          </a>
          <a href="/mahasiswa/prakrs" class="<%= getLinkClass('prakrs') %>">
            Pengisian Pra-KRS
          </a>
          <a href="/info" class="<%= getLinkClass('info') %>">
            Panduan & Info
          </a>
        <% } else if (typeof currentRole !== 'undefined' && currentRole === 'dosen') { %>
          <a href="/" class="<%= getLinkClass('beranda') %>">
            Beranda
          </a>
          <a href="/dosen/jadwal" class="<%= getLinkClass('jadwal') %>">
            Jadwal Mengajar
          </a>
          <a href="/dosen/preferensi" class="<%= getLinkClass('preferensi') %>">
            Form Preferensi
          </a>
          <a href="/info" class="<%= getLinkClass('info') %>">
            Panduan & Info
          </a>
          <a href="/dosen/notifikasi" class="<%= getLinkClass('notifikasi') %>">
            Notifikasi
          </a>
        <% } else { %>
          <a href="/" class="<%= getLinkClass('beranda') %>">
            Beranda
          </a>
          <a href="/info" class="<%= getLinkClass('info') %>">
            Panduan Akademik
          </a>
        <% } %>
      </nav>

      <!-- Right Action Toolbar -->
      <div class="flex items-center space-x-2.5 text-xs shrink-0">

        <!-- Dark/Light Mode Switcher -->
        <button id="theme-toggle-btn" data-toggle-theme type="button"
          onclick="window.toggleTheme ? window.toggleTheme() : (window.JadwalinUI ? window.JadwalinUI.theme.toggle() : document.documentElement.classList.toggle('dark'))"
          aria-label="Ganti Mode Tampilan"
          class="h-8 w-8 rounded-md border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 flex items-center justify-center transition-colors">
          <i id="theme-icon" class="theme-toggle-icon ph ph-moon text-base"></i>
        </button>

        <% const navAuthUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null; %>
        <% const navDisplayName = navAuthUser?.nama || navAuthUser?.username || 'Pengguna'; %>
        <% const navInitials = String(navDisplayName).split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase(); %>
        <% if (typeof currentRole !== 'undefined' && currentRole === 'mahasiswa') { %>
          <!-- User Chip Mahasiswa -->
          <div class="flex items-center gap-2 pl-1">
            <a href="/mahasiswa/dashboard"
              class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 py-1 px-2.5 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700/80 transition-colors">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-[#0c2b5e] text-white text-[10px] font-bold">
                <%= navInitials %>
              </div>
              <span class="font-medium text-xs text-zinc-800 dark:text-zinc-200 hidden sm:inline"><%= navDisplayName %></span>
            </a>
            <a href="/logout" title="Keluar Akun"
              class="h-8 w-8 rounded-md border border-zinc-200 bg-white hover:bg-rose-50 text-zinc-500 hover:text-rose-600 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-rose-950/40 dark:text-zinc-400 dark:hover:text-rose-400 flex items-center justify-center transition-colors">
              <i class="ph ph-sign-out text-base"></i>
            </a>
          </div>
        <% } else if (typeof currentRole !== 'undefined' && currentRole === 'dosen') { %>
          <!-- User Chip Dosen -->
          <div class="flex items-center gap-2 pl-1">
            <a href="/dosen/dashboard"
              class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 py-1 px-2.5 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700/80 transition-colors">
              <div class="flex h-5 w-5 items-center justify-center rounded-full bg-amber-600 text-white text-[10px] font-bold">
                <%= navInitials %>
              </div>
              <span class="font-medium text-xs text-zinc-800 dark:text-zinc-200 hidden sm:inline"><%= navDisplayName %></span>
            </a>
            <a href="/logout" title="Keluar Akun"
              class="h-8 w-8 rounded-md border border-zinc-200 bg-white hover:bg-rose-50 text-zinc-500 hover:text-rose-600 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-rose-950/40 dark:text-zinc-400 dark:hover:text-rose-400 flex items-center justify-center transition-colors">
              <i class="ph ph-sign-out text-base"></i>
            </a>
          </div>
        <% } else if (typeof currentRole !== 'undefined' && currentRole === 'admin') { %>
          <!-- User Chip Admin -->
          <div class="flex items-center gap-2 pl-1">
            <a href="/admin/dashboard"
              class="inline-flex min-h-[34px] items-center gap-1.5 rounded-md bg-[#0c2b5e] hover:bg-[#081d40] px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm border border-blue-900/40 transition-colors">
              <i class="ph ph-squares-four text-amber-400 text-sm"></i>
              <span>Panel Admin</span>
            </a>
            <a href="/logout" title="Keluar Akun"
              class="h-8 w-8 rounded-md border border-zinc-200 bg-white hover:bg-rose-50 text-zinc-500 hover:text-rose-600 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:bg-rose-950/40 dark:text-zinc-400 dark:hover:text-rose-400 flex items-center justify-center transition-colors">
              <i class="ph ph-sign-out text-base"></i>
            </a>
          </div>
        <% } else { %>
          <!-- Login Button -->
          <a href="/login"
            class="inline-flex min-h-[34px] items-center gap-1.5 rounded-md bg-[#0c2b5e] hover:bg-[#081d40] px-3.5 py-1.5 text-xs font-semibold text-white shadow-sm transition-all border border-blue-900/40">
            <i class="ph ph-sign-in text-sm text-amber-400"></i>
            <span>Masuk Sistem</span>
          </a>
        <% } %>

      </div>

    </div>

    <!-- Mobile Sub-bar -->
    <div
      class="md:hidden flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 overflow-x-auto space-x-2">
      <% 
        const getMobileClass = (targetMenu) => {
          return currentActive === targetMenu
            ? 'px-2.5 py-1 rounded bg-blue-50 text-[#0c2b5e] dark:bg-zinc-800 dark:text-amber-400 font-bold whitespace-nowrap'
            : 'px-2.5 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 whitespace-nowrap';
        };
      %>
      <% if (typeof currentRole !== 'undefined' && currentRole === 'mahasiswa') { %>
        <a href="/" class="<%= getMobileClass('beranda') %>">Beranda</a>
        <a href="/mahasiswa/dashboard" class="<%= getMobileClass('dashboard') %>">Dashboard</a>
        <a href="/mahasiswa/jadwal" class="<%= getMobileClass('jadwal') %>">Jadwal Kuliah</a>
        <a href="/mahasiswa/prakrs" class="<%= getMobileClass('prakrs') %>">Pra-KRS</a>
        <a href="/info" class="<%= getMobileClass('info') %>">Panduan</a>
      <% } else if (typeof currentRole !== 'undefined' && currentRole === 'dosen') { %>
        <a href="/" class="<%= getMobileClass('beranda') %>">Beranda</a>
        <a href="/dosen/dashboard" class="<%= getMobileClass('dashboard') %>">Dashboard</a>
        <a href="/dosen/jadwal" class="<%= getMobileClass('jadwal') %>">Jadwal Mengajar</a>
        <a href="/dosen/preferensi" class="<%= getMobileClass('preferensi') %>">Preferensi</a>
        <a href="/info" class="<%= getMobileClass('info') %>">Panduan</a>
      <% } else { %>
        <a href="/" class="<%= getMobileClass('beranda') %>">Beranda</a>
        <a href="/info" class="<%= getMobileClass('info') %>">Panduan</a>
        <a href="/login" class="px-2.5 py-1 rounded text-[#0c2b5e] dark:text-amber-400 font-semibold whitespace-nowrap">Masuk</a>
      <% } %>
    </div>
  </div>
</header>
