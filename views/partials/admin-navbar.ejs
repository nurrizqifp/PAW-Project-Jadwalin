<!-- Admin Panel Dedicated Topbar (Replaces Public Navbar in Admin Scope) -->
<header
  class="sticky top-0 z-30 w-full border-b border-zinc-200/80 bg-white/95 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-900/95 transition-colors">
  <div class="px-4 sm:px-6">
    <div class="flex items-center justify-between h-14">

      <!-- Left: Breadcrumb / Scope Indicator -->
      <div class="flex items-center space-x-2 text-xs">
        <span
          class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-900 dark:text-blue-300 font-mono font-semibold border border-blue-200 dark:border-blue-900 text-[11px]">
          STAFF AKADEMIK
        </span>
        <span class="text-zinc-300 dark:text-zinc-700">/</span>
        <span class="font-medium text-zinc-600 dark:text-zinc-300">
          <%= typeof judul !=='undefined' ? judul.split('—')[0].trim() : 'Panel Administrasi' %>
        </span>
      </div>

      <!-- Right: System Status & User Actions -->
      <div class="flex items-center space-x-3 text-xs">

        <!-- Academic Period Pill -->
        <div class="hidden md:inline-flex items-center gap-1.5 font-mono text-[11px] text-zinc-500 dark:text-zinc-400">
          <i class="ph ph-calendar-blank"></i>
          <span>Ganjil 2026/2027</span>
        </div>

        <div class="h-4 w-px bg-zinc-200 dark:bg-zinc-800 hidden md:block"></div>

        <!-- Dark Mode Toggle Button -->
        <button id="admin-theme-toggle-btn" data-toggle-theme type="button"
          onclick="window.toggleTheme ? window.toggleTheme() : (window.JadwalinUI ? window.JadwalinUI.theme.toggle() : document.documentElement.classList.toggle('dark'))"
          aria-label="Ganti Mode Tampilan"
          class="h-8 w-8 rounded-md border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 flex items-center justify-center transition-colors">
          <i id="admin-theme-icon" class="theme-toggle-icon ph ph-moon text-base"></i>
        </button>

        <!-- Exit to Public Site -->
        <a href="/"
          class="inline-flex min-h-[32px] items-center gap-1.5 rounded-md border border-zinc-200 bg-white px-3 py-1.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700 transition-colors">
          <i class="ph ph-arrow-square-out text-sm"></i>
          <span class="hidden sm:inline">Halaman Publik</span>
        </a>
      </div>

    </div>
  </div>
</header>