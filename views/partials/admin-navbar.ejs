<!-- App Dedicated Topbar (Role-Aware: Admin, Dosen, Mahasiswa) -->
<% const navRole=(typeof currentRole !=='undefined' ) ? currentRole : 'admin' ; %>
  <header
    class="sticky top-0 z-30 w-full border-b border-zinc-200/80 bg-white/95 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-900/95 transition-colors">
    <div class="px-4 sm:px-6">
      <div class="flex items-center justify-between h-14">

        <!-- Left: Mobile Sidebar Toggle + Breadcrumb / Scope Indicator -->
        <div class="flex items-center space-x-2 text-xs min-w-0">
          <button type="button" onclick="window.toggleMobileSidebar ? window.toggleMobileSidebar() : null"
            aria-label="Buka Menu Navigasi"
            class="lg:hidden flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 transition-colors">
            <i class="ph ph-list text-lg"></i>
          </button>
          <% if (navRole==='dosen' ) { %>
            <span
              class="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-900 dark:text-blue-300 font-mono font-semibold border border-blue-200 dark:border-blue-900 text-[11px] shrink-0">
              PORTAL DOSEN
            </span>
            <% } else if (navRole==='mahasiswa' ) { %>
              <span
                class="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-900 dark:text-blue-300 font-mono font-semibold border border-blue-200 dark:border-blue-900 text-[11px] shrink-0">
                PORTAL MAHASISWA
              </span>
              <% } else { %>
                <span
                  class="hidden sm:inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-900 dark:text-blue-300 font-mono font-semibold border border-blue-200 dark:border-blue-900 text-[11px] shrink-0">
                  STAFF AKADEMIK
                </span>
                <% } %>
                  <span class="hidden sm:inline text-zinc-300 dark:text-zinc-700">/</span>
                  <span class="font-semibold sm:font-medium text-zinc-800 dark:text-zinc-200 truncate">
                    <%= typeof judul !=='undefined' ? judul.split('—')[0].trim() : 'Panel Akademik' %>
                  </span>
        </div>

        <!-- Right: System Status, Notifikasi, Theme & User Dropdown -->
        <div class="flex items-center space-x-2.5 text-xs">

          <!-- Academic Period Pill -->
          <div
            class="hidden lg:inline-flex items-center gap-1.5 font-mono text-[11px] text-zinc-500 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 rounded-md">
            <i class="ph ph-calendar-blank text-zinc-600 dark:text-zinc-300"></i>
            <span>
              <%= (typeof activePeriode !=='undefined' && activePeriode) ? (activePeriode.semesterTipe + ' ' +
                activePeriode.tahunAkademik) : 'Ganjil 2026/2027' %>
            </span>
          </div>

          <!-- Tombol Drawer Notifikasi -->
          <% const unreadNotifs=(typeof notifikasiBelumDibaca !=='undefined' ) ? Number(notifikasiBelumDibaca) : 0; %>
            <button id="admin-open-notif-btn" type="button" aria-label="Buka Notifikasi Sistem"
              class="relative h-8 w-8 rounded-md border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 flex items-center justify-center transition-colors">
              <i class="ph ph-bell text-base"></i>
              <% if (unreadNotifs> 0) { %>
                <span id="admin-notif-badge"
                  class="absolute -top-1 -right-1 flex h-4 min-w-[16px] px-1 items-center justify-center rounded-full bg-amber-500 text-[9px] font-mono font-bold text-white shadow-xs">
                  <%= unreadNotifs> 99 ? '99+' : unreadNotifs %>
                </span>
                <% } %>
            </button>

            <!-- Dark Mode Toggle Button -->
            <button id="admin-theme-toggle-btn" data-toggle-theme type="button"
              onclick="window.toggleTheme ? window.toggleTheme() : (window.JadwalinUI ? window.JadwalinUI.theme.toggle() : document.documentElement.classList.toggle('dark'))"
              aria-label="Ganti Mode Tampilan"
              class="h-8 w-8 rounded-md border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-300 flex items-center justify-center transition-colors">
              <i id="admin-theme-icon" class="theme-toggle-icon ph ph-moon text-base"></i>
            </button>

            <div class="h-4 w-px bg-zinc-200 dark:bg-zinc-800 hidden sm:block"></div>

            <!-- User Profile Dropdown Menu -->
            <div class="relative inline-block text-left" id="admin-user-menu-container">
              <button id="admin-user-menu-btn" type="button" aria-expanded="false" aria-haspopup="true"
                class="flex items-center gap-2 rounded-md border border-zinc-200 bg-white p-1 pr-2 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:hover:bg-zinc-700 transition-colors">
                <% const navDosen=(typeof activeDosen !=='undefined' && activeDosen) ? activeDosen : { inisial: 'AS' ,
                  nama: 'Ir. Asroni, S.T., M.Eng' }; %>
                  <% if (navRole==='dosen' ) { %>
                    <div
                      class="flex h-6 w-6 items-center justify-center rounded bg-[#0c2b5e] text-amber-300 font-bold text-[10px]">
                      <%= navDosen.inisial %>
                    </div>
                    <span class="hidden sm:inline font-medium text-xs text-zinc-800 dark:text-zinc-200">
                      <%= navDosen.nama %>
                    </span>
                    <% } else if (navRole==='mahasiswa' ) { const mhsName=(typeof currentUser !=='undefined' &&
                      currentUser?.nama) ? currentUser.nama : 'Mahasiswa TI' ; const
                      mhsIni=String(mhsName).split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
                %>
                  <div
                    class="flex h-6 w-6 items-center justify-center rounded bg-[#0c2b5e] text-white font-bold text-[10px]">
                    <%= mhsIni %>
                  </div>
                  <span class="hidden sm:inline font-medium text-xs text-zinc-800 dark:text-zinc-200"><%= mhsName %></span>
                  <% } else {
                    const admName = (typeof currentUser !== ' undefined' && currentUser?.nama) ? currentUser.nama
                      : 'Admin Akademik' ; const admIni=String(admName).split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
                  %>
                    <div
                      class="flex h-6 w-6 items-center justify-center rounded bg-[#0c2b5e] text-white font-bold text-[10px]">
                      <%= admIni %>
                    </div>
                    <span class="hidden sm:inline font-medium text-xs text-zinc-800 dark:text-zinc-200"><%= admName %></span>
                    <% } %>
                      <i class="ph ph-caret-down text-[10px] text-zinc-400"></i>
            </button>

            <!-- Dropdown Panel -->
            <div id="admin-user-dropdown"
              class="hidden absolute right-0 mt-2 w-60 origin-top-right rounded-xl border border-zinc-200 bg-white p-1.5 shadow-lg ring-1 ring-black/5 dark:border-zinc-800 dark:bg-zinc-900 focus:outline-none z-50 transition-all">

              <% if (navRole===' dosen' ) { %>
                      <div class="px-3 py-2 border-b border-zinc-100 dark:border-zinc-800">
                        <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">
                          <%= navDosen.nama %>
                        </p>
                        <p class="text-[11px] text-zinc-500 dark:text-zinc-400 font-mono">Kode: <%= navDosen.inisial %>
                            · Dosen TI</p>
                      </div>
                      <div class="py-1">
                        <a href="/dosen/dashboard"
                          class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                          <i class="ph ph-squares-four text-base text-[#0c2b5e] dark:text-blue-400"></i>
                          <span>Dashboard Dosen</span>
                        </a>
                        <a href="/dosen/jadwal"
                          class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                          <i class="ph ph-calendar-check text-base"></i>
                          <span>Jadwal Mengajar Saya</span>
                        </a>
                        <a href="/dosen/preferensi"
                          class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                          <i class="ph ph-sliders text-base"></i>
                          <span>Atur Preferensi Waktu</span>
                        </a>
                        <a href="/"
                          class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                          <i class="ph ph-arrow-square-out text-base"></i>
                          <span>Lihat Portal Publik</span>
                        </a>
                      </div>
                      <% } else if (navRole==='mahasiswa' ) { const mhsDropName=(typeof currentUser !=='undefined' &&
                        currentUser?.nama) ? currentUser.nama : ((typeof activeMahasiswa !=='undefined' &&
                        activeMahasiswa?.nama) ? activeMahasiswa.nama : 'Mahasiswa TI' ); const mhsDropNim=(typeof
                        currentUser !=='undefined' && currentUser?.username) ? currentUser.username : ((typeof
                        activeMahasiswa !=='undefined' && activeMahasiswa?.nim) ? activeMahasiswa.nim : '-' ); const
                        mhsDropSmt=(typeof activeMahasiswa !=='undefined' && activeMahasiswa?.semesterAktif) ?
                        activeMahasiswa.semesterAktif : 5; %>
                        <div class="px-3 py-2 border-b border-zinc-100 dark:border-zinc-800">
                          <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">
                            <%= mhsDropName %>
                          </p>
                          <p class="text-[11px] text-zinc-500 dark:text-zinc-400 font-mono">NIM: <%= mhsDropNim %> · Smt
                              <%= mhsDropSmt %> TI</p>
                        </div>
                        <div class="py-1">
                          <a href="/mahasiswa/dashboard"
                            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                            <i class="ph ph-squares-four text-base text-[#0c2b5e] dark:text-blue-400"></i>
                            <span>Dashboard Mahasiswa</span>
                          </a>
                          <a href="/mahasiswa/jadwal"
                            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                            <i class="ph ph-calendar-blank text-base"></i>
                            <span>Jadwal Perkuliahan</span>
                          </a>
                          <a href="/mahasiswa/prakrs"
                            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                            <i class="ph ph-notebook text-base"></i>
                            <span>Pra-KRS Terpandu</span>
                          </a>
                          <a href="/"
                            class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                            <i class="ph ph-arrow-square-out text-base"></i>
                            <span>Lihat Portal Publik</span>
                          </a>
                        </div>
                        <% } else { const admDropName=(typeof currentUser !=='undefined' && currentUser?.nama) ?
                          currentUser.nama : 'Admin Akademik' ; const admDropUser=(typeof currentUser !=='undefined' &&
                          currentUser?.username) ? currentUser.username : 'admin' ; %>
                          <div class="px-3 py-2 border-b border-zinc-100 dark:border-zinc-800">
                            <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">
                              <%= admDropName %>
                            </p>
                            <p class="text-[11px] text-zinc-500 dark:text-zinc-400 font-mono">Akun: <%= admDropUser %> ·
                                Staf Akademik</p>
                          </div>
                          <div class="py-1">
                            <a href="/admin/profil"
                              class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                              <i class="ph ph-user text-base"></i>
                              <span>Profil Staf</span>
                            </a>
                            <a href="/admin/settings"
                              class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                              <i class="ph ph-gear text-base"></i>
                              <span>Pengaturan Sistem</span>
                            </a>
                            <a href="/"
                              class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs text-zinc-700 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
                              <i class="ph ph-arrow-square-out text-base"></i>
                              <span>Lihat Portal Publik</span>
                            </a>
                          </div>
                          <% } %>

                            <div
                              class="border-t border-zinc-100 pt-1 dark:border-zinc-800 flex items-center justify-between px-3 py-1.5">
                              <a href="/logout"
                                class="inline-flex items-center py-2 gap-2.5 text-xs text-rose-600 hover:text-rose-700 dark:text-rose-400 dark:hover:text-rose-300 font-medium transition-colors">
                                <i class="ph ph-sign-out text-sm"></i>
                                <span>Keluar</span>
                              </a>
                            </div>
            </div>
        </div>

      </div>

    </div>
    </div>
  </header>

  <!-- Slide-over Notification Drawer -->
  <div id="admin-notif-overlay"
    class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm transition-opacity duration-200 opacity-0 pointer-events-none">
    <div id="admin-notif-drawer"
      class="fixed inset-y-0 right-0 w-full max-w-sm bg-white shadow-2xl border-l border-zinc-200 dark:bg-zinc-900 dark:border-zinc-800 flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out">

      <!-- Drawer Header -->
      <div class="flex items-center justify-between p-4 border-b border-zinc-200 dark:border-zinc-800">
        <div class="flex items-center gap-2">
          <i class="ph ph-bell text-lg text-amber-500"></i>
          <h3 class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">Notifikasi Sistem Akademik</h3>
        </div>
        <button id="admin-close-notif-btn" type="button" aria-label="Tutup Drawer"
          class="flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 transition-colors">
          <i class="ph ph-x text-base"></i>
        </button>
      </div>

      <!-- Drawer Body / Alerts List -->
      <div class="flex-1 overflow-y-auto p-4 space-y-3">
        <% const navPrkAcc=(typeof prakrsAccess !=='undefined' && prakrsAccess) ? prakrsAccess : { isOpen: true,
          deadline: '2026-12-31' , reason: 'Pengisian Pra-KRS sedang dibuka.' }; %>
          <!-- Item Status Pra-KRS Aktif -->
          <div
            class="rounded-xl border p-3.5 space-y-1 <%= navPrkAcc.isOpen ? 'border-emerald-200 bg-emerald-50/70 dark:border-emerald-900/60 dark:bg-emerald-950/30' : 'border-rose-200 bg-rose-50/70 dark:border-rose-900/60 dark:bg-rose-950/30' %>">
            <div class="flex items-center justify-between text-xs">
              <span
                class="inline-flex items-center gap-1 font-semibold <%= navPrkAcc.isOpen ? 'text-emerald-700 dark:text-emerald-400' : 'text-rose-700 dark:text-rose-400' %>">
                <i class="ph <%= navPrkAcc.isOpen ? 'ph-check-circle' : 'ph-lock-key' %>"></i>
                <%= navPrkAcc.isOpen ? 'Pra-KRS Sedang Dibuka' : 'Pra-KRS Telah Ditutup' %>
              </span>
              <span class="font-mono text-[10px] text-zinc-400">
                <%= navPrkAcc.deadline %>
              </span>
            </div>
            <p
              class="text-xs <%= navPrkAcc.isOpen ? 'text-emerald-950 dark:text-emerald-200' : 'text-rose-950 dark:text-rose-200' %>">
              <%= navPrkAcc.reason %>
            </p>
          </div>

          <% const navNotifs=(typeof notifikasiList !=='undefined' && Array.isArray(notifikasiList)) ?
            notifikasiList.slice(0, 10) : []; %>
            <% if (navNotifs.length===0) { %>
              <div
                class="rounded-xl border border-dashed border-zinc-200 dark:border-zinc-800 p-6 text-center text-xs text-zinc-400">
                Belum ada notifikasi baru saat ini.
              </div>
              <% } else { %>
                <% navNotifs.forEach(function(nf) { %>
                  <div
                    class="rounded-xl border <%= (nf.isRead === false) ? 'border-amber-300 bg-amber-50/50 dark:border-amber-800/60 dark:bg-amber-950/20' : 'border-zinc-200 bg-zinc-50/80 dark:border-zinc-800 dark:bg-zinc-800/40' %> p-3.5 space-y-1 transition-colors">
                    <div class="flex items-center justify-between text-xs">
                      <span class="inline-flex items-center gap-1 font-semibold text-zinc-800 dark:text-zinc-200">
                        <i
                          class="ph ph-bell-ringing <%= (nf.isRead === false) ? 'text-amber-500' : 'text-zinc-400' %>"></i>
                        <%= nf.kodeMatkul %>
                      </span>
                      <span class="font-mono text-[10px] text-zinc-400">
                        <%= nf.waktu || 'Terbaru' %>
                      </span>
                    </div>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400">
                      <%= nf.perubahan %>
                    </p>
                  </div>
                  <% }); %>
                    <% } %>
      </div>

      <!-- Drawer Footer -->
      <div
        class="border-t border-zinc-200 p-3.5 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/50 flex justify-between items-center text-xs">
        <button type="button" onclick="window.tandaiSemuaNotifikasiDibaca ? window.tandaiSemuaNotifikasiDibaca() : null"
          class="font-medium text-[#0c2b5e] hover:underline dark:text-blue-400 transition-colors">
          Tandai semua dibaca
        </button>
        <span id="admin-notif-unread-count" class="font-mono text-[10px] text-zinc-400">
          <%= unreadNotifs %> Belum Dibaca
        </span>
      </div>

    </div>
  </div>

  <!-- Sertakan Modals Universal -->
  <%- include('admin-modals') %>

    <script>
      // Setup Interaksi Dropdown & Drawer
      (function initAdminNavbar() {
        // 1. User Dropdown Menu
        const userMenuBtn = document.getElementById('admin-user-menu-btn');
        const userDropdown = document.getElementById('admin-user-dropdown');
        if (userMenuBtn && userDropdown) {
          userMenuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            userDropdown.classList.toggle('hidden');
          });
          document.addEventListener('click', (e) => {
            if (!userDropdown.contains(e.target) && !userMenuBtn.contains(e.target)) {
              userDropdown.classList.add('hidden');
            }
          });
        }

        // 2. Notification Drawer
        const notifBtn = document.getElementById('admin-open-notif-btn');
        const closeNotifBtn = document.getElementById('admin-close-notif-btn');
        const notifOverlay = document.getElementById('admin-notif-overlay');
        const notifDrawer = document.getElementById('admin-notif-drawer');

        function openDrawer() {
          if (notifOverlay && notifDrawer) {
            notifOverlay.classList.remove('opacity-0', 'pointer-events-none');
            notifDrawer.classList.remove('translate-x-full');
          }
        }

        function closeDrawer() {
          if (notifOverlay && notifDrawer) {
            notifOverlay.classList.add('opacity-0', 'pointer-events-none');
            notifDrawer.classList.add('translate-x-full');
          }
        }

        if (notifBtn) notifBtn.addEventListener('click', openDrawer);
        if (closeNotifBtn) closeNotifBtn.addEventListener('click', closeDrawer);
        if (notifOverlay) {
          notifOverlay.addEventListener('click', (e) => {
            if (e.target === notifOverlay) closeDrawer();
          });
        }

        // Expose Global Helper Functions
        window.openAdminNotifDrawer = openDrawer;
        window.closeAdminNotifDrawer = closeDrawer;

        window.tandaiSemuaNotifikasiDibaca = async function () {
          try {
            const res = await fetch('/api/notifikasi/read-all', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.sukses) {
              const badge = document.getElementById('admin-notif-badge');
              if (badge) badge.remove();
              const counter = document.getElementById('admin-notif-unread-count');
              if (counter) counter.textContent = '0 Belum Dibaca';
              document.querySelectorAll('.notif-unread-item').forEach(el => {
                el.classList.remove('border-amber-300', 'bg-amber-50/50');
              });
              if (window.JadwalinUI?.toast) {
                window.JadwalinUI.toast.show(data.pesan || 'Semua notifikasi ditandai dibaca.', 'success');
              }
            }
          } catch (e) {
            console.error('Gagal menandai notifikasi dibaca:', e);
          }
        };

        // 3. Mobile Sidebar Off-Canvas Drawer
        const sidebarEl = document.getElementById('admin-sidebar');
        const sidebarBackdrop = document.getElementById('mobile-sidebar-backdrop');
        window.toggleMobileSidebar = function (forceOpen) {
          if (!sidebarEl || !sidebarBackdrop) return;
          const isOpen = !sidebarEl.classList.contains('-translate-x-full');
          const nextOpen = typeof forceOpen === 'boolean' ? forceOpen : !isOpen;
          if (nextOpen) {
            sidebarEl.classList.remove('-translate-x-full');
            sidebarBackdrop.classList.remove('opacity-0', 'pointer-events-none');
          } else {
            sidebarEl.classList.add('-translate-x-full');
            sidebarBackdrop.classList.add('opacity-0', 'pointer-events-none');
          }
        };

        // Escape listener
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeDrawer();
            window.toggleMobileSidebar(false);
            if (userDropdown) userDropdown.classList.add('hidden');
          }
        });
      })();
    </script>