<!-- App Fixed Sidebar Navigation (Role-Aware: Admin, Dosen, Mahasiswa) -->
<% const role=(typeof currentRole !=='undefined' ) ? currentRole : 'admin' ; %>
  <% const active=(typeof activeMenu !=='undefined' ) ? activeMenu : '' ; %>

    <!-- Backdrop Mobile Sidebar (< 1024px) -->
    <div id="mobile-sidebar-backdrop" onclick="window.toggleMobileSidebar ? window.toggleMobileSidebar(false) : null"
      class="fixed inset-0 z-40 bg-black/50 backdrop-blur-xs opacity-0 pointer-events-none lg:hidden transition-opacity duration-200"></div>

    <aside id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-50 w-64 -translate-x-full lg:translate-x-0 lg:sticky lg:top-0 lg:z-20 h-screen border-r border-zinc-200 bg-white p-4 flex flex-col justify-between shrink-0 dark:border-zinc-800 dark:bg-zinc-900 overflow-y-auto transition-transform duration-200 ease-out">
      <div class="space-y-5">

        <!-- 1. Brand Logo sesuai Role + Tombol Tutup Mobile -->
        <div class="flex items-center justify-between px-2 py-1">
          <a href="<%= role === 'dosen' ? '/dosen/dashboard' : (role === 'mahasiswa' ? '/mahasiswa/dashboard' : '/admin/dashboard') %>"
            class="flex items-center gap-2.5 group">
            <img src="/logo.png" alt="Logo Jadwalin" class="h-8 w-auto object-contain">
            <div class="flex flex-col">
              <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100 font-heading leading-none">
                <%= typeof appName !=='undefined' ? appName : 'Jadwalin' %>
              </span>
              <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 mt-0.5">
                <%= role==='dosen' ? 'Portal Dosen' : (role==='mahasiswa' ? 'Portal Mahasiswa' : 'Admin Portal' ) %>
              </span>
            </div>
          </a>
          <button type="button" onclick="window.toggleMobileSidebar ? window.toggleMobileSidebar(false) : null" aria-label="Tutup Menu Navigasi"
            class="lg:hidden flex h-8 w-8 items-center justify-center rounded-md text-zinc-500 hover:bg-zinc-100 dark:text-zinc-400 dark:hover:bg-zinc-800 transition-colors">
            <i class="ph ph-x text-base"></i>
          </button>
        </div>

        <!-- 2. User Badge sesuai Role -->
        <%
          const sbUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
          const sbDosen = (typeof activeDosen !== 'undefined' && activeDosen) ? activeDosen : { inisial: 'AS', nama: 'Ir. Asroni, S.T., M.Eng' };
          const sbMhs = (typeof activeMahasiswa !== 'undefined' && activeMahasiswa) ? activeMahasiswa : { nim: '-', nama: 'Mahasiswa TI', semesterAktif: 5 };
        %>
        <% if (role==='dosen' ) {
          const dsnName = sbUser?.nama || sbDosen.nama;
          const dsnIni = sbDosen.inisial || String(dsnName).split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
        %>
          <a href="/dosen/dashboard"
            class="flex items-center gap-3 px-2 py-1.5 rounded-lg bg-zinc-50 hover:bg-zinc-100 dark:bg-zinc-800/50 dark:hover:bg-zinc-800 border border-zinc-200/60 dark:border-zinc-700/60 transition-colors">
            <div
              class="flex h-8 w-8 items-center justify-center rounded-md bg-[#0c2b5e] text-amber-300 font-bold text-xs shadow-sm shrink-0">
              <%= dsnIni %>
            </div>
            <div class="overflow-hidden flex-1">
              <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate"><%= dsnName %></p>
              <p class="text-[11px] text-zinc-500 dark:text-zinc-400 font-mono">Dosen Tetap TI</p>
            </div>
            <i class="ph ph-caret-right text-xs text-zinc-400"></i>
          </a>
          <% } else if (role==='mahasiswa' ) {
            const mhsName = sbUser?.nama || sbMhs.nama;
            const mhsNim = sbUser?.username || sbMhs.nim;
            const mhsIni = String(mhsName).split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
          %>
            <a href="/mahasiswa/dashboard"
              class="flex items-center gap-3 px-2 py-1.5 rounded-lg bg-zinc-50 hover:bg-zinc-100 dark:bg-zinc-800/50 dark:hover:bg-zinc-800 border border-zinc-200/60 dark:border-zinc-700/60 transition-colors">
              <div
                class="flex h-8 w-8 items-center justify-center rounded-md bg-[#0c2b5e] text-white font-bold text-xs shadow-sm shrink-0">
                <%= mhsIni %>
              </div>
              <div class="overflow-hidden flex-1">
                <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate"><%= mhsName %></p>
                <p class="text-[11px] text-zinc-500 dark:text-zinc-400 font-mono"><%= mhsNim %> (Smt <%= sbMhs.semesterAktif || 5 %>)</p>
              </div>
              <i class="ph ph-caret-right text-xs text-zinc-400"></i>
            </a>
            <% } else {
              const admName = sbUser?.nama || 'Admin Akademik';
              const admIni = String(admName).split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
            %>
              <a href="/admin/profil"
                class="flex items-center gap-3 px-2 py-1.5 rounded-lg bg-zinc-50 hover:bg-zinc-100 dark:bg-zinc-800/50 dark:hover:bg-zinc-800 border border-zinc-200/60 dark:border-zinc-700/60 transition-colors">
                <div
                  class="flex h-8 w-8 items-center justify-center rounded-md bg-[#0c2b5e] text-white font-semibold text-xs shadow-sm shrink-0">
                  <%= admIni %>
                </div>
                <div class="overflow-hidden flex-1">
                  <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 truncate"><%= admName %></p>
                  <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Staf Akademik TI</p>
                </div>
                <i class="ph ph-caret-right text-xs text-zinc-400"></i>
              </a>
              <% } %>

                <!-- 3. Navigation Links sesuai Role -->
                <% if (role==='dosen' ) { %>
                  <!-- Scope Dosen -->
                  <div class="space-y-1">
                    <p
                      class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                      Utama
                    </p>
                    <nav class="space-y-0.5 text-xs">
                      <a href="/dosen/dashboard"
                        class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'dashboard' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                        <i class="ph ph-squares-four text-base text-[#0c2b5e] dark:text-blue-400"></i>
                        <span>Dashboard Dosen</span>
                      </a>
                    </nav>
                  </div>

                  <div class="space-y-1">
                    <p
                      class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                      Perkuliahan
                    </p>
                    <nav class="space-y-0.5 text-xs">
                      <a href="/dosen/jadwal"
                        class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'jadwal' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                        <i class="ph ph-calendar-check text-base"></i>
                        <span>Jadwal Mengajar</span>
                      </a>
                      <a href="/dosen/preferensi"
                        class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'preferensi' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                        <i class="ph ph-sliders text-base"></i>
                        <span>Preferensi Waktu</span>
                      </a>
                    </nav>
                  </div>

                  <div class="space-y-1">
                    <p
                      class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                      Informasi & Akun
                    </p>
                    <nav class="space-y-0.5 text-xs">
                      <a href="/dosen/notifikasi"
                        class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'notifikasi' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                        <i class="ph ph-bell text-base"></i>
                        <span>Pusat Notifikasi</span>
                      </a>
                      <a href="/info"
                        class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                        <i class="ph ph-info text-base"></i>
                        <span>Panduan & Info Sistem</span>
                      </a>
                    </nav>
                  </div>

                  <% } else if (role==='mahasiswa' ) { %>
                    <!-- Scope Mahasiswa -->
                    <div class="space-y-1">
                      <p
                        class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                        Utama
                      </p>
                      <nav class="space-y-0.5 text-xs">
                        <a href="/mahasiswa/dashboard"
                          class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'dashboard' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                          <i class="ph ph-squares-four text-base text-[#0c2b5e] dark:text-blue-400"></i>
                          <span>Dashboard Mahasiswa</span>
                        </a>
                      </nav>
                    </div>

                    <div class="space-y-1">
                      <p
                        class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                        Rencana Studi & Jadwal
                      </p>
                      <nav class="space-y-0.5 text-xs">
                        <a href="/mahasiswa/prakrs"
                          class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'prakrs' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                          <i class="ph ph-notebook text-base"></i>
                          <span>Pra-KRS Terpandu</span>
                        </a>
                        <a href="/mahasiswa/jadwal"
                          class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'jadwal' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                          <i class="ph ph-calendar-blank text-base"></i>
                          <span>Jadwal Perkuliahan</span>
                        </a>
                      </nav>
                    </div>

                    <div class="space-y-1">
                      <p
                        class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                        Informasi & Akun
                      </p>
                      <nav class="space-y-0.5 text-xs">
                        <a href="/mahasiswa/notifikasi"
                          class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'notifikasi' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                          <i class="ph ph-bell text-base"></i>
                          <span>Pusat Notifikasi</span>
                        </a>
                        <a href="/info"
                          class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors">
                          <i class="ph ph-info text-base"></i>
                          <span>Panduan & Info Akademik</span>
                        </a>
                      </nav>
                    </div>

                    <% } else { %>
                      <!-- Scope Admin (Default) -->
                      <div class="space-y-1">
                        <nav class="space-y-0.5 text-xs">
                          <a href="/admin/dashboard"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'dashboard' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-squares-four text-base text-[#0c2b5e] dark:text-blue-400"></i>
                            <span>Dashboard Analitik</span>
                          </a>
                        </nav>
                      </div>

                      <div class="space-y-1">
                        <p
                          class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                          Data Master
                        </p>
                        <nav class="space-y-0.5 text-xs">
                          <a href="/admin/master/dosen"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'dosen' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-chalkboard-teacher text-base"></i>
                            <span>Dosen Tetap</span>
                          </a>
                          <a href="/admin/master/matkul"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'matkul' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-book-open text-base"></i>
                            <span>Mata Kuliah</span>
                          </a>
                          <a href="/admin/master/ruangan"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'ruangan' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-door text-base"></i>
                            <span>Ruang & Lab</span>
                          </a>
                          <a href="/admin/master/mahasiswa"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'mahasiswa' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-student text-base"></i>
                            <span>Mahasiswa</span>
                          </a>
                          <a href="/admin/periode"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'periode' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-calendar text-base"></i>
                            <span>Periode & Semester</span>
                          </a>
                        </nav>
                      </div>

                      <div class="space-y-1">
                        <p
                          class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                          Optimasi Jadwal
                        </p>
                        <nav class="space-y-0.5 text-xs">
                          <a href="/admin/constraints"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'constraints' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-sliders text-base"></i>
                            <span>Aturan Constraint</span>
                          </a>
                          <a href="/admin/generate"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'generate' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-cpu text-base"></i>
                            <span>AI Generator Solver</span>
                          </a>
                          <a href="/admin/jadwal"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'jadwal' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-calendar-check text-base"></i>
                            <span>Preview & Publikasi</span>
                          </a>
                        </nav>
                      </div>

                      <div class="space-y-1">
                        <p
                          class="px-2 text-[10px] font-bold uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-mono">
                          Sistem & Akun
                        </p>
                        <nav class="space-y-0.5 text-xs">
                          <a href="/admin/settings"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'settings' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-gear text-base"></i>
                            <span>Pengaturan Sistem</span>
                          </a>
                          <a href="/admin/profil"
                            class="flex items-center gap-2.5 rounded-md px-2.5 py-2 font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-zinc-100 transition-colors <%= active === 'profil' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-950 dark:text-zinc-50 font-semibold' : '' %>">
                            <i class="ph ph-user-circle text-base"></i>
                            <span>Profil Kamu</span>
                          </a>
                        </nav>
                      </div>
                      <% } %>

      </div>

      <!-- Bottom Info: APP_VERSION -->
      <div class="border-t border-zinc-200 pt-4 dark:border-zinc-800 space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[10px] text-zinc-400 dark:text-zinc-500">
            <%= typeof appName !=='undefined' ? appName : 'Jadwalin' %>
          </span>
          <span
            class="rounded bg-blue-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-blue-800 dark:bg-blue-950 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
            <%= typeof appVersion !=='undefined' ? appVersion : 'v1.0.0' %>
          </span>
        </div>
      </div>
    </aside>