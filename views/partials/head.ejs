<!DOCTYPE html>
<html lang="id" class="h-full antialiased scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof judul !== 'undefined' ? judul : 'Jadwalin' %></title>
  
  <!-- Minimalist Monochrome Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%2309090b%22/><text x=%2216%22 y=%2222%22 font-family=%22system-ui,-apple-system,sans-serif%22 font-size=%2218%22 font-weight=%22800%22 fill=%22%23ffffff%22 text-anchor=%22middle%22>J</text></svg>">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Text"', '"SF Pro Display"', 'Inter', '"Segoe UI"', 'Roboto', 'sans-serif'],
            mono: ['"SF Mono"', 'Menlo', 'Monaco', 'Consolas', 'monospace'],
          },
          colors: {
            app: {
              bg: '#f8f8f9',
              card: '#ffffff',
              border: '#e4e4e7',
              muted: '#71717a',
              subtle: '#a1a1aa',
              dark: '#09090b',
              surface: '#f4f4f5',
            }
          },
          boxShadow: {
            'mac': '0 0 0 1px rgba(0, 0, 0, 0.06), 0 2px 8px -1px rgba(0, 0, 0, 0.08)',
            'mac-lg': '0 0 0 1px rgba(0, 0, 0, 0.08), 0 12px 32px -4px rgba(0, 0, 0, 0.12)',
            'mac-inset': 'inset 0 1px 2px 0 rgba(0, 0, 0, 0.05)',
          }
        }
      }
    }
  </script>

  <!-- Google Font: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
      --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Inter", sans-serif;
      letter-spacing: -0.011em;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    /* Pressable button feedback (140ms strong ease-out, GPU-only transform) */
    .btn-press {
      transition: transform 140ms var(--ease-out), background-color 150ms ease, color 150ms ease, opacity 150ms ease;
    }
    .btn-press:active {
      transform: scale(0.97);
    }
    /* Hover states gated for pointer devices */
    @media (hover: hover) and (pointer: fine) {
      .hover-surface:hover {
        background-color: #f4f4f5;
      }
    }
    /* Modal Backdrop & Dialog (200ms strong ease-out, scale 0.96 -> 1) */
    .modal-backdrop {
      opacity: 0;
      pointer-events: none;
      transition: opacity 200ms var(--ease-out);
    }
    .modal-backdrop[data-open="true"] {
      opacity: 1;
      pointer-events: auto;
    }
    .modal-panel {
      opacity: 0;
      transform: scale(0.96) translateY(4px);
      transform-origin: center;
      transition: transform 200ms var(--ease-out), opacity 200ms var(--ease-out);
    }
    .modal-backdrop[data-open="true"] .modal-panel {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
    /* Interruptible Toast Notification */
    .app-toast {
      opacity: 0;
      transform: translateY(12px) scale(0.97);
      pointer-events: none;
      transition: transform 220ms var(--ease-out), opacity 220ms var(--ease-out);
    }
    .app-toast[data-visible="true"] {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }
    /* Reduced Motion Accessibility */
    @media (prefers-reduced-motion: reduce) {
      .btn-press:active {
        transform: none;
      }
      .modal-panel,
      .app-toast {
        transform: none !important;
        transition: opacity 150ms ease !important;
      }
    }
  </style>
</head>
<body class="bg-app-bg text-app-dark h-full flex flex-col antialiased selection:bg-zinc-900 selection:text-white">
