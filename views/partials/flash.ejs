<!-- Global Toast Container Managed by JadwalinUI.toast -->
<div id="jadwalin-toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0">
  <% if (typeof pesanSukses !== 'undefined' && pesanSukses) { %>
    <div class="pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-lg text-xs font-medium shadow-lg border bg-emerald-950/90 text-emerald-100 border-emerald-800 animate-fade-in">
      <i class="ph ph-check-circle text-base shrink-0"></i>
      <span class="flex-1 leading-normal"><%= pesanSukses %></span>
    </div>
  <% } %>
  <% if (typeof pesanError !== 'undefined' && pesanError) { %>
    <div class="pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-lg text-xs font-medium shadow-lg border bg-rose-950/90 text-rose-100 border-rose-800 animate-fade-in">
      <i class="ph ph-warning-circle text-base shrink-0"></i>
      <span class="flex-1 leading-normal"><%= pesanError %></span>
    </div>
  <% } %>
</div>
