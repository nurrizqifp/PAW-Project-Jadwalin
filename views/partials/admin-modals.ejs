<!-- Modal Dialogs Universal untuk Panel Admin -->

<!-- 1. Modal Universal Edit Sesi Jadwal Cepat -->
<div id="admin-edit-modal-overlay"
  class="fixed inset-0 z-[100] bg-black/50 flex items-center justify-center p-4 transition-opacity duration-150 opacity-0 pointer-events-none">
  <div id="admin-edit-modal-panel"
    class="w-full max-w-lg rounded-2xl border border-zinc-200 bg-white p-6 shadow-xl dark:border-zinc-800 dark:bg-zinc-900 transform scale-95 transition-transform duration-150 space-y-5">

    <div class="flex items-center justify-between border-b border-zinc-100 pb-3.5 dark:border-zinc-800">
      <div>
        <h3 id="admin-modal-title" class="font-heading text-lg font-bold text-zinc-900 dark:text-zinc-50">Edit Sesi Jadwal</h3>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">Sesuaikan waktu, dosen, dan ruangan tanpa bentrok</p>
      </div>
      <button onclick="closeEditModal()" type="button" aria-label="Tutup Dialog"
        class="flex h-8 w-8 items-center justify-center rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 dark:text-zinc-400 transition-colors">
        <i class="ph ph-x text-base"></i>
      </button>
    </div>

    <form id="admin-edit-slot-form" onsubmit="handleSaveSlot(event)" class="space-y-4">
      <div class="space-y-1">
        <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Mata Kuliah & Kelas</label>
        <input id="admin-modal-matkul-input" type="text" readonly maxlength="80"
          class="w-full min-h-[40px] rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-2 text-xs font-medium text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Hari Perkuliahan</label>
          <select id="admin-modal-hari-select"
            class="w-full min-h-[40px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
            <option value="Senin">Senin</option>
            <option value="Selasa">Selasa</option>
            <option value="Rabu">Rabu</option>
            <option value="Kamis">Kamis</option>
            <option value="Jumat">Jumat</option>
            <option value="Sabtu">Sabtu</option>
          </select>
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Jam Sesi Mulai</label>
          <select id="admin-modal-jam-select"
            class="w-full min-h-[40px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs font-mono text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
            <option value="07:00">07:00 - 08:40</option>
            <option value="08:50">08:50 - 11:30</option>
            <option value="12:10">12:10 - 14:40</option>
            <option value="14:50">14:50 - 17:20</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Ruangan / Lab</label>
          <select id="admin-modal-ruang-select"
            class="w-full min-h-[40px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
            <% if (typeof ruanganList !== 'undefined' && Array.isArray(ruanganList) && ruanganList.length > 0) { %>
              <% ruanganList.forEach(r => { %>
                <option value="<%= r.kode %>"><%= r.kode %> (<%= r.tipe %>)</option>
              <% }) %>
            <% } else { %>
              <option value="F4.LAB1">F4.LAB1 (Laboratorium)</option>
              <option value="F4.LAB2">F4.LAB2 (Laboratorium)</option>
              <option value="F4.001">F4.001 (Ruang Kuliah)</option>
              <option value="F4.002">F4.002 (Ruang Kuliah)</option>
              <option value="F4.003">F4.003 (Ruang Kuliah)</option>
              <option value="F6.001">F6.001 (Ruang Kuliah Besar)</option>
              <option value="F6.102">F6.102 (Ruang Kuliah Besar)</option>
            <% } %>
          </select>
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Dosen Pengampu (Maks. 60 Karakter)</label>
          <input id="admin-modal-dosen-input" type="text" minlength="3" maxlength="60"
            class="w-full min-h-[40px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-xs text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-1 focus:ring-blue-900">
        </div>
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-zinc-100 dark:border-zinc-800">
        <button onclick="closeEditModal()" type="button"
          class="inline-flex min-h-[38px] items-center rounded-lg border border-zinc-200 px-4 text-xs font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
          Batal
        </button>
        <button type="submit"
          class="inline-flex min-h-[38px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 text-xs font-semibold text-white shadow-sm transition-colors">
          <i class="ph ph-floppy-disk text-amber-400"></i>
          <span>Simpan Perubahan</span>
        </button>
      </div>
    </form>

  </div>
</div>

<!-- 2. Modal Konfirmasi Standar Sistem (Pengganti alert() browser) -->
<div id="admin-confirm-modal-overlay"
  class="fixed inset-0 z-[110] bg-black/50 flex items-center justify-center p-4 transition-opacity duration-150 opacity-0 pointer-events-none">
  <div id="admin-confirm-modal-panel"
    class="w-full max-w-sm rounded-2xl border border-zinc-200 bg-white p-6 shadow-xl dark:border-zinc-800 dark:bg-zinc-900 transform scale-95 transition-transform duration-150 space-y-4">

    <div class="flex items-start gap-3.5">
      <div id="confirm-icon-box" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0c2b5e] dark:bg-blue-950 dark:text-blue-300">
        <i id="confirm-icon" class="ph ph-info text-xl"></i>
      </div>
      <div class="space-y-1">
        <h4 id="confirm-modal-title" class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50">
          Konfirmasi Tindakan
        </h4>
        <p id="confirm-modal-desc" class="text-xs text-zinc-500 dark:text-zinc-400">
          Apakah Anda yakin ingin melanjutkan tindakan ini?
        </p>
      </div>
    </div>

    <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-zinc-100 dark:border-zinc-800">
      <button id="confirm-cancel-btn" type="button"
        class="inline-flex min-h-[36px] items-center rounded-lg border border-zinc-200 px-3.5 text-xs font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors">
        Batal
      </button>
      <button id="confirm-action-btn" type="button"
        class="inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 text-xs font-semibold text-white shadow-sm transition-colors">
        <i id="confirm-action-icon" class="ph ph-check text-amber-400"></i>
        <span id="confirm-action-text">Ya, Lanjutkan</span>
      </button>
    </div>

  </div>
</div>

<script>
  // Script Global Modal Handlers (Accessible dari seluruh halaman)
  window.__editingSlotId = null;

  window.openEditModal = function(matkul, dosen, ruang, hari, jam, id) {
    window.__editingSlotId = id || null;
    const editOverlay = document.getElementById('admin-edit-modal-overlay');
    const editPanel = document.getElementById('admin-edit-modal-panel');
    const matkulInput = document.getElementById('admin-modal-matkul-input');
    const dosenInput = document.getElementById('admin-modal-dosen-input');
    const hariSelect = document.getElementById('admin-modal-hari-select');
    const jamSelect = document.getElementById('admin-modal-jam-select');
    const ruangSelect = document.getElementById('admin-modal-ruang-select');

    if (matkulInput) matkulInput.value = matkul || '';
    if (dosenInput) dosenInput.value = dosen || '';
    if (hariSelect && hari) hariSelect.value = hari;
    if (jamSelect && jam) jamSelect.value = jam.substring(0, 5);
    if (ruangSelect && ruang) ruangSelect.value = ruang;

    if (editOverlay && editPanel) {
      editOverlay.classList.remove('opacity-0', 'pointer-events-none');
      editPanel.classList.remove('scale-95');
      editPanel.classList.add('scale-100');
    }
  };

  window.closeEditModal = function() {
    const editOverlay = document.getElementById('admin-edit-modal-overlay');
    const editPanel = document.getElementById('admin-edit-modal-panel');
    if (editOverlay && editPanel) {
      editOverlay.classList.add('opacity-0', 'pointer-events-none');
      editPanel.classList.remove('scale-100');
      editPanel.classList.add('scale-95');
    }
  };

  window.handleSaveSlot = async function(e) {
    e.preventDefault();
    const hariSelect = document.getElementById('admin-modal-hari-select');
    const jamSelect = document.getElementById('admin-modal-jam-select');
    const ruangSelect = document.getElementById('admin-modal-ruang-select');

    const hari = hariSelect ? hariSelect.value : '';
    const jam = jamSelect ? jamSelect.value : '';
    const ruang = ruangSelect ? ruangSelect.value : '';

    if (!window.__editingSlotId) {
      window.closeEditModal();
      return;
    }

    try {
      const res = await fetch('/api/jadwal/revisi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: Number(window.__editingSlotId), hari, jamMulai: jam, ruang })
      });
      const data = await res.json();
      window.closeEditModal();
      if (!res.ok || data.status !== 'success') {
        window.showConfirmDialog('Gagal Menyimpan Slot', data.message || 'Terjadi pelanggaran constraint.', null, 'Tutup', true);
        return;
      }
      if (window.toast) window.toast.success(data.message);
      setTimeout(() => window.location.reload(), 500);
    } catch (err) {
      window.closeEditModal();
      if (window.toast) window.toast.error('Gagal menghubungi server.');
    }
  };

  window.handlePublishJadwal = function() {
    window.showConfirmDialog(
      'Publikasikan Jadwal',
      'Publikasikan jadwal ke seluruh civitas akademika TI UMY? Sistem akan memvalidasi bahwa 0 Hard Constraint dilanggar.',
      async () => {
        try {
          const res = await fetch('/api/jadwal/publish', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          const data = await res.json();
          if (!res.ok || data.status !== 'success') {
            window.showConfirmDialog('Publikasi Ditolak (Constraint Violation)', data.message || 'Masih terdapat konflik jadwal.', null, 'Mengerti', true);
            return;
          }
          if (window.toast) window.toast.success(data.message);
          setTimeout(() => window.location.reload(), 600);
        } catch (err) {
          if (window.toast) window.toast.error('Gagal menghubungi server.');
        }
      },
      'Publikasikan Sekarang'
    );
  };

  // Dialog Konfirmasi Standar Sistem (Dukungan Konfirmasi Aksi Normal & Hapus/Destructive)
  window.showConfirmDialog = function(title, desc, onConfirm, actionText = 'Lanjutkan', isAlertOnly = false, isDanger = false) {
    const overlay = document.getElementById('admin-confirm-modal-overlay');
    const panel = document.getElementById('admin-confirm-modal-panel');
    const titleEl = document.getElementById('confirm-modal-title');
    const descEl = document.getElementById('confirm-modal-desc');
    const actionBtn = document.getElementById('confirm-action-btn');
    const cancelBtn = document.getElementById('confirm-cancel-btn');
    const actionTextEl = document.getElementById('confirm-action-text');
    const iconBox = document.getElementById('confirm-icon-box');
    const iconEl = document.getElementById('confirm-icon');
    const actionIcon = document.getElementById('confirm-action-icon');

    if (!overlay || !panel) return;

    if (titleEl) titleEl.textContent = title;
    if (descEl) descEl.textContent = desc;
    if (actionTextEl) actionTextEl.textContent = actionText;

    // Deteksi otomatis apakah tindakan adalah hapus data / aksi destruktif berbahaya
    const isDelete = Boolean(isDanger) ||
      /hapus|delete/i.test(String(title || '')) ||
      /hapus|delete/i.test(String(actionText || ''));

    if (isDelete) {
      // Tombol Aksi Warna Merah Khusus Hapus Data
      if (actionBtn) {
        actionBtn.className = 'inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 active:bg-rose-800 px-4 text-xs font-semibold text-white shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-rose-500 focus:ring-offset-2 dark:focus:ring-offset-zinc-900 border border-rose-700/50';
      }
      if (actionIcon) {
        actionIcon.className = 'ph ph-trash text-white text-sm';
      }
      if (iconBox) {
        iconBox.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-100 text-rose-600 dark:bg-rose-950/80 dark:text-rose-400 border border-rose-200 dark:border-rose-900';
      }
      if (iconEl) {
        iconEl.className = 'ph ph-warning-octagon text-xl text-rose-600 dark:text-rose-400';
      }
    } else {
      // Tombol Aksi Standar Warna Biru Brand
      if (actionBtn) {
        actionBtn.className = 'inline-flex min-h-[36px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 text-xs font-semibold text-white shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-blue-900';
      }
      if (actionIcon) {
        actionIcon.className = 'ph ph-check text-amber-400 text-sm';
      }
      if (iconBox) {
        iconBox.className = 'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#0c2b5e] dark:bg-blue-950 dark:text-blue-300';
      }
      if (iconEl) {
        iconEl.className = 'ph ph-info text-xl text-[#0c2b5e] dark:text-blue-300';
      }
    }

    if (isAlertOnly && cancelBtn) {
      cancelBtn.style.display = 'none';
    } else if (cancelBtn) {
      cancelBtn.style.display = '';
    }

    overlay.classList.remove('opacity-0', 'pointer-events-none');
    panel.classList.remove('scale-95');
    panel.classList.add('scale-100');

    const handleAction = () => {
      closeConfirm();
      if (typeof onConfirm === 'function') onConfirm();
    };

    const closeConfirm = () => {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      panel.classList.remove('scale-100');
      panel.classList.add('scale-95');
      actionBtn.removeEventListener('click', handleAction);
      cancelBtn.removeEventListener('click', closeConfirm);
    };

    actionBtn.onclick = handleAction;
    cancelBtn.onclick = closeConfirm;
  };

  // Global Escape Key Listener
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      window.closeEditModal();
      const confirmOverlay = document.getElementById('admin-confirm-modal-overlay');
      if (confirmOverlay) {
        confirmOverlay.classList.add('opacity-0', 'pointer-events-none');
      }
    }
  });
</script>
