<%- include('../partials/head') %>

<% if (typeof hideNavbar === 'undefined' || !hideNavbar) { %>
  <%- include('../partials/navbar') %>
<% } %>

<% if (typeof isRoleAdmin !== 'undefined' && isRoleAdmin) { %>
  <!-- Layout Admin Panel with Collapsible Sidebar -->
  <div class="flex-1 flex overflow-hidden">
    <%- include('../partials/admin-sidebar') %>
    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-6xl mx-auto space-y-6">
        <%- body %>
      </div>
    </main>
  </div>
<% } else { %>
  <!-- Regular Layout for Public / Mahasiswa / Dosen -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-8">
    <%- body %>
  </main>
<% } %>

<% if (typeof hideFooter === 'undefined' || !hideFooter) { %>
  <%- include('../partials/footer') %>
<% } else { %>
  <%- include('../partials/flash') %>
  <script src="/js/app.js"></script>
  </body>
  </html>
<% } %>
