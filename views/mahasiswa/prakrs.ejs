<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Onboarding & Wizard Pra-KRS — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'prakrs', currentRole: 'mahasiswa' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-7xl mx-auto space-y-6">

  <% const prkAccess = (typeof prakrsAccess !== 'undefined' && prakrsAccess) ? prakrsAccess : { isOpen: true, deadline: '2026-12-31', reason: 'Pengisian Pra-KRS sedang dibuka.' }; %>
  <!-- Breadcrumb & Header Navigasi -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
    <div class="space-y-0.5">
      <h1 class="font-heading text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        Pengisian Pra-KRS
      </h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">
        Susun paket mata kuliah bebas bentrok dan simpan ke jadwal pribadi.
      </p>
    </div>

    <!-- Quick Status Badge -->
    <% if (prkAccess.isOpen) { %>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 text-xs font-semibold">
        <i class="ph ph-check-circle text-emerald-600 text-sm"></i>
        <span>Terbuka s/d <%= prkAccess.deadline %></span>
      </div>
    <% } else { %>
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-rose-300 bg-rose-50 text-rose-900 dark:border-rose-800 dark:bg-rose-950/50 dark:text-rose-300 text-xs font-semibold">
        <i class="ph ph-lock-key text-rose-600 text-sm"></i>
        <span>Pra-KRS Ditutup (<%= prkAccess.deadline %>)</span>
      </div>
    <% } %>
  </div>

  <% if (!prkAccess.isOpen) { %>
    <!-- STATE TERKUNCI: PRA-KRS SUDAH DITUTUP -->
    <div class="rounded-2xl border border-rose-200 bg-white p-8 text-center shadow-sm dark:border-rose-900/60 dark:bg-zinc-900 space-y-4">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-100 text-rose-600 dark:bg-rose-950/70 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
        <i class="ph ph-lock-key text-3xl"></i>
      </div>
      <div class="space-y-1.5 max-w-lg mx-auto">
        <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-0.5 font-mono text-[11px] font-bold text-rose-800 dark:bg-rose-950 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
          AKSES PRA-KRS DITUTUP
        </span>
        <h2 class="font-heading text-xl font-bold text-zinc-900 dark:text-zinc-50 pt-1">
          Periode Pengisian Pra-KRS Tidak Dapat Diakses
        </h2>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          <%= prkAccess.reason %> Anda tidak dapat mengubah atau mengirim ulang pilihan mata kuliah pada periode ini.
        </p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a href="/mahasiswa/jadwal" class="inline-flex min-h-[40px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-5 py-2 text-xs font-semibold text-white shadow-xs transition-colors">
          <i class="ph ph-calendar-check text-base text-amber-400"></i>
          <span>Lihat Jadwal Pribadi Saya</span>
        </a>
        <a href="/mahasiswa/dashboard" class="inline-flex min-h-[40px] items-center gap-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-50 px-4 py-2 text-xs font-semibold text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
          <i class="ph ph-arrow-left text-base"></i>
          <span>Kembali ke Dashboard</span>
        </a>
      </div>
    </div>
  <% } %>

  <div class="<%= !prkAccess.isOpen ? 'hidden pointer-events-none select-none' : 'space-y-6' %>">

  <!-- Wizard 3-Step Indicator Tracker (Clickable Tabs) -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <!-- Step 1 Tab -->
    <div id="step-nav-1" role="button" tabindex="0" class="step-nav-item cursor-pointer flex items-center gap-3 rounded-xl border border-brand-blue bg-brand-blue p-3.5 text-white shadow-sm transition-all">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/20 font-mono text-sm font-bold text-white">
        1
      </div>
      <div>
        <p class="text-xs font-bold leading-tight">Profil & Preferensi</p>
        <p class="text-[11px] opacity-80 mt-0.5">Identitas, Rombel & Peminatan</p>
      </div>
    </div>

    <!-- Step 2 Tab -->
    <div id="step-nav-2" role="button" tabindex="0" class="step-nav-item cursor-pointer flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-3.5 text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 transition-all">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-100 font-mono text-sm font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
        2
      </div>
      <div>
        <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-200 leading-tight">Pilih Mata Kuliah</p>
        <p class="text-[11px] mt-0.5">Paket Wajib & Counter SKS</p>
      </div>
    </div>

    <!-- Step 3 Tab -->
    <div id="step-nav-3" role="button" tabindex="0" class="step-nav-item cursor-pointer flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-3.5 text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 transition-all">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-100 font-mono text-sm font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
        3
      </div>
      <div>
        <p class="text-xs font-semibold text-zinc-900 dark:text-zinc-200 leading-tight">Rekomendasi Paket AI</p>
        <p class="text-[11px] mt-0.5">Verifikasi Zero Clash & Simpan</p>
      </div>
    </div>
  </div>

  <!-- Wizard Forms Container -->
  <div class="space-y-6">

    <!-- ==================== LANGKAH 1: PROFIL & PREFERENSI ==================== -->
    <section id="wizard-step-1" class="wizard-pane space-y-6">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
        <div class="border-b border-zinc-100 pb-3 dark:border-zinc-800 flex items-center justify-between">
          <h2 class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50">
            Langkah 1: Profil & Preferensi
          </h2>
          <span class="hidden sm:inline-flex px-2.5 py-0.5 rounded-md bg-blue-50 text-brand-blue dark:bg-blue-950/60 dark:text-blue-300 font-semibold text-xs">
            TI UMY
          </span>
        </div>

        <%
          const prkMhs = (typeof activeMahasiswa !== 'undefined' && activeMahasiswa) ? activeMahasiswa : { nim: '20240140001', nama: 'Mahasiswa TI', angkatan: 2024, semesterAktif: 5, kodePeminatan: 'SE' };
          const prkNama = (typeof currentUser !== 'undefined' && currentUser?.nama) ? currentUser.nama : prkMhs.nama;
          const prkNim = String((typeof currentUser !== 'undefined' && currentUser?.username) ? currentUser.username : prkMhs.nim || '20240140001');
          const prkAngkatan = Number(prkMhs.angkatan) || 2024;
          const prkNimSuffix = prkNim.slice(-3);
          const prkSmt = Number(prkMhs.semesterAktif) || 5;
          const prkPem = String(prkMhs.kodePeminatan || 'SE').toUpperCase();
        %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Nama Mahasiswa -->
          <div>
            <label for="input-nama" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">
              Nama Lengkap Mahasiswa
            </label>
            <input id="input-nama" type="text" minlength="3" maxlength="60" value="<%= prkNama %>" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs font-medium text-zinc-900 placeholder-zinc-400 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors">
          </div>

          <!-- Angkatan & NIM Builder -->
          <div>
            <label for="input-angkatan" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">
              Tahun Angkatan
            </label>
            <select id="input-angkatan" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs font-semibold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors">
              <% [2026, 2025, 2024, 2023, 2022].forEach(function(th) { %>
                <option value="<%= th %>" <%= prkAngkatan === th ? 'selected' : '' %>><%= th %></option>
              <% }); %>
            </select>
          </div>

          <!-- NIM Display / Suffix -->
          <div>
            <label for="input-nim-suffix" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">
              Nomor Induk Mahasiswa (NIM 11 Digit)
            </label>
            <div class="flex items-center">
              <span id="nim-prefix" class="inline-flex min-h-[44px] items-center px-3 rounded-l-md border border-r-0 border-zinc-200 bg-zinc-100 text-xs font-mono text-zinc-500 dark:border-zinc-700 dark:bg-zinc-800">
                <%= prkAngkatan %>0140
              </span>
              <input id="input-nim-suffix" type="text" minlength="3" maxlength="3" pattern="\d{3}" inputmode="numeric" value="<%= prkNimSuffix %>" class="w-full min-h-[44px] rounded-r-md border border-zinc-200 bg-white px-3 py-2 text-xs font-mono font-bold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors">
            </div>
          </div>

          <!-- Semester Aktif (Dikunci sesuai Periode Aktif Ganjil/Genap) -->
          <% const activeTipePrk = (typeof activePeriode !== 'undefined' && activePeriode && activePeriode.semesterTipe) ? activePeriode.semesterTipe : 'Ganjil'; %>
          <div>
            <label for="input-semester" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">
              Semester Berjalan (Periode <%= activeTipePrk %>)
            </label>
            <select id="input-semester" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs font-semibold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors">
              <% for (let s = 1; s <= 8; s++) { const tipeS = (s % 2 === 1) ? 'Ganjil' : 'Genap'; const isMatch = tipeS === activeTipePrk; %>
                <option value="<%= s %>" <%= prkSmt === s ? 'selected' : '' %> <%= !isMatch ? 'disabled' : '' %>>Semester <%= s %> (<%= tipeS %><%= !isMatch ? ' - Tidak Aktif' : '' %>)</option>
              <% } %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <!-- Preferensi Kelas -->
          <div>
            <label for="input-pref-kelas" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-0.5">
              Rombel Asal (Rekomendasi Utama)
            </label>
            <p class="text-[11px] text-zinc-400 mb-1.5">Dapat disesuaikan per matkul di Langkah 2.</p>
            <select id="input-pref-kelas" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs font-semibold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors">
              <option value="B" selected>Kelas B (Rombel Utama)</option>
              <option value="A">Kelas A</option>
              <option value="C">Kelas C</option>
              <option value="D">Kelas D</option>
            </select>
          </div>

          <!-- Jalur Peminatan -->
          <div>
            <label for="input-pref-peminatan" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">
              Jalur Peminatan Keahlian
            </label>
            <select id="input-pref-peminatan" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs font-semibold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors">
              <option value="SE" <%= prkPem === 'SE' ? 'selected' : '' %>>Software Engineering (SE)</option>
              <option value="NS" <%= prkPem === 'NS' ? 'selected' : '' %>>Network &amp; Cyber Security (NS)</option>
            </select>
          </div>

          <!-- Preferensi Waktu -->
          <div>
            <label for="input-pref-waktu" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5">
              Distribusi Waktu Perkuliahan
            </label>
            <select id="input-pref-waktu" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-xs font-semibold text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 dark:focus:border-zinc-100 dark:focus:ring-zinc-100 transition-colors">
              <option value="Semua" selected>Fleksibel (Pagi & Siang Tersebar)</option>
              <option value="Pagi">Diutamakan Sesi Pagi (07:00 – 11:30)</option>
              <option value="Siang">Diutamakan Sesi Siang (12:10 – 17:15)</option>
            </select>
          </div>
        </div>

        <!-- Action Step 1 -->
        <div class="flex justify-end pt-4 border-t border-zinc-100 dark:border-zinc-800">
          <button id="btn-to-step-2" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-brand-blue px-6 py-2.5 text-xs font-bold text-white hover:bg-brand-blueDark transition-colors shadow-sm">
            <span>Lanjut ke Pemilihan Mata Kuliah</span>
            <i class="ph ph-arrow-right text-base"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== LANGKAH 2: PEMILIHAN MATA KULIAH ==================== -->
    <section id="wizard-step-2" class="wizard-pane hidden space-y-6">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
        
        <!-- SKS Dynamic Counter Bar -->
        <div class="rounded-xl border border-blue-200 bg-blue-50/70 p-3.5 dark:border-blue-900/60 dark:bg-blue-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <h3 class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">
              Beban SKS (Maks. 24 SKS)
            </h3>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <div class="text-right">
              <p class="text-[11px] text-zinc-500 dark:text-zinc-400">Total SKS Terpilih</p>
              <p class="text-2xl font-bold font-mono text-brand-blue dark:text-amber-400">
                <span id="current-sks-count">17</span> <span class="text-sm font-normal text-zinc-500">/ 24 SKS</span>
              </p>
            </div>
            <div class="hidden sm:block w-28 bg-zinc-200 dark:bg-zinc-700 h-2.5 rounded-full overflow-hidden">
              <div id="sks-progress-bar" class="bg-brand-yellow h-full rounded-full transition-all duration-300" style="width: 70%;"></div>
            </div>
            <button type="button" onclick="document.getElementById('btn-calculate-prakrs')?.click()"
              class="inline-flex min-h-[38px] items-center gap-1.5 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-xs transition-colors">
              <i class="ph ph-sparkle text-amber-400"></i>
              <span>Susun Jadwal (Langkah 3) →</span>
            </button>
          </div>
        </div>

        <!-- Quick Selector Toolbar -->
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 pb-3 dark:border-zinc-800">
          <div>
            <h2 id="matkul-period-heading" class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50">
              Daftar Mata Kuliah Periode Aktif
            </h2>
            <p id="matkul-period-subtitle" class="text-xs text-zinc-500 dark:text-zinc-400">
              Menampilkan mata kuliah sesuai periode penawaran (Ganjil/Genap) dari database kurikulum TI UMY.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button id="btn-select-all" type="button" class="text-xs font-semibold text-brand-blue dark:text-amber-400 hover:underline inline-flex items-center gap-1">
              <i class="ph ph-check-square"></i>
              <span>Pilih Paket Semester Ini</span>
            </button>
            <span class="text-zinc-300 dark:text-zinc-700">|</span>
            <button id="btn-unselect-all" type="button" class="text-xs font-medium text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 inline-flex items-center gap-1">
              <i class="ph ph-x-square"></i>
              <span>Kosongkan</span>
            </button>
          </div>
        </div>

        <!-- Course List Grid (100% Dinamis dari PostgreSQL Kurikulum & Peminatan) -->
        <div id="matkul-list-container" class="space-y-6 text-xs"></div>

        <!-- Action Step 2 -->
        <div class="flex items-center justify-between pt-4 border-t border-zinc-100 dark:border-zinc-800">
          <button id="btn-back-to-1" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-zinc-200 bg-white px-5 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
            <i class="ph ph-arrow-left text-base"></i>
            <span>Kembali ke Profil</span>
          </button>
          <button id="btn-calculate-prakrs" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-brand-yellow px-6 py-2.5 text-xs font-bold text-zinc-900 hover:bg-brand-yellowGold transition-all shadow-sm">
            <i class="ph ph-sparkle text-base"></i>
            <span>Kalkulasi Rekomendasi Jadwal AI (Langkah 3)</span>
          </button>
        </div>

      </div>
    </section>

    <!-- ==================== LANGKAH 3: REKOMENDASI PAKET JADWAL ==================== -->
    <section id="wizard-step-3" class="wizard-pane hidden space-y-6">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
        
        <!-- Result Summary & Metrics -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/30 flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-emerald-100 dark:bg-emerald-900/60 flex items-center justify-center text-emerald-700 dark:text-emerald-300 shrink-0">
              <i class="ph ph-check-circle text-2xl"></i>
            </div>
            <div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Status Bentrok</p>
              <p class="font-heading font-bold text-sm text-emerald-800 dark:text-emerald-200">Zero Clash (0 Konflik)</p>
            </div>
          </div>

          <div class="rounded-xl border border-blue-200 bg-blue-50/70 p-4 dark:border-blue-900/60 dark:bg-blue-950/30 flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-blue-100 dark:bg-blue-900/60 flex items-center justify-center text-brand-blue dark:text-blue-300 shrink-0">
              <i class="ph ph-calendar-check text-2xl"></i>
            </div>
            <div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Total SKS Terjadwal</p>
              <p id="result-sks-label" class="font-heading font-bold text-sm text-blue-900 dark:text-blue-100">17 SKS · 6 Mata Kuliah</p>
            </div>
          </div>

          <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-900/60 dark:bg-amber-950/30 flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-amber-100 dark:bg-amber-900/60 flex items-center justify-center text-amber-700 dark:text-amber-300 shrink-0">
              <i class="ph ph-clock-user text-2xl"></i>
            </div>
            <div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Kesesuaian Preferensi</p>
              <p class="font-heading font-bold text-sm text-amber-900 dark:text-amber-100">100% Sesuai Kelas B</p>
            </div>
          </div>
        </div>

        <!-- Pratinjau Jadwal Rekomendasi AI -->
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3 dark:border-zinc-800">
            <div>
              <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-zinc-50">
                Susunan Jadwal Kuliah Paket Mahasiswa
              </h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Paket jadwal otomatis didistribusikan tanpa bentrok waktu, ruangan, maupun dosen.</p>
            </div>
            
            <!-- Button Variasi Lain -->
            <button id="btn-minta-variasi" type="button" class="inline-flex min-h-[38px] items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 shadow-sm transition-all">
              <i class="ph ph-shuffle text-sm text-brand-blue dark:text-amber-400"></i>
              <span>Minta Variasi Alternatif</span>
            </button>
          </div>

          <!-- Schedule Grid Pratinjau -->
          <div class="rounded-xl border border-zinc-200 bg-zinc-50/50 dark:border-zinc-800 dark:bg-zinc-900/50 overflow-x-auto">
            <table class="w-full border-collapse text-left text-xs min-w-[700px]">
              <thead>
                <tr class="border-b border-zinc-200 bg-zinc-100/80 dark:border-zinc-800 dark:bg-zinc-800/80">
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Hari & Jam</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Mata Kuliah</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Ruangan</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Kelas & SKS</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Dosen Pengampu</th>
                </tr>
              </thead>
              <tbody id="result-schedule-body" class="divide-y divide-zinc-200 dark:divide-zinc-800">
                <!-- Diisi oleh JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Action Step 3 -->
        <div class="flex items-center justify-between pt-4 border-t border-zinc-100 dark:border-zinc-800">
          <button id="btn-back-to-2" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-zinc-200 bg-white px-5 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
            <i class="ph ph-arrow-left text-base"></i>
            <span>Kembali ke Pilih Matkul</span>
          </button>
          <button id="btn-simpan-prakrs" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-brand-blue px-7 py-2.5 text-xs font-bold text-white hover:bg-brand-blueDark transition-colors shadow-sm">
            <i class="ph ph-floppy-disk text-base"></i>
            <span>Simpan & Terapkan Rencana Jadwal Ini</span>
          </button>
        </div>

      </div>
    </section>
  </div>

      </div>
    </main>

