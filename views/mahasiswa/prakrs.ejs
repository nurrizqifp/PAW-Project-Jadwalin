<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Perencanaan Pra-KRS — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'prakrs', currentRole: 'mahasiswa' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-7xl mx-auto space-y-6">

        <% const prkAccess = (typeof prakrsAccess !== 'undefined' && prakrsAccess) ? prakrsAccess : { isOpen: true, deadline: '2026-12-31', reason: 'Pengisian Pra-KRS sedang dibuka.' }; %>
        
        <!-- Header & Breadcrumb -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
          <div class="space-y-0.5">
            <h1 class="font-heading text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Perencanaan Pra-KRS Mahasiswa
            </h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Pilih kelas mata kuliah langsung dari kalender perkuliahan mingguan untuk menyusun jadwal studi bebas bentrok.
            </p>
          </div>

          <!-- Status Akses Pra-KRS -->
          <% if (prkAccess.isOpen) { %>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 text-xs font-semibold">
              <i class="ph ph-check-circle text-emerald-600 text-sm"></i>
              <span>Periode Terbuka s/d <%= prkAccess.deadline %></span>
            </div>
          <% } else { %>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-rose-300 bg-rose-50 text-rose-900 dark:border-rose-800 dark:bg-rose-950/50 dark:text-rose-300 text-xs font-semibold">
              <i class="ph ph-lock-key text-rose-600 text-sm"></i>
              <span>Pra-KRS Ditutup (<%= prkAccess.deadline %>)</span>
            </div>
          <% } %>
        </div>

        <% if (!prkAccess.isOpen) { %>
          <!-- State Terkunci: Pra-KRS Ditutup -->
          <div class="rounded-2xl border border-rose-200 bg-white p-8 text-center shadow-sm dark:border-rose-900/60 dark:bg-zinc-900 space-y-4">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-100 text-rose-600 dark:bg-rose-950/70 dark:text-rose-400 border border-rose-200 dark:border-rose-800">
              <i class="ph ph-lock-key text-3xl"></i>
            </div>
            <div class="space-y-1.5 max-w-lg mx-auto">
              <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-0.5 font-mono text-[11px] font-bold text-rose-800 dark:bg-rose-950 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                AKSES PRA-KRS DITUTUP
              </span>
              <h2 class="font-heading text-xl font-bold text-zinc-900 dark:text-zinc-50 pt-1">
                Periode Pengisian Pra-KRS Tidak Dapat Diakses
              </h2>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                <%= prkAccess.reason %> Anda tidak dapat mengubah pilihan jadwal pada periode ini.
              </p>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
              <a href="/mahasiswa/jadwal" class="inline-flex min-h-[40px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-5 py-2 text-xs font-semibold text-white shadow-xs transition-colors">
                <i class="ph ph-calendar-check text-base text-amber-400"></i>
                <span>Lihat Jadwal Pribadi Saya</span>
              </a>
              <a href="/mahasiswa/dashboard" class="inline-flex min-h-[40px] items-center gap-2 rounded-lg border border-zinc-200 bg-white hover:bg-zinc-50 px-4 py-2 text-xs font-semibold text-zinc-700 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
                <i class="ph ph-arrow-left text-base"></i>
                <span>Kembali ke Dashboard</span>
              </a>
            </div>
          </div>
        <% } %>

        <div class="<%= !prkAccess.isOpen ? 'hidden pointer-events-none select-none' : 'space-y-6' %>">

          <%
            const prkMhs = (typeof activeMahasiswa !== 'undefined' && activeMahasiswa) ? activeMahasiswa : { nim: '20240140001', nama: 'Mahasiswa TI', angkatan: 2024, semesterAktif: 5, kodePeminatan: 'SE' };
            const mhsSemester = Number(prkMhs.semesterAktif) || 5;
            const mhsPeminatan = String(prkMhs.kodePeminatan || 'SE').toUpperCase();
          %>

          <!-- Profil Mahasiswa & Filter Kalender -->
          <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-4">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
              <!-- Profil Ringkas Mahasiswa -->
              <div class="flex items-center gap-3">
                <div class="h-11 w-11 rounded-xl bg-blue-50 text-[#0c2b5e] dark:bg-blue-950/60 dark:text-blue-300 flex items-center justify-center font-bold text-base border border-blue-200 dark:border-blue-900 shrink-0">
                  <i class="ph ph-student"></i>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-50"><%= prkMhs.nama %></span>
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700"><%= prkMhs.nim %></span>
                  </div>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
                    Angkatan <%= prkMhs.angkatan %> · Semester <%= mhsSemester %> · Peminatan <%= mhsPeminatan === 'NS' ? 'Network Security (NS)' : 'Software Engineering (SE)' %>
                  </p>
                </div>
              </div>

              <!-- Filter Interaktif Kalender -->
              <div class="flex flex-wrap items-center gap-2.5">
                <!-- Filter Semester -->
                <div class="flex items-center gap-1.5">
                  <label for="filter-semester" class="text-xs font-semibold text-zinc-600 dark:text-zinc-400">Semester:</label>
                  <select id="filter-semester" class="h-9 rounded-lg border border-zinc-200 bg-white px-2.5 text-xs font-semibold text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-1 focus:ring-zinc-900">
                    <% [1, 2, 3, 4, 5, 6, 7, 8].forEach(function(s) { %>
                      <option value="<%= s %>" <%= s === mhsSemester ? 'selected' : '' %>>Semester <%= s %></option>
                    <% }); %>
                    <option value="ALL">Semua Semester</option>
                  </select>
                </div>

                <!-- Filter Peminatan -->
                <div class="flex items-center gap-1.5">
                  <label for="filter-peminatan" class="text-xs font-semibold text-zinc-600 dark:text-zinc-400">Peminatan:</label>
                  <select id="filter-peminatan" class="h-9 rounded-lg border border-zinc-200 bg-white px-2.5 text-xs font-semibold text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-1 focus:ring-zinc-900">
                    <option value="ALL">Semua Peminatan</option>
                    <option value="SE" <%= mhsPeminatan === 'SE' ? 'selected' : '' %>>Software Engineering (SE)</option>
                    <option value="NS" <%= mhsPeminatan === 'NS' ? 'selected' : '' %>>Network Security (NS)</option>
                  </select>
                </div>

                <!-- Pencarian Cepat -->
                <div class="relative">
                  <i class="ph ph-magnifying-glass absolute left-2.5 top-2.5 text-zinc-400 text-xs"></i>
                  <input id="filter-search" type="text" placeholder="Cari matkul / dosen / ruang..." class="h-9 w-44 sm:w-56 rounded-lg border border-zinc-200 bg-white pl-8 pr-2.5 text-xs text-zinc-800 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-1 focus:ring-zinc-900 placeholder-zinc-400">
                </div>
              </div>
            </div>

            <!-- Petunjuk Interaksi -->
            <div class="rounded-xl border border-blue-100 bg-blue-50/50 p-3 dark:border-blue-900/40 dark:bg-blue-950/20 text-xs text-blue-900 dark:text-blue-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <i class="ph ph-info text-base text-[#0c2b5e] dark:text-amber-400 shrink-0"></i>
                <span>Klik pada salah satu <strong>kartu kelas</strong> di kalender untuk memilih atau mengganti kelas. Pilihan Anda akan langsung dihitung beban SKS-nya.</span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-purple-800 dark:text-purple-300 bg-purple-100 dark:bg-purple-950/60 px-2 py-0.5 rounded border border-purple-200 dark:border-purple-800">
                  <i class="ph ph-users-three"></i> Kelas Gabungan
                </span>
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-800 dark:text-amber-300 bg-amber-100 dark:bg-amber-950/60 px-2 py-0.5 rounded border border-amber-200 dark:border-amber-800">
                  <i class="ph ph-flask"></i> Praktikum Lab
                </span>
              </div>
            </div>
          </div>

          <!-- Sticky Status & Aksi Simpan Jadwal -->
          <div class="sticky top-2 z-20 rounded-2xl border border-zinc-200 bg-white/95 p-4 shadow-md backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-900/95 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <!-- Counter SKS & Bentrok Status -->
            <div class="flex flex-wrap items-center gap-4 sm:gap-6">
              <!-- Total SKS -->
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs text-zinc-500 dark:text-zinc-400">Beban SKS:</span>
                  <span id="selected-sks-label" class="font-mono text-base font-bold text-zinc-900 dark:text-zinc-50">0 / 24 SKS</span>
                </div>
                <div class="w-32 h-2 rounded-full bg-zinc-200 dark:bg-zinc-700 overflow-hidden">
                  <div id="selected-sks-bar" class="h-full bg-brand-blue transition-all duration-300" style="width: 0%;"></div>
                </div>
              </div>

              <!-- Total Matkul -->
              <div class="border-l border-zinc-200 dark:border-zinc-700 pl-4 space-y-0.5">
                <span class="text-xs text-zinc-500 dark:text-zinc-400">Total Terpilih:</span>
                <p id="selected-matkul-count" class="font-mono text-sm font-bold text-zinc-800 dark:text-zinc-200">0 Mata Kuliah</p>
              </div>

              <!-- Status Bentrok Real-Time -->
              <div class="border-l border-zinc-200 dark:border-zinc-700 pl-4">
                <div id="clash-status-box" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 text-xs font-semibold">
                  <i class="ph ph-shield-check text-emerald-600 text-sm"></i>
                  <span id="clash-status-text">Bebas Bentrok (0 Konflik)</span>
                </div>
              </div>
            </div>

            <!-- Tombol Aksi -->
            <div class="flex items-center gap-2.5 shrink-0 self-end md:self-center">
              <button id="btn-reset-selection" type="button" class="inline-flex min-h-[40px] items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
                <i class="ph ph-arrow-counter-clockwise text-sm"></i>
                <span>Reset</span>
              </button>
              <button id="btn-save-prakrs" type="button" class="inline-flex min-h-[40px] items-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-5 py-2 text-xs font-bold text-white shadow-sm transition-all duration-200">
                <i class="ph ph-floppy-disk text-base text-amber-400"></i>
                <span>Simpan Jadwal Rencana Saya</span>
              </button>
            </div>
          </div>

          <!-- Alert Peringatan Bentrok Real-Time (Muncul jika ada tabrakan) -->
          <div id="clash-alert-banner" class="hidden rounded-xl border border-rose-300 bg-rose-50 p-4 dark:border-rose-900/60 dark:bg-rose-950/40 text-xs text-rose-900 dark:text-rose-200 flex items-start gap-3">
            <i class="ph ph-warning-circle text-rose-600 dark:text-rose-400 text-lg shrink-0 mt-0.5"></i>
            <div class="space-y-1">
              <h4 class="font-heading font-bold text-rose-900 dark:text-rose-100">Terdeteksi Bentrok Waktu Kuliah!</h4>
              <p id="clash-alert-detail" class="text-rose-700 dark:text-rose-300 leading-relaxed"></p>
            </div>
          </div>

          <!-- Interactive Calendar Grid Matriks -->
          <div class="rounded-2xl border border-zinc-200 bg-white shadow-xs dark:border-zinc-800 dark:bg-zinc-900 overflow-hidden space-y-0">
            <!-- Legend Sesi Grid -->
            <div class="px-5 py-3 border-b border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/70 flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex flex-wrap items-center gap-4">
                <span class="text-zinc-500 font-semibold text-[11px]">Keterangan Kartu:</span>
                <div class="inline-flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded bg-blue-100 border border-blue-300 dark:bg-blue-950/70 dark:border-blue-700"></span>
                  <span class="text-zinc-700 dark:text-zinc-300 text-[11px]">Kuliah Teori</span>
                </div>
                <div class="inline-flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded bg-amber-100 border border-amber-300 dark:bg-amber-950/70 dark:border-amber-700"></span>
                  <span class="text-zinc-700 dark:text-zinc-300 text-[11px]">Praktikum Laboratorium</span>
                </div>
                <div class="inline-flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded bg-purple-100 border border-purple-300 dark:bg-purple-950/70 dark:border-purple-700"></span>
                  <span class="text-zinc-700 dark:text-zinc-300 text-[11px]">Kelas Gabungan (Kapasitas Besar)</span>
                </div>
                <div class="inline-flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded bg-[#0c2b5e] border border-blue-900"></span>
                  <span class="text-zinc-900 dark:text-zinc-100 font-bold text-[11px]">Kelas Terpilih</span>
                </div>
                <div class="inline-flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded bg-rose-500 border border-rose-600"></span>
                  <span class="text-rose-700 dark:text-rose-300 font-bold text-[11px]">Bentrok Jam Kuliah</span>
                </div>
              </div>
            </div>

            <!-- Matriks Table Kalender -->
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-left text-xs min-w-[950px]">
                <thead>
                  <tr class="border-b border-zinc-200 bg-zinc-100/75 dark:border-zinc-800 dark:bg-zinc-800/80 font-mono text-[11px]">
                    <th class="sticky left-0 z-10 w-28 border-r border-zinc-200 bg-zinc-100/90 px-3.5 py-3 font-semibold text-zinc-700 dark:border-zinc-800 dark:bg-zinc-800 dark:text-zinc-300 text-center">
                      WAKTU
                    </th>
                    <th class="border-r border-zinc-200 px-3 py-3 font-heading font-bold text-zinc-900 dark:border-zinc-800 dark:text-zinc-100 text-center">
                      SENIN
                    </th>
                    <th class="border-r border-zinc-200 px-3 py-3 font-heading font-bold text-zinc-900 dark:border-zinc-800 dark:text-zinc-100 text-center">
                      SELASA
                    </th>
                    <th class="border-r border-zinc-200 px-3 py-3 font-heading font-bold text-zinc-900 dark:border-zinc-800 dark:text-zinc-100 text-center">
                      RABU
                    </th>
                    <th class="border-r border-zinc-200 px-3 py-3 font-heading font-bold text-zinc-900 dark:border-zinc-800 dark:text-zinc-100 text-center">
                      KAMIS
                    </th>
                    <th class="border-r border-zinc-200 px-3 py-3 font-heading font-bold text-zinc-900 dark:border-zinc-800 dark:text-zinc-100 text-center">
                      JUMAT
                    </th>
                    <th class="px-3 py-3 font-heading font-bold text-zinc-900 dark:text-zinc-100 text-center">
                      SABTU
                    </th>
                  </tr>
                </thead>
                <tbody id="interactive-grid-body" class="divide-y divide-zinc-200 dark:divide-zinc-800 font-sans">
                  <!-- Dynamic Content Rendered by Client-side JS -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Section Ringkasan Daftar Kelas Terpilih -->
          <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-xs dark:border-zinc-800 dark:bg-zinc-900 space-y-3">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-3 dark:border-zinc-800">
              <div>
                <h3 class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100">
                  Daftar Kelas yang Anda Pilih
                </h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400">
                  Periksa kembali daftar mata kuliah di bawah sebelum menekan tombol simpan jadwal.
                </p>
              </div>
              <span id="summary-sks-badge" class="font-mono text-xs font-bold px-2.5 py-1 rounded-md bg-blue-50 text-[#0c2b5e] dark:bg-blue-950 dark:text-blue-300 border border-blue-200 dark:border-blue-900">
                0 SKS Terpilih
              </span>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs min-w-[700px]">
                <thead>
                  <tr class="border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 font-mono text-[11px] uppercase">
                    <th class="py-2.5 px-3">Kode & Mata Kuliah</th>
                    <th class="py-2.5 px-3">Kelas & Tipe</th>
                    <th class="py-2.5 px-3">Hari & Jam</th>
                    <th class="py-2.5 px-3">Ruangan</th>
                    <th class="py-2.5 px-3">Dosen Pengampu</th>
                    <th class="py-2.5 px-3 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody id="summary-selected-body" class="divide-y divide-zinc-100 dark:divide-zinc-800">
                  <!-- Diisi oleh JS -->
                </tbody>
              </table>
            </div>
          </div>

        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Data Master Jadwal Terpublikasi dari PostgreSQL
    const MASTER_JADWAL = <%- JSON.stringify(typeof jadwal !== 'undefined' ? jadwal : []) %>;
    const SAVED_PRAKRS_INITIAL = <%- JSON.stringify((typeof defaultPrakrs !== 'undefined' && defaultPrakrs && Array.isArray(defaultPrakrs.rekomendasiSesi)) ? defaultPrakrs.rekomendasiSesi : (typeof defaultPrakrs !== 'undefined' && defaultPrakrs && Array.isArray(defaultPrakrs.rekomendasi_sesi)) ? defaultPrakrs.rekomendasi_sesi : []) %>;
    const INITIAL_SEMESTER = <%= mhsSemester %>;
    const INITIAL_PEMINATAN = '<%= mhsPeminatan %>';

    // Elements
    const filterSemester = document.getElementById('filter-semester');
    const filterPeminatan = document.getElementById('filter-peminatan');
    const filterSearch = document.getElementById('filter-search');
    const gridBody = document.getElementById('interactive-grid-body');
    const selectedSksLabel = document.getElementById('selected-sks-label');
    const selectedSksBar = document.getElementById('selected-sks-bar');
    const selectedMatkulCount = document.getElementById('selected-matkul-count');
    const clashStatusBox = document.getElementById('clash-status-box');
    const clashStatusText = document.getElementById('clash-status-text');
    const clashAlertBanner = document.getElementById('clash-alert-banner');
    const clashAlertDetail = document.getElementById('clash-alert-detail');
    const summarySelectedBody = document.getElementById('summary-selected-body');
    const summarySksBadge = document.getElementById('summary-sks-badge');
    const btnSave = document.getElementById('btn-save-prakrs');
    const btnReset = document.getElementById('btn-reset-selection');

    // Slot Waktu Standar Kalender
    const timeSlots = [
      { start: '07:00', end: '08:40', label: '07:00 – 08:40' },
      { start: '08:50', end: '11:30', label: '08:50 – 11:30' },
      { isBreak: true, start: '11:30', end: '12:10', label: '11:30 – 12:10' },
      { start: '12:10', end: '14:40', label: '12:10 – 14:40' },
      { start: '14:45', end: '19:20', label: '14:45 – 19:20' }
    ];
    const days = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];

    // State Sesi Terpilih: Map<kodeMatkul, sesiObject>
    // Memastikan 1 mata kuliah hanya memiliki 1 kelas terpilih
    const selectedSesisMap = new Map();

    // Inisialisasi dari saved Pra-KRS jika ada
    if (SAVED_PRAKRS_INITIAL.length > 0) {
      SAVED_PRAKRS_INITIAL.forEach(savedItem => {
        // Cari sesi di MASTER_JADWAL yang paling cocok (berdasarkan kodeMatkul dan kelas)
        const matched = MASTER_JADWAL.find(j => 
          (j.kodeMatkul === savedItem.kodeMatkul || j.id === savedItem.id) &&
          (j.kelas === savedItem.kelas || String(j.kelas).includes(savedItem.kelas))
        ) || savedItem;
        
        const k = matched.kodeMatkul || matched.kode;
        if (k) selectedSesisMap.set(k, matched);
      });
    }

    // Helper: Cek apakah rentang jam bertabrakan
    function isTimeOverlap(s1, e1, s2, e2) {
      return (s1 < e2) && (s2 < e1);
    }

    // Deteksi Bentrok di antara sesi yang sedang dipilih
    function detectClashes() {
      const selectedList = Array.from(selectedSesisMap.values());
      const clashes = [];

      for (let i = 0; i < selectedList.length; i++) {
        for (let j = i + 1; j < selectedList.length; j++) {
          const a = selectedList[i];
          const b = selectedList[j];
          if (a.hari === b.hari && isTimeOverlap(a.jamMulai, a.jamSelesai, b.jamMulai, b.jamSelesai)) {
            clashes.push({ a, b });
          }
        }
      }
      return clashes;
    }

    // Toggle Seleksi Sesi
    function toggleSelectSesi(item) {
      const kode = item.kodeMatkul;
      if (!kode) return;

      const current = selectedSesisMap.get(kode);
      if (current && current.id === item.id) {
        // Klik sesi yang sama -> Batalkan pilihan
        selectedSesisMap.delete(kode);
      } else {
        // Pilih sesi ini (otomatis menggantikan kelas lain untuk matkul yang sama)
        selectedSesisMap.set(kode, item);
      }

      updateUI();
    }

    // Hapus sesi dari ringkasan
    window.removeSelectedSesi = function(kode) {
      selectedSesisMap.delete(kode);
      updateUI();
    };

    // Update Seluruh UI (Kalender, Stats, Alert, dan Ringkasan)
    function updateUI() {
      const selectedList = Array.from(selectedSesisMap.values());
      const totalSks = selectedList.reduce((sum, s) => sum + (Number(s.sks) || 0), 0);
      const clashes = detectClashes();

      // 1. Update SKS & Count
      selectedSksLabel.textContent = `${totalSks} / 24 SKS`;
      const pct = Math.min(100, Math.round((totalSks / 24) * 100));
      selectedSksBar.style.width = `${pct}%`;
      selectedMatkulCount.textContent = `${selectedList.length} Mata Kuliah`;
      summarySksBadge.textContent = `${totalSks} SKS Terpilih (${selectedList.length} Matkul)`;

      if (totalSks > 24) {
        selectedSksLabel.className = 'font-mono text-base font-bold text-rose-600';
        selectedSksBar.className = 'h-full bg-rose-600 transition-all duration-300';
      } else {
        selectedSksLabel.className = 'font-mono text-base font-bold text-zinc-900 dark:text-zinc-50';
        selectedSksBar.className = 'h-full bg-brand-blue transition-all duration-300';
      }

      // 2. Update Clash Status
      if (clashes.length > 0) {
        clashStatusBox.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-rose-300 bg-rose-50 text-rose-900 dark:border-rose-800 dark:bg-rose-950/50 dark:text-rose-300 text-xs font-semibold animate-pulse';
        clashStatusBox.innerHTML = `<i class="ph ph-warning text-rose-600 text-sm"></i><span>Terdeteksi ${clashes.length} Bentrok Jam!</span>`;
        
        clashAlertBanner.classList.remove('hidden');
        const clashTextArr = clashes.map(c => `• <strong>${c.a.mataKuliah}</strong> (Kelas ${c.a.kelas}) bertabrakan dengan <strong>${c.b.mataKuliah}</strong> (Kelas ${c.b.kelas}) pada hari <strong>${c.a.hari} ${c.a.jamMulai}–${c.a.jamSelesai}</strong>.`);
        clashAlertDetail.innerHTML = clashTextArr.join('<br>');
      } else {
        clashStatusBox.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 text-xs font-semibold';
        clashStatusBox.innerHTML = `<i class="ph ph-shield-check text-emerald-600 text-sm"></i><span>Bebas Bentrok (0 Konflik)</span>`;
        clashAlertBanner.classList.add('hidden');
        clashAlertDetail.innerHTML = '';
      }

      // 3. Render Kalender Grid
      renderCalendarGrid(clashes);

      // 4. Render Ringkasan Tabel
      renderSummaryTable();
    }

    // Filter Sesi untuk Kalender
    function getFilteredSessions() {
      const semVal = filterSemester.value;
      const pemVal = filterPeminatan.value;
      const qVal = filterSearch.value.trim().toLowerCase();

      return MASTER_JADWAL.filter(item => {
        // Filter Semester
        if (semVal !== 'ALL' && String(item.semester) !== String(semVal)) {
          return false;
        }

        // Filter Peminatan
        if (pemVal !== 'ALL') {
          if (item.peminatanKode && item.peminatanKode !== pemVal) return false;
        }

        // Filter Search
        if (qVal) {
          const haystack = `${item.mataKuliah} ${item.kodeMatkul} ${item.dosen} ${item.ruang} ${item.kelas}`.toLowerCase();
          if (!haystack.includes(qVal)) return false;
        }

        return true;
      });
    }

    // Render Grid Kalender
    function renderCalendarGrid(clashes) {
      gridBody.innerHTML = '';
      const visibleSessions = getFilteredSessions();
      const clashingIds = new Set();

      clashes.forEach(c => {
        if (c.a?.id) clashingIds.add(c.a.id);
        if (c.b?.id) clashingIds.add(c.b.id);
      });

      timeSlots.forEach(slot => {
        const tr = document.createElement('tr');

        // Break Row (Dhuhur)
        if (slot.isBreak) {
          tr.className = 'bg-zinc-100/90 dark:bg-zinc-800/60 border-y border-zinc-200 dark:border-zinc-700/60';
          tr.innerHTML = `
            <td class="sticky left-0 border-r border-zinc-200 bg-zinc-100 px-3 py-2 text-center text-zinc-500 dark:border-zinc-800 dark:bg-zinc-800 font-semibold text-[11px]">
              ${slot.label}
            </td>
            <td colspan="6" class="px-4 py-2 text-center text-xs font-semibold text-zinc-600 dark:text-zinc-400">
              <span class="inline-flex items-center gap-1.5">
                <i class="ph ph-moon-stars text-amber-500"></i>
                <span>Jeda Ibadah Shalat Dhuhur & Istirahat</span>
              </span>
            </td>
          `;
          gridBody.appendChild(tr);
          return;
        }

        tr.className = 'min-h-[110px] items-stretch';

        // Kolom Label Jam
        const timeTd = document.createElement('td');
        timeTd.className = 'sticky left-0 border-r border-zinc-200 bg-zinc-50 px-2.5 py-2.5 text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 align-top text-center font-medium text-[11px]';
        timeTd.textContent = slot.label;
        tr.appendChild(timeTd);

        // Kolom Hari (Senin s/d Sabtu)
        days.forEach(day => {
          const td = document.createElement('td');
          td.className = 'border-r border-zinc-200 p-1.5 dark:border-zinc-800 align-top hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors';

          // Cari sesi yang pas di slot ini
          const matches = visibleSessions.filter(item => {
            if (item.hari !== day) return false;
            const jMulai = item.jamMulai || '';
            if (slot.start === '07:00' && jMulai < '08:45') return true;
            if (slot.start === '08:50' && jMulai >= '08:45' && jMulai < '11:45') return true;
            if (slot.start === '12:10' && jMulai >= '11:45' && jMulai < '14:45') return true;
            if (slot.start === '14:45' && jMulai >= '14:45') return true;
            return false;
          });

          if (matches.length === 0) {
            td.innerHTML = '<div class="h-16"></div>';
          } else {
            const container = document.createElement('div');
            container.className = 'space-y-2';

            matches.forEach(item => {
              const isSelected = selectedSesisMap.get(item.kodeMatkul)?.id === item.id;
              const isClashing = isSelected && clashingIds.has(item.id);
              const isLab = (item.ruang && item.ruang.toLowerCase().includes('lab')) || 
                            (item.tipeRuang && item.tipeRuang.toLowerCase().includes('lab')) ||
                            (item.jenis && item.jenis.toLowerCase().includes('praktikum'));
              const isGabungan = item.kelas.includes(';') || item.kelas.length > 2;

              const card = document.createElement('div');
              card.className = `group cursor-pointer rounded-xl p-2.5 transition-all select-none relative ${
                isClashing
                  ? 'border-2 border-rose-600 bg-rose-50/90 dark:border-rose-500 dark:bg-rose-950/60 shadow-md ring-2 ring-rose-400/30'
                  : isSelected
                    ? 'border-2 border-[#0c2b5e] bg-blue-50/95 dark:border-blue-500 dark:bg-blue-950/60 shadow-md ring-2 ring-blue-300/40'
                    : isGabungan
                      ? 'border border-purple-200 bg-purple-50/40 hover:border-purple-400 hover:bg-purple-50/80 dark:border-purple-900/60 dark:bg-purple-950/20'
                      : isLab
                        ? 'border border-amber-200 bg-amber-50/40 hover:border-amber-400 hover:bg-amber-50/80 dark:border-amber-900/60 dark:bg-amber-950/20'
                        : 'border border-zinc-200 bg-white hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/90'
              }`;

              card.innerHTML = `
                <!-- Card Header: Kode, Nama Matkul, & Status Icon -->
                <div class="flex items-start justify-between gap-1.5">
                  <div class="min-w-0 flex-1">
                    <span class="font-mono text-[9px] font-semibold text-zinc-400 dark:text-zinc-500 block leading-tight">${item.kodeMatkul}</span>
                    <span class="font-heading font-bold text-xs leading-snug line-clamp-2 ${isSelected ? (isClashing ? 'text-rose-700 dark:text-rose-300' : 'text-[#0c2b5e] dark:text-blue-200') : 'text-zinc-900 dark:text-zinc-100'}" title="${item.mataKuliah}">
                      ${item.mataKuliah}
                    </span>
                  </div>
                  ${isClashing 
                    ? '<span class="inline-flex items-center justify-center h-4 w-4 rounded-full bg-rose-600 text-white shrink-0 shadow-xs" title="Bentrok Waktu Kuliah!"><i class="ph ph-warning text-[10px]"></i></span>'
                    : isSelected 
                      ? '<span class="inline-flex items-center justify-center h-4 w-4 rounded-full bg-[#0c2b5e] text-white shrink-0 shadow-xs" title="Kelas Terpilih"><i class="ph ph-check text-[10px]"></i></span>' 
                      : '<span class="inline-flex items-center justify-center h-4 w-4 rounded-full border border-zinc-300 group-hover:border-blue-600 shrink-0 text-transparent group-hover:text-blue-600 text-[10px]"><i class="ph ph-plus"></i></span>'
                  }
                </div>

                <!-- Badges Row -->
                <div class="mt-1.5 flex flex-wrap items-center gap-1 text-[10px]">
                  <!-- Badge Kelas -->
                  <span class="px-1.5 py-0.5 rounded font-mono font-bold ${
                    isGabungan 
                      ? 'bg-purple-100 text-purple-900 dark:bg-purple-950 dark:text-purple-300 border border-purple-300 dark:border-purple-800' 
                      : 'bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200'
                  }">
                    ${isGabungan ? 'Gabungan ' + item.kelas : 'Kls ' + item.kelas}
                  </span>

                  <!-- SKS -->
                  <span class="px-1 py-0.5 rounded bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 font-mono">
                    ${item.sks} SKS
                  </span>

                  <!-- Lab Indicator -->
                  ${isLab ? '<span class="px-1 py-0.5 rounded bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300 font-semibold" title="Praktikum Laboratorium"><i class="ph ph-flask"></i> Lab</span>' : ''}
                </div>

                <!-- Ruangan & Jam -->
                <div class="mt-1.5 flex items-center justify-between text-[10px] font-medium text-zinc-600 dark:text-zinc-400">
                  <span class="truncate font-semibold" title="${item.ruang}">${item.ruang}</span>
                  <span class="font-mono text-zinc-500">${item.jamMulai}–${item.jamSelesai}</span>
                </div>

                <!-- Dosen Pengampu -->
                <div class="mt-0.5 text-[10px] text-zinc-500 dark:text-zinc-400 truncate" title="${item.dosen}">
                  ${item.dosenInisial || item.dosen}
                </div>
              `;

              card.addEventListener('click', () => toggleSelectSesi(item));
              container.appendChild(card);
            });

            td.appendChild(container);
          }

          tr.appendChild(td);
        });

        gridBody.appendChild(tr);
      });
    }

    // Render Ringkasan Tabel Bawah
    function renderSummaryTable() {
      summarySelectedBody.innerHTML = '';
      const selectedList = Array.from(selectedSesisMap.values());

      if (selectedList.length === 0) {
        summarySelectedBody.innerHTML = `
          <tr>
            <td colspan="6" class="py-6 text-center text-zinc-400">
              Belum ada kelas yang dipilih. Silakan pilih kelas mata kuliah pada kalender di atas.
            </td>
          </tr>
        `;
        return;
      }

      // Urutkan berdasarkan hari & jam
      const dayOrder = { 'Senin': 1, 'Selasa': 2, 'Rabu': 3, 'Kamis': 4, 'Jumat': 5, 'Sabtu': 6 };
      selectedList.sort((a, b) => (dayOrder[a.hari] || 9) - (dayOrder[b.hari] || 9) || a.jamMulai.localeCompare(b.jamMulai));

      selectedList.forEach(item => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-zinc-50 dark:hover:bg-zinc-800/40 transition-colors';
        tr.innerHTML = `
          <td class="py-2.5 px-3">
            <span class="font-semibold text-zinc-900 dark:text-zinc-100">${item.mataKuliah}</span>
            <div class="text-[10px] font-mono text-zinc-400">${item.kodeMatkul} · Semester ${item.semester || '-'}</div>
          </td>
          <td class="py-2.5 px-3">
            <span class="px-2 py-0.5 rounded text-xs font-mono font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200">
              Kelas ${item.kelas}
            </span>
            <span class="text-[11px] text-zinc-500 ml-1">(${item.sks} SKS)</span>
          </td>
          <td class="py-2.5 px-3 font-medium text-zinc-800 dark:text-zinc-200">
            ${item.hari}, ${item.jamMulai}–${item.jamSelesai}
          </td>
          <td class="py-2.5 px-3">
            <span class="font-medium text-zinc-800 dark:text-zinc-200">${item.ruang}</span>
            <div class="text-[10px] text-zinc-400">${item.tipeRuang || 'Ruang Kuliah'}</div>
          </td>
          <td class="py-2.5 px-3 text-zinc-600 dark:text-zinc-400">
            ${item.dosen}
          </td>
          <td class="py-2.5 px-3 text-right">
            <button type="button" onclick="removeSelectedSesi('${item.kodeMatkul}')" class="text-rose-500 hover:text-rose-700 p-1" title="Batalkan Pilihan">
              <i class="ph ph-trash text-sm"></i>
            </button>
          </td>
        `;
        summarySelectedBody.appendChild(tr);
      });
    }

    // Event Listeners Filter
    filterSemester.addEventListener('change', () => updateUI());
    filterPeminatan.addEventListener('change', () => updateUI());
    filterSearch.addEventListener('input', () => updateUI());

    // Reset Pilihan
    btnReset.addEventListener('click', () => {
      if (selectedSesisMap.size === 0) return;
      if (confirm('Kosongkan semua kelas yang telah dipilih di kalender?')) {
        selectedSesisMap.clear();
        updateUI();
        if (window.JadwalinUI?.toast) {
          window.JadwalinUI.toast.show('Seluruh pilihan kelas telah dikosongkan.', 'info');
        }
      }
    });

    // Simpan Jadwal ke Database
    btnSave.addEventListener('click', async () => {
      const selectedList = Array.from(selectedSesisMap.values());
      if (selectedList.length === 0) {
        if (window.JadwalinUI?.toast) {
          window.JadwalinUI.toast.show('Pilih minimal satu kelas perkuliahan sebelum menyimpan jadwal.', 'warning');
        } else {
          alert('Pilih minimal satu kelas perkuliahan sebelum menyimpan jadwal.');
        }
        return;
      }

      const totalSks = selectedList.reduce((sum, s) => sum + (Number(s.sks) || 0), 0);
      if (totalSks > 24) {
        if (window.JadwalinUI?.toast) {
          window.JadwalinUI.toast.show(`Penyimpanan ditolak: Total beban SKS (${totalSks} SKS) melebihi batas maksimal 24 SKS. Harap kurangi mata kuliah yang dipilih.`, 'error');
        } else {
          alert(`Penyimpanan ditolak: Total beban SKS (${totalSks} SKS) melebihi batas maksimal 24 SKS.`);
        }
        return;
      }

      const clashes = detectClashes();
      if (clashes.length > 0) {
        if (window.JadwalinUI?.toast) {
          window.JadwalinUI.toast.show(`Penyimpanan ditolak: Masih terdapat ${clashes.length} bentrok jam kuliah pada jadwal yang Anda pilih. Harap perbaiki bentrok terlebih dahulu.`, 'error');
        } else {
          alert(`Penyimpanan ditolak: Masih terdapat ${clashes.length} bentrok jam kuliah.`);
        }
        return;
      }

      btnSave.disabled = true;
      const targetSmt = INITIAL_SEMESTER;
      const targetPem = INITIAL_PEMINATAN;

      const kelasPerMatkul = {};
      selectedList.forEach(s => {
        kelasPerMatkul[s.kodeMatkul] = s.kelas;
      });

      try {
        const res = await JadwalinUI.apiFetch('/api/jadwal/prakrs/simpan', {
          method: 'POST',
          body: JSON.stringify({
            semester: targetSmt,
            kodePeminatan: targetPem,
            prefKelas: 'Campuran',
            kodeMatkulList: selectedList.map(s => s.kodeMatkul),
            kelasPerMatkul,
            selectedSesis: selectedList
          })
        });

        if (!res || !res.sukses) {
          throw new Error(res?.pesan || 'Gagal menyimpan rencana Pra-KRS.');
        }

        if (window.showConfirmDialog) {
          window.showConfirmDialog(
            'Rencana Jadwal Berhasil Disimpan',
            `${selectedList.length} mata kuliah (${selectedList.reduce((acc, s) => acc + (s.sks || 0), 0)} SKS) telah disimpan ke database sebagai jadwal perkuliahan pribadi Anda. Buka halaman Jadwal Saya?`,
            () => { window.location.href = '/mahasiswa/jadwal'; },
            'Buka Jadwal Saya',
            true
          );
        } else {
          if (window.JadwalinUI?.toast) window.JadwalinUI.toast.show('Rencana jadwal berhasil disimpan!', 'success');
          setTimeout(() => { window.location.href = '/mahasiswa/jadwal'; }, 800);
        }
      } catch (err) {
        if (window.JadwalinUI?.toast) {
          window.JadwalinUI.toast.show(err.message || 'Gagal menyimpan rencana jadwal.', 'error');
        } else {
          alert(err.message || 'Gagal menyimpan rencana jadwal.');
        }
        btnSave.disabled = false;
      }
    });

    // Initial render
    updateUI();
  });
</script>
