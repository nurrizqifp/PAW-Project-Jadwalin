        </div>

      </div>
    </section>

    <!-- ==================== LANGKAH 3: REKOMENDASI PAKET JADWAL ==================== -->
    <section id="wizard-step-3" class="wizard-pane hidden space-y-6">
      <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
        
        <!-- Result Summary & Metrics -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/30 flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-emerald-100 dark:bg-emerald-900/60 flex items-center justify-center text-emerald-700 dark:text-emerald-300 shrink-0">
              <i class="ph ph-check-circle text-2xl"></i>
            </div>
            <div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Status Bentrok</p>
              <p class="font-heading font-bold text-sm text-emerald-800 dark:text-emerald-200">Zero Clash (0 Konflik)</p>
            </div>
          </div>

          <div class="rounded-xl border border-blue-200 bg-blue-50/70 p-4 dark:border-blue-900/60 dark:bg-blue-950/30 flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-blue-100 dark:bg-blue-900/60 flex items-center justify-center text-brand-blue dark:text-blue-300 shrink-0">
              <i class="ph ph-calendar-check text-2xl"></i>
            </div>
            <div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Total SKS Terjadwal</p>
              <p id="result-sks-label" class="font-heading font-bold text-sm text-blue-900 dark:text-blue-100">17 SKS · 6 Mata Kuliah</p>
            </div>
          </div>

          <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-900/60 dark:bg-amber-950/30 flex items-center gap-3">
            <div class="h-10 w-10 rounded-lg bg-amber-100 dark:bg-amber-900/60 flex items-center justify-center text-amber-700 dark:text-amber-300 shrink-0">
              <i class="ph ph-clock-user text-2xl"></i>
            </div>
            <div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Kesesuaian Preferensi</p>
              <p class="font-heading font-bold text-sm text-amber-900 dark:text-amber-100">100% Sesuai Kelas B</p>
            </div>
          </div>
        </div>

        <!-- Pratinjau Jadwal Rekomendasi AI -->
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3 dark:border-zinc-800">
            <div>
              <h3 class="font-heading font-bold text-base text-zinc-900 dark:text-zinc-50">
                Susunan Jadwal Kuliah Paket Mahasiswa
              </h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400">Paket jadwal otomatis didistribusikan tanpa bentrok waktu, ruangan, maupun dosen.</p>
            </div>
            
            <!-- Button Variasi Lain -->
            <button id="btn-minta-variasi" type="button" class="inline-flex min-h-[38px] items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 shadow-sm transition-all">
              <i class="ph ph-shuffle text-sm text-brand-blue dark:text-amber-400"></i>
              <span>Minta Variasi Alternatif</span>
            </button>
          </div>

          <!-- Schedule Grid Pratinjau -->
          <div class="rounded-xl border border-zinc-200 bg-zinc-50/50 dark:border-zinc-800 dark:bg-zinc-900/50 overflow-x-auto">
            <table class="w-full border-collapse text-left text-xs min-w-[700px]">
              <thead>
                <tr class="border-b border-zinc-200 bg-zinc-100/80 dark:border-zinc-800 dark:bg-zinc-800/80">
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Hari & Jam</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Mata Kuliah</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Ruangan</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Kelas & SKS</th>
                  <th class="px-4 py-3 font-semibold text-zinc-600 dark:text-zinc-400">Dosen Pengampu</th>
                </tr>
              </thead>
              <tbody id="result-schedule-body" class="divide-y divide-zinc-200 dark:divide-zinc-800">
                <!-- Diisi oleh JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Action Step 3 -->
        <div class="flex items-center justify-between pt-4 border-t border-zinc-100 dark:border-zinc-800">
          <button id="btn-back-to-2" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg border border-zinc-200 bg-white px-5 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 transition-colors">
            <i class="ph ph-arrow-left text-base"></i>
            <span>Kembali ke Pilih Matkul</span>
          </button>
          <button id="btn-simpan-prakrs" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-brand-blue px-7 py-2.5 text-xs font-bold text-white hover:bg-brand-blueDark transition-colors shadow-sm">
            <i class="ph ph-floppy-disk text-base"></i>
            <span>Simpan & Terapkan Rencana Jadwal Ini</span>
          </button>
        </div>

      </div>
    </section>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Nav elements
    const stepNav1 = document.getElementById('step-nav-1');
    const stepNav2 = document.getElementById('step-nav-2');
    const stepNav3 = document.getElementById('step-nav-3');

    // Panes
    const pane1 = document.getElementById('wizard-step-1');
    const pane2 = document.getElementById('wizard-step-2');
    const pane3 = document.getElementById('wizard-step-3');

    // Buttons
    const btnToStep2 = document.getElementById('btn-to-step-2');
    const btnBackTo1 = document.getElementById('btn-back-to-1');
    const btnCalculate = document.getElementById('btn-calculate-prakrs');
    const btnBackTo2 = document.getElementById('btn-back-to-2');
    const btnMintaVariasi = document.getElementById('btn-minta-variasi');
    const btnSimpan = document.getElementById('btn-simpan-prakrs');
    const btnSelectAll = document.getElementById('btn-select-all');
    const btnUnselectAll = document.getElementById('btn-unselect-all');

    // Form inputs
    const inputAngkatan = document.getElementById('input-angkatan');
    const nimPrefix = document.getElementById('nim-prefix');
    const inputNimSuffix = document.getElementById('input-nim-suffix');
    const inputNama = document.getElementById('input-nama');
    const inputSemester = document.getElementById('input-semester');
    const inputPrefKelas = document.getElementById('input-pref-kelas');
    const inputPrefPeminatan = document.getElementById('input-pref-peminatan');
    const inputPrefWaktu = document.getElementById('input-pref-waktu');

    // SKS Elements
    const matkulCheckboxes = document.querySelectorAll('.matkul-checkbox');
    const currentSksCountEl = document.getElementById('current-sks-count');
    const sksProgressBar = document.getElementById('sks-progress-bar');
    const resultScheduleBody = document.getElementById('result-schedule-body');
    const resultSksLabel = document.getElementById('result-sks-label');

    let currentVariasiIndex = 0;

    // NIM Builder Sync
    inputAngkatan.addEventListener('change', () => {
      nimPrefix.textContent = `${inputAngkatan.value}0140`;
    });

    // Step Switcher Helper
    function setStep(stepNumber) {
      [pane1, pane2, pane3].forEach(p => p.classList.add('hidden'));

      // Reset nav classes
      const allNavs = [stepNav1, stepNav2, stepNav3];
      allNavs.forEach((nav, idx) => {
        if (idx + 1 === stepNumber) {
          nav.className = 'step-nav-item flex items-center gap-3 rounded-xl border border-brand-blue bg-brand-blue p-4 text-white shadow-sm transition-all';
          nav.children[0].className = 'flex h-8 w-8 items-center justify-center rounded-lg bg-white/20 font-mono text-sm font-bold text-white';
          nav.children[1].children[0].className = 'text-xs font-bold leading-tight text-white';
          nav.children[1].children[1].className = 'text-[11px] text-white/80 mt-0.5';
        } else if (idx + 1 < stepNumber) {
          nav.className = 'step-nav-item flex items-center gap-3 rounded-xl border border-emerald-300 bg-emerald-50 p-4 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200 transition-all';
          nav.children[0].className = 'flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-200 font-mono text-sm font-bold text-emerald-800 dark:bg-emerald-800 dark:text-emerald-100';
          nav.children[1].children[0].className = 'text-xs font-semibold leading-tight text-emerald-900 dark:text-emerald-200';
          nav.children[1].children[1].className = 'text-[11px] text-emerald-700 dark:text-emerald-400 mt-0.5';
        } else {
          nav.className = 'step-nav-item flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-4 text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 transition-all';
          nav.children[0].className = 'flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-100 font-mono text-sm font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400';
          nav.children[1].children[0].className = 'text-xs font-semibold text-zinc-900 dark:text-zinc-200 leading-tight';
          nav.children[1].children[1].className = 'text-[11px] text-zinc-500 mt-0.5';
        }
      });

      if (stepNumber === 1) pane1.classList.remove('hidden');
      if (stepNumber === 2) pane2.classList.remove('hidden');
      if (stepNumber === 3) pane3.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Live SKS Counter
    function recalculateSks() {
      let total = 0;
      matkulCheckboxes.forEach(cb => {
        if (cb.checked) {
          total += parseInt(cb.getAttribute('data-sks') || '0', 10);
        }
      });

      currentSksCountEl.textContent = total;
      const pct = Math.min(100, Math.round((total / 24) * 100));
      sksProgressBar.style.width = `${pct}%`;

      if (total > 24) {
        currentSksCountEl.classList.add('text-rose-600');
        JadwalinUI.toast.show('Peringatan: Beban SKS melebihi batas 24 SKS!', 'warning');
      } else {
        currentSksCountEl.classList.remove('text-rose-600');
      }
      return total;
    }

    matkulCheckboxes.forEach(cb => {
      cb.addEventListener('change', recalculateSks);
    });

    btnSelectAll.addEventListener('click', () => {
      matkulCheckboxes.forEach(cb => cb.checked = true);
      recalculateSks();
    });

    btnUnselectAll.addEventListener('click', () => {
      matkulCheckboxes.forEach(cb => cb.checked = false);
      recalculateSks();
    });

    // Step 1 -> Step 2
    btnToStep2.addEventListener('click', () => {
      if (!inputNama.value.trim()) {
        JadwalinUI.toast.show('Harap isi nama lengkap mahasiswa.', 'error');
        return;
      }
      setStep(2);
    });

    btnBackTo1.addEventListener('click', () => setStep(1));
    btnBackTo2.addEventListener('click', () => setStep(2));

    // Calculate Pra-KRS (Step 2 -> Step 3)
    async function fetchRekomendasi() {
      const selectedCodes = [];
      matkulCheckboxes.forEach(cb => {
        if (cb.checked) selectedCodes.push(cb.getAttribute('data-kode'));
      });

      if (selectedCodes.length === 0) {
        JadwalinUI.toast.show('Pilih minimal satu mata kuliah terlebih dahulu.', 'error');
        return;
      }

      const payload = {
        semester: parseInt(inputSemester.value, 10),
        angkatan: parseInt(inputAngkatan.value, 10),
        nama: inputNama.value.trim(),
        nimSuffix: inputNimSuffix.value.trim().padStart(3, '0'),
        kodeMatkulList: selectedCodes,
        prefKelas: inputPrefKelas.value,
        prefHari: 'Semua',
        prefWaktu: inputPrefWaktu.value,
        variasiIndex: currentVariasiIndex
      };

      try {
        const res = await JadwalinUI.apiFetch('/api/jadwal/prakrs', {
          method: 'POST',
          body: JSON.stringify(payload)
        });

        if (res && res.sukses) {
          const sesiList = res.rekomendasiSesi || res.jadwalTerpilih || [];
          renderResultSchedule(sesiList);
          const totalSks = sesiList.reduce((sum, s) => sum + (s.sks || 0), 0);
          resultSksLabel.textContent = `${totalSks} SKS · ${sesiList.length} Mata Kuliah`;
          setStep(3);
          JadwalinUI.toast.show('Paket jadwal bebas bentrok berhasil disusun!', 'success');
        }
      } catch (err) {
        // Fallback local visual jika fetch terhambat
        setStep(3);
      }
    }

    function renderResultSchedule(list) {
      resultScheduleBody.innerHTML = '';
      if (!list || list.length === 0) {
        resultScheduleBody.innerHTML = `
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-zinc-500">
              Tidak ada data jadwal yang cocok.
            </td>
          </tr>
        `;
        return;
      }

      list.forEach(item => {
        const isLab = (item.ruang && item.ruang.toLowerCase().includes('lab')) || 
                      (item.jenis && item.jenis.toLowerCase().includes('praktikum'));
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-zinc-50 dark:hover:bg-zinc-800/40 transition-colors';
        tr.innerHTML = `
          <td class="px-4 py-3 font-semibold text-zinc-800 dark:text-zinc-200">
            ${item.hari}, ${item.jamMulai}–${item.jamSelesai}
          </td>
          <td class="px-4 py-3 font-medium text-zinc-900 dark:text-zinc-100">
            <div>${item.mataKuliah}</div>
            <div class="text-[11px] text-zinc-400">${item.kodeMatkul}</div>
          </td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold ${isLab ? 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300' : 'bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200'}">
              ${isLab ? '<i class="ph ph-flask"></i>' : ''}
              ${item.ruang}
            </span>
          </td>
          <td class="px-4 py-3 font-mono font-semibold text-zinc-700 dark:text-zinc-300">
            Kelas ${item.kelas} · ${item.sks} SKS
          </td>
          <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400">
            ${item.dosen}
          </td>
        `;
        resultScheduleBody.appendChild(tr);
      });
    }

    btnCalculate.addEventListener('click', () => {
      currentVariasiIndex = 0;
      fetchRekomendasi();
    });

    btnMintaVariasi.addEventListener('click', () => {
      currentVariasiIndex += 1;
      fetchRekomendasi();
      JadwalinUI.toast.show(`Menghitung variasi paket alternatif #${currentVariasiIndex + 1}`, 'info');
    });

    btnSimpan.addEventListener('click', () => {
      JadwalinUI.toast.show('Rencana jadwal berhasil disimpan ke profil Anda!', 'success');
      setTimeout(() => {
        window.location.href = '/mahasiswa/jadwal';
      }, 1200);
    });

    // Initial check
    recalculateSks();
  });
</script>
