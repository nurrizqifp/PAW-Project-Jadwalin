<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Nav elements
    const stepNav1 = document.getElementById('step-nav-1');
    const stepNav2 = document.getElementById('step-nav-2');
    const stepNav3 = document.getElementById('step-nav-3');

    // Panes
    const pane1 = document.getElementById('wizard-step-1');
    const pane2 = document.getElementById('wizard-step-2');
    const pane3 = document.getElementById('wizard-step-3');

    // Buttons
    const btnToStep2 = document.getElementById('btn-to-step-2');
    const btnBackTo1 = document.getElementById('btn-back-to-1');
    const btnCalculate = document.getElementById('btn-calculate-prakrs');
    const btnBackTo2 = document.getElementById('btn-back-to-2');
    const btnMintaVariasi = document.getElementById('btn-minta-variasi');
    const btnSimpan = document.getElementById('btn-simpan-prakrs');
    const btnSelectAll = document.getElementById('btn-select-all');
    const btnUnselectAll = document.getElementById('btn-unselect-all');

    // Form inputs
    const inputAngkatan = document.getElementById('input-angkatan');
    const nimPrefix = document.getElementById('nim-prefix');
    const inputNimSuffix = document.getElementById('input-nim-suffix');
    const inputNama = document.getElementById('input-nama');
    const inputSemester = document.getElementById('input-semester');
    const inputPrefKelas = document.getElementById('input-pref-kelas');
    const inputPrefPeminatan = document.getElementById('input-pref-peminatan');
    const inputPrefWaktu = document.getElementById('input-pref-waktu');

    // Dataset Kurikulum & Peminatan Resmi dari PostgreSQL (Semester 1-8)
    const KURIKULUM_DB = <%- JSON.stringify(typeof kurikulumList !== 'undefined' ? kurikulumList : []) %>;
    const PEMINATAN_DB = <%- JSON.stringify(typeof peminatanList !== 'undefined' ? peminatanList : []) %>;

    const matkulListContainer = document.getElementById('matkul-list-container');
    const periodHeading = document.getElementById('matkul-period-heading');
    const periodSubtitle = document.getElementById('matkul-period-subtitle');
    const currentSksCountEl = document.getElementById('current-sks-count');
    const sksProgressBar = document.getElementById('sks-progress-bar');
    const resultScheduleBody = document.getElementById('result-schedule-body');
    const resultSksLabel = document.getElementById('result-sks-label');

    let currentVariasiIndex = 0;

    function getMatkulCheckboxes() {
      return matkulListContainer.querySelectorAll('.matkul-checkbox');
    }

    function renderMatkulGrid() {
      const targetSmt = parseInt(inputSemester.value, 10) || 1;
      const isGanjil = targetSmt % 2 === 1;
      const periodeLabel = isGanjil ? 'Ganjil' : 'Genap';
      const selectedPem = (inputPrefPeminatan.value || 'SE').toUpperCase();

      if (periodHeading) {
        periodHeading.textContent = `Daftar Mata Kuliah Periode ${periodeLabel} (Semester ${isGanjil ? '1, 3, 5, 7' : '2, 4, 6, 8'})`;
      }
      if (periodSubtitle) {
        periodSubtitle.textContent = `Hanya mata kuliah penawaran ${periodeLabel} yang ditampilkan. Paket Semester ${targetSmt} dicentang otomatis.`;
      }

      // Filter kurikulum hanya sesuai paritas (Ganjil: 1,3,5,7 | Genap: 2,4,6,8), urut dari semester awal -> akhir
      const filteredKurikulum = KURIKULUM_DB
        .filter(mk => (Number(mk.semester) % 2 === 1) === isGanjil)
        .filter(mk => !String(mk.nama || '').toLowerCase().startsWith('mk pilihan'))
        .sort((a, b) => Number(a.semester) - Number(b.semester) || String(a.kode).localeCompare(String(b.kode)));

      const grouped = new Map();
      filteredKurikulum.forEach(mk => {
        const s = Number(mk.semester);
        if (!grouped.has(s)) grouped.set(s, []);
        grouped.get(s).push({ ...mk, isPeminatan: false });
      });

      // Tambahkan mata kuliah pilihan peminatan sesuai periode Ganjil/Genap langsung ke semester berjalan agar berada di atas
      const filteredPem = PEMINATAN_DB.filter(p =>
        String(p.kodePeminatan || '').toUpperCase() === selectedPem &&
        String(p.semesterPenawaran || 'Ganjil').toLowerCase() === periodeLabel.toLowerCase()
      );
      if (filteredPem.length > 0) {
        if (!grouped.has(targetSmt)) grouped.set(targetSmt, []);
        filteredPem.forEach(p => {
          grouped.get(targetSmt).push({
            kode: p.kode,
            nama: p.nama,
            sks: p.sks,
            semester: targetSmt,
            kategori: `Pilihan Peminatan ${selectedPem}`,
            jenis: String(p.nama || '').toLowerCase().includes('praktikum') ? 'Praktikum' : 'Teori',
            isPeminatan: true
          });
        });
      }

      matkulListContainer.innerHTML = '';
      if (grouped.size === 0) {
        matkulListContainer.innerHTML = '<div class="rounded-xl border border-zinc-200 p-6 text-center text-zinc-500">Belum ada mata kuliah tersedia untuk periode ini.</div>';
        recalculateSks();
        return;
      }

      function buildSemesterSection(smt, items, isCurrentSmt) {
        const section = document.createElement('div');
        section.className = 'space-y-2.5';
        section.innerHTML = `
          <div class="flex items-center justify-between border-b border-zinc-100 pb-1.5 dark:border-zinc-800">
            <span class="font-heading font-bold text-xs ${isCurrentSmt ? 'text-[#0c2b5e] dark:text-amber-400' : 'text-zinc-700 dark:text-zinc-300'}">
              Semester ${smt} (${periodeLabel}) ${isCurrentSmt ? '· Paket Semester Berjalan & Pilihan Peminatan ' + selectedPem : ''}
            </span>
            <span class="font-mono text-[11px] text-zinc-400">${items.length} Mata Kuliah</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
        `;
        const gridEl = section.querySelector('div.grid');
        const defaultKelas = (inputPrefKelas && inputPrefKelas.value) ? inputPrefKelas.value : 'B';
        items.forEach((mk, idx) => {
          const checked = isCurrentSmt && (!mk.isPeminatan || idx === items.findIndex(x => x.isPeminatan));
          const isLab = String(mk.jenis || '').toLowerCase().includes('praktikum') || String(mk.nama || '').toLowerCase().includes('praktikum');
          const card = document.createElement('div');
          card.className = `matkul-card flex flex-col p-3.5 rounded-xl border ${mk.isPeminatan ? 'border-amber-200 bg-amber-50/30 hover:bg-amber-50/60 dark:border-amber-900/40 dark:bg-amber-950/20' : 'border-zinc-200 bg-zinc-50/50 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-800/40'} transition-all gap-2.5`;
          card.innerHTML = `
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" ${checked ? 'checked' : ''} data-kode="${mk.kode}" data-sks="${mk.sks}" data-semester="${smt}" class="matkul-checkbox mt-1 h-4 w-4 rounded border-zinc-300 text-brand-blue focus:ring-brand-blue">
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-heading font-bold text-sm text-zinc-900 dark:text-zinc-100 truncate">${mk.nama}</span>
                  <span class="font-mono font-bold text-xs text-brand-blue dark:text-amber-400 shrink-0">${mk.sks} SKS</span>
                </div>
                <p class="text-zinc-500 text-[11px] mt-0.5">${mk.kode} · ${mk.kategori || 'Wajib Prodi'} · ${isLab ? 'Praktikum (Lab)' : 'Teori'}</p>
              </div>
            </label>
            <div class="flex items-center justify-between pt-2 border-t border-zinc-200/60 dark:border-zinc-700/60 text-[11px]">
              <span class="text-zinc-500 font-medium">Pilihan Kelas:</span>
              <select data-matkul-kode="${mk.kode}" class="matkul-kelas-select rounded border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-2 py-0.5 text-xs font-bold text-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-1 focus:ring-amber-500">
                <option value="A" ${defaultKelas === 'A' ? 'selected' : ''}>Kelas A</option>
                <option value="B" ${defaultKelas === 'B' ? 'selected' : ''}>Kelas B</option>
                <option value="C" ${defaultKelas === 'C' ? 'selected' : ''}>Kelas C</option>
                <option value="D" ${defaultKelas === 'D' ? 'selected' : ''}>Kelas D</option>
              </select>
            </div>
          `;
          gridEl.appendChild(card);
        });
        return section;
      }

      // Render Semester Aktif di paling atas (tanpa perlu scroll)
      if (grouped.has(targetSmt)) {
        matkulListContainer.appendChild(buildSemesterSection(targetSmt, grouped.get(targetSmt), true));
      }

      // Semester lainnya dimasukkan ke dalam accordion ringkas
      const otherSemesters = Array.from(grouped.keys()).filter(s => s !== targetSmt).sort((a, b) => a - b);
      if (otherSemesters.length > 0) {
        const detailsEl = document.createElement('details');
        detailsEl.className = 'rounded-xl border border-zinc-200 bg-zinc-50/50 p-3.5 dark:border-zinc-800 dark:bg-zinc-800/30';
        detailsEl.innerHTML = `
          <summary class="cursor-pointer font-heading text-xs font-semibold text-zinc-700 dark:text-zinc-300 flex items-center justify-between">
            <span>Ambil Mata Kuliah Lintas Semester (Semester ${otherSemesters.join(', ')})</span>
            <span class="font-mono text-[11px] text-[#0c2b5e] dark:text-amber-400 underline">Buka Daftar</span>
          </summary>
          <div class="mt-4 space-y-5 pt-3 border-t border-zinc-200/80 dark:border-zinc-800" id="other-semesters-box"></div>
        `;
        const otherBox = detailsEl.querySelector('#other-semesters-box');
        otherSemesters.forEach(smt => {
          otherBox.appendChild(buildSemesterSection(smt, grouped.get(smt), false));
        });
        matkulListContainer.appendChild(detailsEl);
      }

      recalculateSks();
    }

    // NIM Builder Sync
    inputAngkatan.addEventListener('change', () => {
      nimPrefix.textContent = `${inputAngkatan.value}0140`;
    });

    // Default Rombel Class Sync ke setiap mata kuliah
    inputPrefKelas.addEventListener('change', () => {
      const newKls = inputPrefKelas.value;
      document.querySelectorAll('.matkul-kelas-select').forEach(sel => {
        sel.value = newKls;
      });
    });

    // Step Switcher Helper
    function setStep(stepNumber) {
      [pane1, pane2, pane3].forEach(p => p.classList.add('hidden'));

      // Reset nav classes
      const allNavs = [stepNav1, stepNav2, stepNav3];
      allNavs.forEach((nav, idx) => {
        if (idx + 1 === stepNumber) {
          nav.className = 'step-nav-item cursor-pointer flex items-center gap-3 rounded-xl border border-brand-blue bg-brand-blue p-3.5 text-white shadow-sm transition-all';
          nav.children[0].className = 'flex h-8 w-8 items-center justify-center rounded-lg bg-white/20 font-mono text-sm font-bold text-white';
          nav.children[1].children[0].className = 'text-xs font-bold leading-tight text-white';
          nav.children[1].children[1].className = 'text-[11px] text-white/80 mt-0.5';
        } else if (idx + 1 < stepNumber) {
          nav.className = 'step-nav-item cursor-pointer flex items-center gap-3 rounded-xl border border-emerald-300 bg-emerald-50 p-3.5 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200 transition-all';
          nav.children[0].className = 'flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-200 font-mono text-sm font-bold text-emerald-800 dark:bg-emerald-800 dark:text-emerald-100';
          nav.children[1].children[0].className = 'text-xs font-semibold leading-tight text-emerald-900 dark:text-emerald-200';
          nav.children[1].children[1].className = 'text-[11px] text-emerald-700 dark:text-emerald-400 mt-0.5';
        } else {
          nav.className = 'step-nav-item cursor-pointer flex items-center gap-3 rounded-xl border border-zinc-200 bg-white p-3.5 text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 transition-all';
          nav.children[0].className = 'flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-100 font-mono text-sm font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400';
          nav.children[1].children[0].className = 'text-xs font-semibold text-zinc-900 dark:text-zinc-200 leading-tight';
          nav.children[1].children[1].className = 'text-[11px] text-zinc-500 mt-0.5';
        }
      });

      if (stepNumber === 1) pane1.classList.remove('hidden');
      if (stepNumber === 2) pane2.classList.remove('hidden');
      if (stepNumber === 3) pane3.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Live SKS Counter
    function recalculateSks() {
      let total = 0;
      getMatkulCheckboxes().forEach(cb => {
        if (cb.checked) {
          total += parseInt(cb.getAttribute('data-sks') || '0', 10);
        }
      });

      currentSksCountEl.textContent = total;
      const pct = Math.min(100, Math.round((total / 24) * 100));
      sksProgressBar.style.width = `${pct}%`;

      if (total > 24) {
        currentSksCountEl.classList.add('text-rose-600');
        JadwalinUI.toast.show('Peringatan: Beban SKS melebihi batas 24 SKS!', 'warning');
      } else {
        currentSksCountEl.classList.remove('text-rose-600');
      }
      return total;
    }

    matkulListContainer.addEventListener('change', (e) => {
      if (e.target.classList.contains('matkul-checkbox')) {
        recalculateSks();
      }
    });

    inputSemester.addEventListener('change', renderMatkulGrid);
    inputPrefPeminatan.addEventListener('change', renderMatkulGrid);
    renderMatkulGrid();

    btnSelectAll.addEventListener('click', () => {
      const targetSmt = String(inputSemester.value);
      getMatkulCheckboxes().forEach(cb => {
        cb.checked = cb.getAttribute('data-semester') === targetSmt;
      });
      recalculateSks();
    });

    btnUnselectAll.addEventListener('click', () => {
      getMatkulCheckboxes().forEach(cb => cb.checked = false);
      recalculateSks();
    });

    // Step 1 -> Step 2
    btnToStep2.addEventListener('click', () => {
      if (!inputNama.value.trim()) {
        JadwalinUI.toast.show('Harap isi nama lengkap mahasiswa.', 'error');
        return;
      }
      renderMatkulGrid();
      setStep(2);
    });

    btnBackTo1.addEventListener('click', () => setStep(1));
    btnBackTo2.addEventListener('click', () => setStep(2));

    // Calculate Pra-KRS (Step 2 -> Step 3)
    async function fetchRekomendasi() {
      const selectedCodes = [];
      getMatkulCheckboxes().forEach(cb => {
        if (cb.checked) selectedCodes.push(cb.getAttribute('data-kode'));
      });

      if (selectedCodes.length === 0) {
        JadwalinUI.toast.show('Pilih minimal satu mata kuliah terlebih dahulu.', 'error');
        return;
      }

      const kelasPerMatkul = {};
      document.querySelectorAll('.matkul-kelas-select').forEach(sel => {
        const k = sel.getAttribute('data-matkul-kode');
        if (k) kelasPerMatkul[k] = sel.value;
      });

      const payload = {
        semester: parseInt(inputSemester.value, 10),
        angkatan: parseInt(inputAngkatan.value, 10),
        nama: inputNama.value.trim(),
        nimSuffix: inputNimSuffix.value.trim().padStart(3, '0'),
        kodeMatkulList: selectedCodes,
        prefKelas: inputPrefKelas.value,
        prefHari: 'Semua',
        prefWaktu: inputPrefWaktu.value,
        variasiIndex: currentVariasiIndex,
        kelasPerMatkul
      };

      try {
        const res = await JadwalinUI.apiFetch('/api/jadwal/prakrs', {
          method: 'POST',
          body: JSON.stringify(payload)
        });

        if (res && res.sukses) {
          const sesiList = res.rekomendasiSesi || res.jadwalTerpilih || [];
          renderResultSchedule(sesiList);
          const totalSks = sesiList.reduce((sum, s) => sum + (s.sks || 0), 0);
          resultSksLabel.textContent = `${totalSks} SKS · ${sesiList.length} Mata Kuliah`;
          setStep(3);
          JadwalinUI.toast.show('Paket jadwal bebas bentrok berhasil disusun!', 'success');
        }
      } catch (err) {
        // Fallback local visual jika fetch terhambat
        setStep(3);
      }
    }

    function renderResultSchedule(list) {
      resultScheduleBody.innerHTML = '';
      if (!list || list.length === 0) {
        resultScheduleBody.innerHTML = `
          <tr>
            <td colspan="5" class="px-4 py-6 text-center text-zinc-500">
              Tidak ada data jadwal yang cocok.
            </td>
          </tr>
        `;
        return;
      }

      list.forEach(item => {
        const isLab = (item.ruang && item.ruang.toLowerCase().includes('lab')) || 
                      (item.jenis && item.jenis.toLowerCase().includes('praktikum'));
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-zinc-50 dark:hover:bg-zinc-800/40 transition-colors';
        tr.innerHTML = `
          <td class="px-4 py-3 font-semibold text-zinc-800 dark:text-zinc-200">
            ${item.hari}, ${item.jamMulai}–${item.jamSelesai}
          </td>
          <td class="px-4 py-3 font-medium text-zinc-900 dark:text-zinc-100">
            <div>${item.mataKuliah}</div>
            <div class="text-[11px] text-zinc-400">${item.kodeMatkul}</div>
          </td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold ${isLab ? 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300' : 'bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200'}">
              ${isLab ? '<i class="ph ph-flask"></i>' : ''}
              ${item.ruang}
            </span>
          </td>
          <td class="px-4 py-3 font-mono font-semibold text-zinc-700 dark:text-zinc-300">
            Kelas ${item.kelas} · ${item.sks} SKS
          </td>
          <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400">
            ${item.dosen}
          </td>
        `;
        resultScheduleBody.appendChild(tr);
      });
    }

    btnCalculate.addEventListener('click', () => {
      currentVariasiIndex = 0;
      fetchRekomendasi();
    });

    const btnTopCalculate = document.getElementById('btn-top-calculate-prakrs');
    if (btnTopCalculate) {
      btnTopCalculate.addEventListener('click', () => btnCalculate.click());
    }

    if (stepNav1) stepNav1.addEventListener('click', () => setStep(1));
    if (stepNav2) stepNav2.addEventListener('click', () => btnToStep2.click());
    if (stepNav3) stepNav3.addEventListener('click', () => btnCalculate.click());

    btnMintaVariasi.addEventListener('click', () => {
      currentVariasiIndex += 1;
      fetchRekomendasi();
      JadwalinUI.toast.show(`Menghitung variasi paket alternatif #${currentVariasiIndex + 1}`, 'info');
    });

    btnSimpan.addEventListener('click', async () => {
      const selectedCodes = [];
      getMatkulCheckboxes().forEach(cb => {
        if (cb.checked) selectedCodes.push(cb.getAttribute('data-kode'));
      });
      if (selectedCodes.length === 0) {
        JadwalinUI.toast.show('Pilih minimal satu mata kuliah sebelum menyimpan.', 'error');
        return;
      }

      const kelasPerMatkul = {};
      document.querySelectorAll('.matkul-kelas-select').forEach(sel => {
        const k = sel.getAttribute('data-matkul-kode');
        if (k) kelasPerMatkul[k] = sel.value;
      });

      btnSimpan.disabled = true;
      try {
        const res = await JadwalinUI.apiFetch('/api/jadwal/prakrs/simpan', {
          method: 'POST',
          body: JSON.stringify({
            semester: parseInt(inputSemester.value, 10),
            kodePeminatan: inputPrefPeminatan.value,
            prefKelas: inputPrefKelas.value,
            prefWaktu: inputPrefWaktu.value,
            kodeMatkulList: selectedCodes,
            variasiIndex: currentVariasiIndex,
            kelasPerMatkul
          })
        });
        if (!res || !res.sukses) {
          throw new Error(res?.pesan || 'Gagal menyimpan Pra-KRS.');
        }
        JadwalinUI.toast.show(res.pesan || 'Rencana Pra-KRS berhasil disimpan!', 'success');
        setTimeout(() => {
          window.location.href = '/mahasiswa/dashboard';
        }, 900);
      } catch (err) {
        JadwalinUI.toast.show(err.message || 'Gagal menyimpan Pra-KRS.', 'error');
        btnSimpan.disabled = false;
      }
    });

    // Initial check
    recalculateSks();
  });
</script>

<script>
// --- INTEGRASI FITUR AI ASSISTANT (Resya x Yuum) ---
  const chatToggle = document.getElementById('ai-chat-toggle');
  const chatWindow = document.getElementById('ai-chat-window');
  const chatClose = document.getElementById('ai-chat-close');
  const chatInput = document.getElementById('chat-input');
  const chatSend = document.getElementById('chat-send');
  const chatMessages = document.getElementById('chat-messages');

  if (chatToggle && chatWindow) {
    chatToggle.addEventListener('click', () => {
      chatWindow.classList.toggle('hidden');
      if (!chatWindow.classList.contains('hidden')) {
        chatInput.focus();
      }
    });

    if (chatClose) {
      chatClose.addEventListener('click', () => chatWindow.classList.add('hidden'));
    }

    async function sendChat() {
      const msg = chatInput.value.trim();
      if (msg.length < 2 || msg.length > 400) {
        JadwalinUI.toast.show('Pertanyaan harus antara 2 hingga 400 karakter.', 'warning');
        return;
      }

      // Render bubble user secara aman (anti-XSS textContent)
      const userBubble = document.createElement('div');
      userBubble.className = 'flex gap-2.5 justify-end';
      const userTextDiv = document.createElement('div');
      userTextDiv.className = 'bg-[#0c2b5e] text-white rounded-2xl rounded-tr-sm p-3 max-w-[85%] shadow-xs';
      userTextDiv.textContent = msg;
      userBubble.appendChild(userTextDiv);
      chatMessages.appendChild(userBubble);
      chatInput.value = '';
      chatMessages.scrollTop = chatMessages.scrollHeight;

      // Loading bubble
      const loadingEl = document.createElement('div');
      loadingEl.className = 'flex gap-2.5';
      loadingEl.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-blue-100 text-[#0c2b5e] dark:bg-blue-950 dark:text-blue-300 flex items-center justify-center shrink-0 border border-blue-200 dark:border-blue-900">
          <i class="ph ph-robot text-sm"></i>
        </div>
        <div class="bg-zinc-100 dark:bg-zinc-800 rounded-2xl rounded-tl-sm p-3 text-zinc-500 border border-zinc-200/60 dark:border-zinc-700/60 flex items-center gap-2">
          <i class="ph ph-spinner animate-spin text-sm text-[#0c2b5e] dark:text-amber-400"></i>
          <span>Memproses pertanyaan Anda...</span>
        </div>
      `;
      chatMessages.appendChild(loadingEl);
      chatMessages.scrollTop = chatMessages.scrollHeight;

      function formatChatMarkdown(raw) {
        const escaped = String(raw || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
        return escaped
          .replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold text-zinc-950 dark:text-white">$1</strong>')
          .replace(/\*([^*\n]+)\*/g, '<em class="italic">$1</em>')
          .replace(/`([^`\n]+)`/g, '<code class="px-1 py-0.5 rounded bg-zinc-200/80 dark:bg-zinc-700 font-mono text-[11px]">$1</code>')
          .replace(/^[ \t]*[\*\-]\s+/gm, '• ');
      }

      const checkedMatkuls = Array.from(document.querySelectorAll('.matkul-checkbox:checked'))
        .map(cb => cb.getAttribute('data-kode'))
        .filter(Boolean);
      const contextPayload = {
        nama: document.getElementById('input-nama')?.value?.trim() || '',
        nim: `${document.getElementById('nim-prefix')?.textContent?.trim() || ''}${document.getElementById('input-nim-suffix')?.value?.trim() || ''}`,
        angkatan: Number(document.getElementById('input-angkatan')?.value || 2024),
        semester: Number(document.getElementById('input-semester')?.value || 5),
        peminatan: (document.getElementById('input-pref-peminatan')?.value || 'SE').toUpperCase(),
        prefKelas: document.getElementById('input-pref-kelas')?.value || 'B',
        prefWaktu: document.getElementById('input-pref-waktu')?.value || 'Semua',
        matkulDipilih: checkedMatkuls
      };

      let reply = '';
      let isError = false;
      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg, context: contextPayload })
        });
        const result = await response.json();
        loadingEl.remove();

        if (response.ok && result && result.sukses && result.connected && result.data && result.data.reply) {
          reply = result.data.reply;
        } else {
          isError = true;
          reply = result?.pesan || `Tidak dapat terhubung ke layanan AI (HTTP ${response.status}).`;
        }
      } catch (err) {
        loadingEl.remove();
        isError = true;
        reply = 'Tidak dapat terhubung ke layanan AI: server tidak merespons atau koneksi jaringan terputus.';
      }

      const replyBubble = document.createElement('div');
      replyBubble.className = 'flex gap-2.5';
      const iconBox = document.createElement('div');
      iconBox.className = `w-7 h-7 rounded-full flex items-center justify-center shrink-0 border ${isError ? 'bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950 dark:text-amber-300 dark:border-amber-800' : 'bg-blue-100 text-[#0c2b5e] border-blue-200 dark:bg-blue-950 dark:text-blue-300 dark:border-blue-900'}`;
      iconBox.innerHTML = `<i class="ph ${isError ? 'ph-warning-circle' : 'ph-robot'} text-sm"></i>`;

      const textBox = document.createElement('div');
      textBox.className = `rounded-2xl rounded-tl-sm p-3 border max-w-[85%] whitespace-pre-wrap leading-relaxed ${isError ? 'bg-amber-50 text-amber-950 border-amber-200 dark:bg-amber-950/40 dark:text-amber-200 dark:border-amber-900/60' : 'bg-zinc-100 text-zinc-800 border-zinc-200/60 dark:bg-zinc-800 dark:text-zinc-200 dark:border-zinc-700/60'}`;
      textBox.innerHTML = formatChatMarkdown(reply);

      replyBubble.appendChild(iconBox);
      replyBubble.appendChild(textBox);
      chatMessages.appendChild(replyBubble);
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    if (chatSend) chatSend.addEventListener('click', sendChat);
    if (chatInput) {
      chatInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') sendChat();
      });
    }
  }
</script>
