    <!-- Raw Jadwal Data Script for Zero Reload Dynamic Filter -->
    <script id="raw-jadwal-data" type="application/json">
  <%- JSON.stringify(jadwal) %>
</script>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const rawDataEl = document.getElementById('raw-jadwal-data');
        let allJadwal = [];
        try {
          allJadwal = JSON.parse(rawDataEl.textContent || '[]');
        } catch (e) {
          allJadwal = [];
        }

        const filterHari = document.getElementById('filter-hari');
        const filterKelas = document.getElementById('filter-kelas');
        const filterTipeRuang = document.getElementById('filter-tipe-ruang');
        const filterPeminatan = document.getElementById('filter-peminatan');
        const filterCari = document.getElementById('filter-cari');
        const btnReset = document.getElementById('btn-reset-filter');
        const countLabel = document.getElementById('active-count-label');

        const viewGridBtn = document.getElementById('view-mode-grid');
        const viewAgendaBtn = document.getElementById('view-mode-agenda');
        const gridContainer = document.getElementById('view-grid-container');
        const agendaContainer = document.getElementById('view-agenda-container');

        const gridTableBody = document.getElementById('grid-table-body');
        const agendaCardsContainer = document.getElementById('agenda-cards-container');
        const agendaDayTabs = document.querySelectorAll('.agenda-tab');

        let currentSelectedAgendaDay = 'Senin';

        // Standard Grid Time Slots
        const timeSlots = [
          { start: '07:00', end: '08:40', label: '07:00 – 08:40' },
          { start: '08:50', end: '11:30', label: '08:50 – 11:30' },
          { isBreak: true, start: '11:30', end: '12:10', label: '11:30 – 12:10' },
          { start: '12:10', end: '14:40', label: '12:10 – 14:40' },
          { start: '14:45', end: '17:15', label: '14:45 – 17:15' }
        ];

        const days = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];

        // Helper: Filter Logic
        function getFilteredData() {
          const hVal = filterHari.value.trim().toLowerCase();
          const kVal = filterKelas.value.trim().toUpperCase();
          const tVal = filterTipeRuang.value.trim().toLowerCase();
          const pVal = filterPeminatan.value.trim().toUpperCase();
          const qVal = filterCari.value.trim().toLowerCase();

          return allJadwal.filter(item => {
            if (hVal && item.hari.toLowerCase() !== hVal) return false;

            if (kVal) {
              const list = item.kelasList || [item.kelas];
              if (!list.includes(kVal) && item.kelas !== kVal) return false;
            }

            if (tVal) {
              const isLab = (item.ruang && item.ruang.toLowerCase().includes('lab')) ||
                (item.tipeRuang && item.tipeRuang.toLowerCase().includes('lab')) ||
                (item.jenis && item.jenis.toLowerCase().includes('praktikum'));
              if (tVal === 'lab' && !isLab) return false;
              if (tVal === 'reguler' && isLab) return false;
            }

            if (pVal) {
              if (item.peminatanKode !== pVal) return false;
            }

            if (qVal) {
              const haystack = `${item.mataKuliah} ${item.kodeMatkul} ${item.dosen} ${item.ruang}`.toLowerCase();
              if (!haystack.includes(qVal)) return false;
            }

            return true;
          });
        }

        // Render Grid Mingguan
        function renderGrid(filtered) {
          gridTableBody.innerHTML = '';
          countLabel.textContent = `Menampilkan ${filtered.length} sesi terverifikasi`;

          timeSlots.forEach(slot => {
            const tr = document.createElement('tr');

            // Break Row (Sholat Dhuhur)
            if (slot.isBreak) {
              tr.className = 'bg-zinc-100/90 dark:bg-zinc-800/60 border-y border-zinc-200 dark:border-zinc-700/60';
              tr.innerHTML = `
            <td class="sticky left-0 border-r border-zinc-200 bg-zinc-100 px-3 py-2 text-center text-zinc-500 dark:border-zinc-800 dark:bg-zinc-800 font-semibold text-[11px]">
              ${slot.label}
            </td>
            <td colspan="6" class="px-4 py-2 text-center text-xs font-semibold text-zinc-600 dark:text-zinc-400">
              <span class="inline-flex items-center gap-1.5">
                <i class="ph ph-moon-stars text-amber-500"></i>
                <span>Jeda Ibadah Shalat Dhuhur & Istirahat</span>
              </span>
            </td>
          `;
              gridTableBody.appendChild(tr);
              return;
            }

            // Regular Time Slot Row
            tr.className = 'min-h-[110px] items-stretch';

            // Time Label Column
            const timeTd = document.createElement('td');
            timeTd.className = 'sticky left-0 border-r border-zinc-200 bg-zinc-50 px-3 py-2.5 text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 align-top text-center font-medium text-[11px]';
            timeTd.textContent = slot.label;
            tr.appendChild(timeTd);

            // Days Columns (Senin -> Sabtu)
            days.forEach(day => {
              const td = document.createElement('td');
              td.className = 'border-r border-zinc-200 p-1.5 dark:border-zinc-800 align-top hover:bg-zinc-50/50 dark:hover:bg-zinc-800/30 transition-colors';

              // Cari sesi yang cocok di hari & rentang jam ini
              const matches = filtered.filter(item => {
                if (item.hari !== day) return false;
                // Toleransi pencocokan jam mulai
                const jMulai = item.jamMulai;
                if (slot.start === '07:00' && jMulai < '08:45') return true;
                if (slot.start === '08:50' && jMulai >= '08:45' && jMulai < '11:30') return true;
                if (slot.start === '12:10' && jMulai >= '12:00' && jMulai < '14:40') return true;
                if (slot.start === '14:45' && jMulai >= '14:40') return true;
                return false;
              });

              if (matches.length === 0) {
                td.innerHTML = '<div class="h-20"></div>';
              } else {
                const container = document.createElement('div');
                container.className = 'space-y-1.5';

                matches.forEach(item => {
                  const isLab = (item.ruang && item.ruang.toLowerCase().includes('lab')) ||
                    (item.tipeRuang && item.tipeRuang.toLowerCase().includes('lab')) ||
                    (item.jenis && item.jenis.toLowerCase().includes('praktikum'));

                  const card = document.createElement('div');
                  card.className = isLab
                    ? 'cursor-pointer rounded-lg border border-amber-300 bg-amber-50/90 p-2 text-amber-950 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100 hover:border-amber-500 dark:hover:border-amber-500 shadow-sm transition-all'
                    : 'cursor-pointer rounded-lg border border-blue-200 bg-blue-50/90 p-2 text-blue-950 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-100 hover:border-brand-blue dark:hover:border-blue-500 shadow-sm transition-all';

                  card.innerHTML = `
                <div class="flex items-start justify-between gap-1">
                  <span class="font-heading font-bold text-xs leading-tight line-clamp-1">${item.mataKuliah}</span>
                  ${isLab ? '<i class="ph ph-flask text-amber-600 dark:text-amber-400 shrink-0 text-xs"></i>' : ''}
                </div>
                <div class="mt-1 flex items-center justify-between text-[10px] opacity-80">
                  <span class="font-semibold">${item.ruang}</span>
                  <span>Kls ${item.kelas} · ${item.sks} SKS</span>
                </div>
                <div class="mt-0.5 text-[10px] truncate opacity-75">
                  ${item.dosenInisial || item.dosen}
                </div>
              `;

                  card.addEventListener('click', () => openDetailModal(item));
                  container.appendChild(card);
                });

                td.appendChild(container);
              }

              tr.appendChild(td);
            });

            gridTableBody.appendChild(tr);
          });
        }

        // Render Agenda Harian
        function renderAgenda(filtered) {
          agendaCardsContainer.innerHTML = '';
          const dayFiltered = filtered.filter(item => item.hari === currentSelectedAgendaDay);

          if (dayFiltered.length === 0) {
            agendaCardsContainer.innerHTML = `
          <div class="rounded-xl border border-dashed border-zinc-200 bg-zinc-50 p-8 text-center dark:border-zinc-800 dark:bg-zinc-900/50">
            <i class="ph ph-calendar-blank text-3xl text-zinc-400 mb-2"></i>
            <p class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Tidak ada perkuliahan pada hari ${currentSelectedAgendaDay}</p>
            <p class="text-xs text-zinc-500 mt-1">Coba sesuaikan filter kelas atau pilih hari lain di atas.</p>
          </div>
        `;
            return;
          }

          // Sort by jam mulai
          dayFiltered.sort((a, b) => a.jamMulai.localeCompare(b.jamMulai));

          dayFiltered.forEach(item => {
            const isLab = (item.ruang && item.ruang.toLowerCase().includes('lab')) ||
              (item.tipeRuang && item.tipeRuang.toLowerCase().includes('lab')) ||
              (item.jenis && item.jenis.toLowerCase().includes('praktikum'));

            const card = document.createElement('div');
            card.className = 'cursor-pointer rounded-xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 hover:border-brand-blue dark:hover:border-amber-400 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4';

            card.innerHTML = `
          <div class="flex items-start gap-3">
            <div class="flex flex-col items-center justify-center rounded-lg ${isLab ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300' : 'bg-blue-100 text-blue-800 dark:bg-blue-950/60 dark:text-blue-300'} px-3 py-2 shrink-0">
              <span class="text-xs font-bold">${item.jamMulai}</span>
              <span class="text-[10px] opacity-75">${item.jamSelesai}</span>
            </div>
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-semibold ${isLab ? 'bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300' : 'bg-blue-100 text-blue-900 dark:bg-blue-950 dark:text-blue-300'}">
                  ${isLab ? 'Praktikum Lab' : 'Kuliah Teori'}
                </span>
                <span class="text-xs text-zinc-400">·</span>
                <span class="text-xs font-semibold text-zinc-600 dark:text-zinc-400">Kelas ${item.kelas}</span>
                <span class="text-xs text-zinc-400">·</span>
                <span class="text-xs text-zinc-600 dark:text-zinc-400">${item.sks} SKS</span>
              </div>
              <h4 class="font-heading text-base font-bold text-zinc-900 dark:text-zinc-50">${item.mataKuliah}</h4>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 flex items-center gap-1.5">
                <i class="ph ph-chalkboard-teacher text-sm text-zinc-400"></i>
                <span>${item.dosen}</span>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3 shrink-0 self-end sm:self-center">
            <div class="text-right">
              <p class="text-xs font-bold text-zinc-800 dark:text-zinc-200">${item.ruang}</p>
              <p class="text-[11px] text-zinc-500">Gedung ${item.gedung}</p>
            </div>
            <i class="ph ph-caret-right text-zinc-400 text-base"></i>
          </div>
        `;

            card.addEventListener('click', () => openDetailModal(item));
            agendaCardsContainer.appendChild(card);
          });
        }

        // Modal Detail Opener
        function openDetailModal(item) {
          const isLab = (item.ruang && item.ruang.toLowerCase().includes('lab')) ||
            (item.tipeRuang && item.tipeRuang.toLowerCase().includes('lab')) ||
            (item.jenis && item.jenis.toLowerCase().includes('praktikum'));

          const badgeJenis = document.getElementById('modal-badge-jenis');
          badgeJenis.textContent = isLab ? 'Praktikum Laboratorium' : 'Kuliah Teori';
          badgeJenis.className = isLab
            ? 'inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-100 text-amber-900 dark:bg-amber-950 dark:text-amber-300'
            : 'inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-100 text-blue-900 dark:bg-blue-950 dark:text-blue-300';

          document.getElementById('modal-matkul-nama').textContent = item.mataKuliah;
          document.getElementById('modal-matkul-kode').textContent = `${item.kodeMatkul} · ${item.sks} SKS`;
          document.getElementById('modal-waktu').textContent = `${item.hari}, ${item.jamMulai} – ${item.jamSelesai} WIB`;
          document.getElementById('modal-ruang').textContent = `${item.ruang} (${item.tipeRuang || 'Ruang Standar'})`;
          document.getElementById('modal-kelas').textContent = `Kelas ${item.kelas}`;
          document.getElementById('modal-sks').textContent = `${item.sks} SKS`;
          document.getElementById('modal-dosen').textContent = item.dosen;

          JadwalinUI.modal.open('modal-sesi-detail');
        }

        // Update Function
        function updateViews() {
          const filtered = getFilteredData();
          renderGrid(filtered);
          renderAgenda(filtered);
        }

        // Switch View Mode
        viewGridBtn.addEventListener('click', () => {
          gridContainer.classList.remove('hidden');
          agendaContainer.classList.add('hidden');
          viewGridBtn.className = 'inline-flex items-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-sm dark:bg-zinc-900 dark:text-zinc-100 transition-all';
          viewAgendaBtn.className = 'inline-flex items-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
        });

        viewAgendaBtn.addEventListener('click', () => {
          gridContainer.classList.add('hidden');
          agendaContainer.classList.remove('hidden');
          viewAgendaBtn.className = 'inline-flex items-center gap-1.5 rounded-md bg-white px-3.5 py-1.5 text-xs font-semibold text-zinc-900 shadow-sm dark:bg-zinc-900 dark:text-zinc-100 transition-all';
          viewGridBtn.className = 'inline-flex items-center gap-1.5 rounded-md px-3.5 py-1.5 text-xs font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all';
          renderAgenda(getFilteredData());
        });

        // Agenda Tab Switching
        agendaDayTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            agendaDayTabs.forEach(t => {
              t.className = 'agenda-tab inline-flex min-h-[38px] items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-4 py-2 text-xs font-medium text-zinc-700 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors';
            });
            tab.className = 'agenda-tab inline-flex min-h-[38px] items-center gap-1.5 rounded-lg bg-brand-blue px-4 py-2 text-xs font-semibold text-white shadow-sm dark:bg-amber-500 dark:text-zinc-900 transition-colors';
            currentSelectedAgendaDay = tab.getAttribute('data-day');
            renderAgenda(getFilteredData());
          });
        });

        // Filter Listeners
        [filterHari, filterKelas, filterTipeRuang, filterPeminatan].forEach(el => {
          el.addEventListener('change', updateViews);
        });
        filterCari.addEventListener('input', updateViews);

        btnReset.addEventListener('click', () => {
          filterHari.value = '';
          filterKelas.value = 'B';
          filterTipeRuang.value = '';
          filterPeminatan.value = '';
          filterCari.value = '';
          updateViews();
          JadwalinUI.toast.show('Filter berhasil direset ke setelan awal', 'info');
        });

        // Initial render
        updateViews();
      });
    </script>