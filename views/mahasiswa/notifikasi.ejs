<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Pusat Notifikasi — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'notifikasi', currentRole: 'mahasiswa' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-4xl mx-auto space-y-6">

        <div class="flex items-center justify-between border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2 text-xs text-zinc-500 mb-1">
              <a href="/mahasiswa/dashboard" class="hover:text-zinc-900 dark:hover:text-zinc-200">Portal Mahasiswa</a>
              <span>/</span>
              <span class="text-amber-600 dark:text-amber-400 font-semibold">Pusat Notifikasi</span>
            </div>
            <h1 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Pusat Notifikasi Jadwal
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
              Informasi real-time perubahan ruangan, dosen pengganti, atau pemindahan jadwal kuliah.
            </p>
          </div>
          <button type="button"
            onclick="window.toast ? window.toast.success('Semua notifikasi mahasiswa ditandai telah dibaca.') : null"
            class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 shadow-xs transition-colors">
            <i class="ph ph-check-double text-blue-900 dark:text-blue-400"></i>
            <span>Tandai Semua Dibaca</span>
          </button>
        </div>

        <div class="space-y-3">
          <!-- Notif Item 1 -->
          <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-950/60 dark:text-amber-400 border border-amber-200/60 dark:border-amber-800/60">
              <i class="ph ph-door text-xl"></i>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex items-center justify-between">
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Perubahan Ruangan Kuliah PBO (Kelas B)</p>
                <span class="font-mono text-[11px] text-zinc-400">10 menit lalu</span>
              </div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">
                Sesi kuliah hari ini dipindahkan dari Ruang F3-201 ke <strong>Lab Komputer Multimedia</strong> karena sesi praktikum langsung.
              </p>
            </div>
          </div>

          <!-- Notif Item 2 -->
          <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
              <i class="ph ph-calendar-check text-xl"></i>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex items-center justify-between">
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Jadwal Final Semester Ganjil Telah Dipublikasikan</p>
                <span class="font-mono text-[11px] text-zinc-400">1 hari lalu</span>
              </div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">
                Admin Akademik telah merilis jadwal kuliah resmi versi <%= typeof appVersion !== 'undefined' ? appVersion : 'v.21' %> yang telah diverifikasi bebas tabrakan oleh AI Solver.
              </p>
            </div>
          </div>
        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>
