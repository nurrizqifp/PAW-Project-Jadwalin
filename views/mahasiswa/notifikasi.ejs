<%- include('../partials/head', { judul: typeof judul !== 'undefined' ? judul : 'Pusat Notifikasi — Jadwalin' }) %>

<div class="flex-1 flex min-h-screen">
  <%- include('../partials/admin-sidebar', { activeMenu: 'notifikasi', currentRole: 'mahasiswa' }) %>

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <%- include('../partials/admin-navbar') %>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-zinc-50/50 dark:bg-zinc-950/50">
      <div class="max-w-4xl mx-auto space-y-6">

        <div class="flex items-center justify-between border-b border-zinc-200/80 pb-5 dark:border-zinc-800">
          <div>
            <div class="flex items-center gap-2 text-xs text-zinc-500 mb-1">
              <a href="/mahasiswa/dashboard" class="hover:text-zinc-900 dark:hover:text-zinc-200">Portal Mahasiswa</a>
              <span>/</span>
              <span class="text-amber-600 dark:text-amber-400 font-semibold">Pusat Notifikasi</span>
            </div>
            <h1 class="font-heading text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
              Pusat Notifikasi Jadwal
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
              Informasi real-time perubahan ruangan, dosen pengganti, atau pemindahan jadwal kuliah.
            </p>
          </div>
          <button type="button" id="btn-read-all-mhs"
            onclick="handleTandaiSemuaDibacaMahasiswa(this)"
            class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-xs font-semibold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 shadow-xs transition-colors">
            <i class="ph ph-check-double text-blue-900 dark:text-blue-400"></i>
            <span>Tandai Semua Dibaca</span>
          </button>
        </div>

        <div class="space-y-3">
          <% const prkNotif = (typeof prakrsAccess !== 'undefined' && prakrsAccess) ? prakrsAccess : { isOpen: true, deadline: '2026-12-31', reason: 'Pengisian Pra-KRS sedang dibuka.' }; %>
          <div class="rounded-xl border p-4 shadow-sm flex items-start gap-4 <%= prkNotif.isOpen ? 'border-emerald-200 bg-emerald-50/70 dark:border-emerald-900/60 dark:bg-emerald-950/30' : 'border-rose-200 bg-rose-50/70 dark:border-rose-900/60 dark:bg-rose-950/30' %>">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg <%= prkNotif.isOpen ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/60 dark:text-emerald-300' : 'bg-rose-100 text-rose-700 dark:bg-rose-900/60 dark:text-rose-300' %>">
              <i class="ph <%= prkNotif.isOpen ? 'ph-check-circle' : 'ph-lock-key' %> text-xl"></i>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex items-center justify-between gap-2">
                <p class="font-heading text-sm font-bold <%= prkNotif.isOpen ? 'text-emerald-950 dark:text-emerald-100' : 'text-rose-950 dark:text-rose-100' %>">
                  <%= prkNotif.isOpen ? 'Status Pra-KRS: Sedang Dibuka' : 'Status Pra-KRS: Telah Ditutup' %>
                </p>
                <span class="font-mono text-[11px] text-zinc-500 shrink-0">Batas: <%= prkNotif.deadline %></span>
              </div>
              <p class="text-xs <%= prkNotif.isOpen ? 'text-emerald-900/90 dark:text-emerald-200' : 'text-rose-900/90 dark:text-rose-200' %>"><%= prkNotif.reason %></p>
            </div>
          </div>

          <% const notifItems = (typeof notifikasiList !== 'undefined' && Array.isArray(notifikasiList)) ? notifikasiList : []; %>
          <% if (notifItems.length === 0) { %>
            <div class="rounded-xl border border-zinc-200 bg-white p-6 text-center text-xs text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900">
              Belum ada notifikasi perubahan jadwal saat ini.
            </div>
          <% } else { %>
            <% notifItems.forEach(function(item) { %>
              <div class="notif-item-mhs rounded-xl border <%= (item.isRead === false) ? 'border-amber-300 bg-amber-50/40 dark:border-amber-800/60 dark:bg-amber-950/20' : 'border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900' %> p-4 shadow-sm flex items-start gap-4 transition-colors">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg <%= (item.isRead === false) ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/60 dark:text-amber-300 border border-amber-200 dark:border-amber-800' : 'bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/60' %>">
                  <i class="ph <%= (item.isRead === false) ? 'ph-bell-ringing' : 'ph-calendar-check' %> text-xl"></i>
                </div>
                <div class="flex-1 space-y-1">
                  <div class="flex items-center justify-between gap-2">
                    <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100"><%= item.kodeMatkul %> — <%= item.mataKuliah %></p>
                    <span class="font-mono text-[11px] text-zinc-400 shrink-0"><%= item.waktu || 'Terbaru' %></span>
                  </div>
                  <p class="text-xs text-zinc-600 dark:text-zinc-400"><%= item.perubahan %></p>
                </div>
              </div>
            <% }); %>
          <% } %>

          <div class="rounded-xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60">
              <i class="ph ph-calendar-check text-xl"></i>
            </div>
            <div class="flex-1 space-y-1">
              <div class="flex items-center justify-between">
                <p class="font-heading text-sm font-bold text-zinc-900 dark:text-zinc-100">Jadwal Final Semester Ganjil Telah Dipublikasikan</p>
                <span class="font-mono text-[11px] text-zinc-400">Terverifikasi</span>
              </div>
              <p class="text-xs text-zinc-600 dark:text-zinc-400">
                Admin Akademik telah merilis jadwal kuliah resmi versi <%= typeof appVersion !== 'undefined' ? appVersion : 'v.21' %> yang telah diverifikasi bebas tabrakan oleh AI Solver.
              </p>
            </div>
          </div>
        </div>

      </div>
    </main>

    <%- include('../partials/admin-footer') %>
  </div>
</div>

<script>
  async function handleTandaiSemuaDibacaMahasiswa(btn) {
    if (btn) btn.disabled = true;
    try {
      const res = await fetch('/api/notifikasi/read-all', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();
      if (data.sukses) {
        if (window.JadwalinUI?.toast) {
          window.JadwalinUI.toast.show(data.pesan || 'Semua notifikasi ditandai dibaca.', 'success');
        }
        const badge = document.getElementById('admin-notif-badge');
        if (badge) badge.remove();
        document.querySelectorAll('.notif-item-mhs').forEach(el => {
          el.className = 'notif-item-mhs rounded-xl border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900 p-4 shadow-sm flex items-start gap-4 transition-colors';
        });
      }
    } catch (e) {
      console.error(e);
    } finally {
      if (btn) btn.disabled = false;
    }
  }
</script>
