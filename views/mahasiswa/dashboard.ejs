      <div class="rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-3">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs font-semibold text-zinc-500 dark:text-zinc-400">10:00 - 11:40</span>
          <span class="rounded bg-zinc-100 px-2 py-0.5 font-mono text-[10px] font-semibold text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">Kelas B</span>
