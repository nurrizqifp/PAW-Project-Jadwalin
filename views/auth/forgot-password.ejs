<%- include('../partials/head', { judul: 'Lupa Kata Sandi — Jadwalin TI UMY' }) %>

<div class="min-h-screen flex flex-col lg:flex-row bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-50">
  
  <!-- SISI KIRI: Branding & Informasi Institusi (Split View) -->
  <div class="hidden lg:flex lg:w-1/2 relative bg-[#0c2b5e] p-12 flex-col justify-between overflow-hidden text-white">
    <!-- Aurora ambient glow -->
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-blue-500/20 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 rounded-full bg-amber-400/20 blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <a href="/" class="flex items-center space-x-3 group">
        <img src="/logo.png" alt="Logo Jadwalin" class="h-10 w-auto object-contain">
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-tight text-white font-heading">Jadwalin</span>
          <span class="text-xs text-blue-200 font-mono">TI Fakultas Teknik UMY</span>
        </div>
      </a>
    </div>

    <div class="relative z-10 space-y-4 max-w-lg">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-mono font-semibold border border-amber-400/30">
        Pemulihan Akun Civitas
      </span>
      <h2 class="font-heading text-3xl font-extrabold tracking-tight leading-tight">
        Akses Kembali Akun Jadwalin Anda
      </h2>
      <p class="text-sm text-blue-100/90 leading-relaxed">
        Masukkan email resmi kampus yang terdaftar untuk menerima tautan pemulihan kata sandi atau kode verifikasi keamanan.
      </p>
    </div>

    <div class="relative z-10 text-xs text-blue-200/80 font-mono">
      Layanan TI UMY · Bantuan: helpdesk@ft.umy.ac.id
    </div>
  </div>

  <!-- SISI KANAN: Form Pemulihan Kata Sandi -->
  <div class="flex-1 flex items-center justify-center p-6 sm:p-12">
    <div class="w-full max-w-md space-y-6">

      <div class="space-y-2">
        <div class="flex items-center gap-3 lg:hidden mb-4">
          <img src="/logo.png" alt="Logo Jadwalin" class="h-10 w-auto">
          <span class="font-heading font-bold text-xl text-zinc-900 dark:text-zinc-50">Jadwalin</span>
        </div>
        <h1 class="font-heading text-2xl font-bold text-zinc-900 dark:text-zinc-50">
          Lupa Kata Sandi?
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          Ketikkan alamat email institusi (@ft.umy.ac.id / @mail.umy.ac.id) Anda di bawah ini.
        </p>
      </div>

      <!-- Success Notification Box (Hidden by default) -->
      <div id="recovery-success-box" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-900/60 dark:bg-emerald-950/40 text-xs text-emerald-800 dark:text-emerald-300 space-y-2">
        <div class="flex items-center gap-2 font-semibold">
          <i class="ph ph-check-circle text-base text-emerald-600 dark:text-emerald-400"></i>
          <span>Tautan Pemulihan Terkirim</span>
        </div>
        <p class="text-[11px] leading-relaxed">
          Instruksi pengaturan ulang kata sandi telah dikirimkan ke email institusi Anda. Silakan periksa kotak masuk atau folder spam.
        </p>
        <a href="/login" class="inline-flex items-center gap-1.5 font-bold text-emerald-900 dark:text-emerald-200 underline pt-1">
          <span>Kembali ke Halaman Masuk</span>
          <i class="ph ph-arrow-right"></i>
        </a>
      </div>

      <form id="recovery-form" onsubmit="handleRecoverySubmit(event)" class="space-y-4 text-xs">
        <div class="space-y-1.5">
          <label for="recovery-email" class="block font-semibold text-zinc-700 dark:text-zinc-300">
            Email Institusi Kampus (Maks. 50 Karakter)
          </label>
          <div class="relative">
            <i class="ph ph-envelope absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 text-base"></i>
            <input id="recovery-email" type="email" required minlength="10" maxlength="50" pattern="[A-Za-z0-9._%+\-]+@(ft\.umy\.ac\.id|mail\.umy\.ac\.id|umy\.ac\.id)" title="Wajib menggunakan email resmi kampus (@ft.umy.ac.id, @mail.umy.ac.id, atau @umy.ac.id)" placeholder="nama@ft.umy.ac.id atau nim@mail.umy.ac.id"
              class="w-full min-h-[42px] rounded-lg border border-zinc-200 bg-white pl-9 pr-3 py-2 text-zinc-900 focus:border-[#0c2b5e] focus:ring-1 focus:ring-[#0c2b5e] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:focus:border-amber-400 dark:focus:ring-amber-400 transition-colors">
          </div>
        </div>

        <div id="recovery-error-alert" role="alert" class="hidden rounded-lg border border-rose-200 bg-rose-50 px-3.5 py-2.5 text-xs text-rose-800 dark:border-rose-900/60 dark:bg-rose-950/40 dark:text-rose-200">
          <span id="recovery-error-text">Alamat email institusi tidak valid.</span>
        </div>

        <button type="submit"
          class="w-full inline-flex min-h-[42px] items-center justify-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
          <i class="ph ph-paper-plane-tilt text-base text-amber-400"></i>
          <span>Kirim Tautan Pemulihan</span>
        </button>
      </form>

      <script>
        async function handleRecoverySubmit(e) {
          e.preventDefault();
          const emailInput = document.getElementById('recovery-email');
          const errBox = document.getElementById('recovery-error-alert');
          const errText = document.getElementById('recovery-error-text');
          const email = (emailInput?.value || '').trim();
          if (errBox) errBox.classList.add('hidden');

          try {
            const res = await fetch('/api/auth/forgot-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email })
            });
            const data = await res.json();
            if (!res.ok || !data.sukses) {
              throw new Error(data.pesan || 'Email institusi tidak valid.');
            }
            document.getElementById('recovery-form').classList.add('hidden');
            document.getElementById('recovery-success-box').classList.remove('hidden');
            if (window.JadwalinUI && window.JadwalinUI.toast) {
              window.JadwalinUI.toast.show(data.pesan, 'success');
            }
          } catch (err) {
            if (errText) errText.textContent = err.message;
            if (errBox) errBox.classList.remove('hidden');
          }
        }
      </script>

      <div class="border-t border-zinc-100 pt-4 dark:border-zinc-800 text-center text-xs text-zinc-500 space-y-2">
        <p>
          Ingat kata sandi Anda?
          <a href="/login" class="text-[#0c2b5e] dark:text-amber-400 font-semibold hover:underline">
            Kembali ke Halaman Masuk
          </a>
        </p>
      </div>

    </div>
  </div>

</div>
