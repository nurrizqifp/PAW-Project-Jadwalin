<%- include('../partials/head', { judul: 'Masuk Sistem — Jadwalin TI UMY' }) %>

  <div class="min-h-screen flex items-center justify-center p-4 bg-zinc-50/50 dark:bg-zinc-950/50">
    <div
      class="w-full max-w-md rounded-2xl border border-blue-900/20 bg-white p-6 sm:p-8 shadow-xl dark:border-blue-900/30 dark:bg-zinc-900 space-y-6">

      <div class="space-y-2 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl">
          <img src="/logo.png" alt="Logo Jadwalin" class="h-14 w-14 object-contain">
        </div>
        <h1 class="font-heading text-2xl font-bold text-zinc-900 dark:text-zinc-50 pt-1">Masuk ke Jadwalin</h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">Sistem Penjadwalan Cerdas Prodi TI UMY</p>
      </div>

      <form action="/api/auth/login" method="POST" class="space-y-4">
        <div class="space-y-1.5">
          <label for="username" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Username / NIP /
            NIM</label>
          <input id="username" name="username" type="text" required placeholder="Contoh: rina.akademik / 20240140093"
            class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-900 focus:border-[#0c2b5e] focus:ring-1 focus:ring-[#0c2b5e] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:focus:border-amber-400 dark:focus:ring-amber-400 transition-colors">
        </div>

        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="password" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Kata Sandi</label>
            <a href="#"
              class="text-xs text-amber-600 hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300 font-medium">Lupa sandi?</a>
          </div>
          <div class="relative">
            <input id="password" name="password" type="password" required placeholder="••••••••"
              class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white pl-3 pr-10 py-2 text-sm text-zinc-900 focus:border-[#0c2b5e] focus:ring-1 focus:ring-[#0c2b5e] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:focus:border-amber-400 dark:focus:ring-amber-400 transition-colors">
            <button type="button" onclick="toggleAuthPasswordEye()"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 p-1">
              <i id="auth-eye-icon" class="ph ph-eye text-base"></i>
            </button>
          </div>
        </div>

        <script>
          function toggleAuthPasswordEye() {
            const passInput = document.getElementById('password');
            const eyeIcon = document.getElementById('auth-eye-icon');
            if (passInput && eyeIcon) {
              if (passInput.type === 'password') {
                passInput.type = 'text';
                eyeIcon.className = 'ph ph-eye-slash text-base text-zinc-700 dark:text-zinc-200';
              } else {
                passInput.type = 'password';
                eyeIcon.className = 'ph ph-eye text-base text-zinc-400';
              }
            }
          }
        </script>

        <button type="submit"
          class="w-full inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 text-xs font-semibold text-white shadow-md border border-blue-900/40 transition-colors">
          <i class="ph ph-sign-in text-base text-amber-400"></i>
          <span>Masuk Sekarang</span>
        </button>
      </form>

      <!-- Quick Role Login (Testing & Prototyping) with Brand Blue & Yellow Accents -->
      <div class="space-y-2.5 pt-2 border-t border-zinc-100 dark:border-zinc-800">
        <p class="text-[11px] font-mono uppercase tracking-wider text-zinc-400 text-center">
          Pilih Akun Demo / Uji Coba Role
        </p>
        <div class="grid grid-cols-3 gap-2">
          <a href="/mahasiswa/dashboard?status=success&msg=Masuk+sebagai+Mahasiswa+(Haidar)"
            class="flex flex-col items-center justify-center p-2.5 rounded-lg border border-blue-200 bg-blue-50/60 hover:bg-blue-100/80 dark:border-blue-900/50 dark:bg-blue-950/40 dark:hover:bg-blue-950/70 text-center transition-colors">
            <i class="ph ph-student text-lg text-[#0c2b5e] dark:text-blue-300"></i>
            <span class="text-[11px] font-semibold text-[#0c2b5e] dark:text-blue-200 mt-1">Mahasiswa</span>
          </a>
          <a href="/dosen/dashboard?status=success&msg=Masuk+sebagai+Dosen+(Dr.+Bambang)"
            class="flex flex-col items-center justify-center p-2.5 rounded-lg border border-amber-200 bg-amber-50/60 hover:bg-amber-100/80 dark:border-amber-900/50 dark:bg-amber-950/40 dark:hover:bg-amber-950/70 text-center transition-colors">
            <i class="ph ph-chalkboard-teacher text-lg text-amber-600 dark:text-amber-400"></i>
            <span class="text-[11px] font-semibold text-amber-800 dark:text-amber-200 mt-1">Dosen</span>
          </a>
          <a href="/admin/dashboard?status=success&msg=Masuk+sebagai+Staf+Akademik+(Rina)"
            class="flex flex-col items-center justify-center p-2.5 rounded-lg border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-800/60 dark:hover:bg-zinc-800 text-center transition-colors">
            <i class="ph ph-shield-check text-lg text-zinc-700 dark:text-zinc-300"></i>
            <span class="text-[11px] font-semibold text-zinc-700 dark:text-zinc-300 mt-1">Admin</span>
          </a>
        </div>
      </div>

      <div class="border-t border-zinc-100 pt-4 dark:border-zinc-800 text-center text-xs text-zinc-500">
        <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-200 inline-flex items-center gap-1 font-medium">
          <i class="ph ph-arrow-left"></i>
          <span>Kembali ke Halaman Depan</span>
        </a>
      </div>

    </div>
  </div>

  <%- include('../partials/footer') %>