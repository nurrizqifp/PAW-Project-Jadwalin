<%- include('../partials/head', { judul: 'Masuk Sistem — Jadwalin TI UMY' }) %>

<div class="min-h-screen flex flex-col lg:flex-row bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-50">
  
  <!-- SISI KIRI: Branding & Informasi Institusi (Split View Desktop) -->
  <div class="hidden lg:flex lg:w-1/2 relative bg-[#0c2b5e] p-12 flex-col justify-between overflow-hidden text-white">
    <!-- Aurora background mesh -->
    <div class="absolute -top-20 -left-20 w-[480px] h-[480px] rounded-full bg-blue-500/20 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -right-20 w-[480px] h-[480px] rounded-full bg-amber-400/20 blur-3xl pointer-events-none"></div>

    <div class="relative z-10">
      <a href="/" class="flex items-center space-x-3 group">
        <img src="/logo.png" alt="Logo Jadwalin" class="h-10 w-auto object-contain">
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-tight text-white font-heading">Jadwalin</span>
          <span class="text-xs text-blue-200 font-mono">TI Fakultas Teknik UMY</span>
        </div>
      </a>
    </div>

    <div class="relative z-10 space-y-6 max-w-lg">
      <div class="space-y-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-mono font-semibold border border-amber-400/30">
          Sistem Penjadwalan Cerdas TI
        </span>
        <h2 class="font-heading text-4xl font-extrabold tracking-tight leading-tight">
          Penyusunan Jadwal Lebih Cepat, Tepat, dan Bebas Bentrok
        </h2>
        <p class="text-sm text-blue-100/90 leading-relaxed pt-1">
          Didukung AI solver untuk mendistribusikan 111 sesi perkuliahan tanpa tabrakan ruang dan jam dosen, menghormati waktu ibadah sholat, dan memudahkan pemilihan Pra-KRS.
        </p>
      </div>

      <!-- Feature Badges -->
      <div class="grid grid-cols-2 gap-3 pt-2 text-xs font-medium">
        <div class="flex items-center gap-2 p-2.5 rounded-lg bg-white/10 backdrop-blur-xs border border-white/10">
          <i class="ph ph-shield-check text-amber-400 text-lg"></i>
          <span>Zero Hard Constraint Clash</span>
        </div>
        <div class="flex items-center gap-2 p-2.5 rounded-lg bg-white/10 backdrop-blur-xs border border-white/10">
          <i class="ph ph-moon-stars text-amber-400 text-lg"></i>
          <span>Jeda Sholat Dhuhur Terjamin</span>
        </div>
        <div class="flex items-center gap-2 p-2.5 rounded-lg bg-white/10 backdrop-blur-xs border border-white/10">
          <i class="ph ph-calendar-check text-amber-400 text-lg"></i>
          <span>Simulasi Pra-KRS Cerdas</span>
        </div>
        <div class="flex items-center gap-2 p-2.5 rounded-lg bg-white/10 backdrop-blur-xs border border-white/10">
          <i class="ph ph-devices text-amber-400 text-lg"></i>
          <span>Calendar Grid Multi-Role</span>
        </div>
      </div>
    </div>

    <div class="relative z-10 flex items-center justify-between text-xs text-blue-200/80 font-mono">
      <span>Tahun Akademik 2026/2027</span>
      <span>Jadwalin Core v2.0</span>
    </div>
  </div>

  <!-- SISI KANAN: Form Masuk (Split View) -->
  <div class="flex-1 flex items-center justify-center p-6 sm:p-12 lg:p-16">
    <div class="w-full max-w-md space-y-6">

      <div class="space-y-2">
        <div class="flex items-center gap-3 lg:hidden mb-4">
          <img src="/logo.png" alt="Logo Jadwalin" class="h-10 w-auto">
          <span class="font-heading font-bold text-xl text-zinc-900 dark:text-zinc-50">Jadwalin</span>
        </div>
        <h1 class="font-heading text-2xl font-bold text-zinc-900 dark:text-zinc-50">
          Masuk ke Portal Jadwalin
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          Gunakan kredensial akun akademik terdaftar untuk mengakses panel perkuliahan.
        </p>
      </div>

      <form action="/api/auth/login" method="POST" class="space-y-4 text-xs">
        <div class="space-y-1.5">
          <label for="username" class="block font-semibold text-zinc-700 dark:text-zinc-300">
            Username / NIM / NIP
          </label>
          <input id="username" name="username" type="text" required placeholder="Contoh: rina.akademik / 20240140093"
            class="w-full min-h-[42px] rounded-lg border border-zinc-200 bg-white px-3 py-2 text-zinc-900 focus:border-[#0c2b5e] focus:ring-1 focus:ring-[#0c2b5e] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:focus:border-amber-400 dark:focus:ring-amber-400 transition-colors">
        </div>

        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label for="password" class="block font-semibold text-zinc-700 dark:text-zinc-300">
              Kata Sandi
            </label>
            <a href="/forgot-password"
              class="text-amber-600 hover:text-amber-700 dark:text-amber-400 dark:hover:text-amber-300 font-medium">
              Lupa sandi?
            </a>
          </div>
          <div class="relative">
            <input id="password" name="password" type="password" required placeholder="••••••••"
              class="w-full min-h-[42px] rounded-lg border border-zinc-200 bg-white pl-3 pr-10 py-2 text-zinc-900 focus:border-[#0c2b5e] focus:ring-1 focus:ring-[#0c2b5e] dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 dark:focus:border-amber-400 dark:focus:ring-amber-400 transition-colors">
            <button type="button" onclick="toggleLoginPasswordEye()"
              class="absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 p-1">
              <i id="login-eye-icon" class="ph ph-eye text-base"></i>
            </button>
          </div>
        </div>

        <button type="submit"
          class="w-full inline-flex min-h-[42px] items-center justify-center gap-2 rounded-lg bg-[#0c2b5e] hover:bg-[#081d40] px-4 py-2 font-semibold text-white shadow-xs border border-blue-900/40 transition-colors">
          <i class="ph ph-sign-in text-base text-amber-400"></i>
          <span>Masuk Sekarang</span>
        </button>
      </form>

      <!-- Quick Role Access Cards (Demo) -->
      <div class="space-y-2.5 pt-2 border-t border-zinc-100 dark:border-zinc-800">
        <p class="text-[11px] font-mono uppercase tracking-wider text-zinc-400 text-center">
          Pilih Peran Demo / Uji Coba Cepat
        </p>
        <div class="grid grid-cols-3 gap-2">
          <button type="button" onclick="selectDemoRole('mahasiswa')"
            class="flex flex-col items-center justify-center p-2.5 rounded-lg border border-blue-200 bg-blue-50/60 hover:bg-blue-100/80 dark:border-blue-900/50 dark:bg-blue-950/40 dark:hover:bg-blue-950/70 text-center transition-colors">
            <i class="ph ph-student text-lg text-[#0c2b5e] dark:text-blue-300"></i>
            <span class="text-[11px] font-semibold text-[#0c2b5e] dark:text-blue-200 mt-1">Mahasiswa</span>
          </button>
          <button type="button" onclick="selectDemoRole('dosen')"
            class="flex flex-col items-center justify-center p-2.5 rounded-lg border border-amber-200 bg-amber-50/60 hover:bg-amber-100/80 dark:border-amber-900/50 dark:bg-amber-950/40 dark:hover:bg-amber-950/70 text-center transition-colors">
            <i class="ph ph-chalkboard-teacher text-lg text-amber-600 dark:text-amber-400"></i>
            <span class="text-[11px] font-semibold text-amber-800 dark:text-amber-200 mt-1">Dosen</span>
          </button>
          <button type="button" onclick="selectDemoRole('admin')"
            class="flex flex-col items-center justify-center p-2.5 rounded-lg border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-800/60 dark:hover:bg-zinc-800 text-center transition-colors">
            <i class="ph ph-shield-check text-lg text-zinc-700 dark:text-zinc-300"></i>
            <span class="text-[11px] font-semibold text-zinc-700 dark:text-zinc-300 mt-1">Admin</span>
          </button>
        </div>
      </div>

      <div class="border-t border-zinc-100 pt-4 dark:border-zinc-800 text-center text-xs text-zinc-500">
        <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-200 inline-flex items-center gap-1 font-medium">
          <i class="ph ph-arrow-left"></i>
          <span>Kembali ke Halaman Beranda</span>
        </a>
      </div>

    </div>
  </div>

</div>

<script>
  function toggleLoginPasswordEye() {
    const input = document.getElementById('password');
    const icon = document.getElementById('login-eye-icon');
    if (!input || !icon) return;
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'ph ph-eye-slash text-base text-zinc-700 dark:text-zinc-200';
    } else {
      input.type = 'password';
      icon.className = 'ph ph-eye text-base text-zinc-400';
    }
  }

  function selectDemoRole(role) {
    document.cookie = "userRole=" + role + "; path=/; max-age=604800";
    if (role === 'mahasiswa') {
      window.location.href = '/mahasiswa/dashboard';
    } else if (role === 'dosen') {
      window.location.href = '/dosen/dashboard';
    } else {
      window.location.href = '/admin/dashboard';
    }
  }

  // Handle Login Form Submit
  const loginForm = document.querySelector('form');
  if (loginForm) {
    loginForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const usernameInput = document.getElementById('username')?.value.trim().toLowerCase() || '';
      
      let role = 'mahasiswa';
      if (usernameInput.includes('admin') || usernameInput.includes('rina')) {
        role = 'admin';
      } else if (usernameInput.includes('dosen') || usernameInput.includes('budi') || usernameInput.includes('asroni')) {
        role = 'dosen';
      }

      document.cookie = "userRole=" + role + "; path=/; max-age=604800";

      if (role === 'admin') {
        window.location.href = '/admin/dashboard';
      } else if (role === 'dosen') {
        window.location.href = '/dosen/dashboard';
      } else {
        window.location.href = '/mahasiswa/dashboard';
      }
    });
  }
</script>
