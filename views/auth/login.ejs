<%- include('../partials/head', { judul: 'Masuk Sistem — Jadwalin TI UMY' }) %>

<div class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md rounded-2xl border border-zinc-200 bg-white p-6 sm:p-8 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 space-y-6">
    
    <div class="space-y-1 text-center">
      <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900">
        <i class="ph ph-calendar text-xl"></i>
      </div>
      <h1 class="font-heading text-xl font-bold text-zinc-900 dark:text-zinc-50 pt-2">Masuk ke Jadwalin</h1>
      <p class="text-xs text-zinc-500 dark:text-zinc-400">Sistem Penjadwalan Cerdas Prodi TI UMY</p>
    </div>

    <form action="/api/auth/login" method="POST" class="space-y-4">
      <div class="space-y-1.5">
        <label for="username" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Username / NIP / NIM</label>
        <input id="username" name="username" type="text" required placeholder="Contoh: rina.akademik / 20240140093" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 transition-colors">
      </div>

      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="password" class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300">Kata Sandi</label>
          <a href="#" class="text-xs text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-200">Lupa sandi?</a>
        </div>
        <input id="password" name="password" type="password" required placeholder="••••••••" class="w-full min-h-[44px] rounded-md border border-zinc-200 bg-white px-3 py-2 text-sm text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-100 transition-colors">
      </div>

      <button type="submit" class="w-full inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md bg-zinc-900 px-4 py-2 text-xs font-semibold text-white hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white transition-colors">
        <i class="ph ph-sign-in text-base"></i>
        <span>Masuk Sekarang</span>
      </button>
    </form>

    <!-- Quick Role Login (Testing & Prototyping) -->
    <div class="space-y-2.5 pt-2 border-t border-zinc-100 dark:border-zinc-800">
      <p class="text-[11px] font-mono uppercase tracking-wider text-zinc-400 text-center">
        Pilih Akun Demo / Uji Coba Role
      </p>
      <div class="grid grid-cols-3 gap-2">
        <a href="/mahasiswa/dashboard?status=success&msg=Masuk+sebagai+Mahasiswa+(Haidar)" class="flex flex-col items-center justify-center p-2 rounded-lg border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-800/60 dark:hover:bg-zinc-800 text-center transition-colors">
          <i class="ph ph-student text-base text-zinc-800 dark:text-zinc-200"></i>
          <span class="text-[10px] font-semibold text-zinc-700 dark:text-zinc-300 mt-1">Mahasiswa</span>
        </a>
        <a href="/dosen/dashboard?status=success&msg=Masuk+sebagai+Dosen+(Dr.+Bambang)" class="flex flex-col items-center justify-center p-2 rounded-lg border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-800/60 dark:hover:bg-zinc-800 text-center transition-colors">
          <i class="ph ph-chalkboard-teacher text-base text-zinc-800 dark:text-zinc-200"></i>
          <span class="text-[10px] font-semibold text-zinc-700 dark:text-zinc-300 mt-1">Dosen</span>
        </a>
        <a href="/admin/dashboard?status=success&msg=Masuk+sebagai+Staf+Akademik+(Rina)" class="flex flex-col items-center justify-center p-2 rounded-lg border border-zinc-200 bg-zinc-50 hover:bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-800/60 dark:hover:bg-zinc-800 text-center transition-colors">
          <i class="ph ph-shield-check text-base text-zinc-800 dark:text-zinc-200"></i>
          <span class="text-[10px] font-semibold text-zinc-700 dark:text-zinc-300 mt-1">Admin</span>
        </a>
      </div>
    </div>

    <div class="border-t border-zinc-100 pt-4 dark:border-zinc-800 text-center text-xs text-zinc-500">
      <a href="/" class="hover:text-zinc-900 dark:hover:text-zinc-200 inline-flex items-center gap-1">
        <i class="ph ph-arrow-left"></i>
        <span>Kembali ke Halaman Depan</span>
      </a>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
